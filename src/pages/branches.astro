---
import PageLayout from '@layouts/PageLayout.astro';
import Icon from '@components/ui/Icon.astro';
import { site, whatsappLink, branches } from '@data/site';
import { OMAN_PATH, OMAN_VIEWBOX, OMAN_PINS, OMAN_SPOKES } from '@data/omanMap';

/** North to south, matching the map. */
const order = ['sohar', 'ruwi', 'salalah'];
const list = order.map((s) => branches.find((b) => b.slug === s)!);

const confirmed = list.filter((b) => b.verified).length;

/** Which side of its pin each label sits on, so the chips never collide. */
const labelSide: Record<string, 'left' | 'right'> = {
  sohar: 'left',
  ruwi: 'right',
  salalah: 'right',
};

/* The nudges existed only to separate two pins that sat 28 map units
   apart. With that branch withdrawn nothing overlaps. */
const labelNudge: Record<string, string> = {
  sohar: '0%',
  ruwi: '0%',
  salalah: '0%',
};

const figures = [
  { icon: 'building', v: site.stats.branches, suffix: '', l: 'Branches' },
  { icon: 'box', v: site.stats.parts, suffix: '', l: 'Parts in stock' },
  {
    icon: 'award',
    v: new Date().getFullYear() - site.stats.since,
    suffix: '+',
    l: 'Years trading',
  },
] as const;

/** Map viewBox, so chip positions can be expressed as percentages. */
const W = 1000;
const H = 1342;
---

<PageLayout
  title="Branches"
  description="Danat Computers has three branches across Oman — Ruwi, Sohar and Salalah. Addresses, opening hours and contact for each."
>
  {/* ─────────────────────── 01 · reach ─────────────────────── */}
  <section class="bh">
    <!-- Soft brand blooms. They are what stops a white page reading as
         an empty page, and they cost one composited layer each. -->
    <div class="bh__aura" aria-hidden="true">
      <span class="bh__b1"></span>
      <span class="bh__b2"></span>
      <span class="bh__b3"></span>
    </div>

    <div class="shell">
      <nav class="bh__crumb" aria-label="Breadcrumb" data-rise>
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">Branches</span>
      </nav>

      <div class="bh__grid">
        <!-- ── copy ── -->
        <div class="bh__copy">
          <p class="eyebrow" data-rise>
            <i class="eyebrow__dot" aria-hidden="true"></i>
            Our reach
            <i class="eyebrow__rule" aria-hidden="true"></i>
          </p>

          <h1 class="bh__h" data-rise style="--d:70ms">
            Three branches.<br /><em>One standard.</em>
          </h1>

          <p class="bh__p" data-rise style="--d:130ms">
            Ruwi, Sohar and Salalah. The same technicians, the same
            free diagnosis and the same stock behind every counter.
          </p>

          <dl class="bh__figs">
            {figures.map((f, i) => (
              <div class="fig" data-rise style={`--d:${190 + i * 70}ms`}>
                <span class="fig__i" aria-hidden="true">
                  <Icon name={f.icon} size={19} />
                </span>
                <div>
                  <dt><span data-count={f.v}>{Number(f.v).toLocaleString('en-US')}</span>{f.suffix}</dt>
                  <dd>{f.l}</dd>
                </div>
              </div>
            ))}
          </dl>

          <div class="bh__acts" data-rise style="--d:400ms">
            <a class="btn-green" href="#branches">
              Find your nearest branch
              <span class="btn-green__i" aria-hidden="true">
                <Icon name="arrow" size={15} />
              </span>
            </a>
            <span class="bh__where">
              <Icon name="pin" size={15} />Across Oman
            </span>
          </div>
        </div>

        <!-- ── map ── -->
        <div class="bh__map" data-rise style="--d:160ms">
          <div class="bh__mapin">
            <svg class="bh__svg" viewBox={OMAN_VIEWBOX} role="img"
              aria-label="Map of Oman showing Danat branches in Sohar, Ruwi and Salalah">
              <defs>
                <linearGradient id="omanFill" x1="0" y1="0" x2="0.4" y2="1">
                  <stop class="bh__s0" offset="0%" />
                  <stop class="bh__s1" offset="100%" />
                </linearGradient>
              </defs>

              <path class="bh__land" d={OMAN_PATH} />
              <path class="bh__edge" d={OMAN_PATH} pathLength="1" />

              {/* Every branch threads back to Ruwi, the main counter. */}
              {OMAN_SPOKES.map(([a, b], i) => {
                const p = OMAN_PINS[a];
                const q = OMAN_PINS[b];
                return (
                  <path class="bh__route" style={`--i:${i}`}
                    d={`M${p.x},${p.y} Q${(p.x + q.x) / 2 - 40},${(p.y + q.y) / 2} ${q.x},${q.y}`} />
                );
              })}

              {list.map((b, i) => (
                <g class="bh__pin" style={`--i:${i}`}
                  transform={`translate(${OMAN_PINS[b.slug].x} ${OMAN_PINS[b.slug].y})`}>
                  <circle class="bh__halo" r="44"></circle>
                  <circle class="bh__ring" r="20"></circle>
                  <circle class="bh__dot" r="12"></circle>
                </g>
              ))}
            </svg>

            {/* Labels are HTML, not SVG text — crisp at every size, and
                each one jumps to its card. */}
            {list.map((b, i) => (
              <a class="chip" href={`#${b.slug}`} data-side={labelSide[b.slug]}
                style={`--i:${i}; --x:${((OMAN_PINS[b.slug].x / W) * 100).toFixed(2)}%; --y:${((OMAN_PINS[b.slug].y / H) * 100).toFixed(2)}%; --dy:${labelNudge[b.slug]}`}>
                {b.city.split(',')[0]}
              </a>
            ))}

            <!-- A handwritten aside, set in the page's serif italic. -->
            <p class="bh__note" aria-hidden="true">
              Three locations<br />Stronger together
              <svg class="bh__arrow" viewBox="0 0 90 70" fill="none">
                <path d="M78 4C84 24 74 46 50 56" stroke="currentColor"
                  stroke-width="3" stroke-linecap="round" pathLength="1" />
                <path d="M62 52 49 57l9 10" stroke="currentColor"
                  stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </p>
          </div>

          <!-- Floating promise card -->
          <a class="promise" href={whatsappLink()} target="_blank"
            rel="noopener noreferrer" data-rise style="--d:520ms">
            <span class="promise__h">Quality<br />support<br />everywhere</span>
            <span class="promise__p">Same service. Same care.<br />In every city.</span>
            <span class="promise__i" aria-hidden="true">
              <Icon name="arrow" size={14} />
            </span>
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* ─────────────────────── 02 · branches ─────────────────────── */}
  <section class="bl section" id="branches" data-tone="light">
    <div class="shell bl__head">
      <p class="eyebrow eyebrow--mid" data-rise>
        <i class="eyebrow__rule" aria-hidden="true"></i>
        Our branches
        <i class="eyebrow__rule" aria-hidden="true"></i>
      </p>
      <h2 class="bl__h" data-rise style="--d:70ms">
        Visit our <em>branches</em>
      </h2>
      <p class="bl__sub" data-rise style="--d:130ms">
        Same friendly team. Same trusted service.
      </p>
    </div>

    <ul class="shell bl__grid">
      {list.map((b, i) => (
        <li id={b.slug} data-rise style={`--d:${(i % 2) * 90}ms`}>
          <article class="card">
            {/* No shopfront photography has been supplied yet, so the
                frame is held open rather than filled with stock. */}
            <div class="card__media">
              <span class="card__hatch" aria-hidden="true"></span>
              <span class="card__wait">Shopfront photo to follow</span>
              <span class="card__badge" aria-hidden="true">
                <Icon name="building" size={19} />
              </span>
            </div>

            <header class="card__top">
              <div>
                <h3 class="card__n">{b.name}</h3>
                <p class="card__c">{b.city}</p>
              </div>
              {b.slug === 'ruwi' ? (
                <span class="card__tag">Main branch</span>
              ) : (
                !b.verified && <span class="card__tag card__tag--todo">To confirm</span>
              )}
            </header>

            <div class="card__rows">
              <div class="card__row">
                <Icon name="pin" size={16} />
                {b.verified ? (
                  <address>{b.address.split('\n').map((l) => <>{l}<br /></>)}</address>
                ) : (
                  <span class="card__slot">Street address to be confirmed</span>
                )}
              </div>

              <div class="card__row">
                <Icon name="clock" size={16} />
                <ul class="card__hours" data-unverified={!b.hoursVerified ? '' : undefined}>
                  {b.hours.map((h) => <li>{h}</li>)}
                  {!b.hoursVerified && <li class="card__warn">Hours not yet confirmed</li>}
                </ul>
              </div>
            </div>

            <footer class="card__acts">
              <a class="card__wa"
                href={whatsappLink(`Hello Danat — I'd like to contact your ${b.name} branch about`)}
                target="_blank" rel="noopener noreferrer"
                title={`WhatsApp ${b.name}`}
                aria-label={`Message ${b.name} on WhatsApp`}>
                <Icon name="whatsapp" size={18} />
              </a>
              <a class="card__call" href={`tel:${b.tel ?? site.phone.tel}`}>
                {b.phone ?? site.phone.display}
              </a>
              <span class="card__go" aria-hidden="true">
                <Icon name="arrow" size={15} />
              </span>
            </footer>
          </article>
        </li>
      ))}
    </ul>

    {confirmed < list.length && (
      <p class="shell bl__note" data-rise>
        {list.length - confirmed} of {list.length} branch addresses are still
        being confirmed with the company. Phone and WhatsApp reach the Ruwi
        counter, who will direct you.
      </p>
    )}
  </section>

  {/* ─────────────────────── 03 · cta ─────────────────────── */}
  <section class="bc" data-tone="ink">
    <div class="shell bc__in">
      <div>
        <p class="label" data-rise>Not sure which branch?</p>
        <h2 class="bc__h" data-rise style="--d:70ms">
          Message us.<br /><em>We will point you.</em>
        </h2>
      </div>
      <a class="bc__wa" data-rise style="--d:140ms" href={whatsappLink()}
        target="_blank" rel="noopener noreferrer"
        title="Chat on WhatsApp" aria-label="Chat with Danat on WhatsApp">
        <Icon name="whatsapp" size={20} />
      </a>
    </div>
  </section>
</PageLayout>

<style>
  /* ============================================================
     01 · REACH
     ============================================================ */

  .bh {
    position: relative;
    background: var(--white);
    padding-block: clamp(6.5rem, 11vw, 9rem) clamp(3rem, 6vw, 5rem);
    overflow: hidden;
    isolation: isolate;
  }

  /* ---------- ambient blooms ---------- */

  .bh__aura {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }
  .bh__aura span {
    position: absolute;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      color-mix(in oklab, var(--green) 30%, transparent) 0%,
      transparent 68%
    );
    filter: blur(28px);
  }
  .bh__b1 { top: -26%; left: -14%; width: 44%; aspect-ratio: 1; opacity: 0.5; }
  .bh__b2 { top: 8%; right: -18%; width: 52%; aspect-ratio: 1; opacity: 0.38; }
  .bh__b3 { bottom: -30%; left: 30%; width: 46%; aspect-ratio: 1; opacity: 0.3; }

  /* A very slow drift. Below ~0.04 Hz it never reads as "animation" —
     it just stops the background looking like a flat fill. */
  @media (prefers-reduced-motion: no-preference) {
    .bh__b1 { animation: drift-a 26s var(--ease) infinite alternate; }
    .bh__b2 { animation: drift-b 32s var(--ease) infinite alternate; }
    .bh__b3 { animation: drift-a 38s var(--ease) infinite alternate-reverse; }
  }
  @keyframes drift-a { to { transform: translate3d(5%, 7%, 0) scale(1.14); } }
  @keyframes drift-b { to { transform: translate3d(-7%, 5%, 0) scale(1.1); } }

  /* ---------- breadcrumb ---------- */

  .bh__crumb {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.8125rem;
    color: var(--text-3);
  }
  .bh__crumb a { transition: color var(--t2) var(--ease); }
  .bh__crumb a:hover { color: var(--green-deep); }
  .bh__crumb [aria-current] { color: var(--text); }

  .bh__grid {
    display: grid;
    gap: clamp(2.5rem, 6vw, 4rem);
    align-items: center;
    margin-top: var(--s5);
  }

  /* ---------- eyebrow ---------- */

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--green-deep);
  }
  .eyebrow__dot {
    width: 9px;
    height: 9px;
    flex: none;
    border-radius: 50%;
    background: var(--green);
    box-shadow: 0 0 0 4px color-mix(in oklab, var(--green) 20%, transparent);
  }
  .eyebrow__rule {
    width: 26px;
    height: 1px;
    flex: none;
    background: color-mix(in oklab, var(--green) 55%, transparent);
  }
  .eyebrow--mid { justify-content: center; }

  /* ---------- headline ---------- */

  .bh__h {
    margin-top: var(--s4);
    font-size: var(--hero);
    line-height: var(--hero-lh);
    letter-spacing: var(--hero-tr);
    font-weight: 700;
  }
  .bh__h em { font-style: normal; color: var(--green-deep); }

  .bh__p {
    margin-top: var(--s4);
    max-width: 42ch;
    font-size: var(--lead);
    line-height: 1.62;
    color: var(--text-2);
  }

  /* ---------- figures ---------- */

  .bh__figs {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(0.6rem, 1.4vw, 0.9rem);
    margin-top: var(--s5);
  }

  .fig {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.85rem 1.15rem 0.85rem 0.85rem;
    border: 1px solid var(--line-light);
    border-radius: 14px;
    background: rgb(255 255 255 / 0.78);
    backdrop-filter: blur(8px);
    box-shadow: 0 12px 26px -22px rgb(0 0 0 / 0.5);
    transition:
      transform var(--t2) var(--ease),
      border-color var(--t2) var(--ease),
      box-shadow var(--t2) var(--ease);
  }
  .fig:hover {
    transform: translateY(-3px);
    border-color: color-mix(in oklab, var(--green) 34%, var(--line-light));
    box-shadow: 0 18px 30px -22px rgb(0 0 0 / 0.45);
  }

  .fig__i {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    flex: none;
    border-radius: 11px;
    color: var(--green-deep);
    background: color-mix(in oklab, var(--green) 14%, #fff);
  }

  .fig dt {
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .fig dd {
    margin-top: 0.2rem;
    font-size: 0.75rem;
    color: var(--text-3);
    white-space: nowrap;
  }

  /* ---------- actions ---------- */

  .bh__acts {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s4) var(--s5);
    margin-top: var(--s5);
  }

  .btn-green {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.55rem 0.55rem 0.55rem 1.6rem;
    border-radius: 999px;
    /* Measured: white is 8.73:1 on #27551F and 4.90:1 on #3D7F35, so
       every point of the ramp clears AA. Running it out to --green
       (#59AA54) would drop the right-hand end to 2.88:1. */
    background: linear-gradient(100deg, #27551f, #3d7f35);
    color: #fff;
    font-size: 0.9375rem;
    font-weight: 600;
    overflow: hidden;
    box-shadow: 0 14px 28px -16px color-mix(in oklab, var(--green) 70%, #000);
    transition: transform var(--t2) var(--ease), box-shadow var(--t2) var(--ease);
  }
  .btn-green:hover {
    transform: translateY(-2px);
    box-shadow: 0 18px 32px -16px color-mix(in oklab, var(--green) 70%, #000);
  }
  /* A light sheen crosses the pill on hover. */
  .btn-green::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      100deg, transparent 35%, rgb(255 255 255 / 0.22) 50%, transparent 65%
    );
    transform: translate3d(-100%, 0, 0);
    transition: transform var(--t4) var(--ease);
  }
  .btn-green:hover::after { transform: translate3d(100%, 0, 0); }

  .btn-green__i {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    flex: none;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.2);
    transition: transform var(--t2) var(--ease);
  }
  .btn-green:hover .btn-green__i { transform: translateX(3px); }

  .bh__where {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.875rem;
    color: var(--text-2);
  }
  .bh__where :global(svg) { color: var(--green-deep); }

  /* ============================================================
     MAP
     ============================================================ */

  .bh__map { position: relative; justify-self: center; width: 100%; }
  .bh__mapin { position: relative; width: 100%; max-width: 26rem; margin-inline: auto; }
  .bh__svg { display: block; width: 100%; height: auto; overflow: visible; }

  /* The fill arrives only once the coastline has been traced, so the
     two do not compete for the eye. */
  /* Gradient stops live here, not on the <stop> elements: var() is not
     reliably resolved inside SVG presentation attributes. */
  .bh__s0 { stop-color: var(--green); stop-opacity: 0.10; }
  .bh__s1 { stop-color: var(--green); stop-opacity: 0.26; }

  .bh__land {
    fill: url(#omanFill);
    stroke: none;
    opacity: 0;
    transition: opacity 900ms var(--ease) 820ms;
  }
  .bh__map[data-in] .bh__land { opacity: 1; }

  /* Coastline draws itself over 1.5s. */
  .bh__edge {
    fill: none;
    stroke: color-mix(in oklab, var(--green) 48%, #fff);
    stroke-width: 3;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 1500ms var(--ease) 120ms;
  }
  .bh__map[data-in] .bh__edge { stroke-dashoffset: 0; }

  /* Spokes thread outward from Ruwi. */
  .bh__route {
    fill: none;
    stroke: var(--green);
    stroke-width: 2.5;
    stroke-dasharray: 2 13;
    stroke-linecap: round;
    opacity: 0;
    transition: opacity 600ms var(--ease) calc(1480ms + var(--i) * 120ms);
  }
  .bh__map[data-in] .bh__route {
    opacity: 0.55;
    animation: flow 3s linear infinite;
  }
  @keyframes flow { to { stroke-dashoffset: -15; } }

  /* Pins drop north to south, 150ms apart — the map is read in the same
     order as the cards below it. */
  .bh__pin {
    --pd: calc(1560ms + var(--i) * 150ms);
    opacity: 0;
    scale: 0.2;
    transform-box: fill-box;
    transform-origin: center;
    transition:
      opacity 400ms var(--ease) var(--pd),
      scale 620ms cubic-bezier(0.3, 1.5, 0.5, 1) var(--pd);
  }
  .bh__map[data-in] .bh__pin { opacity: 1; scale: 1; }

  .bh__dot { fill: var(--green-deep); }
  .bh__ring { fill: #fff; }

  .bh__halo {
    fill: var(--green);
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
  }
  /* The ping waits until every pin has landed. */
  .bh__map[data-in] .bh__halo {
    animation: ping 3s var(--ease) calc(var(--pd) + 400ms) infinite;
  }
  @keyframes ping {
    0% { opacity: 0.3; transform: scale(0.35); }
    70%, 100% { opacity: 0; transform: scale(1); }
  }

  /* ---------- label chips ---------- */

  .chip {
    position: absolute;
    top: calc(var(--y) + var(--dy, 0%));
    left: var(--x);
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.92);
    backdrop-filter: blur(6px);
    box-shadow: 0 6px 16px -10px rgb(0 0 0 / 0.55);
    font-size: var(--small);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text);
    white-space: nowrap;
    opacity: 0;
    transition:
      opacity 380ms var(--ease) calc(1760ms + var(--i) * 150ms),
      color var(--t2) var(--ease),
      background-color var(--t2) var(--ease);
  }
  /* `translate` does the anchoring so `opacity` is the only thing the
     reveal touches — the two never fight. */
  .chip[data-side='right'] { translate: 1.4rem -50%; }
  .chip[data-side='left'] { translate: calc(-100% - 1.4rem) -50%; }

  .bh__map[data-in] .chip { opacity: 1; }

  .chip:hover { background: var(--green-deep); color: #fff; }

  /* ---------- handwritten aside ---------- */

  .bh__note {
    position: absolute;
    top: 0;
    right: -4%;
    max-width: 9.5rem;
    /* It overhangs the map box, so it must never sit in front of the
       promise card's hit area. */
    pointer-events: none;
    font-family: var(--font-serif, Georgia, serif);
    font-style: italic;
    font-size: var(--lead);
    line-height: 1.3;
    color: var(--text-2);
    text-align: center;
    opacity: 0;
    rotate: -4deg;
    transition: opacity 600ms var(--ease) 2200ms;
  }
  .bh__map[data-in] .bh__note { opacity: 1; }

  .bh__arrow {
    display: block;
    width: 62px;
    height: auto;
    margin: 0.2rem auto 0;
    color: var(--green);
  }
  /* The stroke draws once the words have settled. */
  .bh__arrow path:first-child {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 700ms var(--ease) 2500ms;
  }
  .bh__arrow path:last-child {
    opacity: 0;
    transition: opacity 250ms var(--ease) 3100ms;
  }
  .bh__map[data-in] .bh__arrow path:first-child { stroke-dashoffset: 0; }
  .bh__map[data-in] .bh__arrow path:last-child { opacity: 1; }

  /* ---------- promise card ---------- */

  .promise {
    position: relative;
    display: block;
    width: min(14rem, 100%);
    margin: var(--s5) auto 0;
    padding: 1.15rem 1.25rem;
    border: 1px solid var(--line-light);
    border-left: 3px solid var(--green);
    border-radius: 14px;
    background: rgb(255 255 255 / 0.9);
    backdrop-filter: blur(10px);
