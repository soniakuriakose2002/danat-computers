---
import { Image } from 'astro:assets';
import PageLayout from '@layouts/PageLayout.astro';
import Icon from '@components/ui/Icon.astro';
import { site, whatsappLink, branches, brands } from '@data/site';
import imgRack from '@assets/photos/network-eng.jpg';
import imgPatch from '@assets/photos/network-patch.jpg';

/**
 * BUSINESS SOLUTIONS.
 *
 * The B2B side is real and evidenced: the company's AR ledger shows
 * hospitals, enterprises and other computer retailers buying at trade.
 * Everything claimed here rests on that, on the catalogue export, or on
 * the branch list.
 *
 * ⚠ Two things are NOT confirmed and are marked on the page rather than
 * asserted: on-site call-out coverage, and any response-time or SLA
 * commitment. Danat has published neither. Do not turn the "response
 * time" card into a number without the company confirming it.
 *
 * Clay carries the accent here — the consumer pages lead green, so the
 * trade side reading warmer gives it its own identity without leaving
 * the palette.
 */
const years = new Date().getFullYear() - site.stats.since;
const brandCount = brands.flat().length;

/**
 * Span and tone per card. Six equal boxes in a three-up grid is the most
 * conventional layout there is; an uneven grid with two dark tiles gives
 * the page somewhere for the eye to land.
 */
const services = [
  {
    icon: 'box',
    t: 'Supply at trade',
    p: 'Laptops, desktops, peripherals and consumables from the same stock that serves the counter.',
    points: [`${brandCount} brands carried`, `${site.stats.categories} product categories`, 'Held across four branches'],
    span: 2,
    tone: 'ink',
    stat: { v: site.stats.parts, l: 'lines held, ready to go' },
  },
  {
    icon: 'camera',
    t: 'CCTV projects',
    p: 'Surveyed, specified, installed and maintained. Hikvision, Dahua, Uniview and EZVIZ.',
    points: ['Hikvision, Dahua, Uniview', 'Cameras, NVR and DVR', 'Supplied from stock'],
    span: 1, tone: 'light', stat: null,
  },
  {
    icon: 'network',
    t: 'Networking',
    p: 'Cabling, switching and Wi-Fi — set up new, or troubleshot where it already exists.',
    points: ['TP-Link routers and switches', 'Cabling and Wi-Fi', 'Home or business'],
    span: 1, tone: 'light', stat: null,
  },
  {
    icon: 'chip',
    t: 'Board-level repair',
    p: 'The workshop that serves the counter serves you too. A failed board is traced to the component rather than written off — which is the difference between a repair bill and a replacement one.',
    points: ['Free diagnosis, always', 'Quoted before any work', 'Component level, not board swap'],
    span: 2, tone: 'green', stat: null,
  },
  {
    icon: 'printer',
    t: 'Print & consumables',
    p: 'Printers supplied and repaired, with toner and ink on the shelf rather than on order.',
    points: ['Supply and repair', 'Canon, Epson, HP, Brother', 'Toner and ink in stock'],
    span: 1, tone: 'light', stat: null,
  },
  {
    icon: 'drive',
    t: 'Data recovery',
    p: 'Failed drives, dead machines and deleted volumes — assessed, with an honest read on what is recoverable before any work begins.',
    points: ['Assessed before any work', 'Told what is recoverable', 'Failed drives and deleted volumes'],
    span: 1, tone: 'light', stat: null,
  },
];

/** Evidenced by the AR ledger, not aspirational. */
const sectors = [
  { icon: 'shield', t: 'Healthcare', p: 'Clinics and hospitals' },
  { icon: 'box', t: 'Retail', p: 'Including other computer shops buying at trade' },
  { icon: 'building', t: 'Offices', p: 'Single site and multi-branch' },
  { icon: 'users', t: 'Education', p: 'Labs, admin and AV' },
];

/** Why Danat, in a horizontal rail. Every line is defensible. */
const reasons = [
  { icon: 'search', t: 'Free diagnosis', p: 'Before a quote, every time — so you find out what it costs before you commit.' },
  { icon: 'chip', t: 'Board-level repair', p: 'Faults traced to the component, not written off at the mainboard.' },
  { icon: 'chart', t: '5,430 lines in stock', p: 'Across 249 categories, so most jobs do not start with an order.' },
  { icon: 'building', t: 'Four branches', p: 'Ruwi, Sohar, Al Hail and Salalah — the same standard at each counter.' },
  { icon: 'award', t: 'Twenty years in', p: 'Trading on Computer Street since 2003, under one registered company.' },
  { icon: 'box', t: 'Sixteen brands', p: 'HP, Dell, Lenovo, Canon, Hikvision and others, from the company catalogue.' },
];

/**
 * Only what the rest of the site already states as policy. An earlier
 * draft had a four-step process describing site surveys and post-handover
 * support — neither is confirmed, and a process diagram reads as a
 * commitment.
 */
const steps = [
  { n: '01', t: 'Tell us what you need', p: 'A list, a floor plan, or just the problem.' },
  { n: '02', t: 'Diagnosis is free', p: 'You are told what failed and what it costs before anything is agreed.' },
  { n: '03', t: 'Work starts once you agree', p: 'Nothing is touched until the quote is accepted.' },
];
---

<PageLayout
  title="Business Solutions"
  description={`Danat Computers supplies and supports business across Oman — trade supply, CCTV, networking, print and board-level repair from ${site.stats.parts.toLocaleString('en-US')} lines held across four branches.`}
>
  {/* ══════ 01 · hero ══════ */}
  <section class="bh">
    <div class="bh__bg" aria-hidden="true">
      <Image src={imgRack} alt="" widths={[1100, 1700, 2200]} sizes="100vw"
        quality={74} format="webp" loading="eager" fetchpriority="high" />
      {/* Measured against the real crop, not guessed. */}
      <span class="bh__tint"></span>
    </div>

    <div class="shell bh__in">
      <nav class="bh__crumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">Business Solutions</span>
      </nav>

      <p class="eb eb--inv"><i class="eb__r" aria-hidden="true"></i>For business</p>

      <h1 class="bh__h">
        The same counter.<br /><em>Built for volume.</em>
      </h1>

      <p class="bh__p">
        Hospitals, retailers and offices across Oman buy from Danat at trade —
        supply, projects and repair from the same stock and the same
        technicians that serve the shop floor.
      </p>

      <div class="bh__acts">
        <a class="btn" href="#quote">
          Get a trade quote
          <span class="btn__i" aria-hidden="true"><Icon name="arrow" size={15} /></span>
        </a>
        <a class="bh__mail" href={`mailto:${site.email}`}>{site.email}</a>
      </div>
    </div>

    <dl class="bh__figs">
      <div class="shell bh__figsin">
        <div><dt><span data-count={site.stats.parts}>0</span></dt><dd>Lines held</dd></div>
        <div><dt><span data-count={brandCount}>0</span></dt><dd>Brands carried</dd></div>
        <div><dt><span data-count={site.stats.branches}>0</span></dt><dd>Branches</dd></div>
        <div><dt><span data-count={years}>0</span>+</dt><dd>Years trading</dd></div>
      </div>
    </dl>
  </section>

  {/* ══════ 02 · what we do ══════ */}
  <section class="sv section">
    <div class="shell">
      <div class="sv__head" data-rise>
        <p class="eb eb--clay"><i class="eb__r" aria-hidden="true"></i>What we do</p>
        <h2 class="sv__h">Six things we take on<br /><em>for business.</em></h2>
      </div>

      <ul class="sv__grid">
        {services.map((s, i) => (
          <li class="card" data-tone={s.tone} style={`--span:${s.span}; --d:${i * 60}ms`} data-rise>
            <span class="card__i" aria-hidden="true"><Icon name={s.icon} size={21} /></span>
            <h3>{s.t}</h3>
            <p>{s.p}</p>

            {s.stat && (
              <p class="card__stat">
                <b><span data-count={s.stat.v}>0</span></b>
                <em>{s.stat.l}</em>
              </p>
            )}

            <ul class="card__pts">
              {s.points.map((pt) => (
                <li><Icon name="check" size={13} />{pt}</li>
              ))}
            </ul>
            <span class="card__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          </li>
        ))}

        {/* Closes the grid instead of leaving a hole in the last row. */}
        <li class="tile">
          <a href={whatsappLink('Hello Danat — I would like a trade quote for')}
            target="_blank" rel="noopener noreferrer">
            <span class="tile__i" aria-hidden="true"><Icon name="whatsapp" size={22} /></span>
            <b>Send us your list</b>
            <em>A spreadsheet, a photo of a shelf, or a floor plan.</em>
            <span class="tile__go" aria-hidden="true"><Icon name="arrow" size={15} /></span>
          </a>
        </li>
      </ul>
    </div>
  </section>

  {/* ══════ 03 · who ══════ */}
  <section class="wh section">
    <div class="shell wh__grid">
      <div class="wh__intro" data-rise>
        <p class="eb"><i class="eb__r" aria-hidden="true"></i>Who buys from us</p>
        <h2 class="wh__h">Already on the<br /><em>ledger.</em></h2>
        <p class="wh__p">
          This is not a new line of business. The company's own accounts
          show these sectors buying at trade, some of them for years.
        </p>

        <p class="wh__ask">
          Named references available on request — ask and we will put you in
          touch with someone in your sector.
        </p>
      </div>

      <ul class="wh__list">
        {sectors.map((s, i) => (
          <li data-rise style={`--d:${i * 70}ms`}>
            <span aria-hidden="true"><Icon name={s.icon} size={19} /></span>
            <div><b>{s.t}</b><em>{s.p}</em></div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* ══════ 03b · why ══════ */}
  <section class="wy section">
    <div class="shell wy__head" data-rise>
      <p class="eb eb--clay"><i class="eb__r" aria-hidden="true"></i>Why Danat</p>
      <h2 class="wy__h">Reasons you can<br /><em>actually check.</em></h2>
    </div>

    {/* A rail rather than a grid: it signals there is more than fits, and
        it scrolls with a thumb as readily as a trackpad. */}
    <div class="wy__rail">
      <ul class="shell-wide wy__track">
        {reasons.map((r, i) => (
          <li data-rise style={`--d:${i * 50}ms`}>
            <span aria-hidden="true"><Icon name={r.icon} size={22} /></span>
            <b>{r.t}</b>
            <em>{r.p}</em>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* ══════ 04 · how ══════ */}
  <section class="hw" data-tone="ink">
    <div class="hw__bg" aria-hidden="true">
      <Image src={imgPatch} alt="" widths={[1000, 1600]} sizes="100vw"
        quality={70} format="webp" loading="lazy" />
      <span class="hw__tint"></span>
    </div>

    <div class="shell hw__in">
      <p class="eb eb--inv" data-rise><i class="eb__r" aria-hidden="true"></i>How it works</p>
      <h2 class="hw__h" data-rise style="--d:70ms">No surprises.</h2>

      <ol class="hw__steps">
        {steps.map((s, i) => (
          <li data-rise style={`--d:${130 + i * 70}ms`}>
            <b>{s.n}</b>
            <h3>{s.t}</h3>
            <p>{s.p}</p>
          </li>
        ))}
      </ol>

      {/* Honest about what has not been settled. */}
      <p class="hw__note" data-rise style="--d:420ms">
        Annual contracts, on-site call-out coverage, delivery and trade
        credit terms are still being confirmed with the company. Ask us and
        we will tell you what we can actually do for your sites rather than
        guess on a web page.
      </p>
    </div>
  </section>

  {/* ══════ 05 · quote ══════ */}
  <section class="qt section" id="quote">
    <span class="qt__wash" aria-hidden="true"></span>

    <div class="shell qt__head" data-rise>
      <p class="eb eb--clay eb--mid"><i class="eb__r" aria-hidden="true"></i>Open an account</p>
      <h2 class="qt__h">Send us the list.<br /><em>We will price it.</em></h2>
      <p class="qt__p">
        A spreadsheet, a photo of a shelf, or a floor plan. Whatever you have
        is enough to start.
      </p>
    </div>

    <form class="shell qt__form" id="trade" data-rise style="--d:90ms">
      <div class="qf__row">
        <div class="qf">
          <label for="q-name">Your name</label>
          <input id="q-name" name="name" type="text" autocomplete="name" required
            placeholder="Who we are quoting for" />
        </div>
        <div class="qf">
          <label for="q-co">Company</label>
          <input id="q-co" name="company" type="text" autocomplete="organization"
            placeholder="Business or trade name" />
        </div>
      </div>

      <div class="qf__row">
        <div class="qf">
          <label for="q-phone">Phone <span>optional</span></label>
          <input id="q-phone" name="phone" type="tel" autocomplete="tel"
            placeholder="If you would rather we called" />
        </div>
        <div class="qf">
          <label for="q-need">What do you need?</label>
          <select id="q-need" name="need">
            {services.map((sv) => <option value={sv.t}>{sv.t}</option>)}
            <option value="A mix of the above">A mix of the above</option>
          </select>
        </div>
      </div>

      <div class="qf">
        <label for="q-msg">Scope, quantities, or the problem</label>
        <textarea id="q-msg" name="message" rows="5" required
          placeholder="40 laptops for a clinic refit, or 12 cameras across two floors — rough is fine."></textarea>
      </div>

      <div class="qt__acts">
        <button class="btn" type="submit">
          Send to Danat
          <span class="btn__i" aria-hidden="true"><Icon name="whatsapp" size={15} /></span>
        </button>
        <a class="qt__call" href={`tel:${site.phone.tel}`}>{site.phone.display}</a>
      </div>

      <p class="qt__note">
        Opens WhatsApp with your enquiry ready — nothing is stored on this
        site and nothing sends until you press send.
      </p>

      <noscript>
        <p class="qt__nojs">
          This form needs JavaScript. Reach us on
          {' '}<a href={whatsappLink()}>WhatsApp</a>, call
          {' '}<a href={`tel:${site.phone.tel}`}>{site.phone.display}</a>, or email
          {' '}<a href={`mailto:${site.email}`}>{site.email}</a>.
        </p>
      </noscript>
    </form>
  </section>

</PageLayout>

<script is:inline define:vars={{ WA: site.phone.whatsapp }}>
  (() => {
    const form = document.getElementById('trade');
    if (!form) return;
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;
      const d = new FormData(form);
      const opt = (k, label) => {
        const v = String(d.get(k) || '').trim();
        return v ? [`${label}: ${v}`] : [];
      };
      const text = [
        `Hello Danat — trade enquiry from ${String(d.get('name') || '').trim()}.`,
        ``,
        ...opt('company', 'Company'),
        ...opt('need', 'Needs'),
        ...opt('phone', 'Phone'),
        ``,
        String(d.get('message') || '').trim(),
      ].join(String.fromCharCode(10));
      window.open(`https://wa.me/${WA}?text=${encodeURIComponent(text)}`, '_blank', 'noopener');
    });
  })();
</script>

<style>
  /* ───── shared ───── */
  .eb {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--green-deep);
  }
  .eb--clay { color: var(--clay-deep); }
  .eb--inv { color: var(--green-bright); }
  .eb__r { width: 26px; height: 1px; flex: none; background: currentColor; opacity: 0.6; }

  .btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    gap: 0.7rem;
    padding: 0.5rem 0.5rem 0.5rem 1.4rem;
    border-radius: 999px;
    /* white is 8.73:1 on #27551f and 4.90:1 on #3d7f35 — AA across the ramp */
    background: linear-gradient(100deg, #27551f, #3d7f35);
    color: #fff;
    font-size: 0.9375rem;
    font-weight: 600;
    overflow: hidden;
    transition: transform var(--t2) var(--ease);
  }
  .btn:hover { transform: translateY(-2px); }
  .btn__i {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    flex: none;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.2);
    transition: transform var(--t2) var(--ease);
  }
  .btn:hover .btn__i { transform: translateX(3px); }

  /* ───── 01 hero ───── */
  .bh {
    position: relative;
    color: #fff;
    padding-block: clamp(7rem, 12vw, 10rem) 0;
    overflow: hidden;
    isolation: isolate;
  }
  .bh__bg { position: absolute; inset: 0; z-index: 0; }
  .bh__bg :global(img) {
    width: 100%; height: 100%; object-fit: cover; object-position: 56% 42%;
  }
  .bh__tint {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(100deg, rgb(8 10 12 / 0.93) 0%, rgb(8 10 12 / 0.84) 44%,
        rgb(8 10 12 / 0.55) 78%, rgb(8 10 12 / 0.4) 100%),
      linear-gradient(to top, rgb(8 10 12 / 0.7), transparent 40%);
  }
  .bh__in { position: relative; z-index: 1; padding-bottom: clamp(3rem, 7vw, 5.5rem); }

  .bh__crumb {
    display: flex; flex-wrap: wrap; align-items: center; gap: 0.45rem;
    margin-bottom: var(--s5);
    font-size: 0.8125rem; color: rgb(255 255 255 / 0.66);
  }
  .bh__crumb a { transition: color var(--t2) var(--ease); }
  .bh__crumb a:hover { color: #fff; }
  .bh__crumb [aria-current] { color: #fff; }

  .bh__h {
    margin-top: var(--s4);
    font-size: clamp(2.3rem, 6vw, 4.2rem);
    line-height: 1.02;
    letter-spacing: -0.046em;
    font-weight: 700;
  }
  .bh__h em { font-style: normal; color: var(--clay-bright); }
  .bh__p {
    margin-top: var(--s4);
    max-width: 46ch;
    font-size: var(--lead);
    line-height: 1.62;
    color: rgb(255 255 255 / 0.84);
  }
  .bh__acts {
    display: flex; flex-wrap: wrap; align-items: center;
    gap: var(--s4) var(--s5); margin-top: var(--s5);
  }
  .bh__mail {
    font-family: var(--font-mono); font-size: 0.875rem; color: #fff;
    border-bottom: 1px solid rgb(255 255 255 / 0.45); padding-bottom: 2px;
    overflow-wrap: anywhere;
    transition: border-color var(--t2) var(--ease);
  }
  .bh__mail:hover { border-color: var(--clay-bright); }

  /* The figures sit on a band at the base of the photograph. */
  .bh__figs {
    position: relative;
    z-index: 1;
    background: rgb(8 10 12 / 0.55);
    backdrop-filter: blur(10px);
    border-top: 1px solid rgb(255 255 255 / 0.14);
  }
  .bh__figsin {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--s5) var(--s4);
    padding-block: clamp(1.25rem, 3vw, 2rem);
  }
  .bh__figs dt {
    font-size: clamp(1.5rem, 2.6vw, 2.1rem);
    font-weight: 700; letter-spacing: -0.04em; line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .bh__figs dd {
    margin-top: 0.3rem; font-size: 0.8125rem; color: rgb(255 255 255 / 0.7);
  }

  /* ───── 02 cards ───── */
  .sv { background: var(--white); }
  .sv__head { text-align: center; display: grid; justify-items: center; }
  .sv__h {
    margin-top: var(--s4);
    font-size: clamp(1.7rem, 3.2vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.08;
  }
  .sv__h em { font-style: normal; color: var(--clay-deep); }

  .sv__grid {
    display: grid;
    gap: clamp(0.9rem, 2vw, 1.4rem);
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  .card {
    position: relative;
    display: grid;
    align-content: start;
    height: 100%;
    padding: clamp(1.4rem, 2.6vw, 1.9rem);
    border-radius: 22px;
    background: var(--white);
    overflow: hidden;
    box-shadow: 0 1px 2px rgb(30 20 10 / 0.05), 0 14px 32px -20px rgb(30 20 10 / 0.28);
    transition: transform var(--t3) var(--ease), box-shadow var(--t3) var(--ease);
  }
  .card:hover {
    transform: translateY(-6px);
    box-shadow: 0 1px 2px rgb(30 20 10 / 0.05), 0 30px 52px -24px rgb(30 20 10 / 0.34);
  }
  /* A clay rule wipes across the base on hover — the accent as a mark. */
  .card::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 3px;
    background: linear-gradient(90deg, var(--clay-deep), var(--clay));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--t3) var(--ease);
  }
  .card:hover::after { transform: scaleX(1); }
  .card[data-tone='green']::after {
    background: linear-gradient(90deg, var(--green-deep), var(--green-bright));
  }

  .card__i {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 15px;
    color: var(--clay-deep);
    background: linear-gradient(140deg, color-mix(in oklab, var(--clay) 18%, #fff), var(--clay-wash));
    transition: transform var(--t3) var(--ease);
  }
  .card:hover .card__i { transform: scale(1.08) rotate(-6deg); }

  .card h3 {
    margin-top: 0.9rem;
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: -0.025em;
  }
  .card > p {
    margin-top: 0.45rem;
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--text-2);
  }

  .card__pts {
    display: grid;
    gap: 0.35rem;
    margin-top: 0.9rem;
    padding-top: 0.8rem;
    border-top: 1px solid var(--line-light);
  }
  .card__pts li {
    display: flex;
    align-items: flex-start;
    gap: 0.45rem;
    font-size: 0.75rem;
    line-height: 1.45;
    color: var(--text-3);
  }
  .card__pts :global(svg) { flex: none; margin-top: 2px; color: var(--clay-deep); }

  /* ---- tones ---- */

  .card[data-tone='ink'] {
    background: linear-gradient(150deg, #14171a, #0b1a12 58%, #101d14);
    color: #fff;
  }
  .card[data-tone='green'] {
    background: linear-gradient(150deg, #123a1c, #1e4a26 56%, #0f2d18);
    color: #fff;
  }
  .card[data-tone='ink'] .card__i,
  .card[data-tone='green'] .card__i {
    background: rgb(255 255 255 / 0.1);
    color: var(--clay-bright);
  }
  .card[data-tone='green'] .card__i { color: var(--green-bright); }
  .card[data-tone='ink'] > p,
  .card[data-tone='green'] > p { color: rgb(255 255 255 / 0.78); }
  .card[data-tone='ink'] .card__pts,
