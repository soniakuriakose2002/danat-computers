---
import { Image } from 'astro:assets';
import PageLayout from '@layouts/PageLayout.astro';
import Icon from '@components/ui/Icon.astro';
import Logo from '@components/global/Logo.astro';
import VideoModal from '@components/global/VideoModal.astro';
import { site, whatsappLink, brands } from '@data/site';
import imgOffice from '@assets/photos/support-desk.jpg';
import imgRack from '@assets/photos/network-eng.jpg';
import imgPrinter from '@assets/photos/printer-machine.jpg';
import imgCctv from '@assets/photos/cctv-white.jpg';
import imgPatch from '@assets/photos/network-patch.jpg';

/**
 * BUSINESS SOLUTIONS — built to the client's mockup.
 *
 * Every figure traces to a record: years from the earliest ERP entry,
 * products and categories from the catalogue export, branches from the
 * journal codes.
 *
 * ⚠ The mockup carries a testimonial — "Danat Computers has been our
 * trusted technology partner for years", attributed to "Business
 * Customer, Muscat". It is invented. A fabricated review is not
 * something to publish, so that section is a held slot.
 *
 * Worth knowing when Danat fills it: the Aged Partner Balance export
 * lists 20 healthcare accounts (Al Raffah Hospital, Gulf Specialized
 * Hospital and Adrak Multi Speciality among them), 16 schools and
 * colleges, and 202 trade accounts. Real references exist; they only
 * need permission to be named.
 */
const years = new Date().getFullYear() - site.stats.since;
const brandCount = brands.flat().length;

const trust = [
  { icon: 'shield', a: 'Trusted in Oman', b: `Since ${site.stats.since}` },
  { icon: 'users', a: 'Business-focused', b: 'Trade accounts welcome' },
  { icon: 'pin', a: 'Multiple branches', b: 'Across Oman' },
];

/** The ecosystem ring, clockwise from the top. */
const ring = [
  { icon: 'laptop', t: 'Computer support', p: 'Sales, repair and technical support' },
  { icon: 'printer', t: 'Printer services', p: 'Servicing and repair for all brands' },
  { icon: 'camera', t: 'CCTV solutions', p: 'Installation and maintenance' },
  { icon: 'drive', t: 'Data recovery', p: 'Recover lost or inaccessible data' },
  { icon: 'gear', t: 'Software support', p: 'Troubleshoot software and keep working' },
  { icon: 'chip', t: 'Hardware support', p: 'Diagnose and fix hardware problems' },
  { icon: 'network', t: 'Networking', p: 'Setup and troubleshooting for connectivity' },
];

/** Only what the rest of the site already states as policy. */
const steps = [
  { n: '01', icon: 'search', t: 'Understand', p: 'We listen to your requirements and business needs.' },
  { n: '02', icon: 'chat', t: 'Diagnose', p: 'We identify the right solution for your issue or upgrade.' },
  { n: '03', icon: 'gear', t: 'Solve', p: 'Diagnosis is free, and nothing is touched until you agree the quote.' },
  { n: '04', icon: 'check', t: 'Support', p: 'The same counter afterwards, at any of the four branches.' },
];

const cards = [
  { img: imgOffice, t: 'Computer sales & support', p: 'Desktops, laptops and technical support for your office.' },
  { img: imgPrinter, t: 'Printer services', p: 'Servicing and repair for Canon, Epson, HP and Brother.' },
  { img: imgCctv, t: 'CCTV solutions', p: 'Hikvision, Dahua and Uniview — supplied and installed.' },
  { img: imgPatch, t: 'Networking solutions', p: 'Cabling, switching and Wi-Fi, set up or troubleshot.' },
];

const figures = [
  { v: years, suffix: '+', l: 'Years of experience' },
  { v: site.stats.parts, suffix: '+', l: 'Products on our shelves' },
  { v: site.stats.categories, suffix: '', l: 'Product categories' },
  { v: site.stats.branches, suffix: '', l: 'Branches across Oman' },
];
---

<PageLayout
  title="Business Solutions"
  description={`Danat Computers supports business across Oman — IT support, hardware, networking, printers and CCTV from ${site.stats.parts.toLocaleString('en-US')} lines held across four branches since ${site.stats.since}.`}
>
  {/* ══════ 01 · hero ══════ */}
  <section class="hero">
    <div class="shell hero__grid">
      <div class="hero__copy">
        <p class="eb" data-rise>Business solutions</p>

        <h1 class="hero__h" data-rise style="--d:70ms">
          Technology That<br />Keeps Your Business<br /><em>Running.</em>
        </h1>

        <p class="hero__p" data-rise style="--d:130ms">
          Reliable IT support, hardware, networking, printers, CCTV and more —
          helping businesses across Oman work smarter, stay secure and move
          forward.
        </p>

        <div class="hero__acts" data-rise style="--d:190ms">
          <a class="btn" href="#quote">
            Talk to our experts
            <span class="btn__i" aria-hidden="true"><Icon name="arrow" size={15} /></span>
          </a>
          <button class="film" type="button" data-video-open>
            <i aria-hidden="true"><Icon name="play" size={12} /></i>
            <span>Watch video<small>See how we help businesses</small></span>
          </button>
        </div>

        <ul class="hero__trust" data-rise style="--d:250ms">
          {trust.map((t) => (
            <li>
              <i aria-hidden="true"><Icon name={t.icon} size={18} /></i>
              <span><b>{t.a}</b>{t.b}</span>
            </li>
          ))}
        </ul>
      </div>

      <figure class="hero__fig" data-rise style="--d:160ms">
        <Image src={imgOffice} alt="An office team working at their desks"
          widths={[640, 1000, 1500]} sizes="(min-width:62rem) 52vw, 100vw"
          quality={76} format="webp" loading="eager" fetchpriority="high" />
        <figcaption>
          <span class="hero__script">Same People.<br />A Brighter<br />Tomorrow.</span>
          <span class="hero__logo"><Logo /></span>
        </figcaption>
      </figure>
    </div>
  </section>

  {/* ══════ 02 · ecosystem ══════ */}
  <section class="eco section">
    <span class="eco__wash" aria-hidden="true"></span>

    <div class="shell eco__head">
      <div>
        <p class="eb" data-rise>A complete ecosystem</p>
        <h2 class="eco__h" data-rise style="--d:70ms">
          Business Solutions<br />for a Connected <em>Tomorrow.</em>
        </h2>
        <p class="eco__p" data-rise style="--d:130ms">
          From computers and printers to CCTV, networking and data recovery,
          Danat provides end-to-end technology support for businesses of all
          sizes.
        </p>
      </div>
      <p class="eco__aside" data-rise style="--d:190ms">
        Different businesses. Different needs.<br />
        One trusted partner — {site.nameFull}.
      </p>
    </div>

    <div class="shell eco__stage">
      <p class="eco__note eco__note--l" aria-hidden="true">People<br />Technology<br />Progress<br />Together</p>

      <div class="ring" data-rise style="--d:120ms">
        <svg class="ring__guide" viewBox="0 0 100 100" fill="none" aria-hidden="true">
          {/* A spoke per node, drawn out from the hub on reveal. */}
          {ring.map((_, i) => {
            const a = ((i * 360) / ring.length - 90) * (Math.PI / 180);
            return (
              <line class="ring__spoke" style={`--i:${i}`}
                x1={50 + Math.cos(a) * 17} y1={50 + Math.sin(a) * 17}
                x2={50 + Math.cos(a) * 38} y2={50 + Math.sin(a) * 38}
                stroke="currentColor" stroke-width="0.4" pathLength="1" />
            );
          })}
          <circle class="ring__orbit" cx="50" cy="50" r="38"
            stroke="currentColor" stroke-width="0.35" stroke-dasharray="1.2 2.4" />
        </svg>

        {/* A signal running the orbit — the ring is a network, so
            something should be moving on it. */}
        <div class="ring__run" aria-hidden="true"><span></span></div>

        <div class="ring__hub">
          <span class="ring__pulse" aria-hidden="true"></span>
          <Logo />
          <span>Business<br />technology<br />solutions</span>
        </div>

        {ring.map((r, i) => (
          <div class="ring__slot" style={`--th:${(i * 360) / ring.length}deg; --i:${i}`}>
            <div class="node">
              <i aria-hidden="true"><Icon name={r.icon} size={20} /></i>
              <b>{r.t}</b>
              <em>{r.p}</em>
            </div>
          </div>
        ))}
      </div>

      <p class="eco__note eco__note--r" aria-hidden="true">Keeping<br />Oman's Businesses<br />Connected</p>
    </div>
  </section>

  {/* ══════ 03 · process ══════ */}
  <section class="pr section">
    <div class="shell pr__head">
      <div>
        <p class="eb" data-rise>How we support your business</p>
        <h2 class="pr__h" data-rise style="--d:70ms">
          A Simple Process. <em>Real Results.</em>
        </h2>
      </div>
      <p class="pr__aside" data-rise style="--d:130ms">
        We make technology support easy, so you can focus on what matters —
        your business.
      </p>
    </div>

    <ol class="shell pr__steps">
      {steps.map((s, i) => (
        <li data-rise style={`--d:${i * 80}ms`}>
          <span class="pr__marks" aria-hidden="true">
            <b>{s.n}</b>
            <i><Icon name={s.icon} size={18} /></i>
          </span>
          <h3>{s.t}</h3>
          <p>{s.p}</p>
        </li>
      ))}
    </ol>
  </section>

  {/* ══════ 04 · service cards ══════ */}
  <section class="sv section">
    <div class="shell sv__head">
      <div>
        <p class="eb" data-rise>Our business services</p>
        <h2 class="sv__h" data-rise style="--d:70ms">
          Practical Solutions<br />for Everyday <em>Business Needs.</em>
        </h2>
      </div>
      <p class="sv__aside" data-rise style="--d:130ms">
        Proven technology services that help businesses stay secure,
        productive and worry-free.
      </p>
    </div>

    <div class="sv__rail">
      <ul class="shell-wide sv__track">
        {cards.map((c, i) => (
          <li data-rise style={`--d:${i * 60}ms`}>
            <a href="/services">
              <span class="sc__shot">
                <Image src={c.img} alt="" widths={[360, 560]} sizes="280px"
                  quality={74} format="webp" loading="lazy" />
              </span>
              <span class="sc__body">
                <b>{c.t}</b>
                <em>{c.p}</em>
                <i class="sc__go" aria-hidden="true"><Icon name="arrow" size={15} /></i>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* ══════ 05 · stat band ══════ */}
  <section class="st" data-tone="ink">
    <div class="st__bg" aria-hidden="true">
      <Image src={imgRack} alt="" widths={[1000, 1600]} sizes="100vw"
        quality={66} format="webp" loading="lazy" />
      <span class="st__tint"></span>
    </div>

    <div class="shell st__in">
      <div>
        <p class="st__k">Over two decades of trust</p>
        <h2 class="st__h">Supporting Businesses<br />Across Oman Since {site.stats.since}.</h2>
      </div>

      <dl class="st__figs">
        {figures.map((f) => (
          <div>
            <dt><span data-count={f.v}>0</span>{f.suffix}</dt>
            <dd>{f.l}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  {/* ══════ 06 · what customers say ══════ */}
  <section class="tm section">
    <div class="shell tm__grid">
      <div class="tm__copy" data-rise>
        <span class="tm__q" aria-hidden="true">&ldquo;</span>
        {/* The mockup's quote is invented. A fabricated review is not
            something to publish, so the frame is held until Danat
            supplies a real one — the ledger has no shortage of
            candidates. */}
        <p class="tm__slot">
          Customer quote to follow.
          <small>
            Danat has published no testimonial. Once a customer agrees to be
            quoted and named, it drops straight in here.
          </small>
        </p>
      </div>

      <figure class="tm__fig" data-rise style="--d:90ms">
        <Image src={imgRack} alt="" widths={[520, 820]} sizes="(min-width:62rem) 44vw, 92vw"
          quality={74} format="webp" loading="lazy" />
        <figcaption>Technology<br />People<br />Progress<br />Together</figcaption>
      </figure>
    </div>
  </section>

  {/* ══════ 07 · cta ══════ */}
  <section class="ct" id="quote">
    <div class="shell ct__in">
      <div>
        <h2 class="ct__h" data-rise>Let's Keep Your Business <em>Connected.</em></h2>
        <p class="ct__p" data-rise style="--d:70ms">
          Talk to our team and find the right technology solutions for your
          business.
        </p>
      </div>

      <div class="ct__acts" data-rise style="--d:130ms">
        <a class="btn" href={whatsappLink('Hello Danat — I would like to talk about business solutions for')}
          target="_blank" rel="noopener noreferrer">
          Get a free consultation
          <span class="btn__i" aria-hidden="true"><Icon name="arrow" size={15} /></span>
        </a>
        <a class="ct__ghost" href={whatsappLink('Hello Danat — I would like a trade quote for')}
          target="_blank" rel="noopener noreferrer">
          <Icon name="mail" size={16} />Request a quote
        </a>
      </div>
    </div>
  </section>

  <VideoModal />
</PageLayout>

<style>
  /* ───── shared ───── */
  .eb {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--green-deep);
  }

  .btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.55rem 0.55rem 0.55rem 1.5rem;
    border: 0;
    border-radius: 999px;
    /* white is 8.73:1 on #27551f and 4.90:1 on #3d7f35 — AA across the ramp */
    background: linear-gradient(100deg, #27551f, #3d7f35);
    color: #fff;
    font-size: 0.9375rem;
    font-weight: 600;
    transition: transform var(--t2) var(--ease);
  }
  .btn:hover { transform: translateY(-2px); }
  .btn__i {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    flex: none;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.2);
    transition: transform var(--t2) var(--ease);
  }
  .btn:hover .btn__i { transform: translateX(3px); }

  .hero__script,
  .eco__note,
  .tm__fig figcaption {
    font-family: var(--font-serif, Georgia, serif);
    font-style: italic;
    line-height: 1.3;
    pointer-events: none;
  }

  /* ───── 01 hero ───── */
  .hero {
    background: linear-gradient(170deg, #f6fbf6, #eef6ee 62%, #f7fbf7);
    padding-block: clamp(6rem, 10vw, 8rem) clamp(2.5rem, 5vw, 4rem);
    overflow: hidden;
  }
  .hero__grid { display: grid; gap: clamp(2rem, 4vw, 3rem); align-items: center; }
  .hero__copy { display: grid; justify-items: start; }

  .hero__h {
    margin-top: var(--s4);
    font-size: clamp(2rem, 4.4vw, 3.2rem);
    line-height: 1.08;
    letter-spacing: -0.042em;
    font-weight: 700;
  }
  .hero__h em { font-style: normal; color: var(--green-deep); }
  .hero__p {
    margin-top: var(--s4);
    max-width: 42ch;
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--text-2);
  }
  .hero__acts {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s4) var(--s5);
    margin-top: var(--s5);
  }

  .film {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    text-align: left;
  }
  .film i {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    flex: none;
    border-radius: 50%;
    background: var(--green-deep);
    color: #fff;
    transition: transform var(--t2) var(--ease);
  }
  .film:hover i { transform: scale(1.08); }
  .film:focus-visible i { outline: 2px solid var(--green-deep); outline-offset: 3px; }
  .film > span { display: grid; font-size: 0.875rem; font-weight: 600; }
  .film small {
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    font-weight: 400;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  .hero__trust {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s4) var(--s5);
    margin-top: var(--s5);
    padding-top: var(--s5);
    border-top: 1px solid var(--line-light);
  }
  .hero__trust li { display: flex; align-items: center; gap: 0.6rem; }
  .hero__trust i {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    flex: none;
    border-radius: 10px;
    color: var(--green-deep);
    background: var(--green-wash);
  }
  .hero__trust span { display: grid; font-size: 0.75rem; color: var(--text-3); }
  .hero__trust b { font-size: 0.8125rem; color: var(--text); }

  .hero__fig { position: relative; }
  .hero__fig :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 11;
    object-fit: cover;
    /* The curved inner edge from the mockup. */
    border-radius: 44% 18px 18px 44% / 30% 18px 18px 30%;
  }
  .hero__fig figcaption {
    position: absolute;
    top: 1rem;
    right: 1rem;
    display: grid;
    justify-items: end;
    gap: 0.5rem;
    text-align: right;
  }
  .hero__script { font-size: clamp(0.85rem, 1.4vw, 1.1rem); color: var(--green-deep); }
  .hero__logo { display: block; width: clamp(4.5rem, 8vw, 6.5rem); }
  .hero__logo :global(img) {
    width: 100%;
    height: auto;
    border-radius: 0;
    aspect-ratio: auto;
  }

  /* ───── 02 ecosystem ───── */
  .eco {
    position: relative;
    background: linear-gradient(180deg, #fafdfa, #f1f8f1 60%, #f8fbf8);
    overflow: hidden;
    isolation: isolate;
  }
  .eco__wash {
    position: absolute;
    z-index: -1;
    left: 50%;
    top: 58%;
    translate: -50% -50%;
    width: min(56rem, 96vw);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in oklab, var(--green) 12%, transparent), transparent 70%);
    filter: blur(30px);
  }

  .eco__head { display: grid; gap: var(--s5); align-items: end; }
  .eco__h {
    margin-top: var(--s4);
    font-size: clamp(1.7rem, 3.2vw, 2.4rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.12;
  }
  .eco__h em { font-style: normal; color: var(--green-deep); }
  .eco__p {
    margin-top: var(--s4);
    max-width: 46ch;
    font-size: 0.875rem;
    line-height: 1.62;
    color: var(--text-2);
  }
  .eco__aside { font-size: 0.8125rem; line-height: 1.7; color: var(--text-2); }

  .eco__stage {
    position: relative;
    display: grid;
    place-items: center;
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
  }
  .eco__note {
    display: none;
    position: absolute;
    top: 46%;
    font-size: clamp(0.85rem, 1.3vw, 1.05rem);
    color: var(--green-deep);
  }
  .eco__note { max-width: 9rem; }
  .eco__note--l { left: 0.5rem; rotate: -6deg; }
  .eco__note--r { right: 0.5rem; text-align: right; rotate: 5deg; }

  /* ---- the ring ---- */
  .ring {
    position: relative;
    width: min(46rem, 92vw);
    aspect-ratio: 1;
  }
  .ring__guide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    color: color-mix(in oklab, var(--green) 42%, transparent);
  }

  /* Spokes draw from the hub outward, one after another. */
  .ring__spoke {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 560ms var(--ease) calc(320ms + var(--i) * 90ms);
  }
  .ring[data-in] .ring__spoke { stroke-dashoffset: 0; }

  /* The dashed orbit turns slowly, so the ring is never quite still. */
  .ring__orbit { transform-origin: 50% 50%; }
  @media (prefers-reduced-motion: no-preference) {
    .ring__orbit { animation: ring-turn 90s linear infinite; }
  }
  @keyframes ring-turn { to { transform: rotate(360deg); } }

  /* A lit dot running the orbit. Same trick as the nodes: a full-size
     box rotating about the centre with the dot pinned to its top edge,
     so the radius is the ring's. */
  .ring__run {
    position: absolute;
    inset: 12%;
    pointer-events: none;
  }
  .ring__run span {
    position: absolute;
    top: 0;
    left: 50%;
    translate: -50% -50%;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--green);
    box-shadow: 0 0 0 4px color-mix(in oklab, var(--green) 22%, transparent),
      0 0 14px 2px color-mix(in oklab, var(--green) 55%, transparent);
  }
  @media (prefers-reduced-motion: no-preference) {
    .ring__run { animation: ring-turn 14s linear infinite; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ring__run { display: none; }
  }

  .ring__hub {
    position: absolute;
    inset: 31%;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.5rem;
    padding: 1rem;
    border-radius: 50%;
    background: radial-gradient(circle at 36% 30%, #2f6b2a, #14311a 74%);
    color: #fff;
    text-align: center;
    box-shadow: 0 24px 50px -24px rgb(10 40 14 / 0.6);
  }
  .ring__hub :global(img) { position: relative; z-index: 1; width: clamp(3.5rem, 7vw, 5rem); height: auto; }

  /* The hub breathes — a slow ring of light leaving it. */
  .ring__pulse {
    position: absolute;
    inset: -6%;
    border-radius: 50%;
    border: 2px solid color-mix(in oklab, var(--green) 45%, transparent);
    pointer-events: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .ring__pulse { animation: hub-pulse 3.6s var(--ease) infinite; }
  }
  @keyframes hub-pulse {
    0% { transform: scale(0.92); opacity: 0.85; }
    70%, 100% { transform: scale(1.18); opacity: 0; }
  }
  .ring__hub span {
    font-family: var(--font-mono);
    font-size: 0.5rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    line-height: 1.7;
    color: var(--green-bright);
  }

  /* Full-size box rotated about the ring's centre, with the node pinned
     to the top edge — so the radius is the ring's and scales with it. A
     percentage translate on the node would resolve against the node. */
  .ring__slot {
    position: absolute;
    inset: 0;
    transform: rotate(var(--th));
    pointer-events: none;
  }
  .node {
    position: absolute;
    top: 0;
    left: 50%;
    translate: -50% -50%;
    display: grid;
    justify-items: center;
    gap: 0.3rem;
    width: clamp(8rem, 17vw, 10.5rem);
