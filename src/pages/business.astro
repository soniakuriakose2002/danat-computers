---
import { Image } from 'astro:assets';
import PageLayout from '@layouts/PageLayout.astro';
import Icon from '@components/ui/Icon.astro';
import Logo from '@components/global/Logo.astro';
import VideoModal from '@components/global/VideoModal.astro';
import { site, whatsappLink, brands } from '@data/site';
import imgOffice from '@assets/photos/support-desk.jpg';
import imgRack from '@assets/photos/network-eng.jpg';
import imgPrinter from '@assets/photos/printer-machine.jpg';
import imgCctv from '@assets/photos/cctv-white.jpg';
import imgPatch from '@assets/photos/network-patch.jpg';
import imgDrive from '@assets/photos/datarecovery-drive.jpg';
import imgAgent from '@assets/photos/support-agent.jpg';
/* NOT repair-board.jpg — its technician wears a uniform branded
   ТЕХНОБЫТСЕРВИС, a competing repair company, legible at display
   size. That file is deleted; this import does not build. */
import imgBoard from '@assets/photos/network-eng.jpg';

/**
 * BUSINESS SOLUTIONS — built to the client's mockup.
 *
 * Every figure traces to a record: years from the earliest ERP entry,
 * products and categories from the catalogue export, branches from the
 * journal codes.
 *
 * ⚠ The mockup carries a testimonial — "Danat Computers has been our
 * trusted technology partner for years", attributed to "Business
 * Customer, Muscat". It is invented. A fabricated review is not
 * something to publish, so that section is a held slot.
 *
 * Worth knowing when Danat fills it: the Aged Partner Balance export
 * lists 20 healthcare accounts (Al Raffah Hospital, Gulf Specialized
 * Hospital and Adrak Multi Speciality among them), 16 schools and
 * colleges, and 202 trade accounts. Real references exist; they only
 * need permission to be named.
 */
const years = new Date().getFullYear() - site.stats.since;
const brandCount = brands.flat().length;

const trust = [
  { icon: 'shield', a: 'Trusted in Oman', b: `Since ${site.stats.since}` },
  { icon: 'users', a: 'Business-focused', b: 'Trade accounts welcome' },
  { icon: 'pin', a: 'Multiple branches', b: 'Across Oman' },
];

/**
 * The seven services, in the order the client's mockup lists them.
 * Same seven the ecosystem ring carried — the wording is unchanged,
 * only the way they are presented.
 */
/**
 * Each card deep-links to its own service page. The four-card section
 * that used to sit below this one listed the same services with the
 * same photographs and sent all four to /services; it has been removed
 * rather than repeated.
 */
const deck = [
  { icon: 'laptop', img: imgOffice, href: '/services/computer-repair', t: 'Computer support', p: 'Sales, repair and technical support for business.' },
  { icon: 'printer', img: imgPrinter, href: '/services/printer-services', t: 'Printer services', p: 'Servicing and repair for all brands.' },
  { icon: 'drive', img: imgDrive, href: '/services/data-recovery', t: 'Data recovery', p: 'Recover lost or inaccessible data.' },
  { icon: 'gear', img: imgAgent, href: '/services/software-troubleshooting', t: 'Software support', p: 'Troubleshoot software and keep you working.' },
  { icon: 'network', img: imgPatch, href: '/services/networking', t: 'Networking', p: 'Setup and troubleshooting for connectivity.' },
  { icon: 'camera', img: imgCctv, href: '/services/cctv-services', t: 'CCTV solutions', p: 'Installation and maintenance for safer premises.' },
  { icon: 'chip', img: imgBoard, href: '/services/hardware-troubleshooting', t: 'Hardware support', p: 'Diagnose and fix hardware problems.' },
];

/** Only what the rest of the site already states as policy. */
const steps = [
  { n: '01', icon: 'search', t: 'Understand', p: 'We listen to your requirements and business needs.' },
  { n: '02', icon: 'chat', t: 'Diagnose', p: 'We identify the right solution for your issue or upgrade.' },
  { n: '03', icon: 'gear', t: 'Solve', p: 'Diagnosis is free, and nothing is touched until you agree the quote.' },
  { n: '04', icon: 'check', t: 'Support', p: 'The same counter afterwards, at any of the three branches.' },
];

const figures = [
  { v: years, suffix: '+', l: 'Years of experience' },
  { v: site.stats.parts, suffix: '+', l: 'Products on our shelves' },
  { v: site.stats.categories, suffix: '', l: 'Product categories' },
  { v: site.stats.branches, suffix: '', l: 'Branches across Oman' },
];
---

<PageLayout
  title="Business Solutions"
  description={`Danat Computers supports business across Oman — IT support, hardware, networking, printers and CCTV from ${site.stats.parts.toLocaleString('en-US')} lines held across three branches since ${site.stats.since}.`}
>
  {/* ══════ 01 · hero ══════ */}
  <section class="hero">
    <div class="shell hero__grid">
      <div class="hero__copy">
        <p class="eb" data-rise>Business solutions</p>

        <h1 class="hero__h" data-rise style="--d:70ms">
          Technology That<br />Keeps Your Business<br /><em>Running.</em>
        </h1>

        <p class="hero__p" data-rise style="--d:130ms">
          Reliable IT support, hardware, networking, printers, CCTV and more —
          helping businesses across Oman work smarter, stay secure and move
          forward.
        </p>

        <div class="hero__acts" data-rise style="--d:190ms">
          <a class="btn" href="#quote" data-enquiry="consult">
            Talk to our experts
            <span class="btn__i" aria-hidden="true"><Icon name="arrow" size={15} /></span>
          </a>
          <button class="film" type="button" data-video-open>
            <i aria-hidden="true"><Icon name="play" size={12} /></i>
            <span>Watch video<small>See how we help businesses</small></span>
          </button>
        </div>

        <ul class="hero__trust" data-rise style="--d:250ms">
          {trust.map((t) => (
            <li>
              <i aria-hidden="true"><Icon name={t.icon} size={18} /></i>
              <span><b>{t.a}</b>{t.b}</span>
            </li>
          ))}
        </ul>
      </div>

      <figure class="hero__fig" data-rise style="--d:160ms">
        <Image src={imgOffice} alt="An office team working at their desks"
          widths={[640, 1000, 1500]} sizes="(min-width:62rem) 52vw, 100vw"
          quality={76} format="webp" loading="eager" fetchpriority="high" />
        <figcaption>
          <span class="hero__script">Same People.<br />A Brighter<br />Tomorrow.</span>
          <span class="hero__logo"><Logo /></span>
        </figcaption>
      </figure>
    </div>
  </section>

  {/* ══════ 02 · process ══════ */}
  <section class="pr section">
    <div class="shell pr__head">
      <div>
        <p class="eb" data-rise>How we support your business</p>
        <h2 class="pr__h" data-rise style="--d:70ms">
          A Simple Process. <em>Real Results.</em>
        </h2>
      </div>
      <p class="pr__aside" data-rise style="--d:130ms">
        We make technology support easy, so you can focus on what matters —
        your business.
      </p>
    </div>

    <ol class="shell pr__steps">
      {steps.map((s, i) => (
        <li data-rise style={`--d:${i * 80}ms`}>
          <span class="pr__marks" aria-hidden="true">
            <b>{s.n}</b>
            <i><Icon name={s.icon} size={18} /></i>
          </span>
          <h3>{s.t}</h3>
          <p>{s.p}</p>
        </li>
      ))}
    </ol>
  </section>

  {/* ══════ 03 · the stage ══════ */}
  <section class="bs">
    <span class="bs__sky" aria-hidden="true"></span>

    <div class="shell bs__grid">
      {/* ── left ── */}
      <div class="bs__copy">
        <p class="eb" data-rise>A complete ecosystem</p>

        <h2 class="bs__h" data-rise style="--d:70ms">
          Business Solutions<br />for a Connected <em>Tomorrow.</em>
        </h2>

        <p class="bs__p" data-rise style="--d:130ms">
          From computers and printers to CCTV, networking and data recovery,
          Danat provides end-to-end technology support for businesses of all
          sizes.
        </p>

        <p class="bs__aside" data-rise style="--d:190ms">
          Different businesses. Different needs.<br />
          One trusted partner &mdash; {site.nameFull}.
        </p>

        <p class="bs__script" aria-hidden="true">
          People<br />Technology<br />Progress<br />Together
          <svg viewBox="0 0 150 14" fill="none">
            <path d="M4 10C38 3 114 2 146 7" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
          </svg>
        </p>
      </div>

      {/* ── the fanned deck ── */}
      <div class="bs__stage" data-deck>
        <div class="bs__deck">
          {deck.map((d, i) => (
            <article class="bc" data-i={i}>
              <button class="bc__hit" type="button" data-goto={i}
                aria-label={`Show ${d.t}`}></button>

              <figure class="bc__shot">
                <span class="bc__badge" aria-hidden="true"><Icon name={d.icon} size={19} /></span>
                <Image src={d.img} alt="" widths={[380, 620]} sizes="320px"
                  quality={76} format="webp"
                  loading={i === 0 ? 'eager' : 'lazy'}
                  fetchpriority={i === 0 ? 'high' : undefined} />
                <figcaption>{String(i + 1).padStart(2, '0')}</figcaption>
              </figure>

              <div class="bc__body">
                <h2 class="bc__t">{d.t}</h2>
                <p class="bc__p">{d.p}</p>
                <a class="bc__go" href={d.href} tabindex={i === 0 ? undefined : '-1'}>
                  Learn more<Icon name="arrow" size={14} />
                </a>
              </div>
            </article>
          ))}
        </div>

        <div class="bs__dots" aria-hidden="true">
          {deck.map((_, i) => <i data-on={i === 0 ? '' : undefined}></i>)}
        </div>
      </div>

      {/* ── right rail ── */}
      <div class="bs__rail">
        <p class="bs__script bs__script--r" aria-hidden="true">
          Keeping<br />Oman's Businesses<br />Connected
          <svg viewBox="0 0 150 14" fill="none">
            <path d="M4 10C38 3 114 2 146 7" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
          </svg>
        </p>

        <ol class="bs__idx">
          {deck.map((d, i) => (
            <li>
              <button type="button" data-goto={i} data-on={i === 0 ? '' : undefined}>
                <b>{String(i + 1).padStart(2, '0')}</b>
                <i class="bs__dot" aria-hidden="true"></i>
                <span>{d.t}</span>
              </button>
            </li>
          ))}
        </ol>

        <p class="bs__scroll" aria-hidden="true">
          <span class="bs__mouse"></span>
          Scroll<br />to explore
        </p>
      </div>
    </div>

  </section>

  {/* ══════ 04 · stat band ══════ */}
  <section class="st" data-tone="ink">
    <div class="st__bg" aria-hidden="true">
      <Image src={imgRack} alt="" widths={[1000, 1600]} sizes="100vw"
        quality={66} format="webp" loading="lazy" />
      <span class="st__tint"></span>
    </div>

    <div class="shell st__in">
      <div>
        <p class="st__k">Over two decades of trust</p>
        <h2 class="st__h">Supporting Businesses<br />Across Oman Since {site.stats.since}.</h2>
      </div>

      <dl class="st__figs">
        {figures.map((f) => (
          <div>
            <dt><span data-count={f.v}>{Number(f.v).toLocaleString('en-US')}</span>{f.suffix}</dt>
            <dd>{f.l}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  {/* ══════ 05 · what customers say ══════ */}
  <section class="tm section">
    <div class="shell tm__grid">
      <div class="tm__copy" data-rise>
        <span class="tm__q" aria-hidden="true">&ldquo;</span>
        {/* The mockup's quote is invented. A fabricated review is not
            something to publish, so the frame is held until Danat
            supplies a real one — the ledger has no shortage of
            candidates. */}
        <p class="tm__slot">
          Customer quote to follow.
          <small>
            Danat has published no testimonial. Once a customer agrees to be
            quoted and named, it drops straight in here.
          </small>
        </p>
      </div>

      <figure class="tm__fig" data-rise style="--d:90ms">
        <Image src={imgRack} alt="" widths={[520, 820]} sizes="(min-width:62rem) 44vw, 92vw"
          quality={74} format="webp" loading="lazy" />
        <figcaption>Technology<br />People<br />Progress<br />Together</figcaption>
      </figure>
    </div>
  </section>

  {/* ══════ 06 · cta ══════ */}
  <section class="ct" id="quote">
    <div class="shell ct__in">
      <div>
        <h2 class="ct__h" data-rise>Let's Keep Your Business <em>Connected.</em></h2>
        <p class="ct__p" data-rise style="--d:70ms">
          Talk to our team and find the right technology solutions for your
          business.
        </p>
      </div>

      <div class="ct__acts" data-rise style="--d:130ms">
        <a class="btn" data-enquiry="consult"
          href={whatsappLink('Hello Danat — I would like to talk about business solutions for')}
          target="_blank" rel="noopener noreferrer">
          Get a free consultation
          <span class="btn__i" aria-hidden="true"><Icon name="arrow" size={15} /></span>
        </a>
        <a class="ct__ghost" data-enquiry="quote"
          href={whatsappLink('Hello Danat — I would like a trade quote for')}
          target="_blank" rel="noopener noreferrer">
          <Icon name="mail" size={16} />Request a quote
        </a>
      </div>
    </div>
  </section>

  <VideoModal />
</PageLayout>

<script is:inline>
  /* <ClientRouter /> swaps the body on a nav click without a page load,
     and an is:inline script runs once on the first load and never again
     — so everything below was binding to elements that had already been
     thrown away. astro:page-load fires on the first load and after every
     swap. */
  (() => {
    const setup = () => {
    (() => {
      const stage = document.querySelector('[data-deck]');
      if (!stage) return;

      const cards = [...stage.querySelectorAll('.bc')];
      const dots = [...stage.querySelectorAll('.bs__dots i')];
      const idx = [...document.querySelectorAll('.bs__idx [data-goto]')];
      const n = cards.length;
      if (!n) return;

      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let at = 0;
      let timer = null;

      const show = (next) => {
        at = ((next % n) + n) % n;
        cards.forEach((c, i) => {
          // Signed distance wrapped the short way round, so the deck turns
          // through the nearer edge instead of unwinding the whole fan.
          let o = i - at;
          if (o > n / 2) o -= n;
          if (o < -n / 2) o += n;
          const a = Math.abs(o);
          c.style.setProperty('--o', String(o));
          c.style.setProperty('--a', String(a));
          c.dataset.a = String(a);
          // Falling z-index is what makes each neighbour reveal a fixed
          // strip of itself rather than being buried by the one outside it.
          c.style.zIndex = String(n - a);
          c.toggleAttribute('data-on', o === 0);
          c.toggleAttribute('data-far', a >= 3);
          // A card on the left reveals its left edge; one on the right
          // reveals its right edge, because each is overlapped from the
          // side facing the centre. So the contents mirror, or half the
          // deck hides its own title behind the active card.
          c.dataset.side = o === 0 ? 'c' : o > 0 ? 'r' : 'l';
        });
        dots.forEach((d, i) => d.toggleAttribute('data-on', i === at));
        idx.forEach((b, i) => b.toggleAttribute('data-on', i === at));
        // Only the front card's link is in the tab order; the others are
        // reached by selecting the card first, same as with a pointer.
        cards.forEach((c, i) => {
          const go = c.querySelector('.bc__go');
          if (go) go.tabIndex = i === at ? 0 : -1;
        });
      };

      const stop = () => { if (timer) clearInterval(timer); timer = null; };
      const start = () => {
        if (!reduced && !timer) timer = setInterval(() => show(at + 1), 3000);
      };

      document.querySelectorAll('[data-goto]').forEach((b) => {
        b.addEventListener('click', () => { show(Number(b.dataset.goto)); stop(); start(); });
      });

      stage.addEventListener('pointerenter', stop);
      stage.addEventListener('pointerleave', start);
      stage.addEventListener('focusin', stop);
      stage.addEventListener('focusout', start);

      show(0);
      start();
    })();
    };

    let ran = false;
    document.addEventListener('astro:page-load', () => { ran = true; setup(); });
    window.addEventListener('load', () => { if (!ran) { ran = true; setup(); } });
  })();
</script>

<style>
  /* ───── shared ───── */
  .eb {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--green-deep);
  }

  .btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.55rem 0.55rem 0.55rem 1.5rem;
    border: 0;
    border-radius: 999px;
    /* white is 8.73:1 on #27551f and 4.90:1 on #3d7f35 — AA across the ramp */
    background: linear-gradient(100deg, #27551f, #3d7f35);
    color: #fff;
    font-size: 0.9375rem;
    font-weight: 600;
    transition: transform var(--t2) var(--ease);
  }
  .btn:hover { transform: translateY(-2px); }
  .btn__i {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    flex: none;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.2);
    transition: transform var(--t2) var(--ease);
  }
  .btn:hover .btn__i { transform: translateX(3px); }

  .bs__script,
  .hero__script,
  .tm__fig figcaption {
    font-family: var(--font-serif, Georgia, serif);
    font-style: italic;
    line-height: 1.3;
    pointer-events: none;
  }

  /* ───── 01 hero ───── */
  .hero {
    background: linear-gradient(170deg, #f6fbf6, #eef6ee 62%, #f7fbf7);
    padding-block: clamp(6rem, 10vw, 8rem) clamp(2.5rem, 5vw, 4rem);
    overflow: hidden;
  }
  .hero__grid { display: grid; gap: clamp(2rem, 4vw, 3rem); align-items: center; }
  .hero__copy { display: grid; justify-items: start; }

  .hero__h {
    margin-top: var(--s4);
    font-size: var(--hero);
    line-height: var(--hero-lh);
    letter-spacing: var(--hero-tr);
    font-weight: 700;
  }
  .hero__h em { font-style: normal; color: var(--green-deep); }
  .hero__p {
    margin-top: var(--s4);
    max-width: 42ch;
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--text-2);
  }
  .hero__acts {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s4) var(--s5);
    margin-top: var(--s5);
  }

  .hero__trust {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s4) var(--s5);
    margin-top: var(--s5);
    padding-top: var(--s5);
    border-top: 1px solid var(--line-light);
  }
  .hero__trust li { display: flex; align-items: center; gap: 0.6rem; }
  .hero__trust i {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    flex: none;
    border-radius: 10px;
    color: var(--green-deep);
    background: var(--green-wash);
  }
  .hero__trust span { display: grid; font-size: 0.75rem; color: var(--text-3); }
  .hero__trust b { font-size: 0.8125rem; color: var(--text); }

  .hero__fig { position: relative; }
  .hero__fig :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 11;
    object-fit: cover;
    /* The curved inner edge from the mockup. */
    border-radius: 44% 18px 18px 44% / 30% 18px 18px 30%;
  }
  .hero__fig figcaption {
    position: absolute;
    top: 1rem;
    right: 1rem;
    display: grid;
    justify-items: end;
    gap: 0.5rem;
    text-align: right;
  }
  .hero__script { font-size: var(--body); color: var(--green-deep); }
  .hero__logo { display: block; width: clamp(4.5rem, 8vw, 6.5rem); }
  .hero__logo :global(img) {
    width: 100%;
    height: auto;
    border-radius: 0;
    aspect-ratio: auto;
  }

  /* ═════ 03 · the stage ═════
     A fanned deck on a real perspective. Card centres are spaced about
     10.5rem apart while each card is 19rem wide, and z-index falls away
     from the active one — so every neighbour reveals a fixed strip of
     its own left edge rather than being half-buried. That is what keeps
     the titles readable instead of sliced.

     Offsets come from --o (signed, for direction) and --a (absolute,
     for depth and scale). Both are set in script: CSS has no portable
     abs() yet, and deriving one from the other in calc is not worth the
     trouble when the script already knows both. */
  .bs {
    position: relative;
    padding-block: clamp(3.5rem, 7vw, 6rem);
    overflow: hidden;
    isolation: isolate;
  }
  .bs__sky {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(1100px 620px at 62% 8%, #ffffff 0%, rgb(255 255 255 / 0) 62%),
      linear-gradient(168deg, #eef5ef 0%, #f4f9f4 42%, #fbfdfb 100%);
  }

  .bs__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(1.75rem, 3.5vw, 3rem);
    align-items: center;
  }
  .bs__copy, .bs__stage, .bs__rail { min-width: 0; }

  /* ── left ── */
  .bs__h {
    margin-top: var(--s4);
    font-size: var(--d4);
    font-weight: 700;
    letter-spacing: var(--tr4);
    line-height: 1.04;
  }
  .bs__h em { font-style: normal; color: var(--green-deep); }
  .bs__p {
    max-width: 38ch;
    margin-top: var(--s4);
    font-size: 0.9375rem;
    line-height: 1.66;
    color: var(--text-2);
  }
  .film {
    display: inline-flex;
    align-items: center;
    min-width: 0;
    gap: 0.7rem;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    text-align: left;
  }
  .film i {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    flex: none;
    border-radius: 50%;
    background: var(--green-deep);
    color: #fff;
    transition: transform var(--t2) var(--ease);
  }
  .film:hover i { transform: scale(1.08); }
  .film:focus-visible i { outline: 2px solid var(--green-deep); outline-offset: 3px; }
  .film > span { display: grid; min-width: 0; font-size: 0.875rem; font-weight: 600; }
  .film small {
    overflow-wrap: anywhere;
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    font-weight: 400;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  .bs__aside {
    max-width: 34ch;
    margin-top: var(--s5);
    padding-top: var(--s5);
    border-top: 1px solid var(--line-light);
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--text-3);
  }

  .bs__script {
    margin-top: clamp(1.75rem, 4vw, 3rem);
    font-family: var(--font-serif);
    font-size: var(--d7);
    font-style: italic;
    line-height: 1.34;
    color: var(--green-deep);
  }
  .bs__script svg {
    display: block;
    width: clamp(5.5rem, 9vw, 7.5rem);
    margin-top: 0.3rem;
    color: var(--green);
  }
