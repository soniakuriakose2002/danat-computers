---
import PageLayout from '@layouts/PageLayout.astro';
/*
 * The homepage now follows the approved design concept (Scout-style).
 * Nothing was deleted: the previous sections are still in
 * src/components/sections/ and the old running order is kept, commented,
 * at the bottom of this file, so switching back is a copy-paste.
 */
import HeroLaptop from '@components/concept/HeroLaptop.astro';
import Statement from '@components/sections/Statement.astro';
import PhotoRing from '@components/concept/PhotoRing.astro';
import Chapters from '@components/concept/Chapters.astro';
import ServiceIndex from '@components/concept/ServiceIndex.astro';
import NumbersBrands from '@components/concept/NumbersBrands.astro';
import BranchesMap from '@components/concept/BranchesMap.astro';
---

<PageLayout>
  {/* 01 — Real laptop; the film fills the page */}<HeroLaptop />
  {/* 02 — What is Danat, in one line       */}<Statement />
  {/* 03 — Fixing Oman since 2003 (ring)     */}<PhotoRing />
  {/* 04 — From the bench (sliding cards)    */}<Chapters />
  {/* 05 — What do you need help with?       */}<ServiceIndex />
  {/* 06 — Numbers and brands                */}<NumbersBrands />
  {/* 07 — Three branches                    */}<BranchesMap />
  {/* The footer carries "Something broken? Bring it in." */}

  {/* ⚠ LaptopSequence — the photographic teardown scrubbed on scroll,
      built from the client's own reference sheet — is NOT mounted by
      this concept running order. The file is intact at
      components/sections/LaptopSequence.astro and drops back in with
      one line if the teardown is wanted alongside the new hero. */}
</PageLayout>

{/*
  Previous running order, for reference:
  <Teardown />  <Statement />  <BrandStrip />  <ServiceLayers3D show="laptop" />
  <ServiceCoverflow />  <InsideDanat />  <MidCta />  <AcrossOman />
  <ServiceLayers3D show="it" />  <BusinessSolutions />
*/}
