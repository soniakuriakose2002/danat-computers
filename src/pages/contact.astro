---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import PageLayout from '@layouts/PageLayout.astro';
import Icon from '@components/ui/Icon.astro';
import { site, whatsappLink, branches } from '@data/site';
import { OMAN_PATH, OMAN_VIEWBOX, OMAN_PINS } from '@data/omanMap';
import imgHero from '@assets/photos/support-agent.jpg';

/**
 * Built on the pattern every good contact page uses: a photograph that
 * says who picks up, the channels laid out as large rows rather than a
 * paragraph, and the form last — because most people will phone or
 * message instead of typing.
 *
 * The site is a static build with no server, so the form composes the
 * enquiry into a WhatsApp message rather than pretending to POST.
 */

const services = (await getCollection('services')).sort(
  (a, b) => a.data.index - b.data.index
);

const order = ['sohar', 'hail', 'ruwi', 'salalah'];
const list = order.map((s) => branches.find((b) => b.slug === s)!);
const ruwi = branches.find((b) => b.slug === 'ruwi')!;
const unconfirmed = list.filter((b) => !b.verified).length;

const rows = [
  {
    icon: 'phone',
    label: 'Call the counter',
    value: site.phone.display,
    href: `tel:${site.phone.tel}`,
    note: 'Ruwi. They will route you to the right branch.',
    external: false,
  },
  {
    icon: 'whatsapp',
    label: 'WhatsApp',
    value: site.phone.display,
    href: whatsappLink(),
    note: 'Fastest. Send a photo of the fault.',
    external: true,
  },
  {
    icon: 'mail',
    label: 'Email',
    value: site.email,
    href: `mailto:${site.email}`,
    note: 'Quotes, purchase orders and trade accounts.',
    external: false,
  },
] as const;

const W = 1000;
const H = 1342;
---

<PageLayout
  title="Contact"
  description={`Talk to Danat Computers — WhatsApp or call ${site.phone.display}, email ${site.email}, or walk into one of four branches across Oman.`}
>
  {/* ─────────────────────── 01 · hero ─────────────────────── */}
  <section class="hero">
    <div class="hero__bg" aria-hidden="true">
      <Image
        src={imgHero}
        alt=""
        widths={[900, 1400, 2000]}
        sizes="100vw"
        quality={74}
        format="webp"
        loading="eager"
        fetchpriority="high"
      />
      {/* Measured against the real crop: the windows blow out to 252/255,
          so white text needs this much scrim. Worst case is 5.15:1. */}
      <span class="hero__scrim"></span>
    </div>

    <div class="shell hero__in">
      <nav class="hero__crumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">Contact</span>
      </nav>

      <p class="hero__eb">
        <i class="hero__dot" aria-hidden="true"></i>
        We pick up
      </p>

      <h1 class="hero__h">Contact us</h1>

      <p class="hero__p">
        Diagnosis is free and we quote before we touch anything. Message us a
        photo of the fault and we usually know what we are looking at before
        you arrive.
      </p>

      <div class="hero__acts">
        <a class="btn-green" href="#enquiry">
          Send an enquiry
          <span class="btn-green__i" aria-hidden="true">
            <Icon name="arrow" size={15} />
          </span>
        </a>
        <a class="hero__call" href={`tel:${site.phone.tel}`}>
          {site.phone.display}
        </a>
      </div>
    </div>
  </section>

  {/* ─────────────────────── 02 · map + channels ─────────────────────── */}
  <section class="reach section" data-tone="light">
    <div class="shell reach__grid">
      {/* Left: where we are. A real Google embed needs map links the
          company has not supplied yet, so this is our own geography. */}
      <div class="mapcard">
        <div class="mapcard__top">
          <p class="eyebrow">
            <i class="eyebrow__rule" aria-hidden="true"></i>
            Where we are
          </p>
          <p class="mapcard__n"><b>4</b> branches across Oman</p>
        </div>

        <div class="mapcard__fig" data-rise>
          <svg viewBox={OMAN_VIEWBOX} width="272" height="365" role="img"
            aria-label="Map of Oman showing Danat branches in Sohar, Al Hail, Ruwi and Salalah">
            <defs>
              <linearGradient id="cFill" x1="0" y1="0" x2="0.4" y2="1">
                <stop class="cs0" offset="0%" stop-color="#59aa54" stop-opacity="0.10" />
                <stop class="cs1" offset="100%" stop-color="#59aa54" stop-opacity="0.26" />
              </linearGradient>
            </defs>
            <path class="cland" d={OMAN_PATH} fill="url(#cFill)" />
            <path class="cedge" d={OMAN_PATH} pathLength="1" fill="none"
              stroke="#a6d4a2" stroke-width="3" />
            {list.map((b, i) => (
              <g class="cpin" style={`--i:${i}`}
                transform={`translate(${OMAN_PINS[b.slug].x} ${OMAN_PINS[b.slug].y})`}>
                <circle class="chalo" r="44" fill="#59aa54" opacity="0"></circle>
                <circle class="cring" r="19" fill="#ffffff"></circle>
                <circle class="cdot" r="11" fill="#2f6429"></circle>
              </g>
            ))}
          </svg>

          {list.map((b, i) => (
            <a class="cchip" href={`/branches#${b.slug}`}
              data-side={b.slug === 'sohar' ? 'left' : 'right'}
              style={`--i:${i}; --x:${((OMAN_PINS[b.slug].x / W) * 100).toFixed(2)}%; --y:${((OMAN_PINS[b.slug].y / H) * 100).toFixed(2)}%; --dy:${b.slug === 'hail' ? '-3.4%' : b.slug === 'ruwi' ? '2.8%' : '0%'}`}>
              {b.city.split(',')[0]}
            </a>
          ))}
        </div>

        <a class="mapcard__all" href="/branches">
          Addresses and opening hours
          <Icon name="arrow" size={15} />
        </a>
      </div>

      {/* Right: the channels, as large rows. */}
      <div class="rail" data-tone="ink">
        <p class="rail__eb">Reach us</p>
        <h2 class="rail__h">However suits you.</h2>

        <ul class="rail__list">
          {rows.map((r, i) => (
            <li data-rise style={`--d:${i * 80}ms`}>
              <a
                class="row"
                href={r.href}
                target={r.external ? '_blank' : undefined}
                rel={r.external ? 'noopener noreferrer' : undefined}
              >
                <span class="row__i" aria-hidden="true">
                  <Icon name={r.icon} size={22} />
                </span>
                <span class="row__t">
                  <b>{r.label}</b>
                  <em>{r.value}</em>
                  <i>{r.note}</i>
                </span>
                <span class="row__go" aria-hidden="true">
                  <Icon name="arrow" size={15} />
                </span>
              </a>
            </li>
          ))}

          {/* The one address that is actually confirmed. */}
          <li data-rise style="--d:240ms">
            <div class="row row--static">
              <span class="row__i" aria-hidden="true">
                <Icon name="pin" size={22} />
              </span>
              <span class="row__t">
                <b>Walk in</b>
                <address>{ruwi.address.split('\n').map((l) => <>{l}<br /></>)}</address>
                {unconfirmed > 0 && (
                  <i>{unconfirmed} further branch addresses are being confirmed.</i>
                )}
              </span>
            </div>
          </li>
        </ul>
      </div>
    </div>
  </section>

  {/* ─────────────────────── 03 · form ─────────────────────── */}
  <section class="get section" data-tone="off">
    <div class="shell">
      <div class="get__head" data-rise>
        <p class="eyebrow eyebrow--mid eyebrow--clay">
          <i class="eyebrow__rule" aria-hidden="true"></i>
          Send an enquiry
          <i class="eyebrow__rule" aria-hidden="true"></i>
        </p>
        <h2 class="get__h">Get in <em>touch</em></h2>
        <p class="get__p">
          Fill this in and it opens WhatsApp with your message ready. Nothing
          is stored on this site and nothing sends until you press send.
        </p>
      </div>

      <form class="get__form" id="enquiry" data-rise style="--d:90ms">
        <div class="f__row">
          <div class="f">
            <label for="f-name">Your name</label>
            <input id="f-name" name="name" type="text" autocomplete="name"
              placeholder="So we know who we are talking to" required />
          </div>
          <div class="f">
            <label for="f-phone">Phone <span>optional</span></label>
            <input id="f-phone" name="phone" type="tel" autocomplete="tel"
              placeholder="If you would rather we called you" />
          </div>
        </div>

        <div class="f__row">
          <div class="f">
            <label for="f-branch">Nearest branch</label>
            <select id="f-branch" name="branch">
              {list.map((b) => <option value={b.name}>{b.city}</option>)}
              <option value="Not sure">Not sure</option>
            </select>
          </div>
          <div class="f">
            <label for="f-topic">What do you need?</label>
            <select id="f-topic" name="topic">
              {services.map((s) => <option value={s.data.title}>{s.data.title}</option>)}
              <option value="Something else">Something else</option>
            </select>
          </div>
        </div>

        <div class="f">
          <label for="f-msg">What is happening?</label>
          <textarea id="f-msg" name="message" rows="5" required
            placeholder="It will not power on. No lights, no fan. It was fine yesterday."></textarea>
        </div>

        <div class="get__acts">
          <button class="btn-green" type="submit">
            Open in WhatsApp
            <span class="btn-green__i" aria-hidden="true">
              <Icon name="whatsapp" size={15} />
            </span>
          </button>
          <button class="get__alt" type="button" id="by-email">
            Send by email instead
          </button>
        </div>

        <p class="get__note">
          Opens your own WhatsApp or mail app. Danat replies from
          {' '}{site.phone.display}.
        </p>

        <noscript>
          <p class="get__nojs">
            This form needs JavaScript to compose your message. You can reach
            us on <a href={whatsappLink()}>WhatsApp</a>, by phone on
            {' '}<a href={`tel:${site.phone.tel}`}>{site.phone.display}</a>, or
            by email at <a href={`mailto:${site.email}`}>{site.email}</a>.
          </p>
        </noscript>
      </form>
    </div>
  </section>

  {/* ─────────────────────── 04 · company ─────────────────────── */}
  <section class="cl" data-tone="ink">
    <div class="shell cl__in">
      <div>
        <p class="label" data-rise>Company</p>
        <p class="cl__name" data-rise style="--d:70ms">{site.legalName}</p>
        <p class="cl__sub" data-rise style="--d:120ms">
          Trading as {site.nameFull} since {site.stats.since}.
        </p>
      </div>
      <ul class="cl__soc" data-rise style="--d:170ms">
        <li>
          <a href={site.social.facebook} target="_blank" rel="noopener noreferrer">Facebook</a>
        </li>
        <li>
          <a href={site.social.instagram} target="_blank" rel="noopener noreferrer">Instagram</a>
        </li>
      </ul>
    </div>
  </section>
</PageLayout>

<script is:inline define:vars={{ WA: site.phone.whatsapp, MAIL: site.email }}>
  // Compose the enquiry and hand it to WhatsApp or mail. Nothing leaves
  // the page until the person sends it themselves.
  (() => {
    const form = document.getElementById('enquiry');
    if (!form) return;

    const compose = () => {
      const d = new FormData(form);
      const phone = String(d.get('phone') || '').trim();
      return [
        `Hello Danat — this is ${String(d.get('name') || '').trim()}.`,
        ``,
        `Branch: ${d.get('branch')}`,
        `Service: ${d.get('topic')}`,
        ...(phone ? [`Phone: ${phone}`] : []),
        ``,
        String(d.get('message') || '').trim(),
      ].join('\n');
    };

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;
      window.open(
        `https://wa.me/${WA}?text=${encodeURIComponent(compose())}`,
        '_blank',
        'noopener'
      );
    });

    document.getElementById('by-email')?.addEventListener('click', () => {
      if (!form.reportValidity()) return;
      const d = new FormData(form);
      window.location.href =
        `mailto:${MAIL}?subject=${encodeURIComponent(`${d.get('topic')} — ${d.get('branch')}`)}` +
        `&body=${encodeURIComponent(compose())}`;
    });
  })();
</script>

<style>
  /* ============================================================
     01 · HERO
     ============================================================ */

  .hero {
    position: relative;
    display: grid;
    align-items: end;
    min-height: clamp(30rem, 68vh, 44rem);
    padding-block: clamp(8rem, 14vw, 11rem) clamp(3rem, 7vw, 5.5rem);
    background: var(--ink);
    color: #fff;
    overflow: hidden;
    isolation: isolate;
  }

  .hero__bg { position: absolute; inset: 0; z-index: 0; }
  .hero__bg :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 62% 38%;
  }

  /* Heaviest on the left, under the type; the right keeps the photograph. */
  .hero__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(100deg,
        rgb(8 10 12 / 0.88) 0%,
        rgb(8 10 12 / 0.72) 38%,
        rgb(8 10 12 / 0.30) 72%,
        rgb(8 10 12 / 0.12) 100%),
      linear-gradient(to top, rgb(8 10 12 / 0.55), transparent 45%);
  }

  .hero__in { position: relative; z-index: 1; }

  .hero__crumb {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.8125rem;
    color: rgb(255 255 255 / 0.68);
  }
  .hero__crumb a { transition: color var(--t2) var(--ease); }
  .hero__crumb a:hover { color: #fff; }
  .hero__crumb [aria-current] { color: #fff; }

  .hero__eb {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: var(--s5);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--green-bright);
  }
  .hero__dot {
    width: 9px;
    height: 9px;
    flex: none;
    border-radius: 50%;
    background: var(--green-bright);
    box-shadow: 0 0 0 4px rgb(111 201 106 / 0.22);
  }

  .hero__h {
    margin-top: var(--s4);
    font-size: clamp(2.6rem, 8vw, 6rem);
    line-height: 0.96;
    letter-spacing: -0.045em;
    font-weight: 700;
  }

  .hero__p {
    margin-top: var(--s4);
    max-width: 46ch;
    font-size: var(--lead);
    line-height: 1.6;
    color: rgb(255 255 255 / 0.86);
  }

  .hero__acts {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s4) var(--s5);
    margin-top: var(--s5);
  }

  .hero__call {
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    letter-spacing: 0.04em;
    color: #fff;
    border-bottom: 1px solid rgb(255 255 255 / 0.45);
    padding-bottom: 2px;
    transition: border-color var(--t2) var(--ease);
  }
  .hero__call:hover { border-color: #fff; }

  /* ---------- shared green pill ---------- */

  .btn-green {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.55rem 0.55rem 0.55rem 1.6rem;
    border: 0;
    border-radius: 999px;
    /* Measured: white is 8.73:1 on #27551F and 4.90:1 on #3D7F35, so the
       label clears AA across the whole ramp. */
    background: linear-gradient(100deg, #27551f, #3d7f35);
    color: #fff;
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 600;
    cursor: pointer;
    overflow: hidden;
    box-shadow: 0 14px 28px -16px rgb(0 0 0 / 0.6);
    transition: transform var(--t2) var(--ease);
  }
  .btn-green:hover { transform: translateY(-2px); }
  .btn-green::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      100deg, transparent 35%, rgb(255 255 255 / 0.22) 50%, transparent 65%
    );
    transform: translate3d(-100%, 0, 0);
    transition: transform var(--t4) var(--ease);
  }
  .btn-green:hover::after { transform: translate3d(100%, 0, 0); }

  .btn-green__i {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    flex: none;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.2);
    transition: transform var(--t2) var(--ease);
  }
  .btn-green:hover .btn-green__i { transform: translateX(3px); }

  /* ---------- shared eyebrow ---------- */

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--green-deep);
  }
  .eyebrow__rule {
    width: 26px;
    height: 1px;
    flex: none;
    background: color-mix(in oklab, var(--green) 55%, transparent);
  }
  .eyebrow--mid { justify-content: center; }
  .eyebrow--clay { color: var(--clay-deep); }
  .eyebrow--clay .eyebrow__rule {
    background: color-mix(in oklab, var(--clay) 55%, transparent);
  }

  /* ============================================================
     02 · MAP + CHANNELS
     ============================================================ */

  .reach { background: var(--white); }

  .reach__grid { display: grid; gap: clamp(1rem, 2.2vw, 1.5rem); }

  /* ---------- map card ---------- */

  .mapcard {
    display: flex;
    flex-direction: column;
    padding: clamp(1.4rem, 3vw, 2rem);
    border: 1px solid var(--line-light);
    border-radius: 18px;
    background: var(--off);
  }

  .mapcard__top {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s4);
  }
  .mapcard__n { font-size: 0.875rem; color: var(--text-2); }
  .mapcard__n b {
    font-weight: 700;
    color: var(--text);
    font-variant-numeric: tabular-nums;
  }

  .mapcard__fig {
    position: relative;
    width: 100%;
    max-width: 17rem;
    margin: clamp(1.25rem, 3vw, 2rem) auto;
  }
  .mapcard__fig svg { display: block; width: 100%; height: auto; overflow: visible; }

  .cs0 { stop-color: var(--green); stop-opacity: 0.10; }
  .cs1 { stop-color: var(--green); stop-opacity: 0.26; }

  .cland {
    fill: url(#cFill);
    opacity: 0;
    transition: opacity 900ms var(--ease) 780ms;
  }
  .mapcard__fig[data-in] .cland { opacity: 1; }

  .cedge {
    fill: none;
    stroke: color-mix(in oklab, var(--green) 48%, #fff);
    stroke-width: 3;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 1400ms var(--ease) 100ms;
  }
  .mapcard__fig[data-in] .cedge { stroke-dashoffset: 0; }

  .cpin {
    --pd: calc(1420ms + var(--i) * 140ms);
    opacity: 0;
    scale: 0.2;
    transform-box: fill-box;
    transform-origin: center;
    transition:
      opacity 380ms var(--ease) var(--pd),
      scale 580ms cubic-bezier(0.3, 1.5, 0.5, 1) var(--pd);
  }
  .mapcard__fig[data-in] .cpin { opacity: 1; scale: 1; }

  .cdot { fill: var(--green-deep); }
  .cring { fill: #fff; }
  .chalo {
    fill: var(--green);
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
  }
  .mapcard__fig[data-in] .chalo {
    animation: cping 3s var(--ease) calc(var(--pd) + 400ms) infinite;
  }
  @keyframes cping {
    0% { opacity: 0.3; transform: scale(0.35); }
    70%, 100% { opacity: 0; transform: scale(1); }
  }

  .cchip {
    position: absolute;
    top: calc(var(--y) + var(--dy, 0%));
    left: var(--x);
    padding: 0.26rem 0.6rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.94);
    box-shadow: 0 6px 16px -10px rgb(0 0 0 / 0.55);
    font-size: 0.6875rem;
    font-weight: 600;
    white-space: nowrap;
    color: var(--text);
    opacity: 0;
    transition:
      opacity 360ms var(--ease) calc(1620ms + var(--i) * 140ms),
      color var(--t2) var(--ease),
      background-color var(--t2) var(--ease);
  }
  .cchip[data-side='right'] { translate: 1.2rem -50%; }
  .cchip[data-side='left'] { translate: calc(-100% - 1.2rem) -50%; }
  .mapcard__fig[data-in] .cchip { opacity: 1; }
  .cchip:hover { background: var(--green-deep); color: #fff; }

  .mapcard__all {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: auto;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--green-deep);
    border-bottom: 1px solid transparent;
    align-self: flex-start;
    transition: border-color var(--t2) var(--ease);
  }
  .mapcard__all:hover { border-color: var(--green); }

  /* ---------- dark channel rail ---------- */

  .rail {
    padding: clamp(1.5rem, 3.2vw, 2.25rem);
    border-radius: 18px;
    background: var(--ink);
    color: #fff;
  }

  .rail__eb {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--green-bright);
  }
  .rail__h {
    margin-top: var(--s4);
    font-size: clamp(1.4rem, 2.6vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.035em;
  }

  .rail__list {
    display: grid;
    gap: 0.4rem;
    margin-top: var(--s5);
  }

  .row {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.9rem;
    border-radius: 14px;
    transition: background-color var(--t2) var(--ease);
  }
  a.row:hover { background: rgb(255 255 255 / 0.07); }
  .row--static { align-items: flex-start; }
  /* The address is information, not a channel. Clay marks it as the one
     row that does not go anywhere. */
  .row--static .row__i {
    color: var(--clay-bright);
    border-color: rgb(224 139 84 / 0.4);
  }

  /* Outlined circle, the device these pages use to give a plain phone
     number the weight of a button. */
  .row__i {
    display: grid;
    place-items: center;
    width: 54px;
    height: 54px;
    flex: none;
    border-radius: 50%;
    border: 1px solid rgb(255 255 255 / 0.3);
    color: var(--green-bright);
