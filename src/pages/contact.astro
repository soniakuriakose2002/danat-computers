---
import { getCollection } from 'astro:content';
import PageLayout from '@layouts/PageLayout.astro';
import Icon from '@components/ui/Icon.astro';
import { site, whatsappLink, branches } from '@data/site';
import { OMAN_PATH, OMAN_VIEWBOX, OMAN_PINS, OMAN_SPOKES } from '@data/omanMap';

const services = (await getCollection('services')).sort(
  (a, b) => a.data.index - b.data.index
);

const order = ['ruwi', 'sohar', 'hail', 'salalah'];
const list = order.map((s) => branches.find((b) => b.slug === s)!);

/** North-to-south for the map, so the pins read top to bottom. */
const mapOrder = ['sohar', 'hail', 'ruwi', 'salalah'];
const mapList = mapOrder.map((s) => branches.find((b) => b.slug === s)!);

const promises = [
  { icon: 'chat', a: 'Quick', b: 'Response' },
  { icon: 'shield', a: 'Trusted', b: 'Support' },
  { icon: 'users', a: 'Expert', b: 'Team' },
  { icon: 'gear', a: 'Better', b: 'Solutions' },
] as const;

/**
 * Only ONE phone number is verified for Danat. The rest of the numbers on
 * the current live site are unconfirmed, so Call and WhatsApp both point
 * at the number we can actually stand behind rather than inventing a
 * second landline.
 */
const ways = [
  {
    icon: 'phone',
    title: 'Call Us',
    value: site.phone.display,
    note: 'The Ruwi counter. They will route you to your branch.',
    cta: 'Call now',
    href: `tel:${site.phone.tel}`,
    external: false,
  },
  {
    icon: 'whatsapp',
    title: 'WhatsApp',
    value: site.phone.display,
    note: 'Send a photo of the issue for faster support.',
    cta: 'Chat on WhatsApp',
    href: whatsappLink(),
    external: true,
  },
  {
    icon: 'mail',
    title: 'Email Us',
    value: site.email,
    note: 'Quotes, purchase orders and trade accounts.',
    cta: 'Send an email',
    href: `mailto:${site.email}`,
    external: false,
  },
  {
    icon: 'pin',
    title: 'Visit a Branch',
    value: null,
    note: 'Find your nearest Danat Computers branch across Oman.',
    cta: 'View branches',
    href: '/branches',
    external: false,
  },
] as const;

/**
 * Answers are written only where the company's own data supports them.
 * Two of these need input from Danat before they can be answered, and
 * they say so rather than guessing.
 */
const faqs = [
  {
    q: 'What are your working hours?',
    a: null,
    pending:
      'Danat has not published confirmed trading hours. Message us on WhatsApp and we will confirm the hours for your branch.',
  },
  {
    q: 'Do you provide on-site support?',
    a: null,
    pending:
      'On-site coverage and call-out terms are still to be confirmed with the company.',
  },
  {
    q: 'How can I check product availability?',
    a: `We carry ${site.stats.parts.toLocaleString('en-US')} lines across ${site.stats.categories} categories. Send us the make and model on WhatsApp and we will check stock across all four branches before you travel.`,
    pending: null,
  },
  {
    q: 'Do you offer business solutions?',
    a: 'Yes. Alongside the retail counter we supply businesses at trade, and take on CCTV and networking projects. Tell us the scope and we will come back with a quote.',
    pending: null,
  },
  {
    q: 'How can I contact a specific branch?',
    a: `Every branch is reachable on ${site.phone.display}, which rings the Ruwi counter and is routed from there. Each branch's own details are listed on the branches page.`,
    pending: null,
  },
];

const W = 1000;
const H = 1342;

/** Chip offsets: Al Hail and Ruwi sit under 1% apart on the map. */
const nudge: Record<string, string> = {
  sohar: '0%',
  hail: '-3.4%',
  ruwi: '2.8%',
  salalah: '0%',
};
---

<PageLayout
  title="Contact"
  description={`Talk to Danat Computers — call or WhatsApp ${site.phone.display}, email ${site.email}, or visit one of four branches across Oman.`}
>
  {/* ═══════════════ 01 · hero + form ═══════════════ */}
  <section class="hx">
    <div class="hx__deco" aria-hidden="true">
      <span class="hx__orb"></span>
      <span class="hx__orb2"></span>
      <span class="hx__wash"></span>
    </div>

    <p class="hx__side" aria-hidden="true">Same expertise<br />closer to you</p>

    <div class="shell hx__grid">
      {/* ── copy ── */}
      <div class="hx__copy">
        <p class="eb" data-rise>
          <i class="eb__rule" aria-hidden="true"></i>Contact us
        </p>

        <h1 class="hx__h" data-rise style="--d:70ms">
          We're Just<br /><em>a Message Away.</em>
        </h1>

        <p class="hx__p" data-rise style="--d:130ms">
          Have a question, need support, or want to discuss your business
          needs? Our team is here to help.
        </p>

        <ul class="pro" data-rise style="--d:190ms">
          {promises.map((p) => (
            <li>
              <span class="pro__i" aria-hidden="true"><Icon name={p.icon} size={19} /></span>
              <span class="pro__t">{p.a}<br />{p.b}</span>
            </li>
          ))}
        </ul>

        <p class="hx__tag" data-rise style="--d:250ms">
          <i class="eb__rule" aria-hidden="true"></i>
          Technology for a brighter tomorrow
        </p>
      </div>

      {/* ── script aside ── */}
      <div class="hx__aside" data-rise style="--d:300ms">
        <p class="script">Let's<br />Connect</p>
        <svg class="script__sw" viewBox="0 0 150 22" fill="none" aria-hidden="true">
          <path d="M3 15C34 4 92 3 147 9" stroke="currentColor" stroke-width="2"
            stroke-linecap="round" pathLength="1" />
        </svg>
        <p class="hx__mantra">People. Products.<br />Support. A Brighter<br />Tomorrow.</p>
      </div>

      {/* ── form card ── */}
      <div class="card" data-rise style="--d:160ms">
        <h2 class="card__h">Send Us a Message</h2>
        <p class="card__s">
          Fill in the form and we'll get back to you as soon as possible.
        </p>

        <form class="card__f" id="enquiry">
          <div class="fd">
            <Icon name="users" size={16} />
            <input id="f-name" name="name" type="text" autocomplete="name"
              placeholder="Your Name" aria-label="Your name" required />
          </div>

          <div class="fd">
            <Icon name="mail" size={16} />
            <input id="f-email" name="email" type="email" autocomplete="email"
              placeholder="Your Email" aria-label="Your email" />
          </div>

          <div class="card__two">
            <div class="fd">
              <Icon name="phone" size={16} />
              <input id="f-phone" name="phone" type="tel" autocomplete="tel"
                placeholder="Phone Number" aria-label="Your phone number" />
            </div>
            <div class="fd fd--sel">
              <Icon name="gear" size={16} />
              <select id="f-topic" name="topic" aria-label="Subject">
                <option value="" disabled selected>Select Subject</option>
                {services.map((s) => <option value={s.data.title}>{s.data.title}</option>)}
                <option value="Business solutions">Business solutions</option>
                <option value="Something else">Something else</option>
              </select>
            </div>
          </div>

          <div class="fd fd--area">
            <Icon name="chat" size={16} />
            <textarea id="f-msg" name="message" rows="4" maxlength="500"
              placeholder="Your Message" aria-label="Your message" required></textarea>
            <span class="fd__count" id="count" aria-hidden="true">0/500</span>
          </div>

          <button class="btn" type="submit">
            Send Message
            <span class="btn__i" aria-hidden="true"><Icon name="arrow" size={15} /></span>
          </button>

          <p class="card__note">
            <Icon name="lock" size={13} />
            <span>
              Opens WhatsApp with your message ready — nothing is stored on this
              site and nothing sends until you press send.
            </span>
          </p>

          <button class="card__alt" type="button" id="by-email">
            Send by email instead
          </button>

          <noscript>
            <p class="card__nojs">
              This form needs JavaScript. Reach us on
              {' '}<a href={whatsappLink()}>WhatsApp</a>, call
              {' '}<a href={`tel:${site.phone.tel}`}>{site.phone.display}</a>, or email
              {' '}<a href={`mailto:${site.email}`}>{site.email}</a>.
            </p>
          </noscript>
        </form>
      </div>
    </div>
  </section>

  {/* ═══════════════ 02 · other ways ═══════════════ */}
  <section class="wy section" data-tone="light">
    <div class="shell wy__grid">
      <div class="wy__intro" data-rise>
        <p class="eb"><i class="eb__rule" aria-hidden="true"></i>Other ways to reach us</p>
        <h2 class="wy__h">Choose Your<br />Preferred Way</h2>
        <p class="wy__p">
          Whether it's a quick question or technical support, reach out
          through your preferred channel.
        </p>
      </div>

      <ul class="wy__cards">
        {ways.map((w, i) => (
          <li data-rise style={`--d:${i * 70}ms`}>
            <a class="wc" href={w.href}
              target={w.external ? '_blank' : undefined}
              rel={w.external ? 'noopener noreferrer' : undefined}>
              <span class="wc__i" aria-hidden="true"><Icon name={w.icon} size={21} /></span>
              <b class="wc__t">{w.title}</b>
              {w.value && <span class="wc__v">{w.value}</span>}
              <span class="wc__n">{w.note}</span>
              <span class="wc__c">
                {w.cta}<Icon name="arrow" size={14} />
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* ═══════════════ 03 · across oman ═══════════════ */}
  <section class="ao section" data-tone="light">
    <div class="shell">
      <div class="ao__panel">
        {/* copy */}
        <div class="ao__copy" data-rise>
          <p class="eb"><i class="eb__rule" aria-hidden="true"></i>Our branches</p>
          <h2 class="ao__h">Across Oman<br /><em>With You</em></h2>
          <p class="ao__p">
            Four branches. Same commitment. Visit your nearest Danat location
            for expert service, genuine products and reliable support.
          </p>
          <a class="btn btn--solid" href="/branches">
            View all branches
            <span class="btn__i" aria-hidden="true"><Icon name="arrow" size={15} /></span>
          </a>
        </div>

        {/* map */}
        <div class="ao__map" data-rise style="--d:90ms">
          <svg viewBox={OMAN_VIEWBOX} width="300" height="403" role="img"
            aria-label="Map of Oman showing Danat branches in Sohar, Al Hail, Ruwi and Salalah">
            <path class="ao__land" d={OMAN_PATH} fill="#dfe9df" />
            {OMAN_SPOKES.map(([a, b], i) => {
              const p = OMAN_PINS[a];
              const q = OMAN_PINS[b];
              return (
                <path class="ao__route" style={`--i:${i}`} fill="none"
                  stroke="#8fb98c" stroke-width="3" stroke-dasharray="2 12"
                  stroke-linecap="round"
                  d={`M${p.x},${p.y} Q${(p.x + q.x) / 2 - 40},${(p.y + q.y) / 2} ${q.x},${q.y}`} />
              );
            })}
            <text class="ao__wm" x="470" y="880" aria-hidden="true">OMAN</text>
            {mapList.map((b, i) => (
              <g class="ao__pin" style={`--i:${i}`}
                transform={`translate(${OMAN_PINS[b.slug].x} ${OMAN_PINS[b.slug].y}) scale(1.5)`}>
                <path fill="#2f6429"
                  d="M0,0 C-8,-11 -14,-18 -14,-25 A14,14 0 1 1 14,-25 C14,-18 8,-11 0,0 Z" />
                <circle cx="0" cy="-25" r="5" fill="#ffffff"></circle>
              </g>
            ))}
          </svg>

          {mapList.map((b, i) => (
            <a class="ao__chip" href={`/branches#${b.slug}`} style={`--i:${i}; --x:${((OMAN_PINS[b.slug].x / W) * 100).toFixed(2)}%; --y:${((OMAN_PINS[b.slug].y / H) * 100).toFixed(2)}%; --dy:${nudge[b.slug]}`}>
              {b.city.split(',')[0]}
            </a>
          ))}

          <p class="ao__script" aria-hidden="true">Your Tech Partner<br />Across Oman</p>
        </div>

        {/* numbered list */}
        <ol class="ao__list">
          {list.map((b, i) => (
            <li data-rise style={`--d:${i * 60}ms`}>
              <a class="bl" href={`/branches#${b.slug}`}>
                <span class="bl__n">{String(i + 1).padStart(2, '0')}</span>
                <span class="bl__t">
                  <b>{b.name}</b>
                  <em>{b.city}</em>
                  <i data-unverified={!b.hoursVerified ? '' : undefined}>
                    {b.hours[0]}
                    {!b.hoursVerified && <s>Hours to confirm</s>}
                  </i>
                </span>
                <span class="bl__go" aria-hidden="true"><Icon name="arrow" size={15} /></span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  {/* ═══════════════ 04 · faq ═══════════════ */}
  <section class="fq section" data-tone="light">
    <div class="shell fq__grid">
      <div class="fq__intro" data-rise>
        <p class="eb"><i class="eb__rule" aria-hidden="true"></i>Still have questions?</p>
        <h2 class="fq__h">Frequently Asked<br />Questions</h2>
        <p class="fq__p">
          Find quick answers to common questions. Can't find what you're
          looking for? Ask us directly.
        </p>
        <a class="btn btn--ghost" href={whatsappLink('Hello Danat — I have a question about')}
          target="_blank" rel="noopener noreferrer">
          Ask us directly
          <span class="btn__i" aria-hidden="true"><Icon name="arrow" size={14} /></span>
        </a>
      </div>

      <div class="fq__list">
        {faqs.map((f, i) => (
          <details class="ac" data-rise style={`--d:${i * 50}ms`}>
            <summary>
              <span>{f.q}</span>
              <i class="ac__i" aria-hidden="true"><Icon name="plus" size={15} /></i>
            </summary>
            <div class="ac__b">
              {f.a
                ? <p>{f.a}</p>
                : <p class="ac__pending">{f.pending}</p>}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  {/* ═══════════════ 05 · cta ═══════════════ */}
  <section class="ct" data-tone="ink">
    <div class="shell ct__in">
      <span class="ct__i" aria-hidden="true"><Icon name="plane" size={34} /></span>
      <div class="ct__l">
        <p class="ct__k">Still need help?</p>
        <p class="ct__h">Let's talk.</p>
      </div>
      <p class="ct__p">
        Our team is ready to assist you with any questions or support you need.
      </p>
      <a class="ct__b" href={whatsappLink()} target="_blank" rel="noopener noreferrer">
        Contact us now<Icon name="arrow" size={15} />
      </a>
    </div>
  </section>
</PageLayout>

<script is:inline define:vars={{ WA: site.phone.whatsapp, MAIL: site.email }}>
  /* <ClientRouter /> swaps the body on a nav click without a page load,
     and an is:inline script runs once on the first load and never again
     — so everything below was binding to elements that had already been
     thrown away. astro:page-load fires on the first load and after every
     swap. */
  (() => {
    const setup = () => {
    (() => {
      const form = document.getElementById('enquiry');
      if (!form) return;

      const msg = document.getElementById('f-msg');
      const count = document.getElementById('count');
      if (msg && count) {
        const tick = () => { count.textContent = `${msg.value.length}/500`; };
        msg.addEventListener('input', tick);
        tick();
      }

      // No server to POST to, so the enquiry is composed and handed to
      // WhatsApp. Nothing leaves the page until the person sends it.
      const compose = () => {
        const d = new FormData(form);
        const opt = (k, label) => {
          const v = String(d.get(k) || '').trim();
          return v ? [`${label}: ${v}`] : [];
        };
        return [
          `Hello Danat — this is ${String(d.get('name') || '').trim()}.`,
          ``,
          ...opt('topic', 'Subject'),
          ...opt('phone', 'Phone'),
          ...opt('email', 'Email'),
          ``,
          String(d.get('message') || '').trim(),
        ].join('\n');
      };

      form.addEventListener('submit', (e) => {
        e.preventDefault();
        if (!form.reportValidity()) return;
        window.open(`https://wa.me/${WA}?text=${encodeURIComponent(compose())}`,
          '_blank', 'noopener');
      });

      document.getElementById('by-email')?.addEventListener('click', () => {
        if (!form.reportValidity()) return;
        const s = String(new FormData(form).get('topic') || 'Enquiry');
        window.location.href =
          `mailto:${MAIL}?subject=${encodeURIComponent(s)}&body=${encodeURIComponent(compose())}`;
      });
    })();
    };

    let ran = false;
    document.addEventListener('astro:page-load', () => { ran = true; setup(); });
    window.addEventListener('load', () => { if (!ran) { ran = true; setup(); } });
  })();
</script>

<style>
  /* ───────── shared ───────── */

  .eb {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--green-deep);
  }
  .eb__rule {
    width: 28px;
    height: 1px;
    flex: none;
    background: color-mix(in oklab, var(--green) 60%, transparent);
  }

  .btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
    padding: 0.85rem 0.85rem 0.85rem 1.5rem;
    border: 0;
    border-radius: 999px;
    /* white on #27551f is 8.73:1 and on #3d7f35 is 4.90:1 — AA the whole ramp */
    background: linear-gradient(100deg, #27551f, #3d7f35);
    color: #fff;
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 600;
    cursor: pointer;
    overflow: hidden;
    transition: transform var(--t2) var(--ease);
  }
  .btn:hover { transform: translateY(-2px); }
  .btn::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(100deg, transparent 35%, rgb(255 255 255 / 0.22) 50%, transparent 65%);
    transform: translate3d(-100%, 0, 0);
    transition: transform var(--t4) var(--ease);
  }
  .btn:hover::after { transform: translate3d(100%, 0, 0); }
  .btn__i {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    flex: none;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.2);
    transition: transform var(--t2) var(--ease);
  }
  .btn:hover .btn__i { transform: translateX(3px); }

  .btn--solid { align-self: flex-start; margin-top: var(--s5); }

  .btn--ghost {
    align-self: flex-start;
    margin-top: var(--s5);
    padding: 0.7rem 0.7rem 0.7rem 1.35rem;
    background: transparent;
    border: 1px solid var(--line-light);
    color: var(--text);
    font-size: 0.875rem;
  }
  .btn--ghost::after { display: none; }
  .btn--ghost:hover { border-color: var(--green); }
  .btn--ghost .btn__i {
    width: 26px;
    height: 26px;
    background: var(--green-wash);
    color: var(--green-deep);
  }

  /* ═══════════ 01 · HERO ═══════════ */

  .hx {
    position: relative;
    padding-block: clamp(6.5rem, 11vw, 8.5rem) clamp(3rem, 6vw, 5rem);
    background: linear-gradient(170deg, #fbfdfb 0%, #eef5ee 58%, #f7faf7 100%);
    overflow: hidden;
    isolation: isolate;
  }

  .hx__deco { position: absolute; inset: 0; z-index: -1; pointer-events: none; }
  /* Anchored to the top-right CORNER, with the sweep on its bottom-left.
     A circle pushed off-canvas does not work here: the section clips its
     top and the tall form card covers its left, so all that survives is
     a flat band. Cornering it puts the curve on the one edge nothing
     can crop. */
  .hx__orb {
    position: absolute;
    top: 0;
    right: 0;
    width: min(48rem, 58vw);
    height: clamp(15rem, 32vw, 26rem);
    border-radius: 0 0 0 74%;
    background: radial-gradient(
      120% 150% at 78% 12%,
      #35762f 0%,
      #1d4623 48%,
      #122d18 82%
    );
  }

  .hx__orb2 {
    position: absolute;
    right: -6%;
    top: 46%;
    width: min(26rem, 32vw);
    aspect-ratio: 1;
    border-radius: 50%;
    background: color-mix(in oklab, var(--green) 14%, transparent);
    filter: blur(6px);
  }
  .hx__wash {
    position: absolute;
    left: -10%;
    bottom: -30%;
    width: 38%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in oklab, var(--green) 20%, transparent), transparent 66%);
    filter: blur(30px);
  }

  .hx__side {
    position: absolute;
    top: 38%;
    right: 1.1rem;
    z-index: 1;
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    line-height: 1.9;
    color: var(--text-3);
    text-align: right;
    display: none;
  }

  .hx__grid { display: grid; gap: clamp(2rem, 4vw, 3rem); align-items: start; }

  .hx__h {
    margin-top: var(--s4);
    font-size: clamp(2.3rem, 5.2vw, 3.9rem);
    line-height: 1.04;
    letter-spacing: -0.042em;
    font-weight: 700;
  }
  .hx__h em { font-style: normal; color: var(--green-deep); }

  .hx__p {
    margin-top: var(--s4);
    max-width: 38ch;
    font-size: var(--lead);
    line-height: 1.6;
    color: var(--text-2);
  }

  /* ---- four promises ---- */

  .pro {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem 0;
    margin-top: var(--s5);
  }
  .pro li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding-right: 1.1rem;
  }
  .pro li + li { padding-left: 1.1rem; border-left: 1px solid var(--line-light); }

  .pro__i {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    flex: none;
    border-radius: 50%;
    border: 1px solid var(--line-light);
    background: #fff;
    color: var(--text);
  }
  .pro__t { font-size: 0.8125rem; line-height: 1.25; color: var(--text-2); }

  .hx__tag {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: var(--s5);
    font-size: 0.8125rem;
    color: var(--text-2);
  }

  /* ---- script aside ---- */

  .hx__aside { display: grid; justify-items: start; }

  .script {
    font-family: var(--font-serif, Georgia, serif);
    font-style: italic;
    font-size: clamp(1.8rem, 3.6vw, 2.7rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
