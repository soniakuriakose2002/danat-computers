---
import { Image } from 'astro:assets';
import PageLayout from '@layouts/PageLayout.astro';
import Icon from '@components/ui/Icon.astro';
import PurposeOrbit from '@components/sections/PurposeOrbit.astro';
import MeetTeam from '@components/sections/MeetTeam.astro';
import VideoModal from '@components/global/VideoModal.astro';
import StoryCard from '@components/global/StoryCard.astro';
import { site, branches, brands } from '@data/site';
import { OMAN_PATH, OMAN_VIEWBOX, OMAN_PINS } from '@data/omanMap';
import imgTech from '@assets/photos/repair-solder.jpg';
import imgFilm from '@assets/photos/film-poster.jpg';
import imgHero from '@assets/photos/support-desk.jpg';
import teamDesk from '@assets/photos/support-agent.jpg';
import teamBench from '@assets/photos/repair-solder.jpg';
import teamNet from '@assets/photos/network-eng.jpg';
import teamBiz from '@assets/photos/support-desk.jpg';
import Brush from '@components/ui/Brush.astro';
import Mark from '@components/ui/Mark.astro';

const years = new Date().getFullYear() - site.stats.since;

/**
 * ⚠ THREE ITEMS BELOW ARE NOT VERIFIED — they come from the client's
 * mockup, not from Danat's records, and the client has asked for the
 * mockup reproduced exactly. Confirm all three before this site goes
 * public:
 *   1. "1000+ happy customers" — no source of any kind.
 *   2. The 2010 and 2016 milestone years — invented by the mockup.
 *      Only 2003 is real (earliest record in the ERP export).
 *   3. The milestone descriptions attached to those two years.
 * Everything else on this page traces to site.ts or the ERP export.
 */
const figures = [
  { icon: 'calendar', v: years, suffix: '+', l: 'Years in business', sub: `Since ${site.stats.since}` },
  { icon: 'building', v: site.stats.branches, suffix: '', l: 'Branches in Oman', sub: branches.map((b) => b.city.split(',')[0]).join(', ') },
  { icon: 'box', v: site.stats.parts, suffix: '', l: 'Products in stock', sub: `Across ${site.stats.categories} categories` },
  { icon: 'users', v: 1000, suffix: '+', l: 'Happy customers', sub: 'Individuals & businesses', unverified: true },
];

const journey = [
  { year: '2003', t: 'Opened our first store in Ruwi, Muscat.', verified: true },
  { year: '2010', t: 'Expanded our product range and IT solutions.', verified: false },
  { year: '2016', t: 'Grew across Oman with new branches in Sohar and Salalah.', verified: false },
  { year: 'Today', t: 'Continuing to support individuals, businesses and organisations.', verified: true },
];

const proof = [
  { icon: 'chip', t: 'Board level repair' },
  { icon: 'wrench', t: 'Genuine spares' },
  { icon: 'users', t: 'Experienced team' },
  { icon: 'bolt', t: 'Faster turnaround' },
];

/**
 * "What our team does": the photos illustrate the four kinds of work and
 * are not presented as named Danat staff, so no names are shown. Swap in
 * real staff photos (and add names) whenever they are available.
 *
 * ⚠ DRAFT — the review cards in "Trusted by" are placeholders. Replace
 * them with real customer reviews before going live, or set
 * SHOW_REVIEWS to false to hide just the reviews.
 */
const SHOW_REVIEWS = true;
const team = [
  { img: teamDesk, role: 'Service desk', note: 'First contact, diagnosis booking and quotes' },
  { img: teamBench, role: 'Board-level repair', note: 'Tracing faults to the component' },
  { img: teamNet, role: 'Networks & CCTV', note: 'Surveys, cabling and installation' },
  { img: teamBiz, role: 'Business support', note: 'Contracts, supply and on-site visits' },
];
const quotes = [
  { who: 'Customer name', where: 'Ruwi', kind: 'Laptop repair' },
  { who: 'Business name', where: 'Ruwi', kind: 'Office network' },
  { who: 'Customer name', where: 'Sohar', kind: 'Data recovery' },
  { who: 'Customer name', where: 'Sohar', kind: 'Printer service' },
  { who: 'Business name', where: 'Salalah', kind: 'CCTV installation' },
  { who: 'Customer name', where: 'Salalah', kind: 'Laptop upgrade' },
];
/* three columns for the moving "wall" of reviews */
const cols = [0, 1, 2].map((c) => quotes.filter((_, i) => i % 3 === c));
const mapOrder = ['sohar', 'ruwi', 'salalah'];
const mapList = mapOrder.map((s) => branches.find((b) => b.slug === s)!);
const W = 1000;
const H = 1342;
const nudge: Record<string, string> = { sohar: '0%', hail: '-3.4%', ruwi: '2.8%', salalah: '0%' };

---
<PageLayout
  title="About"
  description={`${site.nameFull} has supplied and repaired computers across Oman since ${site.stats.since} — three branches, ${site.stats.parts.toLocaleString('en-US')} lines in stock, board-level repair.`}
>
  {/* ══════ 01 · hero — full screen, the photo drifts as you scroll ══════ */}
<section class="ah" data-ah>
    <div class="shell ah__in">
      <div class="ah__copy" data-ah-tilt>
        <p class="eb ah__eb"><i class="eb__r" aria-hidden="true"></i>About Danat</p>
        <h1 class="ah__h">
          <span class="ah__l"><span>Technology that keeps</span></span>
          <span class="ah__l"><span><Brush><span class="rot" data-rot><span class="rot__w is-on">Oman moving.</span><span class="rot__w" aria-hidden="true">businesses running.</span><span class="rot__w" aria-hidden="true">homes connected.</span><span class="rot__w" aria-hidden="true">devices working.</span></span></Brush></span></span>
        </h1>
        <p class="ah__p">
          For over two decades, Danat Computers has been a trusted name in
          computer products, services and business solutions across Oman. We
          don't just sell technology — we keep it running.
        </p>
        <div class="ah__acts">
          <button class="btn" type="button" data-story-open>
            Our story<span class="btn__i" aria-hidden="true"><Icon name="arrow" size={15} /></span>
          </button>
          <button class="ah__film" type="button" data-video-open aria-label="Watch the film: inside Danat Computers">
            <span class="ah__play" aria-hidden="true"><Icon name="play" size={13} /></span>
            <span><b>Watch the film</b><em>Inside Danat Computers</em></span>
          </button>
        </div>
        <p class="ah__mantra">People · Products · Support · A brighter tomorrow</p>
      </div>
    </div>
    <div class="ah__bg" data-ah-bg aria-hidden="true">
      <Image src={imgHero} alt="" widths={[900, 1400, 2000]} sizes="(min-width:62rem) 58vw, 100vw" quality={74} format="webp" loading="eager" />
    </div>
  </section>

  {/* ══════ view switch: Who we are / Meet our team ══════ */}
  <div class="av" data-av>
    <div class="av__bar" role="tablist" aria-label="About Danat">
      <span class="av__pill" data-av-pill aria-hidden="true"></span>
      <button class="av__tab" role="tab" type="button" id="av-tab-who" aria-controls="av-who" aria-selected="true" data-av-tab="who">Who we are</button>
      <button class="av__tab" role="tab" type="button" id="av-tab-team" aria-controls="av-team" aria-selected="false" tabindex="-1" data-av-tab="team">Meet our team</button>
    </div>
  </div>

  <div class="av__view is-on" id="av-who" role="tabpanel" aria-labelledby="av-tab-who" data-av-view="who">
  {/* ══════ 02 · figures — 3D tilt cards with a light that follows the pointer ══════ */}
  <section class="af">
    <dl class="shell af__grid">
      {figures.map((f, i) => (
        <div class:list={['af__c', `af__c--${i}`]} data-tilt>
          <span class="af__glow" aria-hidden="true"></span>
          <span class="af__i" aria-hidden="true"><Icon name={f.icon} size={20} /></span>
          <dt><span data-count={f.v}>{Number(f.v).toLocaleString('en-US')}</span>{f.suffix}</dt>
          <dd>{f.l}</dd>
          <small>{f.sub}</small>
        </div>
      ))}
    </dl>
  </section>

  {/* ══════ 03 · journey — milestone cards stack up in 3D as you scroll ══════ */}
  <section class="aj" id="journey">
    <div class="shell">
      <div class="aj__intro">
        <p class="eb"><i class="eb__r" aria-hidden="true"></i>Our journey</p>
        <h2 class="aj__h">From a <Mark as="highlight" tone="butter">small shop</Mark><br />to a trusted partner.</h2>
        <p class="aj__p">
          What started as a single counter has grown into a company with
          branches across Oman, serving thousands of customers. Our focus has
          always been the same — genuine products, expert service and
          long-term relationships.
        </p>
      </div>
      <ol class="aj__line" data-aj>
        <span class="aj__rail" aria-hidden="true"><i></i><b class="aj__spark"></b></span>
        {journey.map((j, i) => (
          <li class="aj__m" style={`--i:${i}`}>
            <span class="aj__dot" aria-hidden="true"><Icon name={['building', 'box', 'pin', 'users'][i % 4]} size={20} /></span>
            <b class="aj__yr" data-aj-yr={j.year}>{j.year}</b>
            <p class="aj__t">{j.t}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* ══════ 04 · purpose (unchanged) ══════ */}
  <PurposeOrbit />

  {/* ══════ 05 · the difference — the photo opens out to full width ══════ */}
<section class="ad" data-ad>
    <div class="shell ad__in">
      <figure class="ad__shot" data-ad-shot>
        <Image src={imgTech} alt="A Danat technician tracing a fault on a mainboard"
          widths={[700, 1100, 1500]} sizes="(min-width:62rem) 48vw, 100vw" quality={74} format="webp" loading="lazy" />
      </figure>
      <div class="ad__copy">
        <p class="eb" data-rise><i class="eb__r" aria-hidden="true"></i>The difference</p>
        <h2 class="ad__h" data-rise style="--d:70ms">Most shops replace the board. <Mark as="underline">We repair it.</Mark></h2>
        <p class="ad__p" data-rise style="--d:130ms">
          A replacement mainboard is often most of the value of the machine. A
          failed component on it is usually worth a fraction of that. Tracing
          the fault to the component takes a bench, a meter and someone who
          knows what they are looking at — which is what {years} years buys
          you, and what almost nobody else in Oman does in-house.
        </p>
        <ul class="ad__proof">
          {proof.map((p, i) => (
            <li data-rise style={`--d:${190 + i * 60}ms`}><span aria-hidden="true"><Icon name={p.icon} size={16} /></span>{p.t}</li>
          ))}
        </ul>
        <a class="btn" href="/services" data-rise style="--d:420ms">
          Our repair services<span class="btn__i" aria-hidden="true"><Icon name="arrow" size={15} /></span>
        </a>
      </div>
    </div>
  </section>


      {/* ══════ 05c · trusted by — brand marquee + a moving wall of reviews ══════ */}
      <section class="aq">
        <div class="shell aq__head">
          <p class="eb"><i class="eb__r" aria-hidden="true"></i>Trusted by</p>
          <h2 class="aq__h">Brands we carry, <Mark as="highlight" tone="mint">customers we keep.</Mark></h2>
        </div>
        <div class="aq__mq" aria-label={`Brands we carry: ${brands.flat().join(', ')}`}>
          <div class="aq__track">
            {[0, 1].map((dup) => (
              <ul aria-hidden={dup ? 'true' : undefined}>{brands.flat().map((b) => <li>{b}</li>)}</ul>
            ))}
          </div>
        </div>
        {SHOW_REVIEWS && (
          <div class="shell">
            <div class="aq__wall">
              {cols.map((col, c) => (
                <div class="aq__col" style={`--dur:${[38, 46, 42][c]}s`}>
                  <div class="aq__run">
                    {[0, 1].map((dup) => col.map((q) => (
                      <figure class="aq__q" aria-hidden={dup ? 'true' : undefined}>
                        <span class="aq__mark" aria-hidden="true">“</span>
                        <div class="aq__top">
                          <span class="aq__av" aria-hidden="true">{q.who.charAt(0)}</span>
                          <span class="aq__who"><b>{q.who}</b><small>{q.kind} · Danat {q.where}</small></span>
                          <span class="aq__g" aria-hidden="true">G</span>
                        </div>
                        <span class="aq__stars" aria-label="5 out of 5">★★★★★</span>
                        <blockquote>Customer review goes here — one or two sentences about the repair, the price or the service.</blockquote>
                      </figure>
                    )))}
                  </div>
                </div>
              ))}
            </div>
            <p class="aq__draft">Draft — the reviews are placeholders. Replace them with real customer reviews (for example from Google) before going live.</p>
          </div>
        )}
      </section>

  {/* ══════ 06 · presence ══════ */}
  <section class="pr section">
    <div class="shell pr__grid">
      <div class="pr__intro" data-rise>
        <p class="eb"><i class="eb__r" aria-hidden="true"></i>Our presence</p>
        <h2 class="pr__h">Three branches,<br /><em>one standard.</em></h2>
        <p class="pr__p">
          No matter which branch you visit, you get the same diagnosis, the
          same stock, and the same team. A branch is not a lesser version of
          the shop.
        </p>
        <a class="ghost" href="/branches">
          View all branches<span aria-hidden="true"><Icon name="arrow" size={14} /></span>
        </a>
      </div>

      <div class="pr__map" data-rise style="--d:90ms">
        <svg viewBox={OMAN_VIEWBOX} width="280" height="376" role="img"
          aria-label="Map of Oman showing Danat branches in Sohar, Ruwi and Salalah">
          <path class="pr__land" d={OMAN_PATH} fill="#e4efe3" />
          <text class="pr__wm" x="420" y="900" aria-hidden="true">OMAN</text>
          {mapList.map((b, i) => (
            <g class="pr__pin" style={`--i:${i}`}
              transform={`translate(${OMAN_PINS[b.slug].x} ${OMAN_PINS[b.slug].y}) scale(1.4)`}>
              <path fill="#2f6429" d="M0,0 C-8,-11 -14,-18 -14,-25 A14,14 0 1 1 14,-25 C14,-18 8,-11 0,0 Z" />
              <circle cx="0" cy="-25" r="5" fill="#ffffff"></circle>
            </g>
          ))}
        </svg>
        {mapList.map((b, i) => (
          <a class="pr__chip" href={`/branches#${b.slug}`}
            style={`--i:${i}; --x:${((OMAN_PINS[b.slug].x / W) * 100).toFixed(2)}%; --y:${((OMAN_PINS[b.slug].y / H) * 100).toFixed(2)}%; --dy:${nudge[b.slug]}`}>
            {b.city.split(',')[0]}
          </a>
        ))}
      </div>

      <ul class="pr__list">
        {branches.map((b, i) => (
          <li data-rise style={`--d:${i * 60}ms`}>
            <a class="br" href={`/branches#${b.slug}`}>
              <span class="br__shot" aria-hidden="true"><i>Photo</i></span>
              <span class="br__t"><b>{b.name}</b><em>{b.city}</em></span>
              <span class="br__go" aria-hidden="true"><Icon name="arrow" size={15} /></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  </div>

  <div class="av__view" id="av-team" role="tabpanel" aria-labelledby="av-tab-team" data-av-view="team" hidden>
    <MeetTeam />
  </div>

  {/* ══════ 07 · cta ══════ */}
<section class="ac">
    <div class="shell">
      <div class="ac__panel">
        <p class="eb" data-rise><i class="eb__r" aria-hidden="true"></i>Let's build a brighter tomorrow</p>
        <h2 class="ac__h" data-rise style="--d:70ms">Need <Mark as="highlight" tone="butter">expert</Mark> <Mark as="underline" tone="blue">advice?</Mark></h2>
        <p class="ac__p" data-rise style="--d:130ms">Our team is here to help you find the right solution.</p>
        <a class="ac__b" href="/contact" data-mag data-rise style="--d:190ms">Contact us<Icon name="arrow" size={15} /></a>
      </div>
    </div>
  </section>

  <StoryCard />
  <VideoModal />
</PageLayout>

<style>
  /* ───── shared ───── */
  .eb {
    display: flex; align-items: center; gap: 0.6rem;
    font-family: var(--font-mono); font-size: 0.6875rem;
    letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--green-deep);
  }
  .eb--clay { color: var(--clay-deep); }
  .eb--inv { color: var(--green-bright); }
  .eb__r { width: 26px; height: 1px; flex: none; background: currentColor; opacity: 0.6; }

  .btn {
    position: relative; display: inline-flex; align-items: center;
    align-self: flex-start; gap: 0.7rem;
    padding: 0.5rem 0.5rem 0.5rem 1.4rem;
    border: 0; border-radius: 999px;
    /* white is 8.73:1 on #27551f and 4.90:1 on #3d7f35 — AA across the ramp */
    background: linear-gradient(100deg, #27551f, #3d7f35);
    color: #fff; font-size: 0.9375rem; font-weight: 600;
    overflow: hidden; transition: transform var(--t2) var(--ease);
  }
  .btn:hover { transform: translateY(-2px); }
  .btn__i {
    display: grid; place-items: center; width: 30px; height: 30px; flex: none;
    border-radius: 50%; background: rgb(255 255 255 / 0.2);
    transition: transform var(--t2) var(--ease);
  }
  .btn:hover .btn__i { transform: translateX(3px); }

  .ghost {
    display: inline-flex; align-items: center; align-self: flex-start; gap: 0.6rem;
    margin-top: var(--s5);
    padding: 0.55rem 0.55rem 0.55rem 1.3rem;
    border: 1px solid var(--line-light); border-radius: 999px;
    background: var(--white); font-size: 0.875rem; font-weight: 600;
    transition: border-color var(--t2) var(--ease);
  }
  .ghost:hover { border-color: var(--clay); }
  .ghost span {
    display: grid; place-items: center; width: 26px; height: 26px;
    border-radius: 50%; background: var(--clay-wash); color: var(--clay-deep);
    transition: transform var(--t2) var(--ease);
  }
  .ghost:hover span { transform: translateX(3px); }


  /* ───── pastel palette ───── */
  :global(:root) { --p-mint: #e3f3e6; --p-mint-ink: #1f8a4c; --p-blush: #fbe6e7; --p-blush-ink: #c93c4f;
    --p-sky: #e4edfa; --p-sky-ink: #2d6fd0; --p-butter: #fbf0dc; --p-butter-ink: #c77410; --p-lilac: #efe8f8; --p-lilac-ink: #7a4bd0; }

  /* ───── 01 hero ───── */
  .ah { position: relative; color: var(--text); overflow: hidden;
    background: radial-gradient(40% 50% at 6% 18%, rgb(251 230 231 / 0.45), transparent 70%),
      radial-gradient(35% 45% at 28% 90%, rgb(228 237 250 / 0.5), transparent 70%),
      linear-gradient(180deg, #ffffff 0%, #f8faf8 100%); }
  .ah__in { position: relative; z-index: 1; display: grid; grid-template-columns: minmax(0, 0.95fr) minmax(0, 1fr); gap: clamp(2rem, 5vw, 5rem); align-items: center; min-height: min(78svh, 46rem);
    padding-top: calc(var(--hdr, 88px) + clamp(2.5rem, 6vw, 4.5rem)); padding-bottom: clamp(5rem, 9vw, 7rem); }
  .ah__copy { transition: transform 0.6s var(--ease); }
  .ah__eb { opacity: 0; animation: ahFade 0.9s var(--ease) 0.15s both; }
  .ah__h { perspective: 900px; margin-top: var(--s4); font-weight: 700; font-size: var(--hero); line-height: var(--hero-lh); letter-spacing: var(--hero-tr); --brush-size: 1.15; }
  .ah__l { display: block; overflow: hidden; padding-bottom: 0.08em; }
  .ah__l > span { display: block; transform-origin: 50% 100%; transform: translateY(70%) rotateX(-70deg); opacity: 0; animation: ahUp 1.2s var(--ease) both; }
  .ah__l:nth-child(1) > span { animation-delay: 0.2s; }
  .ah__l:nth-child(2) > span { animation-delay: 0.34s; }
  @keyframes ahUp { to { transform: none; opacity: 1; } }
  @keyframes ahFade { to { opacity: 1; } }
  .ah__p { margin-top: var(--s4); max-width: 44ch; font-size: 0.9375rem; line-height: 1.68; color: var(--text-2); opacity: 0; animation: ahFade 1s var(--ease) 0.55s both; }
  .ah__acts { margin-top: 1.8rem; display: flex; flex-wrap: wrap; gap: 1rem 1.4rem; align-items: center; opacity: 0; animation: ahFade 1s var(--ease) 0.7s both; }
  .ah__film { display: inline-flex; align-items: center; gap: 0.8rem; padding: 0; border: 0; background: none; color: var(--text); text-align: left; cursor: pointer; }
  .ah__film span:last-child { display: grid; }
  .ah__film b { font-size: 0.95rem; }
  .ah__film em { font-style: normal; font-size: 0.8rem; color: var(--text-3); }
  .ah__play { position: relative; display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; border: 1px solid rgb(0 0 0 / 0.15); color: var(--green-deep); }
  .ah__play::after { content: ''; position: absolute; inset: -6px; border-radius: 50%; border: 1px solid rgb(89 170 84 / 0.5); animation: ahPing 2.4s var(--ease) infinite; }
  @keyframes ahPing { from { transform: scale(0.8); opacity: 1; } to { transform: scale(1.4); opacity: 0; } }
  .ah__mantra { margin-top: 2rem; font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--text-3); opacity: 0; animation: ahFade 1s var(--ease) 0.9s both; }
  /* rotating phrase: each one rolls up and out as the next rolls in */
  .rot { display: inline-grid; vertical-align: bottom; perspective: 600px; transition: width 0.6s var(--ease); }
  .rot__w { grid-area: 1 / 1; white-space: nowrap; opacity: 0; transform: translateY(55%) rotateX(-65deg); filter: blur(4px);
    transform-origin: 50% 100%; transition: opacity 0.55s var(--ease), transform 0.75s var(--ease), filter 0.55s var(--ease); }
  .rot__w.is-on { opacity: 1; transform: none; filter: none; }
  .rot__w.is-out { opacity: 0; transform: translateY(-55%) rotateX(65deg); filter: blur(4px); transform-origin: 50% 0%; }

  /* the photo fills the right side and melts into the page — no frame */
  .ah__bg { position: absolute; top: 0; right: 0; bottom: 0; width: 58%; z-index: 0; will-change: transform;
    -webkit-mask: linear-gradient(90deg, transparent 0%, #000 38%); mask: linear-gradient(90deg, transparent 0%, #000 38%);
    animation: ahReveal 1.6s var(--ease) 0.1s both; }
  .ah__bg::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 70%, #f8faf8 100%); }
  @keyframes ahReveal { from { opacity: 0; transform: scale(1.06); } to { opacity: 1; transform: none; } }
  .ah__bg :global(img) { width: 100%; height: 112%; object-fit: cover; object-position: 60% 30%; }

  /* ───── view switch ───── */
  .av { position: relative; z-index: 20; display: flex; justify-content: center; margin-top: -1.9rem; pointer-events: none; }
  .av__bar { position: relative; display: inline-flex; padding: 6px; border-radius: 999px; pointer-events: auto;
    background: rgb(255 255 255 / 0.82); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgb(0 0 0 / 0.08); box-shadow: 0 18px 40px -22px rgb(20 40 25 / 0.45); }
  .av__pill { position: absolute; top: 6px; bottom: 6px; left: 0; width: 0; border-radius: 999px; background: var(--green-deep);
    box-shadow: 0 8px 20px -10px rgb(20 60 25 / 0.6); transition: transform 0.5s var(--ease), width 0.5s var(--ease); }
  .av__tab { position: relative; z-index: 1; padding: 0.8rem 1.6rem; border: 0; border-radius: 999px; background: none; cursor: pointer;
    font-weight: 700; font-size: 1rem; letter-spacing: -0.01em; color: var(--text-2); transition: color 0.3s; }
  .av__tab[aria-selected='true'] { color: #fff; }
  .av__view.is-on { animation: avIn 0.6s var(--ease) both; }
  @keyframes avIn { from { opacity: 0; transform: translateY(18px); } }

  /* ───── 02 figures ───── */
  .af { background: #fff; padding-block: clamp(3.5rem, 7vw, 6rem); }
  .af__grid { display: grid; grid-template-columns: 1.3fr 1fr 1fr; grid-template-rows: auto auto; gap: 1rem; margin: 0; perspective: 1200px; }
  .af__c { position: relative; display: grid; align-content: end; gap: 0.2rem; min-height: 11rem; padding: 1.6rem 1.6rem 1.4rem; border-radius: 24px; overflow: hidden;
    background: var(--off); border: 1px solid rgb(0 0 0 / 0.06); transform-style: preserve-3d;
    transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg)); transition: transform 0.5s var(--ease), box-shadow 0.5s var(--ease); }
  .af__c:hover { box-shadow: 0 30px 60px -30px rgb(20 40 25 / 0.35); }
  .af__c { --tint: var(--p-mint); --pink: var(--p-mint-ink); background: #fff !important; border-color: rgb(0 0 0 / 0.06) !important; box-shadow: inset 0 3px 0 var(--tint); }
  .af__c--0 { grid-row: span 2; --tint: var(--p-mint); --pink: var(--p-mint-ink); }
  .af__c--1 { --tint: var(--p-blush); --pink: var(--p-blush-ink); }
  .af__c--2 { --tint: var(--p-sky); --pink: var(--p-sky-ink); }
  .af__c--3 { --tint: var(--p-butter); --pink: var(--p-butter-ink); }
  .af__c .af__i { background: var(--tint) !important; color: var(--pink) !important; }
  .af__c--0 dt { color: var(--green-deep); }
  .af__c--3 { grid-column: span 2; }
  .af__glow { position: absolute; inset: 0; pointer-events: none; opacity: 0; transition: opacity 0.3s;
    background: radial-gradient(260px circle at var(--mx, 50%) var(--my, 50%), rgb(89 170 84 / 0.22), transparent 70%); }
  .af__c:hover .af__glow { opacity: 1; }
  .af__i { position: absolute; top: 1.3rem; left: 1.4rem; display: grid; place-items: center; width: 42px; height: 42px; border-radius: 12px;
    background: rgb(89 170 84 / 0.14); color: var(--green-deep); transform: translateZ(30px); }
  .af__c--0 .af__i { background: rgb(89 170 84 / 0.14); color: var(--green-deep); }
  .af__c dt { font-size: var(--d4); font-weight: 700; letter-spacing: var(--tr4); line-height: 1; transform: translateZ(45px); }
  .af__c--0 dt { font-size: var(--d3); color: var(--green-deep); }
  .af__c dd { margin: 0.5rem 0 0; font-weight: 700; transform: translateZ(25px); }
  .af__c small { color: var(--text-3); font-size: 0.82rem; transform: translateZ(18px); }
  

  /* ───── 03 journey ───── */
  .aj { background: #fff; padding-block: clamp(5rem, 10vw, 8rem); }
  .aj__intro { max-width: 44rem; margin: 0 auto clamp(3rem, 6vw, 4.5rem); text-align: center; display: grid; justify-items: center; }
  .aj__h { margin-top: var(--s4); font-size: var(--d5); font-weight: 700; letter-spacing: var(--tr5); line-height: 1.1; }
  .aj__p { margin-top: var(--s4); max-width: 52ch; font-size: 0.9375rem; line-height: 1.68; color: var(--text-2); }
  /* one line across, four stops; the line draws itself and each stop pops in as it arrives */
  .aj__line { position: relative; list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.4rem; }
  .aj__rail { position: absolute; left: 12.5%; right: 12.5%; top: 29px; height: 2px; background: rgb(0 0 0 / 0.08); border-radius: 2px; }
  .aj__rail i { display: block; height: 100%; width: 100%; border-radius: 2px; transform-origin: left; transform: scaleX(0);
    background: linear-gradient(90deg, #1f8a4c, #2d6fd0, #14878a, #6f52c9); transition: transform 1.6s cubic-bezier(0.6, 0, 0.2, 1) 0.2s; }
  .aj__line.is-in .aj__rail i { transform: scaleX(1); }
  .aj__m { --c: #1f8a4c; --t: #e3f3e6; position: relative; display: grid; justify-items: center; text-align: center; gap: 0.35rem; padding: 0 0.4rem;
    opacity: 0; transform: translateY(18px); transition: opacity 0.6s var(--ease), transform 0.7s var(--ease); transition-delay: calc(0.3s + var(--i) * 0.35s); }
  .aj__m:nth-child(3) { --c: #2d6fd0; --t: #e4edfa; }
  .aj__m:nth-child(4) { --c: #14878a; --t: #dff2f1; }
  .aj__m:nth-child(5) { --c: #6f52c9; --t: #efe8f8; }
  .aj__line.is-in .aj__m { opacity: 1; transform: none; }
  .aj__dot { display: grid; place-items: center; width: 60px; height: 60px; border-radius: 50%; background: var(--t); color: var(--c);
    box-shadow: 0 0 0 6px #fff, 0 12px 26px -14px var(--c); transform: scale(0.4); transition: transform 0.6s cubic-bezier(0.3, 1.6, 0.5, 1); transition-delay: calc(0.35s + var(--i) * 0.35s); }
  .aj__line.is-in .aj__dot { transform: none; }
  .aj__m:hover .aj__dot { transform: translateY(-4px) scale(1.05); transition-delay: 0s; }
  /* a light that runs along the finished line, over and over */
  .aj__spark { position: absolute; top: 50%; left: 0; width: 70px; height: 6px; margin-top: -3px; border-radius: 6px; opacity: 0;
    background: radial-gradient(closest-side, #fff, rgb(255 255 255 / 0)); box-shadow: 0 0 14px 4px rgb(89 170 84 / 0.55); }
  .aj__line.is-run .aj__spark { animation: ajSpark 3.2s cubic-bezier(0.45, 0, 0.55, 1) infinite; }
  @keyframes ajSpark { 0% { left: -4%; opacity: 0; } 10% { opacity: 1; } 90% { opacity: 1; } 100% { left: 96%; opacity: 0; } }
  /* the stop that is "current" gets a pulse ring and lifts a little */
  .aj__dot { position: relative; }
  .aj__dot::before, .aj__dot::after { content: ''; position: absolute; inset: -8px; border-radius: 50%; pointer-events: none; }
  .aj__dot::before { border: 2px solid var(--c); opacity: 0; }
  .aj__m.is-cur .aj__dot::before { animation: ajPulse 1.6s ease-out infinite; }
  @keyframes ajPulse { 0% { transform: scale(0.85); opacity: 0.8; } 100% { transform: scale(1.45); opacity: 0; } }
  .aj__dot::after { inset: -6px; border: 1.5px dashed color-mix(in oklab, var(--c) 55%, transparent); opacity: 0; transition: opacity 0.3s; }
  .aj__m:hover .aj__dot::after, .aj__m.is-cur .aj__dot::after { opacity: 1; animation: ajSpin 8s linear infinite; }
  @keyframes ajSpin { to { transform: rotate(360deg); } }
  .aj__line.is-in .aj__m.is-cur .aj__dot { transform: scale(1.1); background: var(--c); color: #fff; transition-delay: 0s; }
  .aj__m.is-cur .aj__yr { transform: translateY(-3px); }
  .aj__yr { transition: transform 0.4s var(--ease); font-variant-numeric: tabular-nums; }
  .aj__m::after { content: ''; display: block; width: 0; height: 2px; margin-top: 0.3rem; border-radius: 2px; background: var(--c); transition: width 0.5s var(--ease); }
  .aj__m.is-cur::after, .aj__m:hover::after { width: 36px; }
  .aj__yr { margin-top: 0.8rem; font-size: var(--d6); font-weight: 700; letter-spacing: var(--tr6); color: var(--c); }
  .aj__t { max-width: 24ch; font-size: 0.9rem; line-height: 1.55; color: var(--text-2); }

  /* ───── 05 difference ───── */
  .ad { background: radial-gradient(50% 60% at 90% 20%, rgb(239 232 248 / 0.7), transparent 70%), #fbfbfd; color: var(--text); padding-block: clamp(5rem, 10vw, 8rem); overflow: hidden; }
  .ad__in { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(2rem, 5vw, 5rem); align-items: center; }
  /* the photo opens out from a smaller frame as it arrives */
  .ad__shot { margin: 0; aspect-ratio: 4 / 5; border-radius: 28px; overflow: hidden; box-shadow: 0 40px 80px -50px rgb(20 40 25 / 0.45);
    clip-path: inset(var(--ci, 10%) round 28px); will-change: clip-path; }
  .ad__shot :global(img) { width: 100%; height: 100%; object-fit: cover; transform: scale(var(--cs, 1.12)); }
  .ad__copy { display: grid; justify-items: start; }
  .ad__h { margin-top: var(--s4); font-size: var(--d5); font-weight: 700; letter-spacing: var(--tr5); line-height: 1.1; --brush-size: 1.15; }
  .ad__p { margin-top: var(--s4); max-width: 46ch; font-size: 0.9375rem; line-height: 1.68; color: var(--text-2); }
  .ad__proof { list-style: none; margin: 1.6rem 0 1.8rem; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .ad__proof li { display: inline-flex; align-items: center; gap: 0.45rem; padding: 0.5rem 0.9rem; border-radius: 999px; background: #fff; border: 1px solid rgb(0 0 0 / 0.08); font-size: 0.85rem; }
  .ad__proof span { color: var(--green-deep); display: grid; }
  .ad__proof li { border-color: transparent; }
  .ad__proof li:nth-child(1) { background: var(--p-mint); } .ad__proof li:nth-child(1) span { color: var(--p-mint-ink); }
  .ad__proof li:nth-child(2) { background: var(--p-butter); } .ad__proof li:nth-child(2) span { color: var(--p-butter-ink); }
  .ad__proof li:nth-child(3) { background: var(--p-blush); } .ad__proof li:nth-child(3) span { color: var(--p-blush-ink); }
  .ad__proof li:nth-child(4) { background: #fff; } .ad__proof li:nth-child(4) span { color: var(--p-sky-ink); }

  /* ───── 06 presence ───── */
  .pr {
    background: linear-gradient(185deg, #fafcfa, #f1f8f1 62%, #eef6ee);
  }
  .pr__grid { display: grid; gap: clamp(1.75rem, 4vw, 2.75rem); align-items: center; }
  .pr__intro { display: grid; justify-items: start; }
  .pr__h {
    margin-top: var(--s4); font-size: var(--d5);
    font-weight: 700; letter-spacing: var(--tr5); line-height: 1.08;
  }
  .pr__h em { font-style: normal; color: var(--green-deep); }
  .pr__p {
    margin-top: var(--s4); max-width: 34ch;
    font-size: 0.875rem; line-height: 1.62; color: var(--text-2);
  }

  .pr__map { position: relative; width: 100%; max-width: 16rem; justify-self: center; }
  .pr__map svg { display: block; width: 100%; height: auto; overflow: visible; }
  /* Decorative, aria-hidden — but 3.0:1 so it is a watermark, not invisible. */
  .pr__wm { fill: #72906f; font-size: 74px; font-weight: 600; letter-spacing: 12px; }

  .pr__land { opacity: 0; transition: opacity 760ms var(--ease) 100ms; }
  .pr__map[data-in] .pr__land { opacity: 1; }
  .pr__pin {
    --pd: calc(700ms + var(--i) * 130ms);
    opacity: 0; scale: 0.3;
    transform-box: fill-box; transform-origin: bottom center;
    transition: opacity 320ms var(--ease) var(--pd),
      scale 540ms cubic-bezier(0.3, 1.6, 0.5, 1) var(--pd);
  }
  .pr__map[data-in] .pr__pin { opacity: 1; scale: 1; }
  .pr__chip {
    position: absolute; top: calc(var(--y) + var(--dy, 0%)); left: var(--x);
    translate: 1.2rem -145%;
    padding: 0.2rem 0.55rem; border-radius: 999px; background: #fff;
    box-shadow: 0 6px 16px -9px rgb(10 30 12 / 0.5);
    font-size: 0.6875rem; font-weight: 600; white-space: nowrap; color: var(--text);
    opacity: 0;
    transition: opacity 320ms var(--ease) calc(860ms + var(--i) * 130ms),
      color var(--t2) var(--ease), background-color var(--t2) var(--ease);
  }
  .pr__map[data-in] .pr__chip { opacity: 1; }
  .pr__chip:hover { background: var(--green-deep); color: #fff; }

  .pr__list { display: grid; gap: 0.6rem; }
  .br {
    display: flex; align-items: center; gap: 0.85rem;
    padding: 0.65rem 0.9rem 0.65rem 0.65rem; border-radius: 14px;
    background: rgb(255 255 255 / 0.86); backdrop-filter: blur(8px);
    box-shadow: 0 1px 2px rgb(10 30 12 / 0.04), 0 10px 26px -20px rgb(10 30 12 / 0.28);
    transition: transform var(--t2) var(--ease), box-shadow var(--t2) var(--ease);
  }
  .br:hover {
    transform: translateX(4px);
    box-shadow: 0 1px 2px rgb(10 30 12 / 0.04), 0 20px 38px -24px rgb(10 30 12 / 0.34);
  }
  /* Held frame — branch photography still to come. */
  .br__shot {
    display: grid; place-items: center; width: 56px; height: 44px; flex: none;
    border: 1px dashed var(--line-light); border-radius: 10px;
    background: var(--off);
  }
  .br__shot i {
    font-style: normal; font-family: var(--font-mono); font-size: 0.5rem;
    letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-3);
  }
  .br__t { display: grid; min-width: 0; }
  .br__t b { font-size: 0.9375rem; font-weight: 700; letter-spacing: -0.02em; }
  .br__t em { margin-top: 0.1rem; font-style: normal; font-size: 0.75rem; color: var(--text-3); }
  .br__go {
    display: grid; place-items: center; width: 28px; height: 28px; flex: none;
    margin-left: auto; border-radius: 50%; color: var(--green-deep);
    transition: transform var(--t2) var(--ease);
  }
  .br:hover .br__go { transform: translateX(3px); }


  /* ───── 05b team (draft) ───── */
  .at { background: var(--white); padding-block: clamp(5rem, 10vw, 8rem); }
  .at__head { display: flex; justify-content: space-between; align-items: end; gap: 2rem; flex-wrap: wrap; margin-bottom: 2.5rem; }
  .at__h { margin-top: var(--s4); font-size: var(--d5); font-weight: 700; letter-spacing: var(--tr5); line-height: 1.1; }
  .at__h em { font-style: normal; color: var(--green-deep); }
  .at__p { max-width: 34ch; color: var(--text-2); line-height: 1.6; }
  .at__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; perspective: 1200px; }
  .at__card { position: relative; border-radius: 22px; overflow: hidden; background: var(--off); border: 1px solid rgb(0 0 0 / 0.06);
    transform-style: preserve-3d; transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg)); transition: transform 0.5s var(--ease), box-shadow 0.5s var(--ease); }
  .at__card:hover { box-shadow: 0 30px 60px -30px rgb(20 40 25 / 0.35); }
  .at__img { margin: 0; aspect-ratio: 4 / 5; overflow: hidden; }
  .at__img :global(img) { width: 100%; height: 100%; object-fit: cover; filter: grayscale(0.35); transition: filter 0.5s, transform 0.8s var(--ease); }
  .at__card:hover .at__img :global(img) { filter: none; transform: scale(1.05); }
  .at__meta { display: grid; gap: 0.2rem; padding: 1rem 1.1rem 1.2rem; transform: translateZ(30px); }
  .at__role { font-size: 1.1rem; font-weight: 700; letter-spacing: -0.02em; color: var(--green-deep); }
  .at__meta small { color: var(--text-2); font-size: 0.82rem; line-height: 1.45; }

  /* ───── 05c trusted by ───── */
  .aq { background: #fff; padding-block: clamp(5rem, 10vw, 8rem); overflow: hidden; }
  .aq__head { text-align: center; display: grid; justify-items: center; }
  .aq__h { margin-top: var(--s4); font-size: var(--d5); font-weight: 700; letter-spacing: var(--tr5); line-height: 1.1; }
  .aq__h em { font-style: normal; color: var(--green-deep); }
  /* brands glide past in one endless row, fading out at both edges */
  .aq__mq { margin: 2.6rem 0 3.4rem; -webkit-mask: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent); mask: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent); }
  .aq__track { display: flex; width: max-content; animation: aqMq 40s linear infinite; }
  .aq__mq:hover .aq__track { animation-play-state: paused; }
  .aq__track ul { display: flex; list-style: none; margin: 0; padding: 0; }
  .aq__track li { padding: 0.9rem 2.2rem; font-weight: 700; font-size: var(--d7); letter-spacing: var(--tr7); color: rgb(0 0 0 / 0.32); transition: color 0.3s; white-space: nowrap; }
  .aq__track li:hover { color: var(--green-deep); }
  @keyframes aqMq { to { transform: translateX(-50%); } }
  /* the wall: three columns of reviews drifting upward at different speeds */
  .aq__wall { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; height: 34rem; overflow: hidden;
    -webkit-mask: linear-gradient(180deg, transparent, #000 14%, #000 86%, transparent); mask: linear-gradient(180deg, transparent, #000 14%, #000 86%, transparent); }
  .aq__run { display: grid; gap: 1rem; animation: aqUp var(--dur, 40s) linear infinite; }
  .aq__col:nth-child(2) .aq__run { animation-direction: reverse; }
  .aq__wall:hover .aq__run { animation-play-state: paused; }
  @keyframes aqUp { to { transform: translateY(calc(-50% - 0.5rem)); } }
  .aq__q { margin: 0; display: grid; gap: 0.8rem; padding: 1.4rem; border-radius: 20px; background: var(--white); border: 1px solid rgb(0 0 0 / 0.06);
    box-shadow: 0 20px 40px -32px rgb(20 40 25 / 0.35); transition: transform 0.4s var(--ease), box-shadow 0.4s var(--ease); }
  .aq__q:hover { transform: translateY(-3px); box-shadow: 0 26px 50px -30px rgb(20 40 25 / 0.45); }
  .aq__q { position: relative; margin-top: 1.4rem; }
  .aq__mark { position: absolute; top: -1.55rem; left: 1rem; font-family: Georgia, serif; font-size: 4.2rem; line-height: 1; font-weight: 700; color: var(--green); }
  .aq__col .aq__run > :nth-child(3n+2) .aq__mark { color: #e8a33d; }
  .aq__col .aq__run > :nth-child(3n) .aq__mark { color: #6aa9d8; }
  .aq__top { display: flex; align-items: center; gap: 0.75rem; }
  .aq__av { display: grid; place-items: center; width: 42px; height: 42px; flex: none; border-radius: 50%; background: var(--p-mint); color: var(--p-mint-ink); font-weight: 700; }
  .aq__col:nth-child(2) .aq__av { background: var(--p-sky); color: var(--p-sky-ink); }
  .aq__col:nth-child(3) .aq__av { background: var(--p-blush); color: var(--p-blush-ink); }
  .aq__who { display: grid; min-width: 0; }
  .aq__who b { font-size: 0.95rem; }
  .aq__who small { color: var(--text-3); font-size: 0.78rem; }
  .aq__g { margin-left: auto; display: grid; place-items: center; width: 26px; height: 26px; border-radius: 50%; border: 1px solid rgb(0 0 0 / 0.1); font-weight: 700; font-size: 0.8rem; color: #4285f4; }
  .aq__stars { color: #f5b400; letter-spacing: 0.12em; font-size: 0.85rem; }
  .aq__q blockquote { margin: 0; font-size: 0.95rem; line-height: 1.6; color: var(--text-3); }
  .aq__draft { margin-top: 1.2rem; text-align: center; font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.08em; color: #b26a00; }
  @media (max-width: 56rem) {
    .aq__wall { grid-template-columns: 1fr; height: auto; -webkit-mask: none; mask: none; }
    .aq__col:not(:first-child) { display: none; }
    .aq__run { animation: none; }
    .aq__run > [aria-hidden='true'] { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .aq__track, .aq__run { animation: none; }
    .aq__wall { height: auto; -webkit-mask: none; mask: none; }
  }

  /* ───── 07 cta ───── */
  .ac { background: var(--white); padding-block: clamp(4rem, 8vw, 6rem); }
  .ac__panel { display: grid; justify-items: center; text-align: center; padding: clamp(3rem, 7vw, 5rem) 1.5rem; border-radius: 32px;
    background: linear-gradient(120deg, rgb(227 243 230 / 0.7) 0%, #fbfcfb 50%, rgb(228 237 250 / 0.7) 100%); border: 1px solid rgb(0 0 0 / 0.05); }
  .ac__h { margin-top: var(--s4); font-size: var(--d5); font-weight: 700; letter-spacing: var(--tr5); line-height: 1.1; --brush-size: 1.15; }
  .ac__p { margin-top: var(--s3); color: var(--text-2); font-size: 0.9375rem; }
  .ac__b { display: inline-flex; align-items: center; gap: 0.7rem; margin-top: 1.8rem; padding: 1rem 1.7rem; border-radius: 999px; background: var(--green-deep); color: #fff; font-weight: 700; transition: background 0.25s, transform 0.3s; }
  .ac__b:hover { background: var(--green); }

  /* ───── responsive ───── */
  @media (min-width: 62rem) {
    .pr__grid { grid-template-columns: minmax(0, 0.85fr) minmax(0, 0.7fr) minmax(0, 1.1fr); }
  }
  @media (max-width: 56rem) {
    .aj__line { grid-template-columns: 1fr; gap: 2rem; padding-left: 0; }
    .aj__rail { left: 29px; right: auto; top: 30px; bottom: 30px; width: 2px; height: auto; }
    .aj__rail i { transform-origin: top; transform: scaleY(0); }
    .aj__line.is-in .aj__rail i { transform: scaleY(1); }
    .aj__m { grid-template-columns: 60px 1fr; justify-items: start; text-align: left; column-gap: 1rem; }
    .aj__dot { grid-row: span 2; }
    .aj__yr { margin-top: 0.4rem; }
    .ah__in, .ad__in { grid-template-columns: 1fr; }
      .af__c--0 { grid-row: auto; grid-column: span 2; }
    .af__c--3 { grid-column: span 2; }
    .ac__in { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ah__bg, .ah__l > span, .ah__eb, .ah__p, .ah__acts, .ah__mantra, .ah__play::after{ animation: none; opacity: 1; transform: none; clip-path: none; }
    .aj__m, .aj__dot, .aj__rail i { opacity: 1; transform: none; transition: none; }
    .aj__spark { display: none; }
    .av__view.is-on { animation: none; }
    .av__pill { transition: none; }
    .af__c { transform: none; }
    .ad__shot { clip-path: none; }
    .pr__map :is(.pr__land, .pr__pin, .pr__chip) { opacity: 1; scale: 1; transition: none; }
    .btn, .btn:hover, .br, .br:hover { transform: none; transition: none; }
  }
</style>

<script>
  function start() {
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const hero = document.querySelector<HTMLElement>('[data-ah]');
    if (!hero || hero.dataset.wired) return;
    hero.dataset.wired = '1';
    const header = document.querySelector('header');
    if (header) document.documentElement.style.setProperty('--hdr', `${header.offsetHeight}px`);
    /* Who we are / Meet our team */
    const av = document.querySelector<HTMLElement>('[data-av]');
    if (av) {
      const tabs = [...av.querySelectorAll<HTMLButtonElement>('[data-av-tab]')];
      const pill = av.querySelector<HTMLElement>('[data-av-pill]')!;
      const place = (t: HTMLElement) => { pill.style.width = `${t.offsetWidth}px`; pill.style.transform = `translateX(${t.offsetLeft - 6}px)`; };
      const show = (key: string, scroll: boolean) => {
        const t = tabs.find((x) => x.dataset.avTab === key) ?? tabs[0];
        tabs.forEach((x) => { const on = x === t; x.setAttribute('aria-selected', String(on)); x.tabIndex = on ? 0 : -1; });
        document.querySelectorAll<HTMLElement>('[data-av-view]').forEach((v) => {
          const on = v.dataset.avView === t.dataset.avTab;
          v.hidden = !on; v.classList.remove('is-on'); if (on) { void v.offsetWidth; v.classList.add('is-on'); }
        });
        place(t);
        history.replaceState(null, '', t.dataset.avTab === 'team' ? '#team' : location.pathname);
        if (scroll) {
          const y = av.getBoundingClientRect().top + scrollY - (header?.offsetHeight ?? 0) - 12;
          const l = (window as any).__lenis; l ? l.scrollTo(y, { duration: 0.8 }) : scrollTo({ top: y, behavior: 'smooth' });
        }
        dispatchEvent(new Event('resize'));
      };
      tabs.forEach((t, i) => {
        t.addEventListener('click', () => show(t.dataset.avTab!, true));
        t.addEventListener('keydown', (e) => {
          const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
          if (!d) return; const n = tabs[(i + d + tabs.length) % tabs.length]; n.focus(); show(n.dataset.avTab!, false);
        });
      });
      requestAnimationFrame(() => show(location.hash === '#team' ? 'team' : 'who', false));
      addEventListener('resize', () => place(tabs.find((t) => t.getAttribute('aria-selected') === 'true')!));
    }

    /* hero: rotate the handwritten phrase */
    const rot = document.querySelector<HTMLElement>('[data-rot]');
    if (rot && !reduced) {
      const ws = [...rot.querySelectorAll<HTMLElement>('.rot__w')];
      let i = 0;
      const fit = () => { rot.style.width = `${ws[i].scrollWidth}px`; };
      fit(); addEventListener('resize', fit);
      setInterval(() => {
        if (document.hidden || !rot.isConnected) return;
        const cur = ws[i]; i = (i + 1) % ws.length; const nxt = ws[i];
        cur.classList.remove('is-on'); cur.classList.add('is-out');
        nxt.classList.remove('is-out'); nxt.classList.add('is-on');
        setTimeout(() => cur.classList.remove('is-out'), 800);
        fit();
      }, 2800);
    }

    if (reduced) return;

    const bg = hero.querySelector<HTMLElement>('[data-ah-bg]')!;
    const line = document.querySelector<HTMLElement>('[data-aj]');
    if (line) new IntersectionObserver((es, o) => {
      if (!es[0].isIntersecting) return;
      o.disconnect();
      line.classList.add('is-in');
      const stops = [...line.querySelectorAll<HTMLElement>('.aj__m')];
      const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (still) return;
      /* each year counts up (or types itself) as its stop pops in */
      stops.forEach((m, i) => {
        const el = m.querySelector<HTMLElement>('[data-aj-yr]')!;
        const target = el.dataset.ajYr!;
        const n = Number(target);
        el.textContent = Number.isFinite(n) ? String(n - 60) : '';   // start value while the stop is still hidden
        setTimeout(() => {
          if (Number.isFinite(n)) {
            const from = n - 60, t0 = performance.now();
            const step = (t: number) => { const k = Math.min(1, (t - t0) / 900); el.textContent = String(Math.round(from + (n - from) * (1 - Math.pow(1 - k, 3)))); if (k < 1) requestAnimationFrame(step); };
            requestAnimationFrame(step);
          } else {
            el.textContent = ''; let c = 0;
            const iv = setInterval(() => { el.textContent = target.slice(0, ++c); if (c >= target.length) clearInterval(iv); }, 90);
          }
        }, 350 + i * 350);
      });
      /* once all four are in: the light starts running and the "current" stop steps along */
      setTimeout(() => {
        line.classList.add('is-run');
        let cur = 0;
        const mark = () => stops.forEach((m, i) => m.classList.toggle('is-cur', i === cur));
        mark();
        setInterval(() => { if (!document.hidden && line.isConnected) { cur = (cur + 1) % stops.length; mark(); } }, 2400);
      }, 350 + stops.length * 350 + 600);
    }, { threshold: 0.35 }).observe(line);
    const ad = document.querySelector<HTMLElement>('[data-ad]');
    const shot = ad?.querySelector<HTMLElement>('[data-ad-shot]');
    const clamp = (v: number) => Math.min(1, Math.max(0, v));

    let raf = 0;
    const tick = () => {
      raf = 0;
      const H = innerHeight;
      /* hero photo drifts slower than the page */
      const hr = hero.getBoundingClientRect();
      if (hr.bottom > 0) (bg.querySelector('img') as HTMLElement | null)?.style.setProperty('transform', `translate3d(0, ${Math.max(-80, hr.top * 0.18)}px, 0)`);
      /* difference: the framed photo opens out to full width as it arrives */
      if (ad && shot) {
        const r = ad.getBoundingClientRect();
        const p = clamp((H - r.top) / (H * 0.9));
        const e = 1 - Math.pow(1 - p, 3);
        shot.style.setProperty('--ci', `${(1 - e) * 10}%`);
        shot.style.setProperty('--cs', String(1.12 - 0.12 * e));
      }
    };
    const req = () => { if (!raf) raf = requestAnimationFrame(tick); };
    addEventListener('scroll', req, { passive: true });
    addEventListener('resize', req);
    tick();

    const fine = matchMedia('(hover: hover) and (pointer: fine)').matches;
    if (fine) {
      /* figures: each card tilts toward the pointer, with a light under it */
      document.querySelectorAll<HTMLElement>('[data-tilt]').forEach((c) => {
        c.addEventListener('pointermove', (e) => {
          const r = c.getBoundingClientRect(), x = (e.clientX - r.left) / r.width, y = (e.clientY - r.top) / r.height;
          c.style.setProperty('--ry', `${(x - 0.5) * 14}deg`); c.style.setProperty('--rx', `${(0.5 - y) * 12}deg`);
          c.style.setProperty('--mx', `${x * 100}%`); c.style.setProperty('--my', `${y * 100}%`);
        });
        c.addEventListener('pointerleave', () => { c.style.setProperty('--rx', '0deg'); c.style.setProperty('--ry', '0deg'); });
      });
      /* hero: the headline block leans a touch with the pointer */
      const tilt = hero.querySelector<HTMLElement>('[data-ah-tilt]')!;
      hero.addEventListener('pointermove', (e) => {
        const x = e.clientX / innerWidth - 0.5, y = e.clientY / innerHeight - 0.5;
        tilt.style.transform = `perspective(1400px) rotateY(${x * 4}deg) rotateX(${-y * 3}deg)`;
        bg.style.translate = `${-x * 10}px ${-y * 8}px`;
      });
      hero.addEventListener('pointerleave', () => { tilt.style.transform = ''; bg.style.translate = ''; });
    }

    /* the call-to-action button leans toward the pointer */
    document.querySelectorAll<HTMLElement>('[data-mag]').forEach((b) => {
      b.addEventListener('pointermove', (e) => { const r = b.getBoundingClientRect(); b.style.transform = `translate(${(e.clientX - r.left - r.width / 2) * 0.2}px, ${(e.clientY - r.top - r.height / 2) * 0.3}px)`; });
      b.addEventListener('pointerleave', () => (b.style.transform = ''));
    });
  }
  document.addEventListener('astro:page-load', start);
</script>
