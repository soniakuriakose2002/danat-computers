---
import { Image } from 'astro:assets';
import PageLayout from '@layouts/PageLayout.astro';
import Icon from '@components/ui/Icon.astro';
import PurposeOrbit from '@components/sections/PurposeOrbit.astro';
import VideoModal from '@components/global/VideoModal.astro';
import { site, branches } from '@data/site';
import { OMAN_PATH, OMAN_VIEWBOX, OMAN_PINS } from '@data/omanMap';
import imgTech from '@assets/photos/repair-solder.jpg';
import imgFilm from '@assets/photos/film-poster.jpg';
import r01 from '@assets/renders/01.png';
import r03 from '@assets/renders/03.png';
import r04 from '@assets/renders/04.png';
import r05 from '@assets/renders/05.png';

const years = new Date().getFullYear() - site.stats.since;

/**
 * ⚠ THREE ITEMS BELOW ARE NOT VERIFIED — they come from the client's
 * mockup, not from Danat's records, and the client has asked for the
 * mockup reproduced exactly. Confirm all three before this site goes
 * public:
 *   1. "1000+ happy customers" — no source of any kind.
 *   2. The 2010 and 2016 milestone years — invented by the mockup.
 *      Only 2003 is real (earliest record in the ERP export).
 *   3. The milestone descriptions attached to those two years.
 * Everything else on this page traces to site.ts or the ERP export.
 */
const figures = [
  { icon: 'calendar', v: years, suffix: '+', l: 'Years in business', sub: `Since ${site.stats.since}` },
  { icon: 'building', v: site.stats.branches, suffix: '', l: 'Branches in Oman', sub: branches.map((b) => b.city.split(',')[0]).join(', ') },
  { icon: 'box', v: site.stats.parts, suffix: '', l: 'Products in stock', sub: `Across ${site.stats.categories} categories` },
  { icon: 'users', v: 1000, suffix: '+', l: 'Happy customers', sub: 'Individuals & businesses', unverified: true },
];

const journey = [
  { year: '2003', t: 'Opened our first store in Ruwi, Muscat.', verified: true },
  { year: '2010', t: 'Expanded our product range and IT solutions.', verified: false },
  { year: '2016', t: 'Grew across Oman with new branches in Sohar, Al Hail and Salalah.', verified: false },
  { year: 'Today', t: 'Continuing to support individuals, businesses and organisations.', verified: true },
];

const proof = [
  { icon: 'chip', t: 'Board level repair' },
  { icon: 'wrench', t: 'Genuine spares' },
  { icon: 'users', t: 'Experienced team' },
  { icon: 'bolt', t: 'Faster turnaround' },
];

const mapOrder = ['sohar', 'hail', 'ruwi', 'salalah'];
const mapList = mapOrder.map((s) => branches.find((b) => b.slug === s)!);
const W = 1000;
const H = 1342;
const nudge: Record<string, string> = { sohar: '0%', hail: '-3.4%', ruwi: '2.8%', salalah: '0%' };

/** The exploded hero, layered from the teardown renders we already have. */
const layers = [r01, r03, r04, r05];
---

<PageLayout
  title="About"
  description={`${site.nameFull} has supplied and repaired computers across Oman since ${site.stats.since} — four branches, ${site.stats.parts.toLocaleString('en-US')} lines in stock, board-level repair.`}
>
  {/* ══════ 01 · hero ══════ */}
  <section class="hero">
    <span class="hero__wash" aria-hidden="true"></span>

    <div class="shell hero__grid">
      <div class="hero__copy">
        <p class="eb" data-rise><i class="eb__r" aria-hidden="true"></i>About Danat</p>

        <h1 class="hero__h" data-rise style="--d:70ms">
          Technology<br />That Keeps<br /><em>Oman Moving.</em>
        </h1>

        <p class="hero__p" data-rise style="--d:130ms">
          For over two decades, Danat Computers has been a trusted name in
          computer products, services and business solutions across Oman. We
          don't just sell technology — we keep it running.
        </p>

        <div class="hero__acts" data-rise style="--d:200ms">
          <a class="btn" href="#journey">
            Our story
            <span class="btn__i" aria-hidden="true"><Icon name="arrow" size={15} /></span>
          </a>
          {/* The actual opening frame of the company's film, cropped clear
              of the thumbnail's overlay bars. A real frame says what the
              film is; a ring of text only says that one exists. */}
          <button class="film" type="button" data-video-open
            aria-label="Watch the film: inside Danat Computers">
            <span class="film__shot">
              <Image src={imgFilm} alt="" widths={[220, 360]} sizes="180px"
                quality={78} format="webp" loading="lazy" />
              <span class="film__play" aria-hidden="true">
                <Icon name="play" size={13} />
              </span>
            </span>
            <span class="film__t">
              <b>Watch the film</b>
              <em>Inside Danat Computers</em>
            </span>
          </button>
        </div>

        <p class="hero__mantra" data-rise style="--d:260ms">
          <i class="eb__r" aria-hidden="true"></i>
          People <b>·</b> Products <b>·</b> Support <b>·</b> A brighter tomorrow
        </p>
      </div>

      <div class="hero__media" data-rise style="--d:160ms">
        {/* Exploded from the teardown renders rather than a flat photo. */}
        <div class="explode">
          {layers.map((l, i) => (
            <figure class="explode__l" style={`--i:${i}`}>
              <Image src={l} alt="" widths={[380, 560]} sizes="(min-width:62rem) 34vw, 78vw"
                quality={80} format="webp" loading={i === 0 ? 'eager' : 'lazy'} />
            </figure>
          ))}
        </div>

        <p class="hero__script" aria-hidden="true">
          From Products<br />to Lifelong<br />Support
          <svg viewBox="0 0 80 64" fill="none">
            <path d="M66 6C72 24 60 44 36 52" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" />
            <path d="M46 48 35 53l8 9" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </p>

        <p class="hero__trust">
          <i aria-hidden="true"><Icon name="users" size={17} /></i>
          <span>Trusted by<b>1000+ customers</b>across Oman</span>
        </p>
      </div>
    </div>

    <ol class="hero__rail" aria-hidden="true">
      {['01', '02', '03', '04', '05', '06'].map((n, i) => (
        <li data-on={i === 0 ? '' : undefined}>{n}</li>
      ))}
    </ol>
  </section>

  {/* ══════ 02 · figures ══════ */}
  <section class="fig">
    <div class="shell fig__grid">
      <dl class="fig__cards">
        {figures.map((f, i) => (
          <div class="fc" data-rise style={`--d:${i * 70}ms`}>
            <span class="fc__i" aria-hidden="true"><Icon name={f.icon} size={19} /></span>
            <dt><span data-count={f.v}>0</span>{f.suffix}</dt>
            <dd>{f.l}</dd>
            <small>{f.sub}</small>
          </div>
        ))}
      </dl>
      <p class="fig__script" aria-hidden="true">Same<br />Commitment<br />Bigger<br />Possibilities</p>
    </div>
  </section>

  {/* ══════ 03 · journey ══════ */}
  <section class="jr section" id="journey">
    <span class="jr__wash" aria-hidden="true"></span>
    <div class="shell jr__grid">
      <div class="jr__intro" data-rise>
        <p class="eb eb--clay"><i class="eb__r" aria-hidden="true"></i>Our journey</p>
        <h2 class="jr__h">From a small shop<br />to a <em>trusted partner.</em></h2>
        <p class="jr__p">
          What started as a single counter has grown into a company with four
          branches, serving thousands of customers across Oman. Our focus has
          always been the same — genuine products, expert service and
          long-term relationships.
        </p>
        <a class="ghost" href="/branches">
          Our journey<span aria-hidden="true"><Icon name="arrow" size={14} /></span>
        </a>
      </div>

      <ol class="jr__line">
        {journey.map((j, i) => (
          <li data-rise style={`--d:${i * 90}ms`}>
            <span class="jr__dot" aria-hidden="true"></span>
            <b class="jr__yr">{j.year}</b>
            <p class="jr__t">{j.t}</p>
            {/* Shopfront photography has not been supplied — frame held. */}
            <span class="jr__shot">
              <i>Photo to follow</i>
            </span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* ══════ 04 · our purpose ══════ */}
  <PurposeOrbit />

  {/* ══════ 05 · the difference ══════ */}
  <section class="df" data-tone="ink">
    <figure class="df__shot">
      <Image src={imgTech} alt="A Danat technician tracing a fault on a mainboard"
        widths={[700, 1100, 1500]} sizes="(min-width:62rem) 46vw, 100vw"
        quality={74} format="webp" loading="lazy" />
      <figcaption>
        <i aria-hidden="true"><Icon name="users" size={16} /></i>
        <span>Expert technicians<b>Care about the details</b></span>
      </figcaption>
    </figure>

    <div class="df__panel">
      <div class="df__copy">
        <p class="eb eb--inv" data-rise><i class="eb__r" aria-hidden="true"></i>The difference</p>
        <h2 class="df__h" data-rise style="--d:70ms">
          Most shops replace<br />the board. <em>We repair it.</em>
        </h2>
        <p class="df__p" data-rise style="--d:130ms">
          A replacement mainboard is often most of the value of the machine. A
          failed component on it is usually worth a fraction of that. Tracing
          the fault to the component takes a bench, a meter and someone who
          knows what they are looking at — which is what {years} years buys
          you, and what almost nobody else in Oman does in-house.
        </p>
        <a class="btn" href="/services" data-rise style="--d:190ms">
          Our repair services
          <span class="btn__i" aria-hidden="true"><Icon name="arrow" size={15} /></span>
        </a>
      </div>

      <ul class="df__proof">
        {proof.map((p, i) => (
          <li data-rise style={`--d:${i * 70}ms`}>
            <span aria-hidden="true"><Icon name={p.icon} size={17} /></span>{p.t}
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* ══════ 06 · presence ══════ */}
  <section class="pr section">
    <div class="shell pr__grid">
      <div class="pr__intro" data-rise>
        <p class="eb"><i class="eb__r" aria-hidden="true"></i>Our presence</p>
        <h2 class="pr__h">Four branches,<br /><em>one standard.</em></h2>
        <p class="pr__p">
          No matter which branch you visit, you get the same diagnosis, the
          same stock, and the same team. A branch is not a lesser version of
          the shop.
        </p>
        <a class="ghost" href="/branches">
          View all branches<span aria-hidden="true"><Icon name="arrow" size={14} /></span>
        </a>
      </div>

      <div class="pr__map" data-rise style="--d:90ms">
        <svg viewBox={OMAN_VIEWBOX} width="280" height="376" role="img"
          aria-label="Map of Oman showing Danat branches in Sohar, Al Hail, Ruwi and Salalah">
          <path class="pr__land" d={OMAN_PATH} fill="#e4efe3" />
          <text class="pr__wm" x="420" y="900" aria-hidden="true">OMAN</text>
          {mapList.map((b, i) => (
            <g class="pr__pin" style={`--i:${i}`}
              transform={`translate(${OMAN_PINS[b.slug].x} ${OMAN_PINS[b.slug].y}) scale(1.4)`}>
              <path fill="#2f6429" d="M0,0 C-8,-11 -14,-18 -14,-25 A14,14 0 1 1 14,-25 C14,-18 8,-11 0,0 Z" />
              <circle cx="0" cy="-25" r="5" fill="#ffffff"></circle>
            </g>
          ))}
        </svg>
        {mapList.map((b, i) => (
          <a class="pr__chip" href={`/branches#${b.slug}`}
            style={`--i:${i}; --x:${((OMAN_PINS[b.slug].x / W) * 100).toFixed(2)}%; --y:${((OMAN_PINS[b.slug].y / H) * 100).toFixed(2)}%; --dy:${nudge[b.slug]}`}>
            {b.city.split(',')[0]}
          </a>
        ))}
      </div>

      <ul class="pr__list">
        {branches.map((b, i) => (
          <li data-rise style={`--d:${i * 60}ms`}>
            <a class="br" href={`/branches#${b.slug}`}>
              <span class="br__shot" aria-hidden="true"><i>Photo</i></span>
              <span class="br__t"><b>{b.name}</b><em>{b.city}</em></span>
              <span class="br__go" aria-hidden="true"><Icon name="arrow" size={15} /></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* ══════ 07 · cta ══════ */}
  <section class="cta" data-tone="ink">
    <div class="shell cta__in">
      <div class="cta__copy">
        <p class="eb eb--inv" data-rise><i class="eb__r" aria-hidden="true"></i>Let's build a brighter tomorrow</p>
        <h2 class="cta__h" data-rise style="--d:70ms">Need <em>expert advice</em>?</h2>
        <p class="cta__p" data-rise style="--d:130ms">
          Our team is here to help you find the right solution.
        </p>
        <a class="cta__b" href="/contact" data-rise style="--d:190ms">
          Contact us<Icon name="arrow" size={15} />
        </a>
      </div>
      <figure class="cta__fig" aria-hidden="true">
        <Image src={r01} alt="" widths={[420, 640]} sizes="(min-width:62rem) 34vw, 70vw"
          quality={80} format="webp" loading="lazy" />
      </figure>
      <p class="cta__script" aria-hidden="true">Technology<br />for a Brighter<br />Tomorrow</p>
    </div>
  </section>
  <VideoModal />
</PageLayout>

<style>
  /* ───── shared ───── */
  .eb {
    display: flex; align-items: center; gap: 0.6rem;
    font-family: var(--font-mono); font-size: 0.6875rem;
    letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--green-deep);
  }
  .eb--clay { color: var(--clay-deep); }
  .eb--inv { color: var(--green-bright); }
  .eb__r { width: 26px; height: 1px; flex: none; background: currentColor; opacity: 0.6; }

  .btn {
    position: relative; display: inline-flex; align-items: center;
    align-self: flex-start; gap: 0.7rem;
    padding: 0.5rem 0.5rem 0.5rem 1.4rem;
    border: 0; border-radius: 999px;
    /* white is 8.73:1 on #27551f and 4.90:1 on #3d7f35 — AA across the ramp */
    background: linear-gradient(100deg, #27551f, #3d7f35);
    color: #fff; font-size: 0.9375rem; font-weight: 600;
    overflow: hidden; transition: transform var(--t2) var(--ease);
  }
  .btn:hover { transform: translateY(-2px); }
  .btn__i {
    display: grid; place-items: center; width: 30px; height: 30px; flex: none;
    border-radius: 50%; background: rgb(255 255 255 / 0.2);
    transition: transform var(--t2) var(--ease);
  }
  .btn:hover .btn__i { transform: translateX(3px); }

  .ghost {
    display: inline-flex; align-items: center; align-self: flex-start; gap: 0.6rem;
    margin-top: var(--s5);
    padding: 0.55rem 0.55rem 0.55rem 1.3rem;
    border: 1px solid var(--line-light); border-radius: 999px;
    background: var(--white); font-size: 0.875rem; font-weight: 600;
    transition: border-color var(--t2) var(--ease);
  }
  .ghost:hover { border-color: var(--clay); }
  .ghost span {
    display: grid; place-items: center; width: 26px; height: 26px;
    border-radius: 50%; background: var(--clay-wash); color: var(--clay-deep);
    transition: transform var(--t2) var(--ease);
  }
  .ghost:hover span { transform: translateX(3px); }

  .script,
  .hero__script, .fig__script, .cta__script {
    font-family: var(--font-serif, Georgia, serif);
    font-style: italic; line-height: 1.28; pointer-events: none;
  }

  /* ───── 01 hero ───── */
  .hero {
    position: relative;
    background: linear-gradient(178deg, #fbfdfb, #eef6ee 70%, #f7fbf7);
    padding-block: clamp(6rem, 10vw, 8rem) clamp(2.5rem, 5vw, 4rem);
    overflow: hidden; isolation: isolate;
  }
  .hero__wash {
    position: absolute; z-index: -1; right: -18%; top: -22%;
    width: min(46rem, 58vw); aspect-ratio: 1;
    border-radius: 46% 54% 52% 48% / 54% 46% 54% 46%;
    background: radial-gradient(circle at 38% 34%, color-mix(in oklab, var(--green) 18%, transparent), transparent 66%);
    filter: blur(18px);
  }
  .hero__grid { display: grid; gap: clamp(2rem, 4vw, 3rem); align-items: center; }
  .hero__copy { display: grid; justify-items: start; }

  .hero__h {
    margin-top: var(--s4);
    font-size: clamp(2.2rem, 4.8vw, 3.5rem);
    line-height: 1.04; letter-spacing: -0.045em; font-weight: 700;
  }
  .hero__h em { font-style: normal; color: var(--green-deep); }
  .hero__p {
    margin-top: var(--s4); max-width: 42ch;
    font-size: 0.9375rem; line-height: 1.62; color: var(--text-2);
  }
  .hero__acts {
    display: flex; flex-wrap: wrap; align-items: center;
    gap: var(--s4) var(--s5); margin-top: var(--s5);
  }
  .film {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.4rem 1rem 0.4rem 0.4rem;
    border: 1px solid var(--line-light);
    border-radius: 999px;
    background: rgb(255 255 255 / 0.8);
    backdrop-filter: blur(8px);
    cursor: pointer;
    text-align: left;
    box-shadow: 0 1px 2px rgb(10 30 12 / 0.04), 0 12px 28px -20px rgb(10 30 12 / 0.4);
    transition:
      transform var(--t2) var(--ease),
      border-color var(--t2) var(--ease),
      box-shadow var(--t2) var(--ease);
  }
  .film:hover {
    transform: translateY(-2px);
    border-color: color-mix(in oklab, var(--green) 34%, var(--line-light));
    box-shadow: 0 1px 2px rgb(10 30 12 / 0.04), 0 22px 40px -22px rgb(10 30 12 / 0.42);
  }
  .film:focus-visible { outline: 2px solid var(--green-deep); outline-offset: 3px; }

  .film__shot {
    position: relative;
    display: block;
    width: 74px;
    aspect-ratio: 16 / 10;
    flex: none;
    border-radius: 999px;
    overflow: hidden;
    background: var(--off);
  }
  .film__shot :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 32%;
    transition: scale var(--t3) var(--ease);
  }
  .film:hover .film__shot :global(img) { scale: 1.08; }

  .film__play {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    /* Measured against the real frame, not guessed: at 0.42 the white
       play mark was 2.90:1 over the photo's brightest pixels, under the
       3:1 a non-text graphic needs. 0.52 gives 4.01:1. */
    background: rgb(7 9 10 / 0.52);
    color: #fff;
    transition: background-color var(--t2) var(--ease);
  }
  .film:hover .film__play { background: rgb(47 100 41 / 0.72); }
  /* The play mark breathes, so the control reads as live at rest. */
  @media (prefers-reduced-motion: no-preference) {
    .film__play :global(svg) { animation: film-beat 2.6s var(--ease) infinite; }
  }
  @keyframes film-beat {
    0%, 70%, 100% { transform: scale(1); }
    12% { transform: scale(1.22); }
    24% { transform: scale(1); }
  }

  .film__t { display: grid; }
  .film__t b { font-size: 0.875rem; font-weight: 700; letter-spacing: -0.02em; }
  .film__t em {
    font-style: normal;
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  .hero__mantra {
    display: flex; align-items: center; flex-wrap: wrap; gap: 0.5rem;
    margin-top: var(--s5); padding-top: var(--s5);
    border-top: 1px solid var(--line-light);
    font-family: var(--font-mono); font-size: 0.625rem;
    letter-spacing: 0.16em; text-transform: uppercase; color: var(--text-3);
  }
  .hero__mantra b { color: var(--green); }

  /* exploded stack */
  .hero__media { position: relative; }
  .explode {
    position: relative;
    display: grid;
    perspective: 1400px;
    transform-style: preserve-3d;
  }
  .explode__l {
    grid-area: 1 / 1;
    transform:
      translateY(calc(var(--i) * 15%))
      translateZ(calc(var(--i) * -30px))
      rotateX(8deg) scale(calc(1 - var(--i) * 0.05));
    filter: drop-shadow(0 22px 30px rgb(10 30 12 / 0.35));
  }
  .explode__l :global(img) { width: 100%; height: auto; }

  .hero__script {
    position: absolute; right: -4%; top: 2%;
    max-width: 8.5rem; text-align: center;
    font-size: clamp(0.9rem, 1.5vw, 1.15rem);
    color: var(--green-deep); rotate: -5deg; display: none;
  }
  .hero__script svg { display: block; width: 58px; margin: 0.2rem auto 0; color: var(--green); }

  .hero__trust {
    display: flex; align-items: center; gap: 0.7rem;
    width: fit-content; margin: 0.8rem 0 0 auto;
    padding: 0.8rem 1.1rem; border-radius: 14px;
    background: rgb(255 255 255 / 0.94); backdrop-filter: blur(8px);
    box-shadow: 0 16px 34px -24px rgb(10 30 12 / 0.55);
  }
  .hero__trust i {
    display: grid; place-items: center; width: 36px; height: 36px; flex: none;
    border-radius: 10px; color: var(--clay-deep); background: var(--clay-wash);
  }
  .hero__trust span { display: grid; font-size: 0.75rem; color: var(--text-3); }
  .hero__trust b { font-size: 0.9375rem; color: var(--text); }

  .hero__rail {
    position: absolute; right: 1rem; top: 50%; translate: 0 -50%;
    display: none; gap: 0.7rem; grid-auto-flow: row;
    font-family: var(--font-mono); font-size: 0.5625rem;
    letter-spacing: 0.14em; color: var(--text-3);
  }
  .hero__rail li[data-on] { color: var(--green-deep); font-weight: 600; }

  /* ───── 02 figures ───── */
  .fig { background: var(--white); padding-block: clamp(2rem, 4vw, 3rem); }
  .fig__grid { display: grid; gap: var(--s5); align-items: center; }
  .fig__cards { display: grid; gap: clamp(0.7rem, 1.6vw, 1rem); }

  .fc {
    padding: 1.35rem 1.3rem; border-radius: 18px; background: var(--white);
    box-shadow: 0 1px 2px rgb(10 30 12 / 0.05), 0 12px 28px -18px rgb(10 30 12 / 0.26);
    transition: transform var(--t3) var(--ease), box-shadow var(--t3) var(--ease);
  }
  .fc:hover {
    transform: translateY(-5px);
    box-shadow: 0 1px 2px rgb(10 30 12 / 0.05), 0 26px 44px -22px rgb(10 30 12 / 0.32);
  }
  .fc__i {
    display: grid; place-items: center; width: 42px; height: 42px;
    border-radius: 13px; color: var(--clay-deep); background: var(--clay-wash);
