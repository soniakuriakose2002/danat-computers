---
import { Image } from 'astro:assets';
import PageLayout from '@layouts/PageLayout.astro';
import Icon from '@components/ui/Icon.astro';
import PurposeOrbit from '@components/sections/PurposeOrbit.astro';
import VideoModal from '@components/global/VideoModal.astro';
import StoryCard from '@components/global/StoryCard.astro';
import { site, branches, brands } from '@data/site';
import { reviews, hasReviews, type Review } from '@data/reviews';
import { OMAN_SPOTS } from '@data/omanMap';
import imgTech from '@assets/photos/repair-solder.jpg';
import imgFilm from '@assets/photos/film-poster.jpg';
import imgHero from '@assets/photos/support-desk.jpg';
import omanMap from '@assets/photos/oman-map.png';
import imgDirector from '@assets/photos/director.jpg';
import teamDesk from '@assets/photos/support-agent.jpg';
import teamBench from '@assets/photos/repair-solder.jpg';
import teamNet from '@assets/photos/network-eng.jpg';
import teamBiz from '@assets/photos/support-desk.jpg';
import Brush from '@components/ui/Brush.astro';
import Mark from '@components/ui/Mark.astro';

const years = new Date().getFullYear() - site.stats.since;

/**
 * ⚠ THREE ITEMS BELOW ARE NOT VERIFIED — they come from the client's
 * mockup, not from Danat's records, and the client has asked for the
 * mockup reproduced exactly. Confirm all three before this site goes
 * public:
 *   1. "1000+ happy customers" — no source of any kind.
 *   2. The 2010 and 2016 milestone years — invented by the mockup.
 *      Only 2003 is real (earliest record in the ERP export).
 *   3. The milestone descriptions attached to those two years.
 * Everything else on this page traces to site.ts or the ERP export.
 */
const figures = [
  { icon: 'calendar', v: years, suffix: '+', l: 'Years in business', sub: `Since ${site.stats.since}` },
  { icon: 'building', v: site.stats.branches, suffix: '', l: 'Branches in Oman', sub: branches.map((b) => b.city.split(',')[0]).join(', ') },
  { icon: 'box', v: site.stats.parts, suffix: '', l: 'Products in stock', sub: `Across ${site.stats.categories} categories` },
  { icon: 'users', v: 1000, suffix: '+', l: 'Customers served', sub: 'Individuals & businesses', unverified: true },
];

const journey = [
  { year: '2003', t: 'Opened our first store in Ruwi, Muscat.', verified: true },
  { year: '2010', t: 'Expanded our product range and IT solutions.', verified: false },
  { year: '2016', t: 'Grew across Oman with new branches in Sohar and Salalah.', verified: false },
  { year: 'Today', t: 'Continuing to support individuals, businesses and organisations.', verified: true },
];

const proof = [
  { icon: 'chip', t: 'Board level repair' },
  { icon: 'wrench', t: 'Genuine spares' },
  { icon: 'users', t: 'Experienced team' },
  { icon: 'bolt', t: 'Faster turnaround' },
];

/**
 * "What our team does": the photos illustrate the four kinds of work and
 * are not presented as named Danat staff, so no names are shown. Swap in
 * real staff photos (and add names) whenever they are available.
 *
 * ⚠ DRAFT — until src/data/reviews.ts holds real reviews, the "Trusted
 * by" wall shows obvious placeholder cards with a draft note under them.
 * Add real reviews there and they replace the placeholders.
 */
/** Add the Director's name here to show it beside the message. */
const director = { name: '' };
const SHOW_REVIEWS = true;
/* ⚠ SAMPLE REVIEWS — written for the design preview, not by customers.
   The names are invented and none of these people exist. They show only
   while src/data/reviews.ts is empty, and the draft note under the wall
   says so. Replace them with real reviews before going live. */
const placeholders: Review[] = [
  { name: 'Salim R.', branch: 'Ruwi', service: 'Laptop repair', rating: 5,
    text: 'My laptop stopped charging and they found the fault the same afternoon. Clear price before starting, and it has worked perfectly since.' },
  { name: 'Al Noor Trading', branch: 'Ruwi', service: 'Office network', rating: 5,
    text: 'They cabled our whole office and set up the Wi-Fi without stopping our work. Very professional team.' },
  { name: 'Fatma H.', branch: 'Sohar', service: 'Data recovery', rating: 5,
    text: 'I thought all my photos were gone after my hard disk failed. They recovered almost everything. Thank you Danat!' },
  { name: 'Ahmed K.', branch: 'Sohar', service: 'Printer service', rating: 4,
    text: 'Printer was serviced and working well again. Took one day longer than expected but they kept me informed.' },
  { name: 'Dhofar Star Services', branch: 'Salalah', service: 'CCTV installation', rating: 5,
    text: 'Good advice on camera placement and a neat installation. We can now check the shop from our phones.' },
  { name: 'Maryam S.', branch: 'Salalah', service: 'Laptop upgrade', rating: 5,
    text: 'They added an SSD and more memory to my old laptop. It feels like a new machine, for much less than buying one.' },
].map((p) => ({ ...p, source: 'google' } as Review));
const wallReviews = hasReviews ? reviews : placeholders;
const whatWeDo = [
  { t: 'Computer & laptop sales', icon: 'laptop', href: '/services/computer-sales', tone: 'mint' },
  { t: 'Repairs & maintenance', icon: 'wrench', href: '/services/computer-repair', tone: 'sky' },
  { t: 'Printers', icon: 'printer', href: '/services/printer-services', tone: 'butter' },
  { t: 'CCTV & security', icon: 'camera', href: '/services/cctv-services', tone: 'blush' },
  { t: 'Networking', icon: 'network', href: '/services/networking', tone: 'teal' },
  { t: 'Business IT solutions', icon: 'building', href: '/business', tone: 'lilac' },
];
const team = [
  { img: teamDesk, role: 'Service desk', note: 'First contact, diagnosis booking and quotes' },
  { img: teamBench, role: 'Board-level repair', note: 'Tracing faults to the component' },
  { img: teamNet, role: 'Networks & CCTV', note: 'Surveys, cabling and installation' },
  { img: teamBiz, role: 'Business support', note: 'Contracts, supply and on-site visits' },
];
/* three columns for the moving "wall" of reviews */
const cols = [0, 1, 2].map((c) => wallReviews.filter((_, i) => i % 3 === c));
const mapOrder = ['sohar', 'ruwi', 'salalah'];
const mapList = mapOrder.map((s) => branches.find((b) => b.slug === s)!);

---
<PageLayout
  title="About"
  description={`${site.nameFull} has supplied and repaired computers across Oman since ${site.stats.since} — three branches, ${site.stats.parts.toLocaleString('en-US')} lines in stock, board-level repair.`}
>
  {/* ══════ 01 · hero — full screen, the photo drifts as you scroll ══════ */}
<section class="ah" data-ah>
    <div class="shell ah__in">
      <div class="ah__copy" data-ah-tilt>
        <p class="eb ah__eb"><i class="eb__r" aria-hidden="true"></i>About Danat</p>
        <h1 class="ah__h">
          <span class="ah__l"><span>Technology that keeps</span></span>
          <span class="ah__l"><span><Brush>businesses running.</Brush></span></span>
        </h1>
        <p class="ah__p">
          For over two decades, Danat Computers has been a trusted name in
          computer products, services and business solutions across Oman. We
          don't just sell technology — we keep it running.
        </p>
        <div class="ah__acts">
          <button class="btn" type="button" data-story-open>
            Our story<span class="btn__i" aria-hidden="true"><Icon name="arrow" size={15} /></span>
          </button>
          <button class="ah__film" type="button" data-video-open aria-label="Watch the film: inside Danat Computers">
            <span class="ah__play" aria-hidden="true"><Icon name="play" size={13} /></span>
            <span><b>Watch the film</b><em>Inside Danat Computers</em></span>
          </button>
        </div>
        <p class="ah__mantra">People · Products · Support · A brighter tomorrow</p>
      </div>
    </div>
    <div class="ah__bg" data-ah-bg aria-hidden="true">
      <Image src={imgHero} alt="" widths={[900, 1400, 2000]} sizes="(min-width:62rem) 58vw, 100vw" quality={74} format="webp" loading="eager" />
    </div>
  </section>

  {/* ══════ 02 · figures — 3D tilt cards with a light that follows the pointer ══════ */}
  <section class="af">
    <dl class="shell af__grid">
      {figures.map((f, i) => (
        <div class:list={['af__c', `af__c--${i}`]} data-tilt>
          <span class="af__glow" aria-hidden="true"></span>
          <span class="af__i" aria-hidden="true"><Icon name={f.icon} size={22} /></span>
          <span class="af__t">
            <dt><span data-count={f.v}>{Number(f.v).toLocaleString('en-US')}</span>{f.suffix}</dt>
            <dd>{f.l}</dd>
            <small>{f.sub}</small>
          </span>
        </div>
      ))}
    </dl>
  </section>


  {/* ══════ 03 · director's message — compact, one personal card ══════ */}
  <section class="dm" data-dm>
    <div class="shell">
      <div class="dr">
        <figure class="dr__fig">
          <span class="dr__shape dr__shape--a" aria-hidden="true"></span>
          <span class="dr__shape dr__shape--b" aria-hidden="true"></span>
          <span class="dr__dots" aria-hidden="true"></span>
          <div class="dr__photo"><Image src={imgDirector} alt="The Director of Danat Computers" width={500} quality={90} format="webp" loading="lazy" /></div>
        </figure>
        <div class="dr__copy">
          <p class="eb"><i class="eb__r" aria-hidden="true"></i>Director's message</p>
          <h2 class="dr__h">Growing <em>with your trust.</em></h2>
          <p class="dr__p">Our commitment lies in delivering excellence, prompt service, and innovative solutions tailored to your needs. Trust us as your reliable tech partner, where your satisfaction is our utmost priority.</p>
          <button class="dr__more" type="button" data-dm-open>Read full message<Icon name="arrow" size={15} /></button>
        </div>
        <aside class="dr__side">
          <span class="dr__q" aria-hidden="true">“</span>
          <span class="dr__sig" aria-hidden="true">The Director</span>
          <b>{director.name || 'The Director'}</b>
          <em>Director, Danat Computers</em>
        </aside>
      </div>
    </div>
    <dialog class="dmd" data-dmd aria-labelledby="dmd-t">
      <button class="dmd__x" type="button" data-dmd-close aria-label="Close">×</button>
      <p class="dm__k" id="dmd-t"><span class="dm__qi" aria-hidden="true">“</span>Director's message</p>
      <p class="dmd__p">At Danat Computer Sales and Service Center, we're dedicated to providing top-tier assistance in computer sales, printer servicing, CCTV installation, computer networking, and data recovery. With a team passionate about technology, we ensure your devices function flawlessly. Whether finding the perfect computer, securing your premises with cutting-edge CCTV systems, or recovering vital data, we're here for you. Our commitment lies in delivering excellence, prompt service, and innovative solutions tailored to your needs. Trust us as your reliable tech partner, where your satisfaction is our utmost priority.</p>
      <p class="dmd__sig">— The Director, Danat Computers</p>
    </dialog>
  </section>

  {/* ══════ 03 · journey — milestone cards stack up in 3D as you scroll ══════ */}
  <section class="aj" id="journey">
    <div class="shell">
      <div class="aj__intro">
        <p class="eb"><i class="eb__r" aria-hidden="true"></i>Our journey</p>
        <h2 class="aj__h">From a <Mark as="highlight" tone="butter">small shop</Mark><br />to a trusted partner.</h2>
        <p class="aj__p">
          What started as a single counter has grown into a company with
          branches across Oman, serving thousands of customers. Our focus has
          always been the same — genuine products, expert service and
          long-term relationships.
        </p>
      </div>
      <ol class="aj__line" data-aj>
        <span class="aj__rail" aria-hidden="true"><i></i><b class="aj__spark"></b></span>
        {journey.map((j, i) => (
          <li class="aj__m" style={`--i:${i}`}>
            <span class="aj__dot" aria-hidden="true"><Icon name={['building', 'box', 'pin', 'users'][i % 4]} size={20} /></span>
            <b class="aj__yr" data-aj-yr={j.year}>{j.year}</b>
            <p class="aj__t">{j.t}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* ══════ 04 · purpose (unchanged) ══════ */}
  <PurposeOrbit />

  {/* ══════ 05 · the difference — the photo opens out to full width ══════ */}
<section class="ad" data-ad>
    <div class="shell ad__in">
      <figure class="ad__shot" data-ad-shot>
        <Image src={imgTech} alt="A Danat technician tracing a fault on a mainboard"
          widths={[700, 1100, 1500]} sizes="(min-width:62rem) 48vw, 100vw" quality={74} format="webp" loading="lazy" />
      </figure>
      <div class="ad__copy">
        <p class="eb" data-rise><i class="eb__r" aria-hidden="true"></i>The difference</p>
        <h2 class="ad__h" data-rise style="--d:70ms">Most shops replace the board. <Mark as="underline">We repair it.</Mark></h2>
        <p class="ad__p" data-rise style="--d:130ms">
          A replacement mainboard is often most of the value of the machine. A
          failed component on it is usually worth a fraction of that. Tracing
          the fault to the component takes a bench, a meter and someone who
          knows what they are looking at — which is what {years} years buys
          you, and what almost nobody else in Oman does in-house.
        </p>
        <ul class="ad__proof">
          {proof.map((p, i) => (
            <li data-rise style={`--d:${190 + i * 60}ms`}><span aria-hidden="true"><Icon name={p.icon} size={16} /></span>{p.t}</li>
          ))}
        </ul>
        <a class="btn" href="/services" data-rise style="--d:420ms">
          Our repair services<span class="btn__i" aria-hidden="true"><Icon name="arrow" size={15} /></span>
        </a>
      </div>
    </div>
  </section>


  {/* ══════ 07 · what we do — a short overview ══════ */}
  <section class="wd">
    <div class="shell">
      <header class="wd__head">
        <p class="eb" data-rise><i class="eb__r" aria-hidden="true"></i>What we do</p>
        <h2 class="wd__h" data-rise style="--d:70ms">Everything your technology needs, <Mark as="underline">under one roof.</Mark></h2>
      </header>
      <ul class="wd__grid">
        {whatWeDo.map((w, i) => (
          <li data-rise style={`--d:${i * 60}ms`}>
            <a class={`wd__i wd--${w.tone}`} href={w.href}>
              <span class="wd__ic" aria-hidden="true"><Icon name={w.icon} size={22} /></span>
              <b>{w.t}</b>
              <span class="wd__go" aria-hidden="true"><Icon name="arrow" size={14} /></span>
            </a>
          </li>
        ))}
      </ul>
      <div class="wd__cta" data-rise><a class="btn" href="/services">Explore our services<span class="btn__i" aria-hidden="true"><Icon name="arrow" size={15} /></span></a></div>
    </div>
  </section>

  {/* ══════ 09 · our people — a small band pointing to Leadership ══════ */}
  <section class="pp">
    <div class="shell pp__in">
      <div>
        <p class="eb" data-rise><i class="eb__r" aria-hidden="true"></i>Our people</p>
        <h2 class="pp__h" data-rise style="--d:70ms">The people <Mark as="highlight" tone="mint">behind the work.</Mark></h2>
        <p class="pp__p" data-rise style="--d:120ms">Our own technicians, sales and support staff — in-house, not subcontracted — across Ruwi, Sohar and Salalah.</p>
      </div>
      <ul class="pp__roles">
        <li data-rise style="--d:100ms"><span class="pp--mint"><Icon name="wrench" size={20} /></span>Technicians</li>
        <li data-rise style="--d:160ms"><span class="pp--sky"><Icon name="users" size={20} /></span>Sales teams</li>
        <li data-rise style="--d:220ms"><span class="pp--lilac"><Icon name="headset" size={20} /></span>Support desk</li>
      </ul>
      <a class="btn" href="/leadership" data-rise style="--d:260ms">Meet our leadership<span class="btn__i" aria-hidden="true"><Icon name="arrow" size={15} /></span></a>
    </div>
  </section>

      {/* ══════ 05c · trusted by — brand marquee + a moving wall of reviews ══════ */}
      <section class="aq">
        <div class="shell aq__head">
          <p class="eb"><i class="eb__r" aria-hidden="true"></i>Trusted by</p>
          <h2 class="aq__h">Brands we carry, <Mark as="highlight" tone="mint">customers we keep.</Mark></h2>
        </div>
        <div class="aq__mq" aria-label={`Brands we carry: ${brands.flat().join(', ')}`}>
          <div class="aq__track">
            {[0, 1].map((dup) => (
              <ul aria-hidden={dup ? 'true' : undefined}>{brands.flat().map((b) => <li>{b}</li>)}</ul>
            ))}
          </div>
        </div>
        {SHOW_REVIEWS && (
          <div class="shell">
            <header class="aq__rh">
              <p class="eb"><i class="eb__r" aria-hidden="true"></i>Customer reviews</p>
              <h2 class="aq__h">What our <Mark as="highlight" tone="butter">customers say.</Mark></h2>
            </header>
            <div class="aq__wall">
              {cols.map((col, c) => (
                <div class="aq__col" style={`--dur:${[38, 46, 42][c]}s`}>
                  <div class="aq__run">
                    {[0, 1].map((dup) => col.map((q) => (
                      <figure class="aq__q" aria-hidden={dup ? 'true' : undefined}>
                        <span class="aq__mark" aria-hidden="true">“</span>
                        <div class="aq__top">
                          <span class="aq__av" aria-hidden="true">{q.name.charAt(0)}</span>
                          <span class="aq__who">
                            <b>{q.name}</b>
                            {/* Only what we actually know: no branch or
                                service invented to fill the line. */}
                            <small>{[q.service, q.branch && `Danat ${q.branch}`].filter(Boolean).join(' · ')}</small>
                          </span>
                          {/* The badge names the real source. It used to
                              say "G" on every card regardless. */}
                          <span class="aq__g" aria-hidden="true">{q.source === 'google' ? 'G' : q.source === 'facebook' ? 'f' : '★'}</span>
                        </div>
                        {/* The stars they gave, not five by default. */}
                        <span class="aq__stars" aria-label={`${q.rating} out of 5`}>{'★'.repeat(q.rating)}<i>{'★'.repeat(5 - q.rating)}</i></span>
                        <blockquote>{q.text}</blockquote>
                      </figure>
                    )))}
                  </div>
                </div>
              ))}
            </div>
            {!hasReviews && <p class="aq__draft">Draft — these are sample reviews, not real customers. Replace them with real customer reviews (for example from Google) before going live.</p>}
          </div>
        )}
      </section>

  {/* ══════ 06 · presence ══════ */}
  <section class="pr section">
    <div class="shell pr__grid">
      <div class="pr__intro" data-rise>
        <p class="eb"><i class="eb__r" aria-hidden="true"></i>Our presence</p>
        <h2 class="pr__h">Three branches,<br /><em>one standard.</em></h2>
        <p class="pr__p">
          No matter which branch you visit, you get the same diagnosis, the
          same stock, and the same team. A branch is not a lesser version of
          the shop.
        </p>
        <a class="ghost" href="/branches">
          View all branches<span aria-hidden="true"><Icon name="arrow" size={14} /></span>
        </a>
      </div>

      {/* The real map, not the stylised silhouette this replaced: an OSM
          tile render of Oman, stitched once at build time and served as
          our own image, so there is no key, no per-visitor tile request
          and no cookie banner. The pins come from the same Web Mercator
          maths that produced the crop, shared via OMAN_SPOTS so this and
          the two homepage maps cannot drift apart. */}
      <figure class="pr__map" data-rise style="--d:90ms">
        <Image src={omanMap} alt="Map of Oman showing the Danat branches in Sohar, Ruwi and Salalah"
          widths={[428, 856]} sizes="(min-width: 62rem) 21rem, 62vw"
          quality={80} format="webp" loading="lazy" />
        {/* A pin on a map should open that place on a map. These used to
            go to /branches#slug, which is the branch's text entry, not its
            location. Same OpenStreetMap link the homepage uses, and the
            same zoom rule: 17 for Ruwi, whose street address is confirmed,
            13 for Sohar and Salalah, where only the city is known —
            zooming to a street we cannot vouch for would be inventing a
            location. */}
        {mapList.map((b, i) => (
          <a class="pr__pin" target="_blank" rel="noopener noreferrer"
            href={`https://www.openstreetmap.org/?mlat=${b.geo.lat}&mlon=${b.geo.lon}#map=${b.geo.precise ? 17 : 13}/${b.geo.lat}/${b.geo.lon}`}
            style={`--i:${i}; --x:${OMAN_SPOTS[b.slug].x}%; --y:${OMAN_SPOTS[b.slug].y}%`}>
            <i aria-hidden="true"></i><span>{b.city.split(',')[0]}</span>
          </a>
        ))}
      </figure>

      <ul class="pr__list">
        {branches.map((b, i) => (
          <li data-rise style={`--d:${i * 60}ms`}>
            <a class="br" href={`/branches#${b.slug}`}>
              <span class="br__shot" aria-hidden="true"><i>Photo</i></span>
              <span class="br__t"><b>{b.name}</b><em>{b.city}</em></span>
              <span class="br__go" aria-hidden="true"><Icon name="arrow" size={15} /></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>


  {/* ══════ 07 · cta ══════ */}
<section class="ac">
    <div class="shell">
      <div class="ac__panel">
        <p class="eb" data-rise><i class="eb__r" aria-hidden="true"></i>Let's build a brighter tomorrow</p>
        <h2 class="ac__h" data-rise style="--d:70ms">Need <Mark as="highlight" tone="butter">expert</Mark> <Mark as="underline" tone="blue">advice?</Mark></h2>
        <p class="ac__p" data-rise style="--d:130ms">Our team is here to help you find the right solution.</p>
        <a class="ac__b" href="/contact" data-mag data-rise style="--d:190ms">Contact us<Icon name="arrow" size={15} /></a>
      </div>
    </div>
  </section>

  <StoryCard />
  <VideoModal />
</PageLayout>

<style>
  /* ───── shared ───── */
  .eb {
    display: flex; align-items: center; gap: 0.6rem;
    font-family: var(--font-mono); font-size: 0.6875rem;
    letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--green-deep);
  }
  .eb--clay { color: var(--clay-deep); }
  .eb--inv { color: var(--green-bright); }
  .eb__r { width: 26px; height: 1px; flex: none; background: currentColor; opacity: 0.6; }

  .btn {
    position: relative; display: inline-flex; align-items: center;
    align-self: flex-start; gap: 0.7rem;
    padding: 0.5rem 0.5rem 0.5rem 1.4rem;
    border: 0; border-radius: 999px;
    /* white is 8.73:1 on #27551f and 4.90:1 on #3d7f35 — AA across the ramp */
    background: linear-gradient(100deg, #27551f, #3d7f35);
    color: #fff; font-size: 0.9375rem; font-weight: 600;
    overflow: hidden; transition: transform var(--t2) var(--ease);
  }
  .btn:hover { transform: translateY(-2px); }
  .btn__i {
    display: grid; place-items: center; width: 30px; height: 30px; flex: none;
    border-radius: 50%; background: rgb(255 255 255 / 0.2);
    transition: transform var(--t2) var(--ease);
  }
  .btn:hover .btn__i { transform: translateX(3px); }

  .ghost {
    display: inline-flex; align-items: center; align-self: flex-start; gap: 0.6rem;
    margin-top: var(--s5);
    padding: 0.55rem 0.55rem 0.55rem 1.3rem;
    border: 1px solid var(--line-light); border-radius: 999px;
    background: var(--white); font-size: 0.875rem; font-weight: 600;
    transition: border-color var(--t2) var(--ease);
  }
  .ghost:hover { border-color: var(--clay); }
  .ghost span {
    display: grid; place-items: center; width: 26px; height: 26px;
    border-radius: 50%; background: var(--clay-wash); color: var(--clay-deep);
    transition: transform var(--t2) var(--ease);
  }
  .ghost:hover span { transform: translateX(3px); }


  /* ───── pastel palette ───── */
  :global(:root) { --p-mint: #e3f3e6; --p-mint-ink: #1f8a4c; --p-blush: #fbe6e7; --p-blush-ink: #c93c4f;
    --p-sky: #e4edfa; --p-sky-ink: #2d6fd0; --p-butter: #fbf0dc; --p-butter-ink: #c77410; --p-lilac: #efe8f8; --p-lilac-ink: #7a4bd0; }

  /* ───── 01 hero ───── */
  .ah { position: relative; color: var(--text); overflow: hidden;
    background: radial-gradient(40% 50% at 6% 18%, rgb(251 230 231 / 0.45), transparent 70%),
      radial-gradient(35% 45% at 28% 90%, rgb(228 237 250 / 0.5), transparent 70%),
      linear-gradient(180deg, #ffffff 0%, #f8faf8 100%); }
  .ah__in { position: relative; z-index: 1; display: grid; grid-template-columns: minmax(0, 0.95fr) minmax(0, 1fr); gap: clamp(2rem, 5vw, 5rem); align-items: center; min-height: min(78svh, 46rem);
    padding-top: calc(var(--hdr, 88px) + clamp(2.5rem, 6vw, 4.5rem)); padding-bottom: clamp(5rem, 9vw, 7rem); }
  .ah__copy { transition: transform 0.6s var(--ease); }
  .ah__eb { opacity: 0; animation: ahFade 0.9s var(--ease) 0.15s both; }
  .ah__h { perspective: 900px; margin-top: var(--s4); font-weight: 700; font-size: var(--hero); line-height: var(--hero-lh); letter-spacing: var(--hero-tr); --brush-size: 1.15; }
  .ah__l { display: block; overflow: hidden; padding-bottom: 0.08em; }
  .ah__l > span { display: block; transform-origin: 50% 100%; transform: translateY(70%) rotateX(-70deg); opacity: 0; animation: ahUp 1.2s var(--ease) both; }
  .ah__l:nth-child(1) > span { animation-delay: 0.2s; }
  .ah__l:nth-child(2) > span { animation-delay: 0.34s; }
  .ah__l:nth-child(3) > span { animation-delay: 0.46s; }
  @keyframes ahUp { to { transform: none; opacity: 1; } }
  @keyframes ahFade { to { opacity: 1; } }
  .ah__p { margin-top: var(--s4); max-width: 44ch; font-size: 0.9375rem; line-height: 1.68; color: var(--text-2); opacity: 0; animation: ahFade 1s var(--ease) 0.55s both; }
  .ah__acts { margin-top: 1.8rem; display: flex; flex-wrap: wrap; gap: 1rem 1.4rem; align-items: center; opacity: 0; animation: ahFade 1s var(--ease) 0.7s both; }
  .ah__film { display: inline-flex; align-items: center; gap: 0.8rem; padding: 0; border: 0; background: none; color: var(--text); text-align: left; cursor: pointer; }
  .ah__film span:last-child { display: grid; }
  .ah__film b { font-size: 0.95rem; }
  .ah__film em { font-style: normal; font-size: 0.8rem; color: var(--text-3); }
  .ah__play { position: relative; display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; border: 1px solid rgb(0 0 0 / 0.15); color: var(--green-deep); }
  .ah__play::after { content: ''; position: absolute; inset: -6px; border-radius: 50%; border: 1px solid rgb(89 170 84 / 0.5); animation: ahPing 2.4s var(--ease) infinite; }
  @keyframes ahPing { from { transform: scale(0.8); opacity: 1; } to { transform: scale(1.4); opacity: 0; } }
  .ah__mantra { margin-top: 2rem; font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--text-3); opacity: 0; animation: ahFade 1s var(--ease) 0.9s both; }
  /* rotating phrase: each one rolls up and out as the next rolls in */
  .rot { display: inline-grid; vertical-align: bottom; perspective: 600px; transition: width 0.6s var(--ease); }
  .rot__w { grid-area: 1 / 1; white-space: nowrap; opacity: 0; transform: translateY(55%) rotateX(-65deg); filter: blur(4px);
    transform-origin: 50% 100%; transition: opacity 0.55s var(--ease), transform 0.75s var(--ease), filter 0.55s var(--ease); }
  .rot__w.is-on { opacity: 1; transform: none; filter: none; }
  .rot__w.is-out { opacity: 0; transform: translateY(-55%) rotateX(65deg); filter: blur(4px); transform-origin: 50% 0%; }

  /* the photo fills the right side and melts into the page — no frame */
  .ah__bg { position: absolute; top: 0; right: 0; bottom: 0; width: 58%; z-index: 0; will-change: transform;
    -webkit-mask: linear-gradient(90deg, transparent 0%, #000 38%); mask: linear-gradient(90deg, transparent 0%, #000 38%);
    animation: ahReveal 1.6s var(--ease) 0.1s both; }
  .ah__bg::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 70%, #f8faf8 100%); }
  @keyframes ahReveal { from { opacity: 0; transform: scale(1.06); } to { opacity: 1; transform: none; } }
  .ah__bg :global(img) { width: 100%; height: 112%; object-fit: cover; object-position: 60% 30%; }

  /* ───── 02 figures ───── */
  .af { background: #fff; padding-block: clamp(2.2rem, 4vw, 3.2rem); }
  .af__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; margin: 0; perspective: 1200px; }
  .af__c { position: relative; display: flex; align-items: center; gap: 1rem; padding: 1.3rem 1.3rem; border-radius: 20px; overflow: hidden;
    transform-style: preserve-3d; transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg)); transition: transform 0.5s var(--ease), box-shadow 0.5s var(--ease); }
  .af__c:hover { box-shadow: 0 26px 50px -30px rgb(20 40 25 / 0.35); }
  .af__c { --tint: var(--p-mint); --pink: var(--p-mint-ink); background: #fff !important; border: 1px solid rgb(0 0 0 / 0.06) !important; box-shadow: inset 0 3px 0 var(--tint); }
  .af__c--0 { --tint: var(--p-mint); --pink: var(--p-mint-ink); }
  .af__c--1 { --tint: var(--p-blush); --pink: var(--p-blush-ink); }
  .af__c--2 { --tint: var(--p-sky); --pink: var(--p-sky-ink); }
  .af__c--3 { --tint: var(--p-butter); --pink: var(--p-butter-ink); }
  .af__i { display: grid; place-items: center; flex: none; width: 52px; height: 52px; border-radius: 16px; background: var(--tint); color: var(--pink); transform: translateZ(25px); }
  .af__t { display: grid; gap: 0.1rem; min-width: 0; transform: translateZ(20px); }
  .af__c dt { font-size: var(--d5); font-weight: 700; letter-spacing: var(--tr5); line-height: 1; color: var(--text); }
  .af__c--0 dt { color: var(--green-deep); }
  .af__c dd { margin: 0.3rem 0 0; font-weight: 700; font-size: 0.92rem; }
  .af__c small { color: var(--text-3); font-size: 0.78rem; }
  .af__glow { position: absolute; inset: 0; pointer-events: none; opacity: 0; transition: opacity 0.3s;
    background: radial-gradient(260px circle at var(--mx, 50%) var(--my, 50%), rgb(89 170 84 / 0.22), transparent 70%); }
  .af__c:hover .af__glow { opacity: 1; }
  

  /* ───── 02c mission & vision ───── */
  .mv { background: #fff; padding-block: clamp(4.5rem, 9vw, 7rem); }
  .mv__head { display: grid; justify-items: center; text-align: center; margin-bottom: 2.6rem; }
  .mv__h { margin-top: var(--s4); font-size: var(--d5); font-weight: 700; letter-spacing: var(--tr5); line-height: 1.1; }
  .mv__grid { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: 1.4rem; align-items: stretch; }
  .mv__card { position: relative; display: grid; align-content: start; gap: 0.7rem; padding: clamp(1.6rem, 3.5vw, 2.4rem); border-radius: 24px; overflow: hidden;
    background: #fff; border: 1px solid rgb(0 0 0 / 0.06); box-shadow: 0 24px 50px -36px rgb(20 40 25 / 0.4);
    opacity: 0; transform: translateY(26px); transition: opacity 0.7s var(--ease), transform 0.8s var(--ease), box-shadow 0.4s; }
  .mv__card--v { transition-delay: 0.12s; }
  .mv__card.is-in { opacity: 1; transform: none; }
  .mv__card:hover { box-shadow: 0 30px 60px -32px rgb(20 40 25 / 0.5); }
  .mv__card::before { content: ''; position: absolute; top: -30%; right: -20%; width: 60%; aspect-ratio: 1; border-radius: 50%; opacity: 0.7; transition: transform 0.8s var(--ease); }
  .mv__card--m::before { background: radial-gradient(closest-side, var(--p-mint), transparent); }
  .mv__card--v::before { background: radial-gradient(closest-side, var(--p-sky), transparent); }
  .mv__card:hover::before { transform: scale(1.2); }
  .mv__ic { position: relative; display: grid; place-items: center; width: 54px; height: 54px; border-radius: 16px; }
  .mv__card--m .mv__ic { background: var(--p-mint); color: var(--p-mint-ink); }
  .mv__card--v .mv__ic { background: var(--p-sky); color: var(--p-sky-ink); }
  .mv__card:hover .mv__ic { animation: mvWobble 0.7s ease; }
  @keyframes mvWobble { 30% { transform: rotate(-10deg) scale(1.08); } 60% { transform: rotate(6deg); } }
  .mv__k { position: relative; margin-top: 0.4rem; font-size: 1.3rem; font-weight: 700; letter-spacing: -0.03em; }
  .mv__card--m .mv__k { color: var(--p-mint-ink); }
  .mv__card--v .mv__k { color: var(--p-sky-ink); }
  .mv__t { position: relative; font-size: 0.95rem; line-height: 1.75; color: var(--text-2); }

  /* ───── toggle ───── */
  .av { position: relative; z-index: 20; display: flex; justify-content: center; margin-top: -1.9rem; pointer-events: none; }
  .av__bar { position: relative; display: inline-flex; padding: 6px; border-radius: 999px; pointer-events: auto; background: rgb(255 255 255 / 0.92);
    backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); border: 1px solid rgb(0 0 0 / 0.08); box-shadow: 0 18px 40px -22px rgb(20 40 25 / 0.45); }
  .av__pill { position: absolute; top: 6px; bottom: 6px; left: 0; width: 0; border-radius: 999px; background: var(--green-deep); transition: transform 0.5s var(--ease), width 0.5s var(--ease); }
  .av__tab { position: relative; z-index: 1; padding: 0.8rem 1.6rem; border: 0; border-radius: 999px; background: none; cursor: pointer; font-weight: 700; font-size: 1rem; color: var(--text-2); transition: color 0.3s; }
  .av__tab[aria-selected='true'] { color: #fff; }
  .av__view.is-on { animation: avIn 0.6s var(--ease) both; }
  @keyframes avIn { from { opacity: 0; transform: translateY(18px); } }

  /* ───── 02 who we are ───── */
  .ww { background: #fff; padding-block: clamp(4.5rem, 9vw, 7rem) clamp(2rem, 4vw, 3rem); }
  .ww__in { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr); gap: clamp(2rem, 5vw, 5rem); align-items: center; }
  .ww__h { margin-top: var(--s4); font-size: var(--d5); font-weight: 700; letter-spacing: var(--tr5); line-height: 1.1; }
  .ww__p { margin-top: var(--s4); max-width: 52ch; font-size: 1rem; line-height: 1.75; color: var(--text-2); }
  .ww__facts { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.8rem; }
  .ww__facts li { display: grid; grid-template-columns: 48px 1fr; column-gap: 1rem; align-items: center; padding: 1rem 1.2rem; border-radius: 18px; background: #fff;
    border: 1px solid rgb(0 0 0 / 0.06); box-shadow: 0 16px 34px -28px rgb(20 40 25 / 0.4); transition: transform 0.35s var(--ease), box-shadow 0.35s; }
  .ww__facts li:hover { transform: translateX(6px); box-shadow: 0 22px 44px -28px rgb(20 40 25 / 0.5); }
  .ww__ic { grid-row: span 2; display: grid; place-items: center; width: 48px; height: 48px; border-radius: 14px; }
  .ww--mint { background: var(--p-mint); color: var(--p-mint-ink); } .ww--sky { background: var(--p-sky); color: var(--p-sky-ink); } .ww--lilac { background: var(--p-lilac); color: var(--p-lilac-ink); }
  .ww__facts b { font-size: 1.02rem; letter-spacing: -0.015em; }
  .ww__facts em { font-style: normal; font-size: 0.84rem; color: var(--text-3); }

  /* ───── 03 director's message — photo, message, signature ───── */
  .dm { padding-block: clamp(2.5rem, 5vw, 4rem); background: #fff; }
  .dr { position: relative; display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.25fr) minmax(0, 0.55fr); gap: clamp(1.8rem, 4vw, 3.5rem); align-items: center;
    padding: clamp(1.8rem, 3.5vw, 2.8rem) clamp(1.6rem, 3.5vw, 3rem); border-radius: 28px; overflow: hidden; isolation: isolate;
    background: linear-gradient(180deg, #f3f8f4 0%, #f7faf8 100%); }
  .dr::after { content: ''; position: absolute; right: -8%; bottom: -30%; width: 38%; aspect-ratio: 1; border-radius: 50%; z-index: -1; background: radial-gradient(closest-side, rgb(214 236 218 / 0.9), transparent); }
  /* photo: a tilted rounded frame with green shapes and a dot grid behind */
  .dr__fig { position: relative; margin: 0; justify-self: center; width: min(100%, 21rem); aspect-ratio: 1.05 / 1; }
  .dr__photo { position: absolute; inset: 8% 4% 4% 10%; border-radius: 28px 28px 28px 70px; overflow: hidden; transform: rotate(-6deg) skewY(2deg);
    box-shadow: 0 30px 50px -28px rgb(20 40 25 / 0.5); opacity: 0; translate: 0 26px; transition: opacity 0.8s var(--ease) 0.2s, translate 0.9s var(--ease) 0.2s, transform 0.6s var(--ease); }
  .dm.is-in .dr__photo { opacity: 1; translate: 0 0; }
  .dr__fig:hover .dr__photo { transform: rotate(-3deg) skewY(1deg); }
  .dr__photo :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 50% 28%; transform: rotate(6deg) scale(1.18); }
  .dr__shape { position: absolute; border-radius: 26px; z-index: -1; transition: transform 0.9s var(--ease); }
  .dr__shape--a { inset: 0 18% 30% 2%; background: #cfe8d2; transform: rotate(-12deg) translate(-14px, -10px) scale(0.9); opacity: 0.9; }
  .dr__shape--b { left: 0; top: 34%; width: 26%; height: 42%; background: var(--green); border-radius: 24px; transform: translateX(-20px); opacity: 0; transition: opacity 0.6s 0.4s, transform 0.8s var(--ease) 0.4s; }
  .dm.is-in .dr__shape--a { transform: rotate(-12deg); }
  .dm.is-in .dr__shape--b { transform: none; opacity: 1; }
  .dr__dots { position: absolute; left: -6%; bottom: -2%; width: 30%; height: 28%; z-index: 2;
    background-image: radial-gradient(circle, var(--green) 1.6px, transparent 2px); background-size: 14px 14px; opacity: 0.8; }
  .dr__copy { display: grid; justify-items: start; }
  .dr__h { margin-top: var(--s4); font-size: var(--d5); font-weight: 700; letter-spacing: var(--tr5); line-height: 1.1; }
  .dr__h em { font-style: normal; color: var(--green-deep); }
  .dr__p { margin-top: 1rem; max-width: 52ch; font-size: 1rem; line-height: 1.7; color: var(--text-2); }
  .dr__more { margin-top: 1.4rem; display: inline-flex; align-items: center; gap: 0.6rem; padding: 0.85rem 1.4rem; border-radius: 999px; border: 1px solid rgb(0 0 0 / 0.14); background: #fff;
    font-weight: 600; font-size: 0.92rem; color: var(--text); cursor: pointer; transition: background 0.25s, color 0.25s, border-color 0.25s; }
  .dr__more :global(svg) { color: var(--green-deep); transition: transform 0.3s var(--ease); }
  .dr__more:hover { background: var(--green-deep); color: #fff; border-color: var(--green-deep); }
  .dr__more:hover :global(svg) { color: #fff; transform: translateX(3px); }
  .dr__side { position: relative; display: grid; align-content: center; gap: 0.1rem; padding-left: clamp(1.2rem, 2.5vw, 2rem); border-left: 1px solid rgb(0 0 0 / 0.1); min-height: 12rem; }
  .dr__q { font-family: Georgia, serif; font-size: 6.5rem; line-height: 0.8; color: #cfe3d2; height: 4.2rem; }
  .dr__sig { margin-top: 0.4rem; font-family: var(--font-script); font-size: 1.9rem; color: var(--text); line-height: 1.2; clip-path: inset(0 100% 0 0); transition: clip-path 1.3s cubic-bezier(0.6, 0, 0.3, 1) 0.9s; }
  .dm.is-in .dr__sig { clip-path: inset(0 -6% 0 0); }
  .dr__side b { margin-top: 0.3rem; font-size: 1.05rem; }
  .dr__side em { font-style: normal; font-size: 0.86rem; color: var(--text-3); }
  .dmd { position: fixed; inset: 0; margin: auto; height: fit-content; width: min(640px, calc(100vw - 2rem)); padding: 2rem 2rem 1.8rem; border: 0; border-radius: 24px;
    box-shadow: 0 40px 100px -40px rgb(10 20 15 / 0.55); }
  .dmd::backdrop { background: rgb(12 20 16 / 0.45); backdrop-filter: blur(6px); }
  .dmd[open] { animation: dmdIn 0.45s cubic-bezier(0.2, 0.9, 0.25, 1) both; }
  @keyframes dmdIn { from { opacity: 0; transform: translateY(20px) scale(0.97); } }
  .dmd__x { position: absolute; top: 0.8rem; right: 0.8rem; width: 36px; height: 36px; border: 0; border-radius: 50%; background: #f2f4f2; font-size: 1.4rem; cursor: pointer; }
  .dmd__p { margin-top: 1rem; font-size: 1rem; line-height: 1.8; color: var(--text-2); }
  .dmd__sig { margin-top: 1rem; font-weight: 700; color: var(--green-deep); }

  /* ───── 09 our people (small) ───── */
  .pp { background: #f7faf8; padding-block: clamp(3rem, 6vw, 4.5rem); }
  .pp__in { display: grid; grid-template-columns: minmax(0, 1.2fr) auto auto; gap: clamp(1.5rem, 4vw, 3rem); align-items: center; }
  .pp__h { margin-top: var(--s4); font-size: var(--d6); font-weight: 700; letter-spacing: var(--tr6); line-height: 1.1; }
  .pp__p { margin-top: 0.7rem; max-width: 46ch; font-size: 0.95rem; line-height: 1.65; color: var(--text-2); }
  .pp__roles { list-style: none; margin: 0; padding: 0; display: flex; gap: 0.7rem; }
  .pp__roles li { display: grid; justify-items: center; gap: 0.5rem; width: 6.5rem; padding: 1rem 0.5rem; border-radius: 18px; background: #fff; box-shadow: 0 14px 30px -24px rgb(20 40 25 / 0.45);
    font-size: 0.8rem; font-weight: 600; text-align: center; transition: transform 0.35s var(--ease); }
  .pp__roles li:hover { transform: translateY(-5px); }
  .pp__roles span { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 14px; }
  .pp--mint { background: var(--p-mint); color: var(--p-mint-ink); } .pp--sky { background: var(--p-sky); color: var(--p-sky-ink); } .pp--lilac { background: var(--p-lilac); color: var(--p-lilac-ink); }

  /* ───── 07 what we do ───── */
  .wd { background: #fff; padding-block: clamp(4.5rem, 9vw, 7rem); }
  .wd__head { display: grid; justify-items: center; text-align: center; margin-bottom: 2.4rem; }
  .wd__h { margin-top: var(--s4); font-size: var(--d5); font-weight: 700; letter-spacing: var(--tr5); line-height: 1.1; }
  .wd__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  .wd__i { display: flex; align-items: center; gap: 1rem; padding: 1.2rem 1.3rem; border-radius: 18px; background: #fff; border: 1px solid rgb(0 0 0 / 0.07);
    box-shadow: 0 16px 34px -28px rgb(20 40 25 / 0.4); color: inherit; text-decoration: none; transition: transform 0.35s var(--ease), box-shadow 0.35s, border-color 0.35s; }
  .wd__i:hover { transform: translateY(-4px); box-shadow: 0 24px 46px -28px rgb(20 40 25 / 0.5); border-color: transparent; }
  .wd--mint { --t: var(--p-mint); --c: var(--p-mint-ink); } .wd--sky { --t: var(--p-sky); --c: var(--p-sky-ink); } .wd--butter { --t: var(--p-butter); --c: var(--p-butter-ink); }
  .wd--blush { --t: var(--p-blush); --c: var(--p-blush-ink); } .wd--teal { --t: #dff2f1; --c: #14878a; } .wd--lilac { --t: var(--p-lilac); --c: var(--p-lilac-ink); }
  .wd__ic { display: grid; place-items: center; width: 48px; height: 48px; flex: none; border-radius: 14px; background: var(--t); color: var(--c); transition: transform 0.4s cubic-bezier(0.3, 1.6, 0.5, 1); }
  .wd__i:hover .wd__ic { transform: rotate(-8deg) scale(1.08); }
  .wd__i b { font-size: 1rem; letter-spacing: -0.015em; }
  .wd__go { margin-left: auto; color: var(--c); transition: transform 0.3s var(--ease); }
  .wd__i:hover .wd__go { transform: translateX(4px); }
  .wd__cta { display: flex; justify-content: center; margin-top: 2rem; }

  /* ───── 08 our people ───── */
  .op { background: linear-gradient(180deg, #f7faf8 0%, #fff 100%); padding-block: clamp(4.5rem, 9vw, 7rem); }
  .op__in { display: grid; grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr); gap: clamp(2rem, 6vw, 6rem); align-items: center; }
  .op .dwrap { width: min(100%, 19rem); }
  .op__h { margin-top: var(--s4); font-size: var(--d5); font-weight: 700; letter-spacing: var(--tr5); line-height: 1.1; }
  .op__p { margin-top: var(--s4); max-width: 46ch; font-size: 1rem; line-height: 1.7; color: var(--text-2); }
  .op__q { position: relative; margin: 1.6rem 0 1.8rem; padding: 1.2rem 1.4rem 1.2rem 3.2rem; border-radius: 18px; background: var(--p-mint); font-size: 1.05rem; line-height: 1.5; font-weight: 600; max-width: 52ch; }
  .op__q span { position: absolute; left: 1rem; top: 0.1rem; font-family: Georgia, serif; font-size: 3.4rem; line-height: 1; color: var(--p-mint-ink); }
  .op__q cite { display: block; margin-top: 0.5rem; font-style: normal; font-size: 0.8rem; font-weight: 500; color: var(--text-3); }

  /* ───── 02b director's message ───── */
  .adm { background: linear-gradient(180deg, #fff 0%, #f7f9fc 100%); padding-block: clamp(5rem, 10vw, 8rem); overflow: hidden; }
  .adm__in { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: clamp(2.5rem, 6vw, 6rem); align-items: center; }
  /* Director card: a spinning gradient frame, the portrait in an arch on a soft mesh,
     a glass name plate and a floating quote badge; tilts toward the pointer */
  .dpc { position: relative; border-radius: 30px; padding: 3px; isolation: isolate;
    transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg)); transform-style: preserve-3d; transition: transform 0.5s var(--ease); }
  .dpc__ring { position: absolute; inset: 0; z-index: -1; border-radius: inherit; overflow: hidden; }
  .dpc__ring::before { content: ''; position: absolute; inset: -60%; background: conic-gradient(from 0deg, #59aa54, #6aa9d8, #b39ce8, #f2b35c, #59aa54);
    animation: dpcSpin 7s linear infinite; }
  .dpc:hover .dpc__ring::before { animation-duration: 2.5s; }
  @keyframes dpcSpin { to { transform: rotate(360deg); } }
  .dpc__in { position: relative; border-radius: 27px; background: #fff; padding: 1rem 1rem 1.2rem; box-shadow: 0 40px 70px -40px rgb(20 40 25 / 0.5); }
  .dpc__photo { position: relative; aspect-ratio: 4 / 4.4; border-radius: 180px 180px 22px 22px; overflow: hidden; background: #eef4ef; transform: translateZ(20px); }
  .dpc__mesh { position: absolute; inset: 0; z-index: 0;
    background: radial-gradient(60% 50% at 20% 20%, rgb(227 243 230 / 0.9), transparent 70%), radial-gradient(60% 50% at 85% 30%, rgb(228 237 250 / 0.9), transparent 70%), radial-gradient(60% 60% at 50% 100%, rgb(239 232 248 / 0.9), transparent 70%); }
  .dpc__photo :global(img) { position: relative; z-index: 1; width: 100%; height: 100%; object-fit: cover; object-position: 50% 28%; transition: transform 0.8s var(--ease); }
  .dpc:hover .dpc__photo :global(img) { transform: scale(1.06); }
  .dpc__badge { position: absolute; top: 1.4rem; right: 1.4rem; z-index: 3; display: grid; place-items: center; width: 52px; height: 52px; border-radius: 50%;
    background: #fff; color: var(--green); font-family: Georgia, serif; font-size: 2.2rem; line-height: 1; padding-top: 0.5rem;
    box-shadow: 0 12px 28px -12px rgb(20 40 25 / 0.45); animation: dpcBob 4s ease-in-out infinite alternate; transform: translateZ(40px); }
  @keyframes dpcBob { from { translate: 0 -4px; rotate: -6deg; } to { translate: 0 5px; rotate: 4deg; } }
  .dpc__plate { position: relative; z-index: 2; display: grid; gap: 0.15rem; margin: -3.4rem 0.8rem 0; padding: 1rem 1.1rem; border-radius: 18px;
    background: rgb(255 255 255 / 0.82); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border: 1px solid rgb(255 255 255 / 0.9);
    box-shadow: 0 18px 36px -20px rgb(20 40 25 / 0.45); transform: translateZ(50px); }
  .dpc__chip { justify-self: start; padding: 0.22rem 0.65rem; border-radius: 999px; background: var(--p-mint); color: var(--p-mint-ink); font-size: 0.68rem; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; }
  .dpc__plate b { margin-top: 0.3rem; font-size: 1.2rem; letter-spacing: -0.02em; }
  .dpc__plate em { font-style: normal; font-size: 0.8rem; color: var(--text-3); }
  .dpc__tags { list-style: none; margin: 0.9rem 0.8rem 0; padding: 0; display: flex; gap: 0.4rem; }
  .dpc__tags li { padding: 0.3rem 0.7rem; border-radius: 999px; font-size: 0.72rem; font-weight: 600; }
  .dpc__tags li:nth-child(1) { background: var(--p-mint); color: var(--p-mint-ink); }
  .dpc__tags li:nth-child(2) { background: var(--p-sky); color: var(--p-sky-ink); }
  .dpc__tags li:nth-child(3) { background: var(--p-lilac); color: var(--p-lilac-ink); }
  .dwrap { justify-self: center; width: min(100%, 23rem); animation: dcIn 1s cubic-bezier(0.2, 0.9, 0.25, 1) both, dcFloat 6s ease-in-out 1.2s infinite alternate; animation-play-state: paused; }
  .adm.is-in .dwrap, .op.is-in .dwrap { animation-play-state: running; }
  @keyframes dcIn { from { opacity: 0; translate: 0 40px; rotate: -3deg; } to { opacity: 1; translate: 0 0; rotate: 0deg; } }
  @keyframes dcFloat { from { translate: 0 -4px; } to { translate: 0 6px; } }
  .adm.is-in .adm__photo { clip-path: inset(0 round 26px); }
  .adm.is-in .adm__photo :global(img) { transform: none; }
  .adm.is-in .adm__tag { opacity: 1; transform: none; }
  .adm__copy { position: relative; }
  .adm__h { margin-top: var(--s4); font-size: var(--d5); font-weight: 700; letter-spacing: var(--tr5); line-height: 1.1; }
  .adm__q { position: absolute; right: 0; top: -0.6rem; font-family: Georgia, serif; font-size: 9rem; line-height: 1; color: var(--p-mint); pointer-events: none; }
  .adm__msg { margin: 1.4rem 0 0; padding: 0 0 0 1.2rem; border-left: 3px solid var(--p-mint); display: grid; gap: 0.8rem; }
  .adm__msg p { font-size: 0.98rem; line-height: 1.72; color: var(--text-2); opacity: 0; transform: translateY(14px); transition: opacity 0.7s var(--ease), transform 0.7s var(--ease); }
  .adm__msg p:nth-child(2) { transition-delay: 0.15s; } .adm__msg p:nth-child(3) { transition-delay: 0.3s; }
  .adm.is-in .adm__msg p { opacity: 1; transform: none; }
  .adm__key { color: var(--text) !important; font-weight: 600; }
  .adm__chips { list-style: none; margin: 1.4rem 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.45rem; }
  .adm__chips li { padding: 0.4rem 0.8rem; border-radius: 999px; font-size: 0.8rem; font-weight: 600; background: var(--p-mint); color: var(--p-mint-ink); }
  .adm__chips li:nth-child(2) { background: var(--p-sky); color: var(--p-sky-ink); }
  .adm__chips li:nth-child(3) { background: var(--p-blush); color: var(--p-blush-ink); }
  .adm__chips li:nth-child(4) { background: var(--p-lilac); color: var(--p-lilac-ink); }
  .adm__chips li:nth-child(5) { background: var(--p-butter); color: var(--p-butter-ink); }
  .adm__sign { display: grid; }
  /* big pull-quote: words land one by one when the section arrives */
  .adm { position: relative; }
  .adm::before { content: '”'; position: absolute; right: 4%; bottom: -6rem; font-family: Georgia, serif; font-size: 28rem; line-height: 1; color: rgb(89 170 84 / 0.06);
    pointer-events: none; animation: admDrift 12s ease-in-out infinite alternate; }
  @keyframes admDrift { from { translate: 0 0; rotate: -3deg; } to { translate: -30px -20px; rotate: 3deg; } }
  .adm__big { position: relative; margin-top: var(--s4); font-size: var(--d5); font-weight: 700; letter-spacing: var(--tr5); line-height: 1.18; }
  .adm__qm { position: absolute; left: -0.1em; top: -0.55em; font-family: Georgia, serif; font-size: 3.2em; line-height: 1; color: var(--p-mint); z-index: -1; }
  .adm__w { display: inline-block; opacity: 0; filter: blur(6px); transform: translateY(0.4em); transition: opacity 0.5s var(--ease), transform 0.6s var(--ease), filter 0.5s var(--ease);
    transition-delay: calc(0.25s + var(--w) * 0.06s); }
  .adm.is-in .adm__w { opacity: 1; filter: none; transform: none; }
  .adm__w:nth-child(n+7):nth-child(-n+10) { color: var(--green-deep); }
  .adm__lead { margin-top: 1.4rem; max-width: 60ch; font-size: 0.98rem; line-height: 1.75; color: var(--text-2); opacity: 0; transform: translateY(14px); transition: opacity 0.8s var(--ease) 1.1s, transform 0.8s var(--ease) 1.1s; }
  .adm__commit { margin-top: 1rem; max-width: 60ch; font-size: 1.05rem; line-height: 1.7; font-weight: 600; color: var(--text); opacity: 0; transform: translateY(14px); transition: opacity 0.8s var(--ease) 1.3s, transform 0.8s var(--ease) 1.3s; }
  .adm.is-in .adm__lead, .adm.is-in .adm__commit { opacity: 1; transform: none; }
  /* the signature writes itself */
  .adm__sig { display: grid; }
  .adm__sigt { font-family: var(--font-script, 'Kaushan Script', cursive); font-size: 1.9rem; color: var(--green-deep); line-height: 1.1; clip-path: inset(0 100% 0 0); transition: clip-path 1.4s cubic-bezier(0.6, 0, 0.3, 1) 1.8s; }
  .adm.is-in .adm__sigt { clip-path: inset(0 0 0 0); }
  .adm__sig small { color: var(--text-3); font-size: 0.8rem; }
  /* little facts floating by the card */
  .dwrap { position: relative; }
  .adm__bub { position: absolute; z-index: 4; display: inline-flex; align-items: center; gap: 0.45rem; padding: 0.55rem 0.9rem; border-radius: 999px; background: #fff;
    box-shadow: 0 14px 30px -14px rgb(20 40 25 / 0.4); font-size: 0.82rem; font-weight: 700; color: var(--text); white-space: nowrap; animation: admBob 5s ease-in-out infinite alternate; }
  .adm__bub :global(svg) { color: var(--green); }
  .adm__bub--a { left: -2.2rem; top: 18%; }
  .adm__bub--b { right: -2.4rem; top: 58%; animation-delay: -2.5s; }
  @keyframes admBob { from { translate: 0 -6px; } to { translate: 0 8px; } }
  .adm__foot { margin-top: 1.6rem; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem; }
  .adm__more { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.7rem 1.2rem; border-radius: 999px; border: 1px solid rgb(0 0 0 / 0.12);
    font-weight: 600; font-size: 0.9rem; color: var(--green-deep); transition: background 0.25s, color 0.25s, border-color 0.25s; }
  .adm__more:hover { background: var(--green-deep); color: #fff; border-color: var(--green-deep); }
  .adm__sign span { font-family: var(--font-script); font-size: 1.5rem; color: var(--green-deep); }
  .adm__sign small { font-size: 0.8rem; color: var(--text-3); }

  /* ───── 03 journey ───── */
  .aj { background: #fff; padding-block: clamp(5rem, 10vw, 8rem); }
  .aj__intro { max-width: 44rem; margin: 0 auto clamp(3rem, 6vw, 4.5rem); text-align: center; display: grid; justify-items: center; }
  .aj__h { margin-top: var(--s4); font-size: var(--d5); font-weight: 700; letter-spacing: var(--tr5); line-height: 1.1; }
  .aj__p { margin-top: var(--s4); max-width: 52ch; font-size: 0.9375rem; line-height: 1.68; color: var(--text-2); }
  /* one line across, four stops; the line draws itself and each stop pops in as it arrives */
  .aj__line { position: relative; list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.4rem; }
  .aj__rail { position: absolute; left: 12.5%; right: 12.5%; top: 29px; height: 2px; background: rgb(0 0 0 / 0.08); border-radius: 2px; }
  .aj__rail i { display: block; height: 100%; width: 100%; border-radius: 2px; transform-origin: left; transform: scaleX(0);
    background: linear-gradient(90deg, #1f8a4c, #2d6fd0, #14878a, #6f52c9); transition: transform 1.6s cubic-bezier(0.6, 0, 0.2, 1) 0.2s; }
  .aj__line.is-in .aj__rail i { transform: scaleX(1); }
  .aj__m { --c: #1f8a4c; --t: #e3f3e6; position: relative; display: grid; justify-items: center; text-align: center; gap: 0.35rem; padding: 0 0.4rem;
    opacity: 0; transform: translateY(18px); transition: opacity 0.6s var(--ease), transform 0.7s var(--ease); transition-delay: calc(0.3s + var(--i) * 0.35s); }
  .aj__m:nth-child(3) { --c: #2d6fd0; --t: #e4edfa; }
  .aj__m:nth-child(4) { --c: #14878a; --t: #dff2f1; }
  .aj__m:nth-child(5) { --c: #6f52c9; --t: #efe8f8; }
  .aj__line.is-in .aj__m { opacity: 1; transform: none; }
  .aj__dot { display: grid; place-items: center; width: 60px; height: 60px; border-radius: 50%; background: var(--t); color: var(--c);
    box-shadow: 0 0 0 6px #fff, 0 12px 26px -14px var(--c); transform: scale(0.4); transition: transform 0.6s cubic-bezier(0.3, 1.6, 0.5, 1); transition-delay: calc(0.35s + var(--i) * 0.35s); }
  .aj__line.is-in .aj__dot { transform: none; }
  .aj__m:hover .aj__dot { transform: translateY(-4px) scale(1.05); transition-delay: 0s; }
  /* a light that runs along the finished line, over and over */
  .aj__spark { position: absolute; top: 50%; left: 0; width: 70px; height: 6px; margin-top: -3px; border-radius: 6px; opacity: 0;
    background: radial-gradient(closest-side, #fff, rgb(255 255 255 / 0)); box-shadow: 0 0 14px 4px rgb(89 170 84 / 0.55); }
  .aj__line.is-run .aj__spark { animation: ajSpark 3.2s cubic-bezier(0.45, 0, 0.55, 1) infinite; }
  @keyframes ajSpark { 0% { left: -4%; opacity: 0; } 10% { opacity: 1; } 90% { opacity: 1; } 100% { left: 96%; opacity: 0; } }
  /* the stop that is "current" gets a pulse ring and lifts a little */
  .aj__dot { position: relative; }
  .aj__dot::before, .aj__dot::after { content: ''; position: absolute; inset: -8px; border-radius: 50%; pointer-events: none; }
  .aj__dot::before { border: 2px solid var(--c); opacity: 0; }
  .aj__m.is-cur .aj__dot::before { animation: ajPulse 1.6s ease-out infinite; }
  @keyframes ajPulse { 0% { transform: scale(0.85); opacity: 0.8; } 100% { transform: scale(1.45); opacity: 0; } }
  .aj__dot::after { inset: -6px; border: 1.5px dashed color-mix(in oklab, var(--c) 55%, transparent); opacity: 0; transition: opacity 0.3s; }
  .aj__m:hover .aj__dot::after, .aj__m.is-cur .aj__dot::after { opacity: 1; animation: ajSpin 8s linear infinite; }
  @keyframes ajSpin { to { transform: rotate(360deg); } }
  .aj__line.is-in .aj__m.is-cur .aj__dot { transform: scale(1.1); background: var(--c); color: #fff; transition-delay: 0s; }
  .aj__m.is-cur .aj__yr { transform: translateY(-3px); }
  .aj__yr { transition: transform 0.4s var(--ease); font-variant-numeric: tabular-nums; }
  .aj__m::after { content: ''; display: block; width: 0; height: 2px; margin-top: 0.3rem; border-radius: 2px; background: var(--c); transition: width 0.5s var(--ease); }
  .aj__m.is-cur::after, .aj__m:hover::after { width: 36px; }
  .aj__yr { margin-top: 0.8rem; font-size: var(--d6); font-weight: 700; letter-spacing: var(--tr6); color: var(--c); }
  .aj__t { max-width: 24ch; font-size: 0.9rem; line-height: 1.55; color: var(--text-2); }

  /* ───── 05 difference ───── */
  .ad { background: radial-gradient(50% 60% at 90% 20%, rgb(239 232 248 / 0.7), transparent 70%), #fbfbfd; color: var(--text); padding-block: clamp(5rem, 10vw, 8rem); overflow: hidden; }
  .ad__in { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(2rem, 5vw, 5rem); align-items: center; }
  /* the photo opens out from a smaller frame as it arrives */
  .ad__shot { margin: 0; aspect-ratio: 4 / 5; border-radius: 28px; overflow: hidden; box-shadow: 0 40px 80px -50px rgb(20 40 25 / 0.45);
    clip-path: inset(var(--ci, 10%) round 28px); will-change: clip-path; }
  .ad__shot :global(img) { width: 100%; height: 100%; object-fit: cover; transform: scale(var(--cs, 1.12)); }
  .ad__copy { display: grid; justify-items: start; }
  .ad__h { margin-top: var(--s4); font-size: var(--d5); font-weight: 700; letter-spacing: var(--tr5); line-height: 1.1; --brush-size: 1.15; }
  .ad__p { margin-top: var(--s4); max-width: 46ch; font-size: 0.9375rem; line-height: 1.68; color: var(--text-2); }
  .ad__proof { list-style: none; margin: 1.6rem 0 1.8rem; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .ad__proof li { display: inline-flex; align-items: center; gap: 0.45rem; padding: 0.5rem 0.9rem; border-radius: 999px; background: #fff; border: 1px solid rgb(0 0 0 / 0.08); font-size: 0.85rem; }
  .ad__proof span { color: var(--green-deep); display: grid; }
  .ad__proof li { border-color: transparent; }
  .ad__proof li:nth-child(1) { background: var(--p-mint); } .ad__proof li:nth-child(1) span { color: var(--p-mint-ink); }
  .ad__proof li:nth-child(2) { background: var(--p-butter); } .ad__proof li:nth-child(2) span { color: var(--p-butter-ink); }
  .ad__proof li:nth-child(3) { background: var(--p-blush); } .ad__proof li:nth-child(3) span { color: var(--p-blush-ink); }
  .ad__proof li:nth-child(4) { background: #fff; } .ad__proof li:nth-child(4) span { color: var(--p-sky-ink); }

  /* ───── 06 presence ───── */
  .pr {
    background: linear-gradient(185deg, #fafcfa, #f1f8f1 62%, #eef6ee);
  }
  .pr__grid { display: grid; gap: clamp(1.75rem, 4vw, 2.75rem); align-items: center; }
  .pr__intro { display: grid; justify-items: start; }
  .pr__h {
    margin-top: var(--s4); font-size: var(--d5);
    font-weight: 700; letter-spacing: var(--tr5); line-height: 1.08;
  }
  .pr__h em { font-style: normal; color: var(--green-deep); }
  .pr__p {
    margin-top: var(--s4); max-width: 34ch;
    font-size: 0.875rem; line-height: 1.62; color: var(--text-2);
  }

  /* 21rem rather than the silhouette's 16rem: a real tile render carries
     coastline, borders and place names, and at 16rem none of that is
     legible — the whole point of using the real map. */
  .pr__map { position: relative; width: 100%; max-width: 21rem; justify-self: center; margin: 0;
    padding: 0.4rem; border-radius: 22px; background: #eef3ec; border: 1px solid rgb(20 40 25 / 0.06);
    box-shadow: 0 26px 50px -38px rgb(40 50 45 / 0.4);
    opacity: 0; transition: opacity 760ms var(--ease) 100ms; }
  .pr__map[data-in] { opacity: 1; }
  /* Same treatment as the homepage map: a light sepia rotated onto the
     section's green, which keeps the render readable while letting it
     sit back as a backdrop. Plain grayscale(1) crushed it to mush. */
  .pr__map :global(img) { display: block; width: 100%; height: auto; border-radius: 18px;
    filter: grayscale(0.72) sepia(0.12) hue-rotate(58deg) contrast(1.02) brightness(1.03); }

  /* One element per branch now: the dot and its label travel together, so
     the label cannot drift off its pin the way the old separate chip
     could — that is what the per-city `nudge` table was compensating for. */
  .pr__pin {
    --pd: calc(700ms + var(--i) * 130ms);
    position: absolute; left: var(--x); top: var(--y);
    display: flex; align-items: center; gap: 0.45rem;
    translate: -50% -50%;
    opacity: 0; scale: 0.4;
    transition: opacity 320ms var(--ease) var(--pd),
      scale 540ms cubic-bezier(0.3, 1.6, 0.5, 1) var(--pd);
  }
  .pr__map[data-in] .pr__pin { opacity: 1; scale: 1; }
  .pr__pin i {
    width: 13px; height: 13px; flex: none; border-radius: 50%;
    background: var(--green-deep); box-shadow: 0 0 0 5px rgb(47 100 41 / 0.18);
    transition: box-shadow var(--t2) var(--ease);
  }
  .pr__pin span {
    padding: 0.2rem 0.55rem; border-radius: 999px; background: #fff;
    box-shadow: 0 6px 16px -9px rgb(10 30 12 / 0.5);
    font-size: 0.6875rem; font-weight: 600; white-space: nowrap; color: var(--text);
    transition: color var(--t2) var(--ease), background-color var(--t2) var(--ease);
  }
  /* white on --green-deep is 7.06:1 */
  .pr__pin:hover span { background: var(--green-deep); color: #fff; }
  .pr__pin:hover i { box-shadow: 0 0 0 9px rgb(47 100 41 / 0.22); }
  /* Salalah sits at the bottom-left corner; its label would run off the
     image, so that one hangs to the left of its dot instead. */
  .pr__pin:last-child { flex-direction: row-reverse; }

  .pr__list { display: grid; gap: 0.6rem; }
  .br {
    display: flex; align-items: center; gap: 0.85rem;
    padding: 0.65rem 0.9rem 0.65rem 0.65rem; border-radius: 14px;
    background: rgb(255 255 255 / 0.86); backdrop-filter: blur(8px);
    box-shadow: 0 1px 2px rgb(10 30 12 / 0.04), 0 10px 26px -20px rgb(10 30 12 / 0.28);
    transition: transform var(--t2) var(--ease), box-shadow var(--t2) var(--ease);
  }
  .br:hover {
    transform: translateX(4px);
    box-shadow: 0 1px 2px rgb(10 30 12 / 0.04), 0 20px 38px -24px rgb(10 30 12 / 0.34);
  }
  /* Held frame — branch photography still to come. */
  .br__shot {
    display: grid; place-items: center; width: 56px; height: 44px; flex: none;
    border: 1px dashed var(--line-light); border-radius: 10px;
    background: var(--off);
  }
  .br__shot i {
    font-style: normal; font-family: var(--font-mono); font-size: 0.5rem;
    letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-3);
  }
  .br__t { display: grid; min-width: 0; }
  .br__t b { font-size: 0.9375rem; font-weight: 700; letter-spacing: -0.02em; }
  .br__t em { margin-top: 0.1rem; font-style: normal; font-size: 0.75rem; color: var(--text-3); }
  .br__go {
    display: grid; place-items: center; width: 28px; height: 28px; flex: none;
    margin-left: auto; border-radius: 50%; color: var(--green-deep);
    transition: transform var(--t2) var(--ease);
  }
  .br:hover .br__go { transform: translateX(3px); }


  /* ───── 05b team (draft) ───── */
  .at { background: var(--white); padding-block: clamp(5rem, 10vw, 8rem); }
  .at__head { display: flex; justify-content: space-between; align-items: end; gap: 2rem; flex-wrap: wrap; margin-bottom: 2.5rem; }
  .at__h { margin-top: var(--s4); font-size: var(--d5); font-weight: 700; letter-spacing: var(--tr5); line-height: 1.1; }
  .at__h em { font-style: normal; color: var(--green-deep); }
  .at__p { max-width: 34ch; color: var(--text-2); line-height: 1.6; }
  .at__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; perspective: 1200px; }
  .at__card { position: relative; border-radius: 22px; overflow: hidden; background: var(--off); border: 1px solid rgb(0 0 0 / 0.06);
    transform-style: preserve-3d; transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg)); transition: transform 0.5s var(--ease), box-shadow 0.5s var(--ease); }
  .at__card:hover { box-shadow: 0 30px 60px -30px rgb(20 40 25 / 0.35); }
  .at__img { margin: 0; aspect-ratio: 4 / 5; overflow: hidden; }
  .at__img :global(img) { width: 100%; height: 100%; object-fit: cover; filter: grayscale(0.35); transition: filter 0.5s, transform 0.8s var(--ease); }
  .at__card:hover .at__img :global(img) { filter: none; transform: scale(1.05); }
  .at__meta { display: grid; gap: 0.2rem; padding: 1rem 1.1rem 1.2rem; transform: translateZ(30px); }
  .at__role { font-size: 1.1rem; font-weight: 700; letter-spacing: -0.02em; color: var(--green-deep); }
  .at__meta small { color: var(--text-2); font-size: 0.82rem; line-height: 1.45; }

  /* ───── 05c trusted by ───── */
  .aq { background: #fff; padding-block: clamp(5rem, 10vw, 8rem); overflow: hidden; }
  .aq__head { text-align: center; display: grid; justify-items: center; }
  .aq__h { margin-top: var(--s4); font-size: var(--d5); font-weight: 700; letter-spacing: var(--tr5); line-height: 1.1; }
  .aq__h em { font-style: normal; color: var(--green-deep); }
  /* brands glide past in one endless row, fading out at both edges */
  .aq__mq { margin: 2.6rem 0 3.4rem; -webkit-mask: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent); mask: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent); }
  .aq__track { display: flex; width: max-content; animation: aqMq 40s linear infinite; }
  .aq__mq:hover .aq__track { animation-play-state: paused; }
  .aq__track ul { display: flex; list-style: none; margin: 0; padding: 0; }
  .aq__track li { padding: 0.9rem 2.2rem; font-weight: 700; font-size: var(--d7); letter-spacing: var(--tr7); color: rgb(0 0 0 / 0.32); transition: color 0.3s; white-space: nowrap; }
  .aq__track li:hover { color: var(--green-deep); }
  @keyframes aqMq { to { transform: translateX(-50%); } }
  /* the wall: three columns of reviews drifting upward at different speeds */
  .aq__wall { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; height: 34rem; overflow: hidden;
    -webkit-mask: linear-gradient(180deg, transparent, #000 14%, #000 86%, transparent); mask: linear-gradient(180deg, transparent, #000 14%, #000 86%, transparent); }
  .aq__run { display: grid; gap: 1rem; animation: aqUp var(--dur, 40s) linear infinite; }
  .aq__col:nth-child(2) .aq__run { animation-direction: reverse; }
  .aq__wall:hover .aq__run { animation-play-state: paused; }
  @keyframes aqUp { to { transform: translateY(calc(-50% - 0.5rem)); } }
  .aq__q { margin: 0; display: grid; gap: 0.8rem; padding: 1.4rem; border-radius: 20px; background: var(--white); border: 1px solid rgb(0 0 0 / 0.06);
    box-shadow: 0 20px 40px -32px rgb(20 40 25 / 0.35); transition: transform 0.4s var(--ease), box-shadow 0.4s var(--ease); }
  .aq__q:hover { transform: translateY(-3px); box-shadow: 0 26px 50px -30px rgb(20 40 25 / 0.45); }
  .aq__q { position: relative; margin-top: 1.4rem; }
  .aq__mark { position: absolute; top: -1.55rem; left: 1rem; font-family: Georgia, serif; font-size: 4.2rem; line-height: 1; font-weight: 700; color: var(--green); }
  .aq__col .aq__run > :nth-child(3n+2) .aq__mark { color: #e8a33d; }
  .aq__col .aq__run > :nth-child(3n) .aq__mark { color: #6aa9d8; }
  .aq__top { display: flex; align-items: center; gap: 0.75rem; }
  .aq__av { display: grid; place-items: center; width: 42px; height: 42px; flex: none; border-radius: 50%; background: var(--p-mint); color: var(--p-mint-ink); font-weight: 700; }
  .aq__col:nth-child(2) .aq__av { background: var(--p-sky); color: var(--p-sky-ink); }
  .aq__col:nth-child(3) .aq__av { background: var(--p-blush); color: var(--p-blush-ink); }
  .aq__who { display: grid; min-width: 0; }
  .aq__who b { font-size: 0.95rem; }
  .aq__who small { color: var(--text-3); font-size: 0.78rem; }
  .aq__g { margin-left: auto; display: grid; place-items: center; width: 26px; height: 26px; border-radius: 50%; border: 1px solid rgb(0 0 0 / 0.1); font-weight: 700; font-size: 0.8rem; color: #4285f4; }
  .aq__stars { color: #f5b400; letter-spacing: 0.12em; font-size: 0.85rem; }
  /* The stars a reviewer did NOT give, so a 4-star review reads as four
     and not as five. Grey rather than absent, which keeps the row the
     same width on every card. */
  .aq__stars i { font-style: normal; color: rgb(0 0 0 / 0.16); }
  .aq__rh { display: grid; justify-items: center; text-align: center; margin: 1rem 0 2.2rem; }
  .aq__draft { margin-top: 1.2rem; text-align: center; font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.08em; color: #b26a00; }
  .aq__q blockquote { margin: 0; font-size: 0.95rem; line-height: 1.6; color: var(--text-3); }
  @media (max-width: 56rem) {
    .dr { grid-template-columns: 1fr; }
    .dr__fig { width: min(80%, 18rem); }
    .dr__side { border-left: 0; border-top: 1px solid rgb(0 0 0 / 0.1); padding: 1rem 0 0; min-height: 0; }
    .dr__q { display: none; }
    .pp__in { grid-template-columns: 1fr; }
    .wd__grid { grid-template-columns: 1fr 1fr; }
    .op__in { grid-template-columns: 1fr; }
    .ww__in { grid-template-columns: 1fr; }
    .mv__grid { grid-template-columns: 1fr; }
    .adm__in { grid-template-columns: 1fr; }
      .aq__wall { grid-template-columns: 1fr; height: auto; -webkit-mask: none; mask: none; }
    .aq__col:not(:first-child) { display: none; }
    .aq__run { animation: none; }
    .aq__run > [aria-hidden='true'] { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .dr__photo { opacity: 1; translate: 0 0; transition: none; }
    .dr__shape--b { opacity: 1; transform: none; }
    .dr__sig { clip-path: none; transition: none; }
    .dm__qi { transform: none; transition: none; }
    .av__view.is-on { animation: none; }
    .dwrap { animation: none; }
    .adm__w, .adm__lead, .adm__commit { opacity: 1; filter: none; transform: none; transition: none; }
    .adm__sigt { clip-path: none; transition: none; }
    .adm::before, .adm__bub { animation: none; }
    .dpc__ring::before, .dpc__badge { animation: none; }
    .mv__card { opacity: 1; transform: none; transition: none; }
    .aq__track, .aq__run { animation: none; }
    .aq__wall { height: auto; -webkit-mask: none; mask: none; }
  }

  /* ───── 07 cta ───── */
  .ac { background: var(--white); padding-block: clamp(4rem, 8vw, 6rem); }
  .ac__panel { display: grid; justify-items: center; text-align: center; padding: clamp(3rem, 7vw, 5rem) 1.5rem; border-radius: 32px;
    background: linear-gradient(120deg, rgb(227 243 230 / 0.7) 0%, #fbfcfb 50%, rgb(228 237 250 / 0.7) 100%); border: 1px solid rgb(0 0 0 / 0.05); }
  .ac__h { margin-top: var(--s4); font-size: var(--d5); font-weight: 700; letter-spacing: var(--tr5); line-height: 1.1; --brush-size: 1.15; }
  .ac__p { margin-top: var(--s3); color: var(--text-2); font-size: 0.9375rem; }
  .ac__b { display: inline-flex; align-items: center; gap: 0.7rem; margin-top: 1.8rem; padding: 1rem 1.7rem; border-radius: 999px; background: var(--green-deep); color: #fff; font-weight: 700; transition: background 0.25s, transform 0.3s; }
  .ac__b:hover { background: var(--green); }

  /* ───── responsive ───── */
  @media (min-width: 62rem) {
    .pr__grid { grid-template-columns: minmax(0, 0.85fr) minmax(0, 0.7fr) minmax(0, 1.1fr); }
  }
  @media (max-width: 56rem) {
    .aj__line { grid-template-columns: 1fr; gap: 2rem; padding-left: 0; }
    .aj__rail { left: 29px; right: auto; top: 30px; bottom: 30px; width: 2px; height: auto; }
    .aj__rail i { transform-origin: top; transform: scaleY(0); }
    .aj__line.is-in .aj__rail i { transform: scaleY(1); }
    .aj__m { grid-template-columns: 60px 1fr; justify-items: start; text-align: left; column-gap: 1rem; }
    .aj__dot { grid-row: span 2; }
    .aj__yr { margin-top: 0.4rem; }
    .ah__in, .ad__in { grid-template-columns: 1fr; }
    .af__grid { grid-template-columns: 1fr 1fr; }
    .af__c { flex-direction: column; align-items: flex-start; gap: 0.7rem; }
    .af__i { width: 44px; height: 44px; }
    .ac__in { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ah__bg, .ah__l > span, .ah__eb, .ah__p, .ah__acts, .ah__mantra, .ah__play::after{ animation: none; opacity: 1; transform: none; clip-path: none; }
    .aj__m, .aj__dot, .aj__rail i { opacity: 1; transform: none; transition: none; }
    .aj__spark { display: none; }
    .adm__back, .adm__photo, .adm__photo :global(img), .adm__tag, .adm__msg p { opacity: 1; transform: none; clip-path: none; transition: none; }
    .af__c { transform: none; }
    .ad__shot { clip-path: none; }
    .pr__map, .pr__map .pr__pin { opacity: 1; scale: 1; transition: none; }
    .btn, .btn:hover, .br, .br:hover { transform: none; transition: none; }
  }
</style>

<script>
  function start() {
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const hero = document.querySelector<HTMLElement>('[data-ah]');
    if (!hero || hero.dataset.wired) return;
    hero.dataset.wired = '1';
    const header = document.querySelector('header');
    if (header) document.documentElement.style.setProperty('--hdr', `${header.offsetHeight}px`);
    /* Director's message: reveal on arrival, full message in a dialog */
    const dm = document.querySelector<HTMLElement>('[data-dm]');
    if (dm) {
      new IntersectionObserver((es, o) => { if (es[0].isIntersecting) { dm.classList.add('is-in'); o.disconnect(); } }, { threshold: 0.3 }).observe(dm);
      const dlg = dm.querySelector<HTMLDialogElement>('[data-dmd]')!;
      dm.querySelector('[data-dm-open]')?.addEventListener('click', () => dlg.showModal());
      dlg.querySelector('[data-dmd-close]')?.addEventListener('click', () => dlg.close());
      dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
    }

    /* hero: rotate the handwritten phrase */
    const rot = document.querySelector<HTMLElement>('[data-rot]');
    if (rot && !reduced) {
      const ws = [...rot.querySelectorAll<HTMLElement>('.rot__w')];
      let i = 0;
      const fit = () => { rot.style.width = `${ws[i].scrollWidth}px`; };
      fit(); addEventListener('resize', fit);
      setInterval(() => {
        if (document.hidden || !rot.isConnected) return;
        const cur = ws[i]; i = (i + 1) % ws.length; const nxt = ws[i];
        cur.classList.remove('is-on'); cur.classList.add('is-out');
        nxt.classList.remove('is-out'); nxt.classList.add('is-on');
        setTimeout(() => cur.classList.remove('is-out'), 800);
        fit();
      }, 2800);
    }

    if (reduced) return;

    const bg = hero.querySelector<HTMLElement>('[data-ah-bg]')!;
    const adm = document.querySelector<HTMLElement>('[data-adm]');
    if (adm) new IntersectionObserver((es, o) => { if (es[0].isIntersecting) { adm.classList.add('is-in'); o.disconnect(); } }, { threshold: 0.25 }).observe(adm);
    const line = document.querySelector<HTMLElement>('[data-aj]');
    if (line) new IntersectionObserver((es, o) => {
      if (!es[0].isIntersecting) return;
      o.disconnect();
      line.classList.add('is-in');
      const stops = [...line.querySelectorAll<HTMLElement>('.aj__m')];
      const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (still) return;
      /* each year counts up (or types itself) as its stop pops in */
      stops.forEach((m, i) => {
        const el = m.querySelector<HTMLElement>('[data-aj-yr]')!;
        const target = el.dataset.ajYr!;
        const n = Number(target);
        el.textContent = Number.isFinite(n) ? String(n - 60) : '';   // start value while the stop is still hidden
        setTimeout(() => {
          if (Number.isFinite(n)) {
            const from = n - 60, t0 = performance.now();
            const step = (t: number) => { const k = Math.min(1, (t - t0) / 900); el.textContent = String(Math.round(from + (n - from) * (1 - Math.pow(1 - k, 3)))); if (k < 1) requestAnimationFrame(step); };
            requestAnimationFrame(step);
          } else {
            el.textContent = ''; let c = 0;
            const iv = setInterval(() => { el.textContent = target.slice(0, ++c); if (c >= target.length) clearInterval(iv); }, 90);
          }
        }, 350 + i * 350);
      });
      /* once all four are in: the light starts running and the "current" stop steps along */
      setTimeout(() => {
        line.classList.add('is-run');
        let cur = 0;
        const mark = () => stops.forEach((m, i) => m.classList.toggle('is-cur', i === cur));
        mark();
        setInterval(() => { if (!document.hidden && line.isConnected) { cur = (cur + 1) % stops.length; mark(); } }, 2400);
      }, 350 + stops.length * 350 + 600);
    }, { threshold: 0.35 }).observe(line);
    const ad = document.querySelector<HTMLElement>('[data-ad]');
    const shot = ad?.querySelector<HTMLElement>('[data-ad-shot]');
    const clamp = (v: number) => Math.min(1, Math.max(0, v));

    let raf = 0;
    const tick = () => {
      raf = 0;
      const H = innerHeight;
      /* hero photo drifts slower than the page */
      const hr = hero.getBoundingClientRect();
      if (hr.bottom > 0) (bg.querySelector('img') as HTMLElement | null)?.style.setProperty('transform', `translate3d(0, ${Math.max(-80, hr.top * 0.18)}px, 0)`);
      /* difference: the framed photo opens out to full width as it arrives */
      if (ad && shot) {
        const r = ad.getBoundingClientRect();
        const p = clamp((H - r.top) / (H * 0.9));
        const e = 1 - Math.pow(1 - p, 3);
        shot.style.setProperty('--ci', `${(1 - e) * 10}%`);
        shot.style.setProperty('--cs', String(1.12 - 0.12 * e));
      }
    };
    const req = () => { if (!raf) raf = requestAnimationFrame(tick); };
    addEventListener('scroll', req, { passive: true });
    addEventListener('resize', req);
    tick();

    const fine = matchMedia('(hover: hover) and (pointer: fine)').matches;
    if (fine) {
      /* figures: each card tilts toward the pointer, with a light under it */
      document.querySelectorAll<HTMLElement>('[data-tilt]').forEach((c) => {
        c.addEventListener('pointermove', (e) => {
          const r = c.getBoundingClientRect(), x = (e.clientX - r.left) / r.width, y = (e.clientY - r.top) / r.height;
          c.style.setProperty('--ry', `${(x - 0.5) * 14}deg`); c.style.setProperty('--rx', `${(0.5 - y) * 12}deg`);
          c.style.setProperty('--mx', `${x * 100}%`); c.style.setProperty('--my', `${y * 100}%`);
        });
        c.addEventListener('pointerleave', () => { c.style.setProperty('--rx', '0deg'); c.style.setProperty('--ry', '0deg'); });
      });
      /* hero: the headline block leans a touch with the pointer */
      const tilt = hero.querySelector<HTMLElement>('[data-ah-tilt]')!;
      hero.addEventListener('pointermove', (e) => {
        const x = e.clientX / innerWidth - 0.5, y = e.clientY / innerHeight - 0.5;
        tilt.style.transform = `perspective(1400px) rotateY(${x * 4}deg) rotateX(${-y * 3}deg)`;
        bg.style.translate = `${-x * 10}px ${-y * 8}px`;
      });
      hero.addEventListener('pointerleave', () => { tilt.style.transform = ''; bg.style.translate = ''; });
    }

    /* the call-to-action button leans toward the pointer */
    document.querySelectorAll<HTMLElement>('[data-mag]').forEach((b) => {
      b.addEventListener('pointermove', (e) => { const r = b.getBoundingClientRect(); b.style.transform = `translate(${(e.clientX - r.left - r.width / 2) * 0.2}px, ${(e.clientY - r.top - r.height / 2) * 0.3}px)`; });
      b.addEventListener('pointerleave', () => (b.style.transform = ''));
    });
  }
  document.addEventListener('astro:page-load', start);
</script>
