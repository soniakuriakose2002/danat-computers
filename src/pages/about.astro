---
import { Image } from 'astro:assets';
import PageLayout from '@layouts/PageLayout.astro';
import Icon from '@components/ui/Icon.astro';
import PurposeOrbit from '@components/sections/PurposeOrbit.astro';
import VideoModal from '@components/global/VideoModal.astro';
import StoryCard from '@components/global/StoryCard.astro';
import { site, branches } from '@data/site';
import { OMAN_PATH, OMAN_VIEWBOX, OMAN_PINS } from '@data/omanMap';
import imgTech from '@assets/photos/repair-solder.jpg';
import imgFilm from '@assets/photos/film-poster.jpg';
import imgHero from '@assets/photos/support-desk.jpg';
import laptop from '@assets/products/laptop-hero.png';
import Brush from '@components/ui/Brush.astro';

const years = new Date().getFullYear() - site.stats.since;

/**
 * ⚠ THREE ITEMS BELOW ARE NOT VERIFIED — they come from the client's
 * mockup, not from Danat's records, and the client has asked for the
 * mockup reproduced exactly. Confirm all three before this site goes
 * public:
 *   1. "1000+ happy customers" — no source of any kind.
 *   2. The 2010 and 2016 milestone years — invented by the mockup.
 *      Only 2003 is real (earliest record in the ERP export).
 *   3. The milestone descriptions attached to those two years.
 * Everything else on this page traces to site.ts or the ERP export.
 */
const figures = [
  { icon: 'calendar', v: years, suffix: '+', l: 'Years in business', sub: `Since ${site.stats.since}` },
  { icon: 'building', v: site.stats.branches, suffix: '', l: 'Branches in Oman', sub: branches.map((b) => b.city.split(',')[0]).join(', ') },
  { icon: 'box', v: site.stats.parts, suffix: '', l: 'Products in stock', sub: `Across ${site.stats.categories} categories` },
  { icon: 'users', v: 1000, suffix: '+', l: 'Happy customers', sub: 'Individuals & businesses', unverified: true },
];

const journey = [
  { year: '2003', t: 'Opened our first store in Ruwi, Muscat.', verified: true },
  { year: '2010', t: 'Expanded our product range and IT solutions.', verified: false },
  { year: '2016', t: 'Grew across Oman with new branches in Sohar and Salalah.', verified: false },
  { year: 'Today', t: 'Continuing to support individuals, businesses and organisations.', verified: true },
];

const proof = [
  { icon: 'chip', t: 'Board level repair' },
  { icon: 'wrench', t: 'Genuine spares' },
  { icon: 'users', t: 'Experienced team' },
  { icon: 'bolt', t: 'Faster turnaround' },
];

const mapOrder = ['sohar', 'ruwi', 'salalah'];
const mapList = mapOrder.map((s) => branches.find((b) => b.slug === s)!);
const W = 1000;
const H = 1342;
const nudge: Record<string, string> = { sohar: '0%', hail: '-3.4%', ruwi: '2.8%', salalah: '0%' };

---
<PageLayout
  title="About"
  description={`${site.nameFull} has supplied and repaired computers across Oman since ${site.stats.since} — three branches, ${site.stats.parts.toLocaleString('en-US')} lines in stock, board-level repair.`}
>
  {/* ══════ 01 · hero — full screen, the photo drifts as you scroll ══════ */}
  <section class="ah" data-ah data-tone="ink">
    <div class="ah__bg" data-ah-bg aria-hidden="true">
      <Image src={imgHero} alt="" widths={[900, 1400, 2000]} sizes="100vw" quality={72} format="webp" loading="eager" />
    </div>
    <div class="shell ah__in" data-ah-tilt>
      <p class="eb eb--inv ah__eb"><i class="eb__r" aria-hidden="true"></i>About Danat</p>
      <h1 class="ah__h">
        <span class="ah__l"><span>Technology</span></span>
        <span class="ah__l"><span>That Keeps</span></span>
        <span class="ah__l"><span><em>Oman Moving.</em></span></span>
      </h1>
      <div class="ah__row">
        <p class="ah__p">
          For over two decades, Danat Computers has been a trusted name in
          computer products, services and business solutions across Oman. We
          don't just sell technology — we keep it running.
        </p>
        <div class="ah__acts">
          <button class="btn" type="button" data-story-open>
            Our story<span class="btn__i" aria-hidden="true"><Icon name="arrow" size={15} /></span>
          </button>
          <button class="ah__film" type="button" data-video-open aria-label="Watch the film: inside Danat Computers">
            <span class="ah__play" aria-hidden="true"><Icon name="play" size={13} /></span>
            <span><b>Watch the film</b><em>Inside Danat Computers</em></span>
          </button>
        </div>
      </div>
      <p class="ah__mantra">People · Products · Support · A brighter tomorrow</p>
    </div>
    <span class="ah__hint" aria-hidden="true">Scroll</span>
    <div class="ah__wave" aria-hidden="true">
      <svg viewBox="0 0 1440 130" preserveAspectRatio="none"><path class="b" d="M0,38 C106,6 214,42 336,76 C524,130 712,80 908,38 C1104,-4 1276,116 1440,14 L1440,134 L0,134 Z"/><path class="f" d="M0,58 C118,22 248,64 380,98 C570,146 760,100 950,52 C1140,4 1300,132 1440,34 L1440,134 L0,134 Z"/></svg>
    </div>
  </section>

  {/* ══════ 02 · figures — 3D tilt cards with a light that follows the pointer ══════ */}
  <section class="af">
    <dl class="shell af__grid">
      {figures.map((f, i) => (
        <div class:list={['af__c', `af__c--${i}`]} data-tilt>
          <span class="af__glow" aria-hidden="true"></span>
          <span class="af__i" aria-hidden="true"><Icon name={f.icon} size={20} /></span>
          <dt><span data-count={f.v}>{Number(f.v).toLocaleString('en-US')}</span>{f.suffix}</dt>
          <dd>{f.l}</dd>
          <small>{f.sub}</small>
        </div>
      ))}
    </dl>
  </section>

  {/* ══════ 03 · journey — milestone cards stack up in 3D as you scroll ══════ */}
  <section class="aj" id="journey" data-aj>
    <div class="shell">
      <div class="aj__intro">
        <p class="eb"><i class="eb__r" aria-hidden="true"></i>Our journey</p>
        <h2 class="aj__h">From a small shop<br />to a <Brush>trusted partner.</Brush></h2>
        <p class="aj__p">
          What started as a single counter has grown into a company with
          branches across Oman, serving thousands of customers. Our focus has
          always been the same — genuine products, expert service and
          long-term relationships.
        </p>
      </div>
      <ol class="aj__stack">
        {journey.map((j, i) => (
          <li class:list={['aj__card', `aj__card--${i % 4}`]} data-aj-card style={`--i:${i}`}>
            <span class="aj__n">{String(i + 1).padStart(2, '0')} / {String(journey.length).padStart(2, '0')}</span>
            <b class="aj__yr">{j.year}</b>
            <p class="aj__t">{j.t}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* ══════ 04 · purpose (unchanged) ══════ */}
  <PurposeOrbit />

  {/* ══════ 05 · the difference — the photo opens out to full width ══════ */}
  <section class="ad" data-ad data-tone="ink">
    <figure class="ad__shot" data-ad-shot>
      <Image src={imgTech} alt="A Danat technician tracing a fault on a mainboard"
        widths={[900, 1400, 2000]} sizes="100vw" quality={74} format="webp" loading="lazy" />
    </figure>
    <div class="shell ad__in">
      <div class="ad__copy">
        <p class="eb eb--inv" data-rise><i class="eb__r" aria-hidden="true"></i>The difference</p>
        <h2 class="ad__h" data-rise style="--d:70ms">Most shops replace<br />the board. <em>We repair it.</em></h2>
        <p class="ad__p" data-rise style="--d:130ms">
          A replacement mainboard is often most of the value of the machine. A
          failed component on it is usually worth a fraction of that. Tracing
          the fault to the component takes a bench, a meter and someone who
          knows what they are looking at — which is what {years} years buys
          you, and what almost nobody else in Oman does in-house.
        </p>
        <ul class="ad__proof">
          {proof.map((p, i) => (
            <li data-rise style={`--d:${190 + i * 60}ms`}><span aria-hidden="true"><Icon name={p.icon} size={16} /></span>{p.t}</li>
          ))}
        </ul>
        <a class="btn" href="/services" data-rise style="--d:420ms">
          Our repair services<span class="btn__i" aria-hidden="true"><Icon name="arrow" size={15} /></span>
        </a>
      </div>
    </div>
  </section>

  {/* ══════ 06 · presence ══════ */}
  <section class="pr section">
    <div class="shell pr__grid">
      <div class="pr__intro" data-rise>
        <p class="eb"><i class="eb__r" aria-hidden="true"></i>Our presence</p>
        <h2 class="pr__h">Three branches,<br /><em>one standard.</em></h2>
        <p class="pr__p">
          No matter which branch you visit, you get the same diagnosis, the
          same stock, and the same team. A branch is not a lesser version of
          the shop.
        </p>
        <a class="ghost" href="/branches">
          View all branches<span aria-hidden="true"><Icon name="arrow" size={14} /></span>
        </a>
      </div>

      <div class="pr__map" data-rise style="--d:90ms">
        <svg viewBox={OMAN_VIEWBOX} width="280" height="376" role="img"
          aria-label="Map of Oman showing Danat branches in Sohar, Ruwi and Salalah">
          <path class="pr__land" d={OMAN_PATH} fill="#e4efe3" />
          <text class="pr__wm" x="420" y="900" aria-hidden="true">OMAN</text>
          {mapList.map((b, i) => (
            <g class="pr__pin" style={`--i:${i}`}
              transform={`translate(${OMAN_PINS[b.slug].x} ${OMAN_PINS[b.slug].y}) scale(1.4)`}>
              <path fill="#2f6429" d="M0,0 C-8,-11 -14,-18 -14,-25 A14,14 0 1 1 14,-25 C14,-18 8,-11 0,0 Z" />
              <circle cx="0" cy="-25" r="5" fill="#ffffff"></circle>
            </g>
          ))}
        </svg>
        {mapList.map((b, i) => (
          <a class="pr__chip" href={`/branches#${b.slug}`}
            style={`--i:${i}; --x:${((OMAN_PINS[b.slug].x / W) * 100).toFixed(2)}%; --y:${((OMAN_PINS[b.slug].y / H) * 100).toFixed(2)}%; --dy:${nudge[b.slug]}`}>
            {b.city.split(',')[0]}
          </a>
        ))}
      </div>

      <ul class="pr__list">
        {branches.map((b, i) => (
          <li data-rise style={`--d:${i * 60}ms`}>
            <a class="br" href={`/branches#${b.slug}`}>
              <span class="br__shot" aria-hidden="true"><i>Photo</i></span>
              <span class="br__t"><b>{b.name}</b><em>{b.city}</em></span>
              <span class="br__go" aria-hidden="true"><Icon name="arrow" size={15} /></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* ══════ 07 · cta ══════ */}
  <section class="ac" data-tone="ink">
    <div class="shell ac__in">
      <div>
        <p class="eb eb--inv" data-rise><i class="eb__r" aria-hidden="true"></i>Let's build a brighter tomorrow</p>
        <h2 class="ac__h" data-rise style="--d:70ms">Need <Brush>expert advice?</Brush></h2>
        <p class="ac__p" data-rise style="--d:130ms">Our team is here to help you find the right solution.</p>
        <a class="ac__b" href="/contact" data-mag data-rise style="--d:190ms">Contact us<Icon name="arrow" size={15} /></a>
      </div>
      <figure class="ac__fig" data-ac-fig aria-hidden="true">
        <Image src={laptop} alt="" width={900} format="png" loading="lazy" />
      </figure>
    </div>
  </section>

  <StoryCard />
  <VideoModal />
</PageLayout>

<style>
  /* ───── shared ───── */
  .eb {
    display: flex; align-items: center; gap: 0.6rem;
    font-family: var(--font-mono); font-size: 0.6875rem;
    letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--green-deep);
  }
  .eb--clay { color: var(--clay-deep); }
  .eb--inv { color: var(--green-bright); }
  .eb__r { width: 26px; height: 1px; flex: none; background: currentColor; opacity: 0.6; }

  .btn {
    position: relative; display: inline-flex; align-items: center;
    align-self: flex-start; gap: 0.7rem;
    padding: 0.5rem 0.5rem 0.5rem 1.4rem;
    border: 0; border-radius: 999px;
    /* white is 8.73:1 on #27551f and 4.90:1 on #3d7f35 — AA across the ramp */
    background: linear-gradient(100deg, #27551f, #3d7f35);
    color: #fff; font-size: 0.9375rem; font-weight: 600;
    overflow: hidden; transition: transform var(--t2) var(--ease);
  }
  .btn:hover { transform: translateY(-2px); }
  .btn__i {
    display: grid; place-items: center; width: 30px; height: 30px; flex: none;
    border-radius: 50%; background: rgb(255 255 255 / 0.2);
    transition: transform var(--t2) var(--ease);
  }
  .btn:hover .btn__i { transform: translateX(3px); }

  .ghost {
    display: inline-flex; align-items: center; align-self: flex-start; gap: 0.6rem;
    margin-top: var(--s5);
    padding: 0.55rem 0.55rem 0.55rem 1.3rem;
    border: 1px solid var(--line-light); border-radius: 999px;
    background: var(--white); font-size: 0.875rem; font-weight: 600;
    transition: border-color var(--t2) var(--ease);
  }
  .ghost:hover { border-color: var(--clay); }
  .ghost span {
    display: grid; place-items: center; width: 26px; height: 26px;
    border-radius: 50%; background: var(--clay-wash); color: var(--clay-deep);
    transition: transform var(--t2) var(--ease);
  }
  .ghost:hover span { transform: translateX(3px); }


  /* ───── 01 hero ───── */
  .ah { position: relative; min-height: 100svh; display: grid; align-items: end; overflow: hidden; color: #fff; background: var(--ink); }
  .ah__bg { position: absolute; inset: -8% 0 0; will-change: transform; }
  .ah__bg :global(img) { width: 100%; height: 100%; object-fit: cover; transform: scale(1.08); animation: ahIn 2.4s var(--ease) both; }
  @keyframes ahIn { from { transform: scale(1.18); filter: blur(6px); opacity: 0.4; } }
  .ah::before { content: ''; position: absolute; inset: 0; z-index: 1;
    background: linear-gradient(180deg, rgb(8 10 9 / 0.55) 0%, rgb(8 10 9 / 0.25) 35%, rgb(8 10 9 / 0.88) 100%),
      linear-gradient(90deg, rgb(8 10 9 / 0.75) 0%, transparent 70%); }
  .ah__in { position: relative; z-index: 2; transform-style: preserve-3d; transition: transform 0.6s var(--ease); padding-top: calc(var(--hdr, 88px) + 3rem); padding-bottom: clamp(7rem, 15vh, 10rem); }
  .ah__eb { opacity: 0; animation: ahFade 0.9s var(--ease) 0.2s both; }
  .ah__h { perspective: 900px; margin-top: var(--s5); font-weight: 700; font-size: var(--d1); line-height: 0.95; letter-spacing: var(--tr1); }
  .ah__h em { font-style: normal; color: var(--green-bright); }
  .ah__l { display: block; overflow: hidden; padding-bottom: 0.04em; }
  .ah__l > span { display: block; transform-origin: 50% 100%; transform: translateY(70%) rotateX(-75deg); opacity: 0; animation: ahUp 1.3s var(--ease) both; }
  .ah__l:nth-child(1) > span { animation-delay: 0.25s; }
  .ah__l:nth-child(2) > span { animation-delay: 0.37s; }
  .ah__l:nth-child(3) > span { animation-delay: 0.49s; }
  @keyframes ahUp { to { transform: none; opacity: 1; } }
  @keyframes ahFade { to { opacity: 1; } }
  .ah__row { margin-top: clamp(1.5rem, 4vh, 2.5rem); display: flex; flex-wrap: wrap; gap: 1.5rem 3rem; align-items: center; opacity: 0; animation: ahFade 1s var(--ease) 0.8s both; }
  .ah__p { max-width: 46ch; color: rgb(255 255 255 / 0.78); line-height: 1.65; }
  .ah__acts { display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; }
  .ah__film { display: inline-flex; align-items: center; gap: 0.8rem; padding: 0; border: 0; background: none; color: #fff; text-align: left; cursor: pointer; }
  .ah__film span:last-child { display: grid; }
  .ah__film b { font-size: 0.95rem; }
  .ah__film em { font-style: normal; font-size: 0.8rem; color: rgb(255 255 255 / 0.6); }
  .ah__play { position: relative; display: grid; place-items: center; width: 46px; height: 46px; border-radius: 50%; border: 1px solid rgb(255 255 255 / 0.5); }
  .ah__play::after { content: ''; position: absolute; inset: -6px; border-radius: 50%; border: 1px solid rgb(122 211 116 / 0.6); animation: ahPing 2.4s var(--ease) infinite; }
  @keyframes ahPing { from { transform: scale(0.8); opacity: 1; } to { transform: scale(1.4); opacity: 0; } }
  .ah__mantra { margin-top: 2rem; font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.18em; text-transform: uppercase; color: rgb(255 255 255 / 0.5); opacity: 0; animation: ahFade 1s var(--ease) 1s both; }
  .ah__hint { position: absolute; z-index: 2; right: var(--gut); bottom: clamp(5rem, 12vh, 8rem); font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.2em; text-transform: uppercase; color: rgb(255 255 255 / 0.55); writing-mode: vertical-rl; }
  .ah__hint::after { content: ''; display: block; width: 1px; height: 48px; margin: 0.8rem auto 0; background: linear-gradient(currentColor, transparent); animation: ahDrip 1.8s ease-in-out infinite; }
  @keyframes ahDrip { 0% { transform: scaleY(0); transform-origin: top; } 50% { transform: scaleY(1); transform-origin: top; } 51% { transform-origin: bottom; } 100% { transform: scaleY(0); transform-origin: bottom; } }
  .ah__wave { position: absolute; left: -4%; right: -4%; bottom: -1px; z-index: 3; height: clamp(44px, 6vw, 110px); pointer-events: none; }
  .ah__wave svg { display: block; width: 100%; height: 100%; }
  .ah__wave .b { fill: color-mix(in oklab, var(--white) 88%, var(--green)); }
  .ah__wave .f { fill: var(--white); }

  /* ───── 02 figures ───── */
  .af { background: var(--white); padding-block: clamp(3.5rem, 7vw, 6rem); }
  .af__grid { display: grid; grid-template-columns: 1.3fr 1fr 1fr; grid-template-rows: auto auto; gap: 1rem; margin: 0; perspective: 1200px; }
  .af__c { position: relative; display: grid; align-content: end; gap: 0.2rem; min-height: 11rem; padding: 1.6rem 1.6rem 1.4rem; border-radius: 24px; overflow: hidden;
    background: var(--off); border: 1px solid rgb(0 0 0 / 0.06); transform-style: preserve-3d;
    transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg)); transition: transform 0.5s var(--ease), box-shadow 0.5s var(--ease); }
  .af__c:hover { box-shadow: 0 30px 60px -30px rgb(20 40 25 / 0.35); }
  .af__c--0 { grid-row: span 2; background: radial-gradient(120% 90% at 20% 0%, #1f4f22 0%, var(--ink) 70%); color: #fff; border-color: transparent; }
  .af__c--3 { grid-column: span 2; }
  .af__glow { position: absolute; inset: 0; pointer-events: none; opacity: 0; transition: opacity 0.3s;
    background: radial-gradient(260px circle at var(--mx, 50%) var(--my, 50%), rgb(89 170 84 / 0.22), transparent 70%); }
  .af__c:hover .af__glow { opacity: 1; }
  .af__i { position: absolute; top: 1.3rem; left: 1.4rem; display: grid; place-items: center; width: 42px; height: 42px; border-radius: 12px;
    background: rgb(89 170 84 / 0.14); color: var(--green-deep); transform: translateZ(30px); }
  .af__c--0 .af__i { background: rgb(255 255 255 / 0.1); color: var(--green-bright); }
  .af__c dt { font-size: var(--d3); font-weight: 700; letter-spacing: var(--tr3); line-height: 1; transform: translateZ(45px); }
  .af__c--0 dt { font-size: var(--d2); color: var(--green-bright); }
  .af__c dd { margin: 0.5rem 0 0; font-weight: 700; transform: translateZ(25px); }
  .af__c small { color: var(--text-3); font-size: 0.82rem; transform: translateZ(18px); }
  .af__c--0 small { color: rgb(255 255 255 / 0.6); }

  /* ───── 03 journey ───── */
  /* Pastel, not tonal. Each milestone gets its own soft ground instead of
     the old white/near-black alternation — four chalky tints that read as
     one family because they share a low saturation and a high value.
     Contrast computed, not eyeballed (see the table below each pair). */
  .aj { background: linear-gradient(180deg, #f3f7f2 0%, #f7f3ed 55%, #f4f1f5 100%);
    padding-block: clamp(5rem, 10vw, 8rem) clamp(3rem, 6vw, 5rem); }
  .aj__intro { max-width: 44rem; margin-bottom: clamp(2.5rem, 6vw, 4rem); }
  .aj__h { margin-top: var(--s4); font-size: var(--d4); font-weight: 700; letter-spacing: var(--tr4); line-height: 1.06; }
  .aj__p { margin-top: var(--s4); max-width: 44ch; color: var(--text-2); line-height: 1.65; }
  .aj__stack { list-style: none; margin: 0; padding: 0; display: grid; gap: 2.5rem; perspective: 1400px; }
  /* each card pins a little lower than the one before; the ones underneath tip back */
  .aj__card { position: sticky; top: calc(var(--hdr, 88px) + 2rem + var(--i) * 22px); min-height: min(58vh, 30rem);
    display: grid; align-content: space-between; padding: clamp(1.6rem, 4vw, 3rem); border-radius: 28px;
    background: var(--pc, #fff); border: 1px solid rgb(20 40 25 / 0.05); box-shadow: 0 34px 64px -44px rgb(40 50 45 / 0.38);
    transform-origin: 50% 0%; transform: translateZ(0) scale(var(--s, 1)) rotateX(var(--r, 0deg)); filter: brightness(var(--b, 1));
    will-change: transform; }
  /*                ground     year ink   ── year on ground / body #14171A
     mint   2003    #E6F0E4    #2F6429       6.03 : 1  /  15.38 : 1
     sand   2010    #F3EADC    #8A5518       5.19 : 1  /  15.09 : 1
     blush  2016    #F4E6E3    #9B4A3C       5.02 : 1  /  14.80 : 1
     mist   Today   #E3ECEF    #2D5866       6.49 : 1  /  15.00 : 1
     All AA at any size; the years are large text, which needs only 3:1. */
  .aj__card--0 { --pc: #e6f0e4; --yr: #2f6429; }
  .aj__card--1 { --pc: #f3eadc; --yr: #8a5518; }
  .aj__card--2 { --pc: #f4e6e3; --yr: #9b4a3c; }
  .aj__card--3 { --pc: #e3ecef; --yr: #2d5866; }
  /* --text-3 drops to 4.15:1 on blush, which small mono text cannot have.
     --text-2 clears 5.27:1 on the worst of the four. */
  .aj__n { font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.18em; color: var(--text-2); }
  /* The serif italic, not the grotesk — the one place on this page the
     type changes voice. Serif display faces are drawn with their own
     fit, so the negative tracking the grotesk needed comes back off. */
  .aj__yr { display: block; font-family: var(--font-serif); font-style: italic; font-weight: 400;
    font-size: var(--d2); letter-spacing: var(--tr2); line-height: 0.95; color: var(--yr, var(--green-deep)); }
  .aj__t { max-width: 30ch; font-size: var(--lead); font-weight: 500; letter-spacing: -0.015em; line-height: 1.4; color: var(--text); }

  /* ───── 05 difference ───── */
  .ad { position: relative; overflow: hidden; color: #fff; background: var(--ink); min-height: 100svh; display: grid; align-items: center; }
  .ad__shot { position: absolute; inset: 0; margin: 0; clip-path: inset(var(--ci, 12%) var(--ci, 12%) var(--ci, 12%) var(--ci, 12%) round var(--cr, 28px)); will-change: clip-path; }
  .ad__shot :global(img) { width: 100%; height: 100%; object-fit: cover; transform: scale(var(--cs, 1.12)); }
  .ad__shot::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, transparent 20%, rgb(8 10 9 / 0.9) 70%); opacity: var(--co, 0); }
  .ad__in { position: relative; z-index: 1; display: grid; justify-items: end; padding-block: clamp(5rem, 10vw, 8rem); }
  .ad__copy { max-width: 36rem; display: grid; justify-items: start; gap: 0; }
  .ad__h { margin-top: var(--s4); font-size: var(--d4); font-weight: 700; letter-spacing: var(--tr4); line-height: 1.06; }
  .ad__h em { font-style: normal; color: var(--green-bright); }
  .ad__p { margin-top: var(--s4); color: rgb(255 255 255 / 0.78); line-height: 1.65; }
  .ad__proof { list-style: none; margin: 1.6rem 0 1.8rem; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .ad__proof li { display: inline-flex; align-items: center; gap: 0.45rem; padding: 0.5rem 0.9rem; border-radius: 999px; border: 1px solid rgb(255 255 255 / 0.2); background: rgb(255 255 255 / 0.06); backdrop-filter: blur(6px); font-size: 0.85rem; }
  .ad__proof span { color: var(--green-bright); display: grid; }

  /* ───── 06 presence ───── */
  .pr {
    background: linear-gradient(185deg, #fafcfa, #f1f8f1 62%, #eef6ee);
  }
  .pr__grid { display: grid; gap: clamp(1.75rem, 4vw, 2.75rem); align-items: center; }
  .pr__intro { display: grid; justify-items: start; }
  .pr__h {
    margin-top: var(--s4); font-size: var(--d5);
    font-weight: 700; letter-spacing: var(--tr5); line-height: 1.08;
  }
  .pr__h em { font-style: normal; color: var(--green-deep); }
  .pr__p {
    margin-top: var(--s4); max-width: 34ch;
    font-size: 0.875rem; line-height: 1.62; color: var(--text-2);
  }

  .pr__map { position: relative; width: 100%; max-width: 16rem; justify-self: center; }
  .pr__map svg { display: block; width: 100%; height: auto; overflow: visible; }
  /* Decorative, aria-hidden — but 3.0:1 so it is a watermark, not invisible. */
  .pr__wm { fill: #72906f; font-size: 74px; font-weight: 600; letter-spacing: 12px; }

  .pr__land { opacity: 0; transition: opacity 760ms var(--ease) 100ms; }
  .pr__map[data-in] .pr__land { opacity: 1; }
  .pr__pin {
    --pd: calc(700ms + var(--i) * 130ms);
    opacity: 0; scale: 0.3;
    transform-box: fill-box; transform-origin: bottom center;
    transition: opacity 320ms var(--ease) var(--pd),
      scale 540ms cubic-bezier(0.3, 1.6, 0.5, 1) var(--pd);
  }
  .pr__map[data-in] .pr__pin { opacity: 1; scale: 1; }
  .pr__chip {
    position: absolute; top: calc(var(--y) + var(--dy, 0%)); left: var(--x);
    translate: 1.2rem -145%;
    padding: 0.2rem 0.55rem; border-radius: 999px; background: #fff;
    box-shadow: 0 6px 16px -9px rgb(10 30 12 / 0.5);
    font-size: 0.6875rem; font-weight: 600; white-space: nowrap; color: var(--text);
    opacity: 0;
    transition: opacity 320ms var(--ease) calc(860ms + var(--i) * 130ms),
      color var(--t2) var(--ease), background-color var(--t2) var(--ease);
  }
  .pr__map[data-in] .pr__chip { opacity: 1; }
  .pr__chip:hover { background: var(--green-deep); color: #fff; }

  .pr__list { display: grid; gap: 0.6rem; }
  .br {
    display: flex; align-items: center; gap: 0.85rem;
    padding: 0.65rem 0.9rem 0.65rem 0.65rem; border-radius: 14px;
    background: rgb(255 255 255 / 0.86); backdrop-filter: blur(8px);
    box-shadow: 0 1px 2px rgb(10 30 12 / 0.04), 0 10px 26px -20px rgb(10 30 12 / 0.28);
    transition: transform var(--t2) var(--ease), box-shadow var(--t2) var(--ease);
  }
  .br:hover {
    transform: translateX(4px);
    box-shadow: 0 1px 2px rgb(10 30 12 / 0.04), 0 20px 38px -24px rgb(10 30 12 / 0.34);
  }
  /* Held frame — branch photography still to come. */
  .br__shot {
    display: grid; place-items: center; width: 56px; height: 44px; flex: none;
    border: 1px dashed var(--line-light); border-radius: 10px;
    background: var(--off);
  }
  .br__shot i {
    font-style: normal; font-family: var(--font-mono); font-size: 0.5rem;
    letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-3);
  }
  .br__t { display: grid; min-width: 0; }
  .br__t b { font-size: 0.9375rem; font-weight: 700; letter-spacing: -0.02em; }
  .br__t em { margin-top: 0.1rem; font-style: normal; font-size: 0.75rem; color: var(--text-3); }
  .br__go {
    display: grid; place-items: center; width: 28px; height: 28px; flex: none;
    margin-left: auto; border-radius: 50%; color: var(--green-deep);
    transition: transform var(--t2) var(--ease);
  }
  .br:hover .br__go { transform: translateX(3px); }


  /* ───── 07 cta ───── */
  .ac { background: radial-gradient(70% 90% at 80% 50%, #15301a 0%, var(--ink) 65%); color: #fff; padding-block: clamp(5rem, 10vw, 8rem); overflow: hidden; }
  .ac__in { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr); gap: 2rem; align-items: center; }
  .ac__h { margin-top: var(--s4); font-size: var(--d3); font-weight: 700; letter-spacing: var(--tr3); line-height: 1.02; --brush-size: 1.05; }
  .ac__h :global(.brush) { color: var(--green-bright); }
  .ac__p { margin-top: var(--s4); color: rgb(255 255 255 / 0.72); }
  .ac__b { display: inline-flex; align-items: center; gap: 0.7rem; margin-top: 2rem; padding: 1.05rem 1.7rem; border-radius: 999px; background: var(--green); color: #fff; font-weight: 700; transition: background 0.25s; }
  .ac__b:hover { background: var(--green-bright); color: var(--ink); }
  .ac__fig { margin: 0; perspective: 1000px; animation: acFloat 6s ease-in-out infinite alternate; }
  .ac__fig :global(img) { transform: rotateY(var(--fy, -8deg)) rotateX(var(--fx, 4deg)); transition: transform 0.6s var(--ease); }
  .ac__fig :global(img) { width: 100%; height: auto; filter: drop-shadow(0 30px 40px rgb(0 0 0 / 0.5)); }
  @keyframes acFloat { from { transform: translateY(-8px) rotate(-1deg); } to { transform: translateY(8px) rotate(0.5deg); } }

  /* ───── responsive ───── */
  @media (min-width: 62rem) {
    .pr__grid { grid-template-columns: minmax(0, 0.85fr) minmax(0, 0.7fr) minmax(0, 1.1fr); }
  }
  @media (max-width: 56rem) {
    .af__grid { grid-template-columns: 1fr 1fr; }
    .af__c--0 { grid-row: auto; grid-column: span 2; }
    .af__c--3 { grid-column: span 2; }
    .ac__in { grid-template-columns: 1fr; }
    .ad__shot::after { background: linear-gradient(180deg, rgb(8 10 9 / 0.3), rgb(8 10 9 / 0.9)); }
    .ad__in { justify-items: start; }
    .ah__hint { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ah__bg :global(img), .ah__l > span, .ah__eb, .ah__row, .ah__mantra, .ah__play::after, .ah__hint::after, .ac__fig { animation: none; opacity: 1; transform: none; }
    .aj__card { transform: none; filter: none; }
    .af__c { transform: none; }
    .ad__shot { clip-path: none; }
    .pr__map :is(.pr__land, .pr__pin, .pr__chip) { opacity: 1; scale: 1; transition: none; }
    .btn, .btn:hover, .br, .br:hover { transform: none; transition: none; }
  }
</style>

<script>
  function start() {
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const hero = document.querySelector<HTMLElement>('[data-ah]');
    if (!hero || hero.dataset.wired) return;
    hero.dataset.wired = '1';
    const header = document.querySelector('header');
    if (header) document.documentElement.style.setProperty('--hdr', `${header.offsetHeight}px`);
    if (reduced) return;

    const bg = hero.querySelector<HTMLElement>('[data-ah-bg]')!;
    const cards = [...document.querySelectorAll<HTMLElement>('[data-aj-card]')];
    const ad = document.querySelector<HTMLElement>('[data-ad]');
    const shot = ad?.querySelector<HTMLElement>('[data-ad-shot]');
    const clamp = (v: number) => Math.min(1, Math.max(0, v));

    let raf = 0;
    const tick = () => {
      raf = 0;
      const H = innerHeight;
      /* hero photo drifts slower than the page */
      const hr = hero.getBoundingClientRect();
      if (hr.bottom > 0) bg.style.transform = `translate3d(0, ${-hr.top * 0.35}px, 0)`;
      /* journey: cards that have been covered by the next one tip back and dim */
      cards.forEach((c, i) => {
        const next = cards[i + 1];
        if (!next) return;
        const a = c.getBoundingClientRect(), n = next.getBoundingClientRect();
        const cover = clamp((a.bottom - n.top) / a.height);          // 0 → 1 as the next card slides over
        c.style.setProperty('--s', (1 - 0.07 * cover).toFixed(4));
        c.style.setProperty('--r', `${(8 * cover).toFixed(2)}deg`);
        /* 0.25 was tuned against white and near-black. Pastels have
           nowhere to go when darkened — they turn grey rather than dim —
           so the covered card recedes by a tenth, not a quarter. */
        c.style.setProperty('--b', (1 - 0.1 * cover).toFixed(3));
      });
      /* difference: the framed photo opens out to full width as it arrives */
      if (ad && shot) {
        const r = ad.getBoundingClientRect();
        const p = clamp((H - r.top) / (H * 0.9));
        const e = 1 - Math.pow(1 - p, 3);
        shot.style.setProperty('--ci', `${(1 - e) * 12}%`);
        shot.style.setProperty('--cr', `${(1 - e) * 28}px`);
        shot.style.setProperty('--cs', String(1.12 - 0.12 * e));
        shot.style.setProperty('--co', String(clamp((p - 0.5) * 2)));
      }
    };
    const req = () => { if (!raf) raf = requestAnimationFrame(tick); };
    addEventListener('scroll', req, { passive: true });
    addEventListener('resize', req);
    tick();

    const fine = matchMedia('(hover: hover) and (pointer: fine)').matches;
    if (fine) {
      /* figures: each card tilts toward the pointer, with a light under it */
      document.querySelectorAll<HTMLElement>('[data-tilt]').forEach((c) => {
        c.addEventListener('pointermove', (e) => {
          const r = c.getBoundingClientRect(), x = (e.clientX - r.left) / r.width, y = (e.clientY - r.top) / r.height;
          c.style.setProperty('--ry', `${(x - 0.5) * 14}deg`); c.style.setProperty('--rx', `${(0.5 - y) * 12}deg`);
          c.style.setProperty('--mx', `${x * 100}%`); c.style.setProperty('--my', `${y * 100}%`);
        });
        c.addEventListener('pointerleave', () => { c.style.setProperty('--rx', '0deg'); c.style.setProperty('--ry', '0deg'); });
      });
      /* hero: the headline block leans a touch with the pointer */
      const tilt = hero.querySelector<HTMLElement>('[data-ah-tilt]')!;
      hero.addEventListener('pointermove', (e) => {
        const x = e.clientX / innerWidth - 0.5, y = e.clientY / innerHeight - 0.5;
        tilt.style.transform = `perspective(1400px) rotateY(${x * 4}deg) rotateX(${-y * 3}deg)`;
        bg.style.translate = `${-x * 18}px ${-y * 12}px`;
      });
      hero.addEventListener('pointerleave', () => { tilt.style.transform = ''; bg.style.translate = ''; });
      /* ending: the laptop turns toward the pointer */
      const fig = document.querySelector<HTMLElement>('[data-ac-fig]');
      fig?.closest('section')?.addEventListener('pointermove', (e) => {
        const r = fig.getBoundingClientRect(), x = (e.clientX - (r.left + r.width / 2)) / innerWidth, y = (e.clientY - (r.top + r.height / 2)) / innerHeight;
        fig.style.setProperty('--fy', `${x * 30 - 8}deg`); fig.style.setProperty('--fx', `${-y * 20 + 4}deg`);
      });
    }

    /* the call-to-action button leans toward the pointer */
    document.querySelectorAll<HTMLElement>('[data-mag]').forEach((b) => {
      b.addEventListener('pointermove', (e) => { const r = b.getBoundingClientRect(); b.style.transform = `translate(${(e.clientX - r.left - r.width / 2) * 0.2}px, ${(e.clientY - r.top - r.height / 2) * 0.3}px)`; });
      b.addEventListener('pointerleave', () => (b.style.transform = ''));
    });
  }
  document.addEventListener('astro:page-load', start);
</script>
