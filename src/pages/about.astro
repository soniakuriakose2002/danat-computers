---
import { Image } from 'astro:assets';
import PageLayout from '@layouts/PageLayout.astro';
import Icon from '@components/ui/Icon.astro';
import { site, whatsappLink, branches } from '@data/site';
import { OMAN_PATH, OMAN_VIEWBOX, OMAN_PINS } from '@data/omanMap';
import imgHero from '@assets/photos/repair-solder.jpg';
import imgCta from '@assets/renders/01.png';

const years = new Date().getFullYear() - site.stats.since;

/**
 * Figures. Each carries the record it came from, and anything the company
 * has not given us is marked rather than rounded up. The mockup's "1000+
 * happy customers" is not a number anyone here can stand behind, so the
 * card keeps its place in the layout and says so.
 */
const figures = [
  {
    icon: 'calendar',
    v: years, suffix: '+',
    l: 'Years in business',
    sub: `Since ${site.stats.since}`,
    pending: false,
  },
  {
    icon: 'building',
    v: site.stats.branches, suffix: '',
    l: 'Branches in Oman',
    sub: branches.map((b) => b.city.split(',')[0]).join(', '),
    pending: false,
  },
  {
    icon: 'box',
    v: site.stats.parts, suffix: '',
    l: 'Products in stock',
    sub: `Across ${site.stats.categories} categories`,
    pending: false,
  },
  {
    icon: 'users',
    v: null, suffix: '',
    l: 'Customers served',
    sub: 'Figure to confirm with Danat',
    pending: true,
  },
];

/**
 * Timeline. 2003 is the earliest record in the company's own ERP export.
 * The middle milestones in the mockup carried invented years — a real
 * twenty-year-old company's history is not something to guess at — so
 * they are held open until Danat confirms the dates.
 */
const story = [
  {
    year: String(site.stats.since),
    t: 'We started our journey',
    p: 'The first counter opened on Computer Street in Ruwi, Muscat.',
    pending: false,
  },
  {
    year: null,
    t: 'The range widened',
    p: 'More brands, and the move beyond retail into IT solutions and supply.',
    pending: true,
  },
  {
    year: null,
    t: 'We grew across Oman',
    p: 'Branches opened in Sohar, Al Hail and Salalah.',
    pending: true,
  },
  {
    year: 'Today',
    t: 'A stronger tomorrow',
    p: 'Supporting individuals, businesses and organisations across the country with repair, supply and support.',
    pending: false,
  },
];

const values = [
  {
    icon: 'shield',
    t: 'Genuine products',
    p: 'Only authentic stock from the brands we are supplied by directly.',
  },
  {
    icon: 'person',
    t: 'Expert service',
    p: 'Technicians who trace a fault to the component, not to the invoice.',
  },
  {
    icon: 'gem',
    t: 'Customer first',
    p: 'Honest advice, fair pricing, and a free diagnosis before you commit.',
  },
  {
    icon: 'chart',
    t: 'Continuous improvement',
    p: 'Always learning, always adapting as the hardware changes.',
  },
];

const mapOrder = ['sohar', 'hail', 'ruwi', 'salalah'];
const mapList = mapOrder.map((s) => branches.find((b) => b.slug === s)!);
const W = 1000;
const H = 1342;
const nudge: Record<string, string> = {
  sohar: '0%', hail: '-3.4%', ruwi: '2.8%', salalah: '0%',
};
---

<PageLayout
  title="About"
  description={`${site.nameFull} has repaired and supplied computers across Oman since ${site.stats.since} — four branches, ${site.stats.parts.toLocaleString('en-US')} lines in stock, board-level repair.`}
>
  {/* ═══════════ 01 · hero ═══════════ */}
  <section class="ah">
    <div class="ah__aura" aria-hidden="true"><span></span><span></span></div>

    <div class="shell">
      <nav class="ah__crumb" aria-label="Breadcrumb" data-rise>
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">About</span>
      </nav>

      <div class="ah__grid">
        <div class="ah__copy">
          <p class="eb" data-rise><i class="eb__rule" aria-hidden="true"></i>About Danat</p>

          <h1 class="ah__h" data-rise style="--d:70ms">
            Technology<br />that keeps<br /><em>Oman moving.</em>
          </h1>

          <p class="ah__p" data-rise style="--d:130ms">
            For over two decades, Danat Computers has been a trusted name in
            computer products, services and business solutions across Oman.
          </p>

          <div class="ah__acts" data-rise style="--d:200ms">
            <a class="btn" href="/services">
              Our services
              <span class="btn__i" aria-hidden="true"><Icon name="arrow" size={15} /></span>
            </a>

            {/* No film exists yet, so this is a held slot rather than a
                button that goes nowhere. */}
            <span class="ah__film" aria-disabled="true" title="Company film to follow">
              <i aria-hidden="true"><Icon name="play" size={13} /></i>
              <span>
                Watch our story
                <small>Film to follow</small>
              </span>
            </span>
          </div>
        </div>

        <div class="ah__media" data-rise style="--d:160ms">
          <figure class="ah__fig">
            <Image src={imgHero} alt="A Danat technician working on a machine at the bench"
              widths={[560, 900, 1300]} sizes="(min-width: 62rem) 46vw, 92vw"
              quality={74} format="webp" loading="eager" fetchpriority="high" />
          </figure>

          <p class="ah__mantra">
            People.<br />Products.<br />Support.<br /><b>A brighter tomorrow.</b>
          </p>

          <p class="ah__trust">
            <i aria-hidden="true"><Icon name="users" size={17} /></i>
            <span>
              Trusted across Oman
              <small>Customer count to confirm</small>
            </span>
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* ═══════════ 02 · numbers ═══════════ */}
  <section class="an section" data-tone="light">
    {/* The hero lifts into this section on a curve rather than meeting it
        on a straight rule. */}
    <svg class="an__curve" viewBox="0 0 1440 120" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0,0 C260,104 560,118 820,86 C1060,58 1260,14 1440,0 L1440,0 L0,0 Z" />
    </svg>

    <div class="shell">
      <p class="eb eb--mid" data-rise>
        <i class="eb__rule" aria-hidden="true"></i>By the numbers
        <i class="eb__rule" aria-hidden="true"></i>
      </p>

      <dl class="an__grid">
        {figures.map((f, i) => (
          <div class="nc" data-rise style={`--d:${i * 70}ms`} data-pending={f.pending ? '' : undefined}>
            <span class="nc__i" aria-hidden="true"><Icon name={f.icon} size={19} /></span>
            <dt>
              {f.pending
                ? <span class="nc__blank" aria-label="Figure not yet confirmed"></span>
                : <><span data-count={f.v}>0</span>{f.suffix}</>}
            </dt>
            <dd>{f.l}</dd>
            <small>{f.sub}</small>
          </div>
        ))}
      </dl>
    </div>
  </section>

  {/* ═══════════ 03 · story ═══════════ */}
  <section class="as section" data-tone="light">
    <span class="as__blob" aria-hidden="true"></span>
    <div class="shell as__grid">
      <div class="as__intro" data-rise>
        <p class="eb"><i class="eb__rule" aria-hidden="true"></i>Our story</p>
        <h2 class="as__h">From a small shop<br /><em>to a trusted brand.</em></h2>
        <p class="as__p">
          What started as a single counter has grown into a company with four
          branches. The focus has not changed — genuine products, expert
          service and long relationships.
        </p>
        <a class="btn" href="/branches">
          Our branches
          <span class="btn__i" aria-hidden="true"><Icon name="arrow" size={15} /></span>
        </a>
      </div>

      <ol class="as__line">
        {story.map((s, i) => (
          <li data-rise style={`--d:${i * 80}ms`} data-pending={s.pending ? '' : undefined}>
            <span class="as__dot" aria-hidden="true"></span>
            <span class="as__yr">
              {s.year ?? <i class="as__q" aria-label="Year to confirm">Year?</i>}
            </span>
            <div class="as__t">
              <h3>{s.t}</h3>
              <p>{s.p}</p>
              {s.pending && <small>Date to confirm with Danat</small>}
            </div>
          </li>
        ))}
      </ol>

      <p class="as__script" aria-hidden="true">Same Commitment<br />Bigger Possibilities</p>
    </div>
  </section>

  {/* ═══════════ 04 · values ═══════════ */}
  <section class="av section" data-tone="light">
    <span class="av__blob" aria-hidden="true"></span>
    <div class="shell">
      <p class="eb" data-rise><i class="eb__rule" aria-hidden="true"></i>Our values</p>
      <h2 class="av__h" data-rise style="--d:70ms">
        Four things we <em>never compromise on.</em>
      </h2>

      <ul class="av__grid">
        {values.map((v, i) => (
          <li data-rise style={`--d:${120 + i * 70}ms`}>
            <span class="av__i" aria-hidden="true"><Icon name={v.icon} size={20} /></span>
            <b>{v.t}</b>
            <span>{v.p}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* ═══════════ 05 · presence ═══════════ */}
  <section class="ap section" data-tone="light">
    <span class="ap__blob" aria-hidden="true"></span>
    <div class="shell ap__grid">
      <div class="ap__intro" data-rise>
        <p class="eb"><i class="eb__rule" aria-hidden="true"></i>Our presence</p>
        <h2 class="ap__h">Four branches,<br /><em>one standard.</em></h2>
        <p class="ap__p">
          Whichever branch you visit, you get the same diagnosis, the same
          stock and the same team. A branch is not a lesser version of the
          shop.
        </p>
        <a class="ap__ghost" href="/branches">
          View all branches
          <span aria-hidden="true"><Icon name="arrow" size={14} /></span>
        </a>
      </div>

      <div class="ap__map" data-rise style="--d:90ms">
        <svg viewBox={OMAN_VIEWBOX} width="290" height="389" role="img"
          aria-label="Map of Oman showing Danat branches in Sohar, Al Hail, Ruwi and Salalah">
          <path class="ap__land" d={OMAN_PATH} fill="#e3eee2" />
          <text class="ap__wm" x="430" y="900" aria-hidden="true">OMAN</text>
          {mapList.map((b, i) => (
            <g class="ap__pin" style={`--i:${i}`}
              transform={`translate(${OMAN_PINS[b.slug].x} ${OMAN_PINS[b.slug].y}) scale(1.45)`}>
              <path fill="#2f6429"
                d="M0,0 C-8,-11 -14,-18 -14,-25 A14,14 0 1 1 14,-25 C14,-18 8,-11 0,0 Z" />
              <circle cx="0" cy="-25" r="5" fill="#ffffff"></circle>
            </g>
          ))}
        </svg>

        {mapList.map((b, i) => (
          <a class="ap__chip" href={`/branches#${b.slug}`}
            style={`--i:${i}; --x:${((OMAN_PINS[b.slug].x / W) * 100).toFixed(2)}%; --y:${((OMAN_PINS[b.slug].y / H) * 100).toFixed(2)}%; --dy:${nudge[b.slug]}`}>
            {b.city.split(',')[0]}
          </a>
        ))}
      </div>

      <ul class="ap__list">
        {branches.map((b, i) => (
          <li data-rise style={`--d:${i * 60}ms`}>
            <a class="bl" href={`/branches#${b.slug}`}>
              <span class="bl__i" aria-hidden="true"><Icon name="building" size={18} /></span>
              <span class="bl__t">
                <b>{b.name}</b>
                <em>{b.city}</em>
              </span>
              <span class="bl__go" aria-hidden="true"><Icon name="arrow" size={15} /></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* ═══════════ 06 · cta ═══════════ */}
  <section class="ac" data-tone="ink">
    <div class="shell ac__in">
      <div class="ac__copy">
        <p class="eb eb--inv" data-rise>
          <i class="eb__rule" aria-hidden="true"></i>Let's build a brighter tomorrow
        </p>
        <h2 class="ac__h" data-rise style="--d:70ms">Need expert advice?</h2>
        <p class="ac__p" data-rise style="--d:130ms">
          Our team is here to help you find the right solution.
        </p>
        <a class="btn" href="/contact" data-rise style="--d:190ms">
          Contact us
          <span class="btn__i" aria-hidden="true"><Icon name="arrow" size={15} /></span>
        </a>
      </div>

      <figure class="ac__fig" aria-hidden="true">
        <Image src={imgCta} alt="" widths={[420, 640]} sizes="(min-width: 62rem) 34vw, 70vw"
          quality={80} format="webp" loading="lazy" />
      </figure>

      <p class="ac__script" aria-hidden="true">Technology<br />for a Brighter<br />Tomorrow</p>
    </div>
  </section>
</PageLayout>

<style>
  /* ───────── shared ───────── */

  .eb {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--green-deep);
  }
  .eb--mid { justify-content: center; }
  .eb--inv { color: var(--green-bright); }
  .eb__rule {
    width: 28px;
    height: 1px;
    flex: none;
    background: color-mix(in oklab, var(--green) 58%, transparent);
  }
  .eb--inv .eb__rule { background: color-mix(in oklab, var(--green-bright) 60%, transparent); }

  .btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    gap: 0.7rem;
    padding: 0.5rem 0.5rem 0.5rem 1.4rem;
    border: 0;
    border-radius: 999px;
    /* white is 8.73:1 on #27551f and 4.90:1 on #3d7f35 — AA across the ramp */
    background: linear-gradient(100deg, #27551f, #3d7f35);
    color: #fff;
    font-size: 0.9375rem;
    font-weight: 600;
    overflow: hidden;
    transition: transform var(--t2) var(--ease);
  }
  .btn:hover { transform: translateY(-2px); }
  .btn::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(100deg, transparent 35%, rgb(255 255 255 / 0.22) 50%, transparent 65%);
    transform: translate3d(-100%, 0, 0);
    transition: transform var(--t4) var(--ease);
  }
  .btn:hover::after { transform: translate3d(100%, 0, 0); }
  .btn__i {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    flex: none;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.2);
    transition: transform var(--t2) var(--ease);
  }
  .btn:hover .btn__i { transform: translateX(3px); }

  /* ───────── 01 · hero ───────── */

  .ah {
    position: relative;
    background: linear-gradient(175deg, #fbfdfb, #f1f7f1 62%, #fafcfa);
    padding-block: clamp(6.5rem, 11vw, 9rem) clamp(3rem, 6vw, 4.5rem);
    overflow: hidden;
    isolation: isolate;
  }
  .ah__aura { position: absolute; inset: 0; z-index: -1; pointer-events: none; }
  .ah__aura span {
    position: absolute;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in oklab, var(--green) 24%, transparent), transparent 68%);
    filter: blur(32px);
  }
  .ah__aura span:first-child { top: -26%; left: -14%; width: 44%; aspect-ratio: 1; opacity: 0.42; }
  .ah__aura span:last-child { bottom: -30%; right: -12%; width: 46%; aspect-ratio: 1; opacity: 0.32; }

  .ah__crumb {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.8125rem;
    color: var(--text-3);
  }
  .ah__crumb a { transition: color var(--t2) var(--ease); }
  .ah__crumb a:hover { color: var(--green-deep); }
  .ah__crumb [aria-current] { color: var(--text); }

  .ah__grid {
    display: grid;
    gap: clamp(2rem, 5vw, 3.5rem);
    align-items: center;
    margin-top: var(--s5);
  }
  .ah__copy { display: grid; justify-items: start; }

  .ah__h {
    margin-top: var(--s4);
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    line-height: 1.02;
    letter-spacing: -0.045em;
    font-weight: 700;
  }
  .ah__h em { font-style: normal; color: var(--green-deep); }

  .ah__p {
    margin-top: var(--s4);
    max-width: 38ch;
    font-size: 0.9375rem;
    line-height: 1.62;
    color: var(--text-2);
  }

  .ah__acts {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s4) var(--s5);
    margin-top: var(--s5);
  }

  /* Held, not linked. There is no film yet. */
  .ah__film {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    cursor: not-allowed;
  }
  .ah__film i {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    flex: none;
    border-radius: 50%;
    border: 1px dashed var(--line-light);
    color: var(--text-3);
  }
  .ah__film > span { display: grid; font-size: 0.875rem; color: var(--text-2); }
  .ah__film small {
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  /* ---- media stack ---- */

  .ah__media { position: relative; }
  .ah__fig :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 11;
    object-fit: cover;
    border-radius: 16px;
  }

  .ah__mantra,
  .ah__trust {
    padding: 0.9rem 1.1rem;
    border-radius: 14px;
    background: rgb(255 255 255 / 0.94);
    backdrop-filter: blur(8px);
    box-shadow: 0 18px 38px -26px rgb(10 30 12 / 0.55);
  }

  .ah__mantra {
    margin-top: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    line-height: 1.7;
    color: var(--green-deep);
  }
  .ah__mantra b { color: var(--text); font-weight: 700; }

  .ah__trust {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin-top: 0.6rem;
  }
  .ah__trust i {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    flex: none;
    border-radius: 10px;
    color: var(--green-deep);
    background: var(--green-wash);
  }
  .ah__trust > span { display: grid; font-size: 0.875rem; font-weight: 600; }
  .ah__trust small {
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    font-weight: 400;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  /* ───────── 02 · numbers ───────── */

  /* Flat white against flat grey, section after section, is what reads
     as dated. Each ground is now a soft gradient with its own organic
     shape, and the joins are curved. */
  .an {
    position: relative;
    background: linear-gradient(180deg, #fafcfa 0%, var(--white) 46%);
    padding-top: clamp(4rem, 8vw, 6rem);
  }
  .an__curve {
    position: absolute;
    top: -1px;
    left: 0;
    width: 100%;
    height: clamp(48px, 7vw, 108px);
    fill: #f1f7f1;
    pointer-events: none;
  }

  .an__grid {
    display: grid;
    gap: clamp(0.75rem, 1.8vw, 1.15rem);
    margin-top: clamp(1.75rem, 4vw, 2.75rem);
  }

  /* A 1px border on flat white is a 2012 card. Layered shadow, bigger
     radius and a rule that wipes in on hover gives it depth instead. */
  .nc {
    position: relative;
    padding: 1.5rem 1.4rem;
    border-radius: 20px;
    background: var(--white);
    overflow: hidden;
    box-shadow:
      0 1px 2px rgb(10 30 12 / 0.05),
      0 12px 28px -18px rgb(10 30 12 / 0.28);
    transition: transform var(--t3) var(--ease), box-shadow var(--t3) var(--ease);
  }
  .nc:hover {
    transform: translateY(-5px);
    box-shadow:
      0 1px 2px rgb(10 30 12 / 0.05),
      0 28px 48px -22px rgb(10 30 12 / 0.34);
  }
  .nc::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 3px;
    background: linear-gradient(90deg, var(--green-deep), var(--green));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--t3) var(--ease);
  }
  .nc:hover::after { transform: scaleX(1); }
  .nc:hover .nc__i { transform: scale(1.08) rotate(-6deg); }
  .nc__i {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 14px;
    color: var(--green-deep);
    background: linear-gradient(140deg, color-mix(in oklab, var(--green) 20%, #fff), var(--green-wash));
    transition: transform var(--t3) var(--ease);
  }
  .nc dt {
    margin-top: 0.9rem;
    font-size: clamp(1.6rem, 2.8vw, 2.1rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .nc dd { margin-top: 0.4rem; font-size: 0.875rem; color: var(--text-2); }
  .nc small {
    display: block;
    margin-top: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  /* A figure nobody has supplied. Held open, never invented. */
  .nc[data-pending] {
    background: var(--off);
    box-shadow: inset 0 0 0 1px var(--line-light);
  }
  .nc[data-pending]::after { background: #c9ced4; }
  .nc__blank {
    display: inline-block;
    width: 3.2ch;
    height: 0.62em;
    border-bottom: 2px dashed #b9bfc5;
  }

  /* ───────── 03 · story ───────── */

  .as {
    position: relative;
    background: linear-gradient(200deg, var(--white) 0%, #f3f8f3 58%, #eef5ee 100%);
    overflow: hidden;
    isolation: isolate;
  }
  .as__blob {
    position: absolute;
    right: -14%;
    top: 4%;
    z-index: -1;
    width: min(34rem, 46vw);
    aspect-ratio: 1;
    border-radius: 48% 52% 44% 56% / 52% 44% 56% 48%;
    background: radial-gradient(circle at 36% 34%, color-mix(in oklab, var(--green) 20%, transparent), transparent 66%);
    filter: blur(14px);
  }
  .as__grid { position: relative; display: grid; gap: clamp(2rem, 4vw, 3rem); }

  .as__intro { display: grid; justify-items: start; }
  .as__h {
