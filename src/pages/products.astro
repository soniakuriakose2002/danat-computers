---
import { Image } from 'astro:assets';
import PageLayout from '@layouts/PageLayout.astro';
import Icon from '@components/ui/Icon.astro';
import VideoModal from '@components/global/VideoModal.astro';
import { site, brands } from '@data/site';
import imgRetail from '@assets/photos/retail-display.jpg';
import imgPatch from '@assets/photos/network-patch.jpg';
import imgCctv from '@assets/photos/cctv-white.jpg';
import imgDrive from '@assets/photos/drive-macro.jpg';
import imgBoard from '@assets/photos/repair-board.jpg';
import imgDesk from '@assets/photos/support-desk.jpg';

/**
 * PRODUCTS — built to the client's mockup.
 *
 * ⚠ Danat has no online catalogue: no prices, no stock levels, no cart.
 * The old site's product page had none either. So every call to action
 * here ends in a conversation rather than pretending to a basket —
 * "Browse all products" moves down to the categories, and the per-
 * category buttons open the quote modal. Nothing claims a price.
 *
 * The five categories are the ones the old product page carried, minus
 * the four entries on it that were actually services and already live
 * on /services — CCTV installation, wired networking, wireless
 * networking and spare parts.
 *
 * Brand names are set as type. Danat has no licence on file for HP,
 * Dell, Apple, ASUS or Lenovo artwork, and their marks are not ours to
 * redraw; the sixteen names come from the catalogue export.
 */
/**
 * Five items, one per category — which is what the mockup draws: five
 * rows on the left, five dots on the right.
 *
 * Their product lines are the old page's own names. Its ten entries map
 * onto these five: the brand titles under laptops, wired and wireless
 * networking together, CCTV installation under security, spare parts
 * under accessories, refurbished desktop on its own.
 *
 * ⚠ No brand product photography is in the project, so each card shows
 * a Danat photograph. Send the product shots and they drop in.
 */
const cats = [
  {
    n: '01', icon: 'laptop', t: 'Laptops & desktops', sub: 'Work. Learn. Create.',
    line: 'HP · Dell · Asus · Apple · Lenovo',
    p: 'Unleash power and performance.',
    blurb: 'Reliable, versatile machines built for business and everyday use, from the brands the workshop already services.',
    img: imgRetail, alt: 'Retail display of computers and accessories',
  },
  {
    n: '02', icon: 'network', t: 'Networking', sub: 'Stay connected.',
    line: 'Wired · Wireless',
    p: 'Wired and wireless networking.',
    blurb: 'Routers, switches, access points and structured cabling — for a new setup or to fix one that already exists.',
    img: imgPatch, alt: 'Network patch panel with structured cabling',
  },
  {
    n: '03', icon: 'camera', t: 'Security & CCTV', sub: 'Safer environments.',
    line: 'Hikvision · Dahua · Uniview · EZVIZ',
    p: 'CCTV installation.',
    blurb: 'Cameras, recorders and storage supplied by the people who also maintain them.',
    img: imgCctv, alt: 'Security cameras mounted on a white wall',
  },
  {
    n: '04', icon: 'drive', t: 'Accessories & parts', sub: 'Enhance your setup.',
    line: 'Canon · Epson · Zebra · AOC',
    p: 'Spare parts and consumables.',
    blurb: 'Drives, peripherals and the spare parts the bench uses — held in country rather than ordered in.',
    img: imgDrive, alt: 'Close detail of a storage drive',
  },
  {
    n: '05', icon: 'chip', t: 'Refurbished desktops', sub: 'Smart value.',
    line: 'HP · Dell · Lenovo',
    p: 'Refurbished desktop.',
    blurb: 'Tested at component level by the same technicians who repair them, for a fit-out that does not need the newest thing.',
    img: imgBoard, alt: 'A technician working on a desktop mainboard',
  },
];

const marks = [
  { icon: 'shield', t: 'Genuine products', p: 'Trusted brands' },
  { icon: 'headset', t: 'Expert support', p: 'Across Oman' },
  { icon: 'pin', t: 'Visit our branches', p: `${site.stats.branches} locations` },
];

const helps = [
  { icon: 'users', t: 'Expert guidance', p: 'Get the right solution' },
  { icon: 'pin', t: 'Multiple branches', p: 'Service across Oman' },
  { icon: 'chat', t: 'Ongoing support', p: "We're always here" },
];
---

<PageLayout
  title="Products"
  description={`Laptops, desktops, networking, security and accessories from ${brands.flat().length} brands — supplied across Oman from ${site.stats.branches} branches since ${site.stats.since}.`}
>
  {/* ══════ 01 · hero ══════ */}
  <section class="ph">
    <span class="ph__sky" aria-hidden="true"></span>

    <div class="shell ph__grid">
      <div class="ph__copy">
        <p class="eb" data-rise>Explore products</p>
        <h1 class="ph__h" data-mask>
          <span class="mask"><span class="mask__i" style="--d:90ms">Technology,</span></span>
          <span class="mask"><span class="mask__i" style="--d:170ms">chosen for the way</span></span>
          <span class="mask"><span class="mask__i" style="--d:250ms"><em>you work.</em></span></span>
        </h1>
        <p class="ph__p" data-rise style="--d:260ms">
          Laptops, desktops, networking, security and more — genuine products
          and trusted technology solutions for businesses and individuals
          across Oman.
        </p>

        <div class="ph__acts" data-rise style="--d:320ms">
          <a class="btn" href="#categories">
            Browse all products
            <span class="btn__i" aria-hidden="true"><Icon name="arrow" size={15} /></span>
          </a>
          <button class="film" type="button" data-video-open>
            <i aria-hidden="true"><Icon name="play" size={12} /></i>
            <span>Watch video<small>Explore our range</small></span>
          </button>
        </div>

        <ul class="ph__marks" data-rise style="--d:380ms">
          {marks.map((m) => (
            <li>
              <i aria-hidden="true"><Icon name={m.icon} size={17} /></i>
              <span><b>{m.t}</b>{m.p}</span>
            </li>
          ))}
        </ul>
      </div>

      {/* Same layered treatment as the services hero. Every decoration is
          a sibling of the figure — inside it they would be clipped to the
          picture's own frame. */}
      <div class="ph__stage" data-mask>
        <span class="ph__slab" aria-hidden="true"></span>
        <span class="ph__dots" aria-hidden="true"></span>

        <figure class="ph__media">
          <Image src={imgDesk} alt="Danat staff at the support desk"
            widths={[700, 1100, 1500]} sizes="(min-width:62rem) 48vw, 100vw"
            quality={78} format="webp" loading="eager" fetchpriority="high" />
        </figure>

        <p class="ph__chip" data-rise style="--d:560ms">
          <i aria-hidden="true"><Icon name="bolt" size={15} /></i>
          <span><b>Reliable tech</b>Brighter tomorrow</span>
        </p>

        <p class="ph__script" aria-hidden="true">Better Technology<br />A Smarter Oman</p>
      </div>
    </div>
  </section>

  {/* ══════ 02 · featured ══════ */}
  <section class="pf section" data-pick>
    <p class="eb eb--mid" data-rise>Featured products</p>
    <h2 class="pf__h" data-rise style="--d:70ms">Premium brands. Wider choices.</h2>

    <div class="shell pf__grid">
      <ul class="pf__nav" data-rise>
        {cats.map((c, i) => (
          <li>
            <button type="button" data-go={i} data-on={i === 0 ? '' : undefined}>
              <i aria-hidden="true"><Icon name={c.icon} size={18} /></i>
              <span><b>{c.t}</b>{c.sub}</span>
            </button>
          </li>
        ))}
      </ul>

      {/* A real fan on a perspective stage, not a cross-fade: the active
          card stands square and forward, the rest sit back and turn
          inward. Offsets come from --o (signed) and --a (absolute), both
          set in script — CSS has no portable abs(). */}
      <div class="pf__stage" data-rise style="--d:120ms">
        <button class="pf__arrow pf__arrow--l" type="button" data-step="-1" aria-label="Previous">
          <Icon name="arrow" size={16} />
        </button>

        <div class="pf__deck">
          {cats.map((c, i) => (
            <figure class="pf__slide" data-i={i}>
              <Image src={c.img} alt={c.alt} widths={[380, 620]} sizes="300px"
                quality={78} format="webp" loading={i === 0 ? 'eager' : 'lazy'} />
            </figure>
          ))}
        </div>

        <span class="pf__podium" aria-hidden="true">
          <i class="pf__ring">
            {cats.map((c) => <b>{c.t}</b>)}
          </i>
        </span>

        <button class="pf__arrow pf__arrow--r" type="button" data-step="1" aria-label="Next">
          <Icon name="arrow" size={16} />
        </button>
      </div>

      <div class="pf__card" data-rise style="--d:180ms">
        {cats.map((c, i) => (
          <div class="pf__pane" data-i={i} data-on={i === 0 ? '' : undefined}>
            <p class="pf__makes">{c.line}</p>
            <h3 class="pf__t">{c.t}</h3>
            <p class="pf__sub">{c.p}</p>
            <p class="pf__blurb">{c.blurb}</p>
            <a class="btn" href="/contact" data-enquiry="quote">
              View {c.t.toLowerCase()}
              <span class="btn__i" aria-hidden="true"><Icon name="arrow" size={15} /></span>
            </a>
          </div>
        ))}
        <span class="pf__dots" aria-hidden="true">
          {cats.map((_, i) => <i data-on={i === 0 ? '' : undefined}></i>)}
        </span>
      </div>
    </div>
  </section>

  {/* ══════ 03 · categories ══════ */}
  <section class="pc section" id="categories">
    <div class="shell pc__head">
      <div>
        <p class="eb" data-rise>Product categories</p>
        <h2 class="pc__h" data-rise style="--d:70ms">Solutions for every need.</h2>
      </div>
      <p class="pc__p" data-rise style="--d:130ms">
        From leading global brands to essential accessories — {site.stats.parts.toLocaleString('en-US')}
        lines across {site.stats.categories} categories, held across
        {' '}{site.stats.branches} branches.
      </p>
      <a class="pc__all" href="/contact" data-enquiry="quote" data-rise style="--d:190ms">
        Ask for a list<Icon name="arrow" size={15} />
      </a>
    </div>

    <ul class="shell pc__grid">
      {cats.map((c, i) => (
        <li data-rise data-tone={['a', 'b', 'c', 'd', 'a'][i]} style={`--d:${i * 60}ms`}>
          <a href="/contact" data-enquiry="quote">
            <span class="pc__n">{c.n}</span>
            <span class="pc__t">{c.t}</span>
            <span class="pc__s">{c.p}</span>
            <span class="pc__shot">
              <Image src={c.img} alt="" widths={[320, 520]} sizes="240px"
                quality={74} format="webp" loading="lazy" />
            </span>
            <span class="pc__go" aria-hidden="true"><Icon name="arrow" size={15} /></span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  {/* ══════ 04 · brands ══════ */}
  <section class="pb">
    <div class="shell pb__in">
      <div>
        <p class="eb" data-rise>Trusted global brands</p>
        <h2 class="pb__h" data-rise style="--d:70ms">
          World-class technology.<br /><em>Closer to you.</em>
        </h2>
      </div>

      {/* Set as type: the marks are not ours to redraw and no licence is
          on file. The names come from the catalogue export. */}
      <ul class="pb__list" data-rise style="--d:130ms">
        {brands.flat().map((b) => <li>{b}</li>)}
      </ul>

      <p class="pb__note" data-rise style="--d:190ms">
        Genuine products.<br />Authorised sources.<br />Lasting value.
      </p>
    </div>
  </section>

  {/* ══════ 05 · cta ══════ */}
  <section class="pt">
    <span class="pt__wash" aria-hidden="true"></span>
    <div class="shell pt__in">
      <div>
        <h2 class="pt__h" data-rise>Need help choosing?</h2>
        <p class="pt__p" data-rise style="--d:70ms">
          Our experts are here to help you find the right products for your
          home or business.
        </p>
        <div class="pt__acts" data-rise style="--d:130ms">
          <a class="btn btn--light" href="/contact" data-enquiry="consult">
            Talk to Danat
            <span class="btn__i" aria-hidden="true"><Icon name="arrow" size={15} /></span>
          </a>
          <a class="pt__ghost" href="/branches">
            <Icon name="pin" size={16} />Visit a branch
          </a>
        </div>
      </div>

      <ul class="pt__list" data-rise style="--d:160ms">
        {helps.map((h) => (
          <li>
            <i aria-hidden="true"><Icon name={h.icon} size={17} /></i>
            <span><b>{h.t}</b>{h.p}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <VideoModal />
</PageLayout>

<script is:inline>
  /* <ClientRouter /> swaps the body on a nav click without a page load,
     and an is:inline script runs once and never again — so the wiring
     has to be re-run on astro:page-load. */
  (() => {
    const setup = () => {
      const root = document.querySelector('[data-pick]');
      if (!root) return;

      const navs = [...root.querySelectorAll('[data-go]')];
      const slides = [...root.querySelectorAll('.pf__slide')];
      const panes = [...root.querySelectorAll('.pf__pane')];
      const dots = [...root.querySelectorAll('.pf__dots i')];
      const n = slides.length;
      if (!n) return;

      let at = 0;
      const show = (next) => {
        at = ((next % n) + n) % n;
        slides.forEach((el, i) => {
          // Signed distance wrapped the short way, so the fan turns
          // through the nearer edge rather than unwinding the whole deck.
          let o = i - at;
          if (o > n / 2) o -= n;
          if (o < -n / 2) o += n;
          const abs = Math.abs(o);
          el.style.setProperty('--o', String(o));
          el.style.setProperty('--a', String(abs));
          // Falling z-index is what makes each neighbour reveal a strip
          // of itself instead of being buried by the one outside it.
          el.style.zIndex = String(n - abs);
          el.toggleAttribute('data-on', o === 0);
        });
        const mark = (els) =>
          els.forEach((e, i) => e.toggleAttribute('data-on', i === at));
        mark(navs);
        mark(panes);
        mark(dots);
      };

      navs.forEach((b) => b.addEventListener('click', () => show(Number(b.dataset.go))));
      root.querySelectorAll('[data-step]').forEach((b) =>
        b.addEventListener('click', () => show(at + Number(b.dataset.step)))
      );
      show(0);
    };

    let ran = false;
    document.addEventListener('astro:page-load', () => { ran = true; setup(); });
    window.addEventListener('load', () => { if (!ran) { ran = true; setup(); } });
  })();
</script>

<style>
  /* ───────── shared ───────── */
  .eb {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--green-deep);
  }
  .eb::before { content: ''; width: 28px; height: 1px; background: currentColor; }
  .eb--mid { justify-content: center; }
  .eb--mid::before { display: none; }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.85rem 0.85rem 0.85rem 1.4rem;
    border-radius: 999px;
    background: var(--green-deep);
    color: #fff;
    font-size: 0.9375rem;
    font-weight: 700;
    transition: background-color var(--t2) var(--ease);
  }
  .btn:hover { background: #26551f; }
  .btn__i {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.2);
    transition: transform var(--t2) var(--ease);
  }
  .btn:hover .btn__i { transform: translateX(3px); }
  .btn--light { background: #fff; color: #10301a; }
  .btn--light:hover { background: var(--green-bright); }
  .btn--light .btn__i { background: rgb(16 48 26 / 0.14); }

  .film {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    min-width: 0;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    text-align: left;
  }
  .film i {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    flex: none;
    border-radius: 50%;
    background: var(--green-deep);
    color: #fff;
    transition: transform var(--t2) var(--ease);
  }
  .film:hover i { transform: scale(1.08); }
  .film:focus-visible i { outline: 2px solid var(--green-deep); outline-offset: 3px; }
  .film > span { display: grid; min-width: 0; font-size: 0.9375rem; font-weight: 700; }
  .film small {
    overflow-wrap: anywhere;
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    font-weight: 400;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  /* ───────── 01 hero ───────── */
  .ph { position: relative; overflow: hidden; isolation: isolate; }
  .ph__sky {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(880px 520px at 12% 16%, #e6f1e8 0%, rgb(230 241 232 / 0) 62%),
      linear-gradient(162deg, #eff6f0 0%, #f5faf5 58%, #f1f7f2 100%);
  }
  .ph__grid { display: grid; gap: clamp(1.75rem, 3.5vw, 2.75rem); align-items: center; }
  .ph__copy, .ph__stage { min-width: 0; }
  .ph__copy { padding-block: clamp(5.5rem, 10vw, 8rem) clamp(2rem, 4vw, 3rem); }

  .ph__h {
    margin-top: var(--s4);
    font-size: clamp(2.1rem, 4.2vw, 3.1rem);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 1.05;
  }
  .ph__h em { font-style: normal; color: var(--green-deep); }
  .ph__p {
    max-width: 44ch;
    margin-top: var(--s4);
    font-size: 0.9375rem;
    line-height: 1.68;
    color: var(--text-2);
  }
  .ph__acts {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s4) var(--s5);
    margin-top: var(--s5);
  }
  .ph__marks {
    display: grid;
    gap: var(--s4);
    margin-top: var(--s5);
    padding-top: var(--s5);
    border-top: 1px solid var(--line-light);
  }
  .ph__marks li { display: grid; grid-template-columns: auto 1fr; align-items: center; gap: 0.7rem; }
  .ph__marks i {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 12px;
    background: #e9f3ea;
    color: var(--green-deep);
  }
  .ph__marks span { display: grid; font-size: 0.75rem; color: var(--text-3); }
  .ph__marks b { font-size: 0.8125rem; font-weight: 700; color: var(--text); }

  .ph__stage { position: relative; margin-bottom: clamp(1.5rem, 3vw, 2.5rem); }
  .ph__slab, .ph__dots, .ph__script { display: none; }
  .ph__media {
    position: relative;
    aspect-ratio: 16 / 11;
    border-radius: 18px;
    overflow: hidden;
  }
  .ph__media :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .ph__chip {
    position: absolute;
    top: clamp(0.7rem, 2vw, 1.2rem);
    left: clamp(0.7rem, 2vw, 1.2rem);
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 0.6rem;
    padding: 0.6rem 0.9rem;
    border-radius: 14px;
    background: rgb(255 255 255 / 0.95);
    backdrop-filter: blur(8px);
    box-shadow: 0 16px 34px -18px rgb(8 22 10 / 0.5);
  }
  .ph__chip i { display: grid; place-items: center; color: var(--green-deep); }
  .ph__chip span { display: grid; font-size: 0.6875rem; color: var(--text-3); }
  .ph__chip b { font-size: 0.8125rem; font-weight: 700; color: var(--text); }

  /* ───────── 02 featured ───────── */
  .pf { background: var(--white); }
  .pf__h {
    max-width: 22ch;
    margin: var(--s4) auto 0;
    font-size: clamp(1.5rem, 2.8vw, 2.1rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.12;
    text-align: center;
  }
  .pf__grid {
    display: grid;
    gap: clamp(1.25rem, 2.6vw, 2rem);
    margin-top: clamp(1.75rem, 4vw, 2.75rem);
    align-items: center;
  }

  .pf__nav { display: grid; gap: 0.4rem; align-content: start; }
  .pf__nav button {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 0.8rem;
    width: 100%;
    padding: 0.85rem 1rem;
    border: 0;
    border-radius: 14px;
    background: var(--off);
    text-align: left;
    cursor: pointer;
    transition: background-color var(--t2) var(--ease), color var(--t2) var(--ease);
  }
  .pf__nav i { display: grid; place-items: center; color: var(--green-deep); }
  .pf__nav span { display: grid; min-width: 0; font-size: 0.6875rem; color: var(--text-3); }
  .pf__nav b { font-size: 0.875rem; font-weight: 700; color: var(--text); }
  .pf__nav button:hover { background: #e9f3ea; }
  .pf__nav [data-on] { background: var(--green-deep); }
  .pf__nav [data-on] i { color: var(--green-bright); }
  .pf__nav [data-on] span { color: rgb(255 255 255 / 0.76); }
  .pf__nav [data-on] b { color: #fff; }
  .pf__nav button:focus-visible { outline: 2px solid var(--green-deep); outline-offset: 2px; }

  .pf__stage {
    position: relative;
    aspect-ratio: 1 / 0.72;
    perspective: 1500px;
  }
  .pf__deck { position: absolute; inset: 0 0 16% 0; transform-style: preserve-3d; }

  .pf__slide {
    position: absolute;
    top: 50%;
    left: 50%;
    /* The individual translate resolves before transform, so the card is
       centred first and every fan offset is measured from the middle. */
    translate: -50% -50%;
    width: min(13.5rem, 52%);
    aspect-ratio: 4 / 3;
    padding: 0.4rem;
    border-radius: 18px;
    background: var(--white);
    box-shadow: 0 2px 4px rgb(10 30 12 / 0.05), 0 30px 58px -30px rgb(10 30 12 / 0.42);
    transform:
      translateX(calc(var(--o, 0) * 6.9rem))
      translateY(calc(var(--a, 0) * 0.5rem))
      translateZ(calc(var(--a, 0) * -110px))
      rotateY(calc(var(--o, 0) * -14deg))
      scale(calc(1 - var(--a, 0) * 0.05));
    transition:
      transform 700ms cubic-bezier(0.4, 0, 0.2, 1),
      opacity 460ms var(--ease),
      box-shadow 460ms var(--ease);
  }
  .pf__slide:not([data-on]) { opacity: calc(1 - var(--a, 0) * 0.08); }
  .pf__slide[data-on] {
    box-shadow: 0 2px 4px rgb(10 30 12 / 0.06), 0 46px 80px -32px rgb(10 30 12 / 0.5);
  }
  .pf__slide :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 13px;
  }

  /* the plinth the fan stands on */
  .pf__podium {
