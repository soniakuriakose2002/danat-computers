---
import { Image } from 'astro:assets';
import PageLayout from '@layouts/PageLayout.astro';
import Icon from '@components/ui/Icon.astro';
import { site, brands } from '@data/site';
import pHp from '@assets/products/hp.png';
import scLaptop from '@assets/products/scene/laptop.png';
import scDesktop from '@assets/products/scene/desktop.png';
import scRouter from '@assets/products/scene/router.png';
import scCamera from '@assets/products/scene/camera.png';
import scParts from '@assets/products/scene/parts.png';
import scTower from '@assets/products/scene/tower.png';

/* All six come off one sheet, so they share a light source and a grade.
   The brand machines in the featured fan stay as they are. */
const heroShot = scLaptop;

/** The rest of the range standing around the dais. */
const props = [
  { img: scDesktop, at: 'desk' },
  { img: scRouter, at: 'rout' },
  { img: scCamera, at: 'cam' },
  { img: scTower, at: 'tower' },
  { img: scParts, at: 'part' },
];
import pDell from '@assets/products/dell.png';
import pAsus from '@assets/products/asus.png';
import pLenovo from '@assets/products/lenovo.png';
import pWired from '@assets/products/wired.jpg';
import pWireless from '@assets/products/wireless.jpg';
import pCctv from '@assets/products/cctv.jpg';
import pSpare from '@assets/products/spare.jpg';
import pRefurb from '@assets/products/refurb.jpg';
import imgPatch from '@assets/photos/network-patch.jpg';
import imgCctv from '@assets/photos/cctv-white.jpg';
import imgDrive from '@assets/photos/drive-macro.jpg';
/* NOT repair-board.jpg — its technician wears a uniform branded
   ТЕХНОБЫТСЕРВИС, a competing repair company, legible at display size. */
import imgBoard from '@assets/photos/drive-macro.jpg';

/**
 * PRODUCTS — built to the client's mockup.
 *
 * ⚠ Danat has no online catalogue: no prices, no stock levels, no cart.
 * The old site's product page had none either. So every call to action
 * here ends in a conversation rather than pretending to a basket —
 * "Browse all products" moves down to the categories, and the per-
 * category buttons open the quote modal. Nothing claims a price.
 *
 * The five categories are the ones the old product page carried, minus
 * the four entries on it that were actually services and already live
 * on /services — CCTV installation, wired networking, wireless
 * networking and spare parts.
 *
 * Brand names are set as type. Danat has no licence on file for HP,
 * Dell, Apple, ASUS or Lenovo artwork, and their marks are not ours to
 * redraw; the sixteen names come from the catalogue export.
 */
/**
 * ⚠ Apple is in the brand row and the category's brand line but NOT on
 * the stage. The old site's Apple picture is a dark studio composite of
 * a dozen products, and the iMac's screen sits within tolerance of the
 * ground behind it — every automatic cut takes the screen away with the
 * background, leaving an outline. It needs a product shot on white, like
 * the other four have. Four machines turn on the stage until then.
 *
 * The five categories and their items are the old product page's own,
 * names and all — pulled from danatcomputers.com/page/product together
 * with its photographs, which now live in src/assets/products.
 *
 * Each category holds its items; the fan turns them and the card on the
 * right follows. Laptops has the five brands, networking has wired and
 * wireless, the rest have one each.
 */
const cats = [
  {
    icon: 'laptop', t: 'Laptops & Desktops', sub: 'Leading brands. Reliable performance.', pre: 'Computers and laptops',
    items: [
      { b: 'HP', t: 'HP Laptops & Desktops', img: pHp, cut: true,
        p: 'Power your ideas with HP. Designed for work, learning and everyday performance.' },
      { b: 'Dell', t: 'Dell Laptops & Desktops', img: pDell, cut: true,
        p: 'Precision and innovation with Dell, for the desk and the site office alike.' },
      { b: 'Asus', t: 'Asus Laptops & Desktops', img: pAsus, cut: true,
        p: 'Elevate your experience with Asus — everyday machines that keep up.' },
      { b: 'Lenovo', t: 'Lenovo Laptops & Desktops', img: pLenovo, cut: true,
        p: 'Innovation redefined with Lenovo, built to be worked rather than admired.' },
    ],
  },
  {
    icon: 'network', t: 'Networking', sub: 'Wired and wireless, planned and fixed.', pre: 'Networking equipment',
    items: [
      { b: 'Wired', t: 'Wired Networking', img: pWired,
        p: 'Structured cabling, patching and switching — set up new or put right.' },
      { b: 'Wireless', t: 'Wireless Networking', img: pWireless,
        p: 'Access points and coverage planned around how the space is actually used.' },
    ],
  },
  {
    icon: 'camera', t: 'Security & CCTV', sub: 'Smarter, safer spaces.', pre: 'CCTV and security',
    items: [
      { b: 'CCTV', t: 'CCTV Installation', img: pCctv,
        p: 'Cameras, recorders and storage, supplied by the people who maintain them.' },
    ],
  },
  {
    icon: 'gear', t: 'Spare Parts', sub: 'Held here, not ordered in.', pre: 'Hardware support',
    items: [
      { b: 'Parts', t: 'Spare Parts', img: pSpare,
        p: 'The parts the bench uses every day, on the shelf rather than on order.' },
    ],
  },
  {
    icon: 'chip', t: 'Refurbished Desktop', sub: 'Reliable performance, better value.', pre: 'Computers and laptops',
    items: [
      { b: 'Refurbished', t: 'Refurbished Desktop', img: pRefurb,
        p: 'Tested at component level by the technicians who repair them.' },
    ],
  },
];

/** The chips that float around the scene, in the mockup's order. */
const chips = [
  { icon: 'laptop', t: 'Desktops', at: 'a' },
  { icon: 'laptop', t: 'Laptops', at: 'b' },
  { icon: 'network', t: 'Networking', at: 'c' },
  { icon: 'camera', t: 'Security & CCTV', at: 'd' },
  { icon: 'chip', t: 'Refurbished desktops', at: 'e' },
  { icon: 'gear', t: 'Spare parts', at: 'f' },
];

/** The hero's three. Deliberately not the plinth's three below it —
    the same words twice on one page reads as a mistake. */
const heroMarks = [
  { icon: 'gem', t: 'Trusted brands' },
  { icon: 'laptop', t: 'Latest technology' },
  { icon: 'shield', t: 'Reliable products' },
];

/** The mockup's three, on the plinth. */
const plinth = [
  { icon: 'gem', t: 'Top brands' },
  { icon: 'laptop', t: 'Latest models' },
  { icon: 'shield', t: 'Genuine products' },
];

/** The mockup's three ticks on the right-hand card. */
const ticks = ['Wide range of models', 'Reliable performance', 'Ideal for business & home'];

const marks = [
  { icon: 'shield', t: 'Genuine products', p: 'Trusted brands' },
  { icon: 'headset', t: 'Expert support', p: 'Across Oman' },
  { icon: 'pin', t: 'Visit our branches', p: `${site.stats.branches} locations` },
];

const helps = [
  { icon: 'users', t: 'Expert guidance', p: 'Get the right solution' },
  { icon: 'pin', t: 'Multiple branches', p: 'Service across Oman' },
  { icon: 'chat', t: 'Ongoing support', p: "We're always here" },
];
---

<PageLayout
  title="Products"
  description={`Laptops, desktops, networking, security and accessories from ${brands.flat().length} brands — supplied across Oman from ${site.stats.branches} branches since ${site.stats.since}.`}
>
  {/* ══════ 01 · hero ══════ */}
  <section class="ph">
    <span class="ph__waves" aria-hidden="true">
      <svg viewBox="0 0 1440 420" preserveAspectRatio="none" fill="none">
        <path d="M0,300 C260,190 520,360 760,250 C1000,140 1220,300 1440,210 L1440,420 L0,420 Z" />
        <path d="M0,360 C300,250 560,400 820,300 C1060,210 1250,340 1440,270 L1440,420 L0,420 Z" />
        <path d="M980,0 C1120,120 1180,60 1320,170 C1400,230 1420,300 1440,360" />
        <path d="M1080,0 C1210,130 1270,80 1400,200" />
      </svg>
    </span>

    <div class="shell ph__grid">
      <div class="ph__copy">
        <p class="eb" data-rise>Our product range</p>
        <h1 class="ph__h" data-rise style="--d:70ms">
          Technology for <em>Every Need</em>
        </h1>
        <p class="ph__p" data-rise style="--d:130ms">
          Explore trusted devices built for work, business, and everyday life.
        </p>
        <ul class="ph__marks" data-rise style="--d:190ms">
          {heroMarks.map((m) => (
            <li><i aria-hidden="true"><Icon name={m.icon} size={16} /></i>{m.t}</li>
          ))}
        </ul>
      </div>

      {/* The scene: a lit dais with the range standing on it and the
          categories floating around, as drawn. The chips are siblings of
          the picture — inside it they would be clipped by its own box. */}
      <div class="ph__scene" data-rise style="--d:160ms">
        <span class="ph__dais" aria-hidden="true"><i></i></span>

        {props.map((x) => (
          <span class="ph__prop" data-at={x.at} aria-hidden="true">
            <img src={x.img.src} width={x.img.width} height={x.img.height}
              alt="" loading="lazy" />
          </span>
        ))}
        <img class="ph__hero" src={heroShot.src} width={heroShot.width}
          height={heroShot.height} alt="" loading="eager" fetchpriority="high" />

        {chips.map((c, i) => (
          <span class="ph__chip" data-at={c.at} style={`--d:${300 + i * 90}ms`}>
            <i aria-hidden="true"><Icon name={c.icon} size={15} /></i>{c.t}
          </span>
        ))}
      </div>

      {/* The same six, for widths where a label cannot float beside the
          thing it names without landing on top of it. Only one of the two
          is ever displayed. */}
      <ul class="ph__cats">
        {chips.map((c) => (
          <li><i aria-hidden="true"><Icon name={c.icon} size={14} /></i>{c.t}</li>
        ))}
      </ul>
    </div>
  </section>

  {/* ══════ 02 · featured ══════ */}
  <section class="pf section" data-pick
    data-cats={JSON.stringify(cats.map((x) => ({ n: x.items.length, t: x.t, s: x.sub })))}>
    {/* Not the hero's shape again: a ruled band, the title on the left and
        the supporting line and marks set against it on the right. */}
    <div class="shell pf__head">
      <span class="pf__hr" aria-hidden="true"></span>
      <div class="pf__lede">
        <p class="eb" data-rise>Explore our products</p>
        <h2 class="pf__h" data-rise style="--d:70ms">
          <span data-cat-a>{cats[0].t.split(' ').slice(0, -1).join(' ')}</span>
          {' '}
          <em data-cat-b>{cats[0].t.split(' ').slice(-1)[0]}</em>
        </h2>
      </div>
      <div class="pf__aside">
        <p class="pf__sub" data-cat-s data-rise style="--d:110ms">{cats[0].sub}</p>
        <ul class="pf__over" data-rise style="--d:150ms">
          {plinth.map((m) => (
            <li><i aria-hidden="true"><Icon name={m.icon} size={15} /></i>{m.t}</li>
          ))}
        </ul>
      </div>
    </div>

    <div class="shell pf__grid">
      <ul class="pf__nav" data-rise>
        {cats.map((c, i) => (
          <li>
            <button type="button" data-go={i} data-on={i === 0 ? '' : undefined}>
              <i aria-hidden="true"><Icon name={c.icon} size={18} /></i>
              <b>{c.t}</b>
              <em aria-hidden="true"><Icon name="arrow" size={14} /></em>
            </button>
          </li>
        ))}
      </ul>

      {/* A real fan on a perspective stage. Offsets come from --o (signed)
          and --a (absolute), both set in script — CSS has no portable
          abs() — and z-index falls away from the active card so each
          neighbour reveals a strip of itself. */}
      <div class="pf__stage" data-rise style="--d:120ms">
        <button class="pf__arrow pf__arrow--l" type="button" data-step="-1" aria-label="Previous">
          <Icon name="arrow" size={16} />
        </button>

        <div class="pf__deck">
          {cats.map((cat, ci) =>
            cat.items.map((it, ii) => (
              <figure class="pf__slide" data-c={ci} data-i={ii} data-cut={it.cut ? '' : undefined}>
                <Image src={it.img} alt={it.t} widths={[360, 620]} sizes="320px"
                  quality={82} format="webp" loading={ci === 0 && ii === 0 ? 'eager' : 'lazy'} />
              </figure>
            ))
          )}
        </div>

        <span class="pf__halo" aria-hidden="true"></span>

        {/* The stage the range stands on: an ellipse for the top face and
            a stack of offset shadows for the side, which reads as a
            cylinder without a second element. */}
        <span class="pf__podium" aria-hidden="true">
          <i class="pf__top"></i>
          <i class="pf__brands">
            {cats[0].items.map((it) => <b>{it.b}</b>)}
          </i>
        </span>

        <span class="pf__dots" data-fan-dots aria-hidden="true">
          {cats[0].items.map((_, i) => <i data-on={i === 0 ? '' : undefined}></i>)}
        </span>

        <button class="pf__arrow pf__arrow--r" type="button" data-step="1" aria-label="Next">
          <Icon name="arrow" size={16} />
        </button>
      </div>

      <div class="pf__card" data-rise style="--d:180ms">
        {cats.map((cat, ci) =>
          cat.items.map((it, ii) => (
            <div class="pf__pane" data-c={ci} data-i={ii}
              data-on={ci === 0 && ii === 0 ? '' : undefined}>
              <p class="pf__mark">{it.b}</p>
              <h3 class="pf__t">{it.t}</h3>
              <p class="pf__blurb">{it.p}</p>
              <ul class="pf__ticks">
                {ticks.map((t) => (
                  <li><i aria-hidden="true"><Icon name="check" size={12} /></i>{t}</li>
                ))}
              </ul>
              {/* It opens a quote, so it says so. There is no catalogue
                  behind this site to list, and a button promising one
                  would misdescribe what happens next. The subject rides
                  along so the form does not arrive blank. */}
              <a class="btn" href="/contact" data-enquiry="quote"
                data-enquiry-product={cat.pre}>
                Ask about {it.b}
                <span class="btn__i" aria-hidden="true"><Icon name="arrow" size={15} /></span>
              </a>
            </div>
          ))
        )}
      </div>
    </div>

    {/* ── shop by brand ── */}
    <p class="eb eb--low shell" data-rise>Shop by brand</p>
    <div class="shell pb__row" data-rise style="--d:70ms">
      <ul>
        {['HP', 'Dell', 'Asus', 'Apple', 'Lenovo'].map((b) => <li>{b}</li>)}
      </ul>
      <p>Trusted brands<br />for a smarter Oman.</p>
    </div>
  </section>

  {/* ══════ 03 · categories ══════ */}
  <section class="pc section" id="categories">
    <div class="shell pc__head">
      <div>
        <p class="eb" data-rise>Product categories</p>
        <h2 class="pc__h" data-rise style="--d:70ms">Solutions for every need.</h2>
      </div>
      <p class="pc__p" data-rise style="--d:130ms">
        From leading global brands to essential accessories — {site.stats.parts.toLocaleString('en-US')}
        lines across {site.stats.categories} categories, held across
        {' '}{site.stats.branches} branches.
      </p>
      <a class="pc__all" href="/contact" data-enquiry="quote" data-rise style="--d:190ms">
        Ask for a list<Icon name="arrow" size={15} />
      </a>
    </div>

    <ul class="shell pc__grid">
      {cats.map((c, i) => (
        <li data-rise data-tone={['a', 'b', 'c', 'd', 'a'][i]} style={`--d:${i * 60}ms`}>
          <a href="/contact" data-enquiry="quote" data-enquiry-product={c.pre}>
            <span class="pc__n">{String(i + 1).padStart(2, '0')}</span>
            <span class="pc__t">{c.t}</span>
            <span class="pc__s">{c.sub}</span>
            <span class="pc__shot">
              <Image src={c.items[0].img} alt="" widths={[320, 520]} sizes="240px"
                quality={74} format="webp" loading="lazy" />
            </span>
            <span class="pc__go" aria-hidden="true"><Icon name="arrow" size={15} /></span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  {/* ══════ 04 · brands ══════ */}
  <section class="pb">
    <div class="shell pb__in">
      <div>
        <p class="eb" data-rise>Trusted global brands</p>
        <h2 class="pb__h" data-rise style="--d:70ms">
          World-class technology.<br /><em>Closer to you.</em>
        </h2>
      </div>

      {/* Set as type: the marks are not ours to redraw and no licence is
          on file. The names come from the catalogue export.

          Two rails running opposite ways, each holding its row twice so
          the loop has something to scroll into. Duplicated content is
          noise to a screen reader, so the rails are hidden from it and
          the real list sits behind them. */}
      <ul class="pb__sr">
        {brands.flat().map((b) => <li>{b}</li>)}
      </ul>

      <div class="pb__rails" data-rise style="--d:130ms" aria-hidden="true">
        {brands.map((row, r) => (
          <div class="pb__rail" data-dir={r === 1 ? 'rev' : undefined}>
            <div class="pb__track">
              {[0, 1].map(() => row.map((b) => <span>{b}</span>))}
            </div>
          </div>
        ))}
      </div>

      <p class="pb__note" data-rise style="--d:190ms">
        Genuine products.<br />Authorised sources.<br />Lasting value.
      </p>
    </div>
  </section>

  {/* ══════ 05 · cta ══════ */}
  <section class="pt">
    <span class="pt__wash" aria-hidden="true"></span>
    <div class="shell pt__in">
      <div>
        <h2 class="pt__h" data-rise>Need help choosing?</h2>
        <p class="pt__p" data-rise style="--d:70ms">
          Our experts are here to help you find the right products for your
          home or business.
        </p>
        <div class="pt__acts" data-rise style="--d:130ms">
          <a class="btn btn--light" href="/contact" data-enquiry="consult">
            Talk to Danat
            <span class="btn__i" aria-hidden="true"><Icon name="arrow" size={15} /></span>
          </a>
          <a class="pt__ghost" href="/branches">
            <Icon name="pin" size={16} />Visit a branch
          </a>
        </div>
      </div>

      <ul class="pt__list" data-rise style="--d:160ms">
        {helps.map((h) => (
          <li>
            <i aria-hidden="true"><Icon name={h.icon} size={17} /></i>
            <span><b>{h.t}</b>{h.p}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

</PageLayout>

<script is:inline>
  /* <ClientRouter /> swaps the body on a nav click without a page load,
     and an is:inline script runs once and never again — so the wiring
     has to be re-run on astro:page-load. */
  (() => {
    const setup = () => {
      const root = document.querySelector('[data-pick]');
      if (!root) return;

      const navs = [...root.querySelectorAll('[data-go]')];
      const slides = [...root.querySelectorAll('.pf__slide')];
      const panes = [...root.querySelectorAll('.pf__pane')];
      const dotBox = root.querySelector('[data-fan-dots]');
      const catA = root.querySelector('[data-cat-a]');
      const catB = root.querySelector('[data-cat-b]');
      const catS = root.querySelector('[data-cat-s]');
      if (!slides.length) return;

      const CATS = JSON.parse(root.dataset.cats || '[]');
      let c = 0;
      let i = 0;

      const show = () => {
        const n = CATS[c] ? CATS[c].n : 1;
        i = ((i % n) + n) % n;

        // An even count cannot fan symmetrically — four items put two on
        // one side and one on the other, which is what read as untidy.
        // Show the active one plus the same number each side, always.
        const wing = Math.floor((n - 1) / 2);

        slides.forEach((el) => {
          const mine = Number(el.dataset.c) === c;
          if (!mine) {
            el.toggleAttribute('data-off', true);
            // data-on has to come OFF too. Returning early left every
            // category we had visited still flagged active, so those
            // slides kept the float animation and, worse, kept the --o
            // and --a they were last posed with — so returning to a
            // category started it from a stale arrangement instead of
            // fanning into place.
            el.toggleAttribute('data-on', false);
            return;
          }
          el.removeAttribute('data-off');
          // Signed distance wrapped the short way, so the fan turns
          // through the nearer edge rather than unwinding the deck.
          let o = Number(el.dataset.i) - i;
          if (o > n / 2) o -= n;
          if (o < -n / 2) o += n;
          const abs = Math.abs(o);
          el.style.setProperty('--o', String(o));
          el.style.setProperty('--a', String(abs));
          el.style.zIndex = String(9 - abs);
          el.toggleAttribute('data-on', o === 0);
          el.toggleAttribute('data-far', abs > wing);
        });

        panes.forEach((el) =>
          el.toggleAttribute('data-on',
            Number(el.dataset.c) === c && Number(el.dataset.i) === i)
        );
        navs.forEach((el, k) => el.toggleAttribute('data-on', k === c));

        if (CATS[c]) {
          const parts = CATS[c].t.split(' ');
          const last = parts.pop();
          if (catA) catA.textContent = parts.join(' ');
          if (catB) catB.textContent = last;
        }
        if (catS && CATS[c]) catS.textContent = CATS[c].s;

        // The dot count follows the category, which does not hold a
        // fixed number of items.
        if (dotBox) {
          if (dotBox.children.length !== n) {
            dotBox.replaceChildren();
            for (let k = 0; k < n; k++) dotBox.appendChild(document.createElement('i'));
          }
          [...dotBox.children].forEach((d, k) => d.toggleAttribute('data-on', k === i));
        }
      };

      navs.forEach((b) => b.addEventListener('click', () => { c = Number(b.dataset.go); i = 0; show(); stop(); start(); }));
      let timer = null;
      const stop = () => { if (timer) clearInterval(timer); timer = null; };
      const start = () => {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        if (!timer) timer = setInterval(() => { i += 1; show(); }, 3600);
      };

      root.querySelectorAll('[data-step]').forEach((b) =>
        b.addEventListener('click', () => { i += Number(b.dataset.step); show(); stop(); start(); })
      );

      // It pauses while someone is actually working the controls. Holding
      // on the whole section meant a pointer resting anywhere near it —
      // over the heading, the card, the empty margin — stopped the fan,
      // which is indistinguishable from it never animating at all.
      root.querySelectorAll('.pf__nav, .pf__arrow').forEach((el) => {
        el.addEventListener('pointerenter', stop);
        el.addEventListener('pointerleave', start);
      });
      root.addEventListener('focusin', stop);
      root.addEventListener('focusout', start);

      show();
      start();
    };

    let ran = false;
    document.addEventListener('astro:page-load', () => { ran = true; setup(); });
    window.addEventListener('load', () => { if (!ran) { ran = true; setup(); } });
  })();
</script>

<style>
  /* ───────── shared ───────── */
  .eb {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--green-deep);
  }
  .eb::before { content: ''; width: 28px; height: 1px; background: currentColor; }
  .eb--mid { justify-content: center; }
  .eb--mid::before { display: none; }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.85rem 0.85rem 0.85rem 1.4rem;
    border-radius: 999px;
    background: var(--green-deep);
    color: #fff;
    font-size: 0.9375rem;
    font-weight: 700;
    transition: background-color var(--t2) var(--ease);
  }
  .btn:hover { background: #26551f; }
  .btn__i {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.2);
    transition: transform var(--t2) var(--ease);
  }
  .btn:hover .btn__i { transform: translateX(3px); }
  .btn--light { background: #fff; color: #10301a; }
  .btn--light:hover { background: var(--green-bright); }
  .btn--light .btn__i { background: rgb(16 48 26 / 0.14); }

  .film {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    min-width: 0;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    text-align: left;
  }
  .film i {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    flex: none;
    border-radius: 50%;
    background: var(--green-deep);
    color: #fff;
    transition: transform var(--t2) var(--ease);
  }
  .film:hover i { transform: scale(1.08); }
  .film:focus-visible i { outline: 2px solid var(--green-deep); outline-offset: 3px; }
  .film > span { display: grid; min-width: 0; font-size: 0.9375rem; font-weight: 700; }
  .film small {
    overflow-wrap: anywhere;
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    font-weight: 400;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  /* ───────── 01 hero ───────── */
  .ph {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    padding-block: clamp(5.5rem, 10vw, 8rem) clamp(2rem, 4vw, 3.5rem);
    background:
      radial-gradient(900px 520px at 78% 40%, #e9f5eb 0%, rgb(233 245 235 / 0) 66%),
      linear-gradient(170deg, #f4faf5 0%, #ffffff 58%, #f1f8f3 100%);
  }
  .ph__waves { position: absolute; inset: 0; z-index: -1; }
  .ph__waves svg { width: 100%; height: 100%; }
  .ph__waves path { fill: rgb(47 100 41 / 0.045); }
  .ph__waves path:nth-child(2) { fill: rgb(47 100 41 / 0.03); }
  .ph__waves path:nth-child(n+3) {
    fill: none;
    stroke: rgb(47 100 41 / 0.12);
    stroke-width: 1.5;
  }

  .ph__grid { display: grid; gap: clamp(1.75rem, 4vw, 3rem); align-items: center; }
  .ph__copy, .ph__scene { min-width: 0; }

  .ph__h {
    margin-top: var(--s4);
    font-size: var(--hero);
    font-weight: 700;
    letter-spacing: var(--hero-tr);
    line-height: var(--hero-lh);
  }
  .ph__h em { font-style: normal; color: var(--green-deep); }
  .ph__p {
    max-width: 44ch;
    margin-top: var(--s4);
    font-size: var(--lead);
    line-height: 1.6;
    color: var(--text-2);
  }
  .ph__marks {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem clamp(0.9rem, 2.4vw, 2rem);
    margin-top: var(--s5);
  }
  .ph__marks li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--text-2);
  }
  .ph__marks li + li {
    padding-left: clamp(0.9rem, 2.4vw, 2rem);
    border-left: 1px solid var(--line-light);
  }
  .ph__marks i { display: grid; place-items: center; color: var(--green-deep); }

  /* the scene */
  .ph__scene { position: relative; aspect-ratio: 1 / 0.62; }
  .ph__hero {
    position: absolute;
    left: 50%;
    bottom: 21%;
    translate: -50% 0;
    width: min(15rem, 32%);
    height: auto;
    z-index: 2;
    filter:
      drop-shadow(0 3px 2px rgb(10 30 12 / 0.34))
      drop-shadow(0 14px 18px rgb(10 30 12 / 0.16));
  }
  /* The rest of the range. Depth is carried by z-index against the dais:
     the desktop and the router stand BEHIND it, the drives in front. */
  .ph__prop { position: absolute; display: block; }
  .ph__prop img {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    height: auto;
    filter: drop-shadow(0 10px 12px rgb(10 30 12 / 0.16));
  }
  /* Each group stands on its own podium, as the mockup draws it — without
     one everything but the laptop reads as hanging in the air. Stacked
     offsets give the side of the cylinder; the dais uses the same trick. */
  .ph__prop::after {
    content: '';
    position: absolute;
    z-index: 0;
    left: 50%;
    bottom: -5%;
    translate: -50% 0;
    width: 116%;
    aspect-ratio: 3.4 / 1;
    border-radius: 50%;
    background: radial-gradient(ellipse at 50% 30%, #ffffff 0%, #f3f9f4 58%, #e8f3ea 100%);
    box-shadow:
      0 4px 0 #fcfefc, 0 9px 0 #f4faf5, 0 15px 0 #ecf6ee,
      0 22px 16px -12px rgb(47 100 41 / 0.26);
  }
  /* The drives lie flat and are wide — a podium as broad as the rest would
     swamp them. */
  .ph__prop[data-at='part']::after { width: 84%; bottom: -9%; }
  .ph__prop[data-at='desk']  { z-index: 0; left: 15%;  bottom: 40%; width: 19%; }
  .ph__prop[data-at='rout']  { z-index: 0; right: 27%; bottom: 63%; width: 10%; }
  .ph__prop[data-at='cam']   { z-index: 1; right: 19%; bottom: 44%; width: 9%; }
  .ph__prop[data-at='tower'] { z-index: 0; right: 15%; bottom: 27%; width: 6%; }
  .ph__prop[data-at='part']  { z-index: 2; left: 11%;  bottom: 23%; width: 15%; }

  .ph__dais {
    position: absolute;
    left: 51%;
    bottom: 12%;
    translate: -50% 0;
    z-index: 1;
    width: 41%;
    aspect-ratio: 3.4 / 1;
    border-radius: 50%;
    background: radial-gradient(ellipse at 50% 30%, #ffffff 0%, #f1f8f3 58%, #e4f0e7 100%);
    box-shadow:
      0 6px 0 #fbfefb, 0 13px 0 #f3faf4, 0 21px 0 #ebf5ed,
      0 32px 26px -18px rgb(47 100 41 / 0.3);
  }
  /* the lit ring the range stands in */
  .ph__dais i {
    position: absolute;
    inset: 12% 8% 22%;
    border-radius: 50%;
    border: 2px solid color-mix(in oklab, var(--green) 55%, transparent);
    box-shadow: 0 0 22px 2px rgb(89 170 84 / 0.4);
  }

  /* The mockup sets each label as a card, not a tag: sans, bold, roomy,
     with a sizeable icon and a frosted panel behind it. */
  .ph__chip {
    position: absolute;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    max-width: 26%;
    padding: 0.45rem 0.7rem;
    border-radius: 9px;
    background: rgb(255 255 255 / 0.97);
    backdrop-filter: blur(10px);
    box-shadow:
      0 1px 2px rgb(10 30 12 / 0.06),
      0 14px 24px -14px rgb(10 30 12 / 0.4);
    font-size: var(--label);
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    line-height: 1.25;
    color: var(--text);
    animation: phBob 7s var(--ease) infinite;
    animation-delay: var(--d, 0ms);
  }
  /* The chip carries z-index, so it opens a stacking context and this
     paints behind the card but still above the scene. */
  .ph__chip::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: -0.32rem -0.55rem;
    border-radius: 12px;
    background: rgb(233 245 235 / 0.52);
  }
  .ph__chip i { display: grid; place-items: center; flex: none; color: var(--green-deep); }

  /* Shown only in place of the floating labels — see the narrow block. */
  .ph__cats { display: none; }
  /* Two words, two lines — as drawn. */
  .ph__chip[data-at='d'], .ph__chip[data-at='e'] { max-width: 22%; }

  .ph__chip[data-at='a'] { left: 14%; top: 26%; }
  .ph__chip[data-at='b'] { left: 36%; top: 20%; }
  .ph__chip[data-at='c'] { right: 6%;  top: 21%; }
  .ph__chip[data-at='d'] { right: 1%;  top: 42%; }
  .ph__chip[data-at='e'] { right: 5%;  top: 68%; }
  .ph__chip[data-at='f'] { left: 11%;  top: 77%; }
  @keyframes phBob {
    0%, 100% { translate: 0 0; }
    50% { translate: 0 -8px; }
  }

  /* ───────── 02 featured ───────── */
  /* First section on the page now, so it carries the header
     clearance the hero used to. */
  .pf {
    position: relative;
    isolation: isolate;
    background:
      radial-gradient(1100px 620px at 52% 62%, #e9f4ea 0%, rgb(233 244 234 / 0) 68%),
      linear-gradient(180deg, #f6fbf7 0%, #ffffff 62%);
    padding-block: clamp(2.25rem, 4.5vw, 3.5rem) clamp(2rem, 4vw, 3.25rem);
  }
  /* Same as every other heading block on the site: a leading rule, left
     aligned, and the emphasis on its own line in green. */
  .eb {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--green-deep);
  }
  .eb::before { content: ''; width: 28px; height: 1px; background: currentColor; }
  .eb--low { margin-top: clamp(2.25rem, 4.5vw, 3.5rem); }
  .pf__h em { font-style: normal; color: var(--green-deep); }
  .pf__head { display: grid; gap: clamp(0.9rem, 2vw, 1.4rem); }
  .pf__hr { grid-column: 1 / -1; height: 1px; background: var(--line-light); }
  .pf__h {
    margin-top: var(--s3);
    /* Deliberately smaller than the hero's — the same size twice in a
       column reads as the same section repeated. */
    font-size: var(--d6);
    font-weight: 700;
    letter-spacing: var(--tr6);
    line-height: 1.06;
  }
  .pf__sub {
    max-width: 40ch;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--text-2);
  }
  .pf__over {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem clamp(0.8rem, 2vw, 1.5rem);
    margin-top: var(--s4);
  }
  .pf__over li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--text-2);
  }
  .pf__over li + li {
    padding-left: clamp(0.9rem, 2.4vw, 2rem);
    border-left: 1px solid var(--line-light);
  }
  .pf__over i { display: grid; place-items: center; color: var(--green-deep); }

  .pf__grid {
    display: grid;
    gap: clamp(1.25rem, 2.6vw, 2rem);
    margin-top: clamp(1.25rem, 2.6vw, 1.75rem);
    align-items: center;
  }

  /* the category column */
  .pf__nav {
    display: grid;
    align-content: start;
    padding: 0.5rem;
    border-radius: 22px;
    background: var(--white);
    box-shadow: 0 2px 4px rgb(10 30 12 / 0.04), 0 26px 54px -34px rgb(10 30 12 / 0.4);
  }
  .pf__nav li + li { border-top: 1px solid var(--line-light); }
  .pf__nav button {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.85rem;
    width: 100%;
    padding: 0.95rem 1rem;
    border: 0;
    border-radius: 14px;
    background: none;
    text-align: left;
    cursor: pointer;
    transition: background-color var(--t2) var(--ease);
  }
  .pf__nav i { display: grid; place-items: center; color: var(--green-deep); }
  .pf__nav b { font-size: 0.9375rem; font-weight: 700; color: var(--text); }
  .pf__nav em { display: grid; place-items: center; color: var(--text-3); opacity: 0; }
  .pf__nav button:hover { background: #eef6ef; }
  .pf__nav [data-on] { background: var(--green-deep); }
  .pf__nav [data-on] i, .pf__nav [data-on] em { color: #fff; opacity: 1; }
  .pf__nav [data-on] b { color: #fff; }
  .pf__nav button:focus-visible { outline: 2px solid var(--green-deep); outline-offset: -2px; }

  /* the fan */
  .pf__stage { position: relative; aspect-ratio: 1 / 0.66; perspective: 1400px; }
  .pf__deck {
    position: absolute;
    z-index: 2;
    inset: 2% 0 20% 0;
    transform-style: preserve-3d;
  }
  .pf__slide {
    position: absolute;
    left: 50%;
    /* Anchored to the FLOOR of the deck, not its middle, so every item
       stands on the stage instead of hanging in the middle of its own
       box. transform-origin follows, or scaling lifts the feet off. */
    bottom: 0;
    translate: -50% 0;
    transform-origin: bottom center;
    /* One box for every slide, matching the canvas the machines were
       normalised onto. They are all the same height and stood on the
       same floor in the asset, so the arc comes out even without CSS
       having to reconcile five different shapes. */
    width: min(24rem, 70%);
    aspect-ratio: 900 / 640;
    /* translateY is NEGATIVE with distance: on an ellipse seen from
       slightly above, whatever sits further back sits HIGHER on screen.
       Pushing the outer ones down was what made the row read as a flat
       fan hanging over the disc rather than a group standing on it. */
    transform:
      translateX(calc(var(--o, 0) * 8.4rem))
      translateY(calc(var(--a, 0) * var(--a, 0) * -0.35rem))
      translateZ(calc(var(--a, 0) * var(--a, 0) * -60px))
      rotateY(calc(var(--o, 0) * -15deg))
      scale(calc(1 - var(--a, 0) * 0.12));
    transition:
      transform 700ms cubic-bezier(0.4, 0, 0.2, 1),
      opacity 420ms var(--ease);
  }
  .pf__slide :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  /* A photograph with a real background still needs a frame; a cut-out
     must not have one, or it reads as a box sitting on the stage. */
  .pf__slide:not([data-cut]) {
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 2px 4px rgb(10 30 12 / 0.05), 0 26px 50px -28px rgb(10 30 12 / 0.4);
  }
  .pf__slide:not([data-on]) { opacity: calc(1 - var(--a, 0) * 0.16); }
  /* data-off: belongs to another category. data-far: outside the
     symmetric wing. The script had been setting data-far since the
     symmetry change with no rule to match it, so nothing was hidden and
     four machines fanned where three should. */
  .pf__slide[data-off],
  .pf__slide[data-far] { opacity: 0; pointer-events: none; }
  .pf__slide[data-on] { animation: pfFloat 6s var(--ease) infinite; }
  @keyframes pfFloat {
    0%, 100% { margin-bottom: 0; }
    50% { margin-bottom: 6px; }
  }

  .pf__halo {
    position: absolute;
    z-index: 0;
    left: 50%;
    top: 4%;
    translate: -50% 0;
    width: min(32rem, 66%);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(255 255 255 / 0.55) 38%, rgb(233 244 234 / 0) 72%);
  }

  /* the stage */
  .pf__podium {
    position: absolute;
    z-index: 1;
    left: 50%;
    bottom: 14%;
    translate: -50% 0;
    display: block;
    width: 74%;
  }
  .pf__top {
    display: block;
    width: 100%;
    aspect-ratio: 3.6 / 1;
    border-radius: 50%;
    background: radial-gradient(ellipse at 50% 26%, #ffffff 0%, #f1f8f3 62%, #e7f2ea 100%);
    /* Stacked offsets read as the side of a cylinder. */
    box-shadow:
      0 8px 0 #fbfefb,
      0 18px 0 #f3faf4,
      0 30px 0 #ebf5ed,
      0 42px 0 #dfeee3,
      0 56px 40px -26px rgb(47 100 41 / 0.3);
  }
  .pf__brands {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(100% + 0.55rem);
    display: flex;
    flex-wrap: nowrap;
    justify-content: center;
    align-items: center;
    gap: clamp(0.5rem, 1.6vw, 1.2rem);
    font-style: normal;
    font-family: var(--font-mono);
    font-size: var(--label);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-3);
    white-space: nowrap;
  }
  .pf__brands b { font-weight: 500; }
  .pf__brands b + b {
    padding-left: clamp(0.5rem, 1.6vw, 1.2rem);
    border-left: 1px solid var(--line-light);
  }

  .pf__dots {
    position: absolute;
    z-index: 3;
    left: 50%;
    bottom: 1%;
    translate: -50% 0;
    display: flex;
    gap: 0.35rem;
  }
  .pf__dots i {
    width: 1.3rem;
    height: 4px;
    border-radius: 2px;
    background: #cfe0d2;
    transition: background-color var(--t2) var(--ease), width var(--t2) var(--ease);
  }
  .pf__dots i[data-on] { width: 2rem; background: var(--green-deep); }

  .pf__arrow {
    position: absolute;
    top: 34%;
    z-index: 5;
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border: 0;
    border-radius: 50%;
    background: var(--white);
    color: var(--green-deep);
    cursor: pointer;
    box-shadow: 0 12px 26px -14px rgb(10 30 12 / 0.55);
    transition: background-color var(--t2) var(--ease);
  }
  .pf__arrow:hover { background: #e9f3ea; }
  .pf__arrow:focus-visible { outline: 2px solid var(--green-deep); outline-offset: 2px; }
  .pf__arrow--l { left: -1.1rem; rotate: 180deg; }
  .pf__arrow--r { right: -1.1rem; }

  /* the card */
  .pf__card {
    position: relative;
    display: grid;
    align-content: start;
    padding: clamp(1.25rem, 2.6vw, 1.9rem);
    border-radius: 22px;
    background: var(--white);
    box-shadow: 0 2px 4px rgb(10 30 12 / 0.04), 0 26px 54px -34px rgb(10 30 12 / 0.4);
  }
  .pf__pane { display: none; }
  .pf__pane[data-on] { display: grid; }
  .pf__mark {
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--green-deep);
  }
  .pf__t {
    margin-top: 0.6rem;
    font-size: var(--d7);
    font-weight: 700;
    letter-spacing: var(--tr7);
    line-height: 1.14;
  }
  .pf__blurb {
    margin-top: 0.7rem;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--text-2);
  }
  .pf__ticks { display: grid; gap: 0.55rem; margin-top: 1rem; }
  .pf__ticks li {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.875rem;
    color: var(--text);
  }
  .pf__ticks i {
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--green-deep);
    color: #fff;
  }
  .pf__pane .btn { justify-self: start; margin-top: 1.2rem; }

  /* shop by brand */
  .pb__row {
    display: grid;
    gap: var(--s4);
    align-items: center;
    margin-top: var(--s5);
  }
  .pb__row ul {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem clamp(1rem, 3vw, 2.5rem);
  }
  .pb__row li {
    font-size: var(--d7);
    font-weight: 700;
    letter-spacing: var(--tr7);
    color: var(--text-2);
  }
  .pb__row li + li {
    padding-left: clamp(1rem, 3vw, 2.5rem);
    border-left: 1px solid var(--line-light);
  }
  .pb__row p {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--text-3);
  }

  /* ───────── 03 categories ───────── */
  .pc { background: linear-gradient(180deg, #f4faf5, #ffffff); }
  .pc__head { display: grid; gap: var(--s4); align-items: end; }
  .pc__h {
    margin-top: var(--s4);
    font-size: var(--d5);
    font-weight: 700;
    letter-spacing: var(--tr5);
    line-height: 1.08;
  }
  .pc__p { max-width: 44ch; font-size: 0.875rem; line-height: 1.64; color: var(--text-2); }
  .pc__all {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    justify-self: start;
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--green-deep);
  }

  .pc__grid { display: grid; gap: clamp(0.75rem, 1.6vw, 1.1rem); margin-top: clamp(1.75rem, 4vw, 2.75rem); }
  .pc__grid a {
    position: relative;
    display: grid;
    align-content: start;
    height: 100%;
    min-height: clamp(14rem, 22vw, 17rem);
    padding: 1.3rem 1.2rem 1.2rem;
    border-radius: 22px;
    overflow: hidden;
    transition: transform var(--t2) var(--ease), box-shadow var(--t2) var(--ease);
  }
  .pc__grid a:hover { transform: translateY(-5px); box-shadow: 0 28px 50px -30px rgb(10 30 12 / 0.4); }
  .pc__grid a:focus-visible { outline: 2px solid var(--green-deep); outline-offset: 3px; }
  .pc__grid [data-tone='a'] a { background: #eaf3eb; }
  .pc__grid [data-tone='b'] a { background: #f6efe8; }
  .pc__grid [data-tone='c'] a { background: #eef4f6; }
  .pc__grid [data-tone='d'] a { background: #f3f1ec; }
  .pc__n {
    position: relative;
    z-index: 1;
    font-size: var(--d6);
    font-weight: 700;
    letter-spacing: var(--tr6);
    line-height: 1;
    color: var(--green-deep);
    font-variant-numeric: tabular-nums;
  }
  .pc__t { position: relative; z-index: 1; margin-top: 0.7rem; font-size: 0.9375rem; font-weight: 700; letter-spacing: -0.025em; }
  .pc__s { position: relative; z-index: 1; margin-top: 0.25rem; font-size: 0.75rem; line-height: 1.5; color: var(--text-2); }
  /* The picture is the lower half of the card and the words sit above
     it — the first pass floated it over the title. */
  .pc__shot {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 52%;
    overflow: hidden;
  }
  .pc__shot::after {
