---
import { Image } from 'astro:assets';
import PageLayout from '@layouts/PageLayout.astro';
import Icon from '@components/ui/Icon.astro';
import { site, brands } from '@data/site';
import pHp from '@assets/products/hp.png';
import pDell from '@assets/products/dell.png';
import pAsus from '@assets/products/asus.png';
import pLenovo from '@assets/products/lenovo.png';
import pWired from '@assets/products/wired.jpg';
import pWireless from '@assets/products/wireless.jpg';
import pCctv from '@assets/products/cctv.jpg';
import pSpare from '@assets/products/spare.jpg';
import pRefurb from '@assets/products/refurb.jpg';
import imgPatch from '@assets/photos/network-patch.jpg';
import imgCctv from '@assets/photos/cctv-white.jpg';
import imgDrive from '@assets/photos/drive-macro.jpg';
import imgBoard from '@assets/photos/repair-board.jpg';

/**
 * PRODUCTS — built to the client's mockup.
 *
 * ⚠ Danat has no online catalogue: no prices, no stock levels, no cart.
 * The old site's product page had none either. So every call to action
 * here ends in a conversation rather than pretending to a basket —
 * "Browse all products" moves down to the categories, and the per-
 * category buttons open the quote modal. Nothing claims a price.
 *
 * The five categories are the ones the old product page carried, minus
 * the four entries on it that were actually services and already live
 * on /services — CCTV installation, wired networking, wireless
 * networking and spare parts.
 *
 * Brand names are set as type. Danat has no licence on file for HP,
 * Dell, Apple, ASUS or Lenovo artwork, and their marks are not ours to
 * redraw; the sixteen names come from the catalogue export.
 */
/**
 * ⚠ Apple is in the brand row and the category's brand line but NOT on
 * the stage. The old site's Apple picture is a dark studio composite of
 * a dozen products, and the iMac's screen sits within tolerance of the
 * ground behind it — every automatic cut takes the screen away with the
 * background, leaving an outline. It needs a product shot on white, like
 * the other four have. Four machines turn on the stage until then.
 *
 * The five categories and their items are the old product page's own,
 * names and all — pulled from danatcomputers.com/page/product together
 * with its photographs, which now live in src/assets/products.
 *
 * Each category holds its items; the fan turns them and the card on the
 * right follows. Laptops has the five brands, networking has wired and
 * wireless, the rest have one each.
 */
const cats = [
  {
    icon: 'laptop', t: 'Laptops & Desktops', sub: 'Leading brands. Reliable performance.',
    items: [
      { b: 'HP', t: 'HP Laptops & Desktops', img: pHp, cut: true,
        p: 'Power your ideas with HP. Designed for work, learning and everyday performance.' },
      { b: 'Dell', t: 'Dell Laptops & Desktops', img: pDell, cut: true,
        p: 'Precision and innovation with Dell, for the desk and the site office alike.' },
      { b: 'Asus', t: 'Asus Laptops & Desktops', img: pAsus, cut: true,
        p: 'Elevate your experience with Asus — everyday machines that keep up.' },
      { b: 'Lenovo', t: 'Lenovo Laptops & Desktops', img: pLenovo, cut: true,
        p: 'Innovation redefined with Lenovo, built to be worked rather than admired.' },
    ],
  },
  {
    icon: 'network', t: 'Networking', sub: 'Wired and wireless, planned and fixed.',
    items: [
      { b: 'Wired', t: 'Wired Networking', img: pWired,
        p: 'Structured cabling, patching and switching — set up new or put right.' },
      { b: 'Wireless', t: 'Wireless Networking', img: pWireless,
        p: 'Access points and coverage planned around how the space is actually used.' },
    ],
  },
  {
    icon: 'camera', t: 'Security & CCTV', sub: 'Smarter, safer spaces.',
    items: [
      { b: 'CCTV', t: 'CCTV Installation', img: pCctv,
        p: 'Cameras, recorders and storage, supplied by the people who maintain them.' },
    ],
  },
  {
    icon: 'gear', t: 'Spare Parts', sub: 'Held here, not ordered in.',
    items: [
      { b: 'Parts', t: 'Spare Parts', img: pSpare,
        p: 'The parts the bench uses every day, on the shelf rather than on order.' },
    ],
  },
  {
    icon: 'chip', t: 'Refurbished Desktop', sub: 'Reliable performance, better value.',
    items: [
      { b: 'Refurbished', t: 'Refurbished Desktop', img: pRefurb,
        p: 'Tested at component level by the technicians who repair them.' },
    ],
  },
];

/** The mockup's three, on the plinth. */
const plinth = [
  { icon: 'gem', t: 'Top brands' },
  { icon: 'laptop', t: 'Latest models' },
  { icon: 'shield', t: 'Genuine products' },
];

/** The mockup's three ticks on the right-hand card. */
const ticks = ['Wide range of models', 'Reliable performance', 'Ideal for business & home'];

const marks = [
  { icon: 'shield', t: 'Genuine products', p: 'Trusted brands' },
  { icon: 'headset', t: 'Expert support', p: 'Across Oman' },
  { icon: 'pin', t: 'Visit our branches', p: `${site.stats.branches} locations` },
];

const helps = [
  { icon: 'users', t: 'Expert guidance', p: 'Get the right solution' },
  { icon: 'pin', t: 'Multiple branches', p: 'Service across Oman' },
  { icon: 'chat', t: 'Ongoing support', p: "We're always here" },
];
---

<PageLayout
  title="Products"
  description={`Laptops, desktops, networking, security and accessories from ${brands.flat().length} brands — supplied across Oman from ${site.stats.branches} branches since ${site.stats.since}.`}
>
  {/* ══════ 02 · featured ══════ */}
  <section class="pf section" data-pick
    data-cats={JSON.stringify(cats.map((x) => ({ n: x.items.length, t: x.t, s: x.sub })))}>
    <div class="shell pf__head">
      <p class="eb" data-rise>Explore our products</p>
      {/* The page's h1 — the hero that used to carry one is gone. */}
      <h1 class="pf__h" data-rise style="--d:70ms">
        <span data-cat-a>{cats[0].t.split(' ').slice(0, -1).join(' ')}</span>
        {' '}
        <em data-cat-b>{cats[0].t.split(' ').slice(-1)[0]}</em>
      </h1>
      <p class="pf__sub" data-cat-s data-rise style="--d:110ms">{cats[0].sub}</p>
    </div>

    <ul class="shell pf__over" data-rise style="--d:150ms">
      {plinth.map((m) => (
        <li><i aria-hidden="true"><Icon name={m.icon} size={16} /></i>{m.t}</li>
      ))}
    </ul>

    <div class="shell pf__grid">
      <ul class="pf__nav" data-rise>
        {cats.map((c, i) => (
          <li>
            <button type="button" data-go={i} data-on={i === 0 ? '' : undefined}>
              <i aria-hidden="true"><Icon name={c.icon} size={18} /></i>
              <b>{c.t}</b>
              <em aria-hidden="true"><Icon name="arrow" size={14} /></em>
            </button>
          </li>
        ))}
      </ul>

      {/* A real fan on a perspective stage. Offsets come from --o (signed)
          and --a (absolute), both set in script — CSS has no portable
          abs() — and z-index falls away from the active card so each
          neighbour reveals a strip of itself. */}
      <div class="pf__stage" data-rise style="--d:120ms">
        <button class="pf__arrow pf__arrow--l" type="button" data-step="-1" aria-label="Previous">
          <Icon name="arrow" size={16} />
        </button>

        <div class="pf__deck">
          {cats.map((cat, ci) =>
            cat.items.map((it, ii) => (
              <figure class="pf__slide" data-c={ci} data-i={ii} data-cut={it.cut ? '' : undefined}>
                <Image src={it.img} alt={it.t} widths={[360, 620]} sizes="320px"
                  quality={82} format="webp" loading={ci === 0 && ii === 0 ? 'eager' : 'lazy'} />
              </figure>
            ))
          )}
        </div>

        <span class="pf__halo" aria-hidden="true"></span>

        {/* The stage the range stands on: an ellipse for the top face and
            a stack of offset shadows for the side, which reads as a
            cylinder without a second element. */}
        <span class="pf__podium" aria-hidden="true">
          <i class="pf__top"></i>
          <i class="pf__brands">
            {cats[0].items.map((it) => <b>{it.b}</b>)}
          </i>
        </span>

        <span class="pf__dots" data-fan-dots aria-hidden="true">
          {cats[0].items.map((_, i) => <i data-on={i === 0 ? '' : undefined}></i>)}
        </span>

        <button class="pf__arrow pf__arrow--r" type="button" data-step="1" aria-label="Next">
          <Icon name="arrow" size={16} />
        </button>
      </div>

      <div class="pf__card" data-rise style="--d:180ms">
        {cats.map((cat, ci) =>
          cat.items.map((it, ii) => (
            <div class="pf__pane" data-c={ci} data-i={ii}
              data-on={ci === 0 && ii === 0 ? '' : undefined}>
              <p class="pf__mark">{it.b}</p>
              <h3 class="pf__t">{it.t}</h3>
              <p class="pf__blurb">{it.p}</p>
              <ul class="pf__ticks">
                {ticks.map((t) => (
                  <li><i aria-hidden="true"><Icon name="check" size={12} /></i>{t}</li>
                ))}
              </ul>
              <a class="btn" href="/contact" data-enquiry="quote">
                View {it.b} products
                <span class="btn__i" aria-hidden="true"><Icon name="arrow" size={15} /></span>
              </a>
            </div>
          ))
        )}
      </div>
    </div>

    {/* ── shop by brand ── */}
    <p class="eb eb--low shell" data-rise>Shop by brand</p>
    <div class="shell pb__row" data-rise style="--d:70ms">
      <ul>
        {['HP', 'Dell', 'Asus', 'Apple', 'Lenovo'].map((b) => <li>{b}</li>)}
      </ul>
      <p>Trusted brands<br />for a smarter Oman.</p>
    </div>
  </section>

  {/* ══════ 03 · categories ══════ */}
  <section class="pc section" id="categories">
    <div class="shell pc__head">
      <div>
        <p class="eb" data-rise>Product categories</p>
        <h2 class="pc__h" data-rise style="--d:70ms">Solutions for every need.</h2>
      </div>
      <p class="pc__p" data-rise style="--d:130ms">
        From leading global brands to essential accessories — {site.stats.parts.toLocaleString('en-US')}
        lines across {site.stats.categories} categories, held across
        {' '}{site.stats.branches} branches.
      </p>
      <a class="pc__all" href="/contact" data-enquiry="quote" data-rise style="--d:190ms">
        Ask for a list<Icon name="arrow" size={15} />
      </a>
    </div>

    <ul class="shell pc__grid">
      {cats.map((c, i) => (
        <li data-rise data-tone={['a', 'b', 'c', 'd', 'a'][i]} style={`--d:${i * 60}ms`}>
          <a href="/contact" data-enquiry="quote">
            <span class="pc__n">{String(i + 1).padStart(2, '0')}</span>
            <span class="pc__t">{c.t}</span>
            <span class="pc__s">{c.sub}</span>
            <span class="pc__shot">
              <Image src={c.items[0].img} alt="" widths={[320, 520]} sizes="240px"
                quality={74} format="webp" loading="lazy" />
            </span>
            <span class="pc__go" aria-hidden="true"><Icon name="arrow" size={15} /></span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  {/* ══════ 04 · brands ══════ */}
  <section class="pb">
    <div class="shell pb__in">
      <div>
        <p class="eb" data-rise>Trusted global brands</p>
        <h2 class="pb__h" data-rise style="--d:70ms">
          World-class technology.<br /><em>Closer to you.</em>
        </h2>
      </div>

      {/* Set as type: the marks are not ours to redraw and no licence is
          on file. The names come from the catalogue export. */}
      <ul class="pb__list" data-rise style="--d:130ms">
        {brands.flat().map((b) => <li>{b}</li>)}
      </ul>

      <p class="pb__note" data-rise style="--d:190ms">
        Genuine products.<br />Authorised sources.<br />Lasting value.
      </p>
    </div>
  </section>

  {/* ══════ 05 · cta ══════ */}
  <section class="pt">
    <span class="pt__wash" aria-hidden="true"></span>
    <div class="shell pt__in">
      <div>
        <h2 class="pt__h" data-rise>Need help choosing?</h2>
        <p class="pt__p" data-rise style="--d:70ms">
          Our experts are here to help you find the right products for your
          home or business.
        </p>
        <div class="pt__acts" data-rise style="--d:130ms">
          <a class="btn btn--light" href="/contact" data-enquiry="consult">
            Talk to Danat
            <span class="btn__i" aria-hidden="true"><Icon name="arrow" size={15} /></span>
          </a>
          <a class="pt__ghost" href="/branches">
            <Icon name="pin" size={16} />Visit a branch
          </a>
        </div>
      </div>

      <ul class="pt__list" data-rise style="--d:160ms">
        {helps.map((h) => (
          <li>
            <i aria-hidden="true"><Icon name={h.icon} size={17} /></i>
            <span><b>{h.t}</b>{h.p}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

</PageLayout>

<script is:inline>
  /* <ClientRouter /> swaps the body on a nav click without a page load,
     and an is:inline script runs once and never again — so the wiring
     has to be re-run on astro:page-load. */
  (() => {
    const setup = () => {
      const root = document.querySelector('[data-pick]');
      if (!root) return;

      const navs = [...root.querySelectorAll('[data-go]')];
      const slides = [...root.querySelectorAll('.pf__slide')];
      const panes = [...root.querySelectorAll('.pf__pane')];
      const dotBox = root.querySelector('[data-fan-dots]');
      const catA = root.querySelector('[data-cat-a]');
      const catB = root.querySelector('[data-cat-b]');
      const catS = root.querySelector('[data-cat-s]');
      if (!slides.length) return;

      const CATS = JSON.parse(root.dataset.cats || '[]');
      let c = 0;
      let i = 0;

      const show = () => {
        const n = CATS[c] ? CATS[c].n : 1;
        i = ((i % n) + n) % n;

        // An even count cannot fan symmetrically — four items put two on
        // one side and one on the other, which is what read as untidy.
        // Show the active one plus the same number each side, always.
        const wing = Math.floor((n - 1) / 2);

        slides.forEach((el) => {
          const mine = Number(el.dataset.c) === c;
          if (!mine) { el.toggleAttribute('data-off', true); return; }
          el.removeAttribute('data-off');
          // Signed distance wrapped the short way, so the fan turns
          // through the nearer edge rather than unwinding the deck.
          let o = Number(el.dataset.i) - i;
          if (o > n / 2) o -= n;
          if (o < -n / 2) o += n;
          const abs = Math.abs(o);
          el.style.setProperty('--o', String(o));
          el.style.setProperty('--a', String(abs));
          el.style.zIndex = String(9 - abs);
          el.toggleAttribute('data-on', o === 0);
          el.toggleAttribute('data-far', abs > wing);
        });

        panes.forEach((el) =>
          el.toggleAttribute('data-on',
            Number(el.dataset.c) === c && Number(el.dataset.i) === i)
        );
        navs.forEach((el, k) => el.toggleAttribute('data-on', k === c));

        if (CATS[c]) {
          const parts = CATS[c].t.split(' ');
          const last = parts.pop();
          if (catA) catA.textContent = parts.join(' ');
          if (catB) catB.textContent = last;
        }
        if (catS && CATS[c]) catS.textContent = CATS[c].s;

        // The dot count follows the category, which does not hold a
        // fixed number of items.
        if (dotBox) {
          if (dotBox.children.length !== n) {
            dotBox.replaceChildren();
            for (let k = 0; k < n; k++) dotBox.appendChild(document.createElement('i'));
          }
          [...dotBox.children].forEach((d, k) => d.toggleAttribute('data-on', k === i));
        }
      };

      navs.forEach((b) => b.addEventListener('click', () => { c = Number(b.dataset.go); i = 0; show(); stop(); start(); }));
      let timer = null;
      const stop = () => { if (timer) clearInterval(timer); timer = null; };
      const start = () => {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        if (!timer) timer = setInterval(() => { i += 1; show(); }, 3600);
      };

      root.querySelectorAll('[data-step]').forEach((b) =>
        b.addEventListener('click', () => { i += Number(b.dataset.step); show(); stop(); start(); })
      );

      // Turning on its own, but never while someone is reading or using it.
      root.addEventListener('pointerenter', stop);
      root.addEventListener('pointerleave', start);
      root.addEventListener('focusin', stop);
      root.addEventListener('focusout', start);

      show();
      start();
    };

    let ran = false;
    document.addEventListener('astro:page-load', () => { ran = true; setup(); });
    window.addEventListener('load', () => { if (!ran) { ran = true; setup(); } });
  })();
</script>

<style>
  /* ───────── shared ───────── */
  .eb {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--green-deep);
  }
  .eb::before { content: ''; width: 28px; height: 1px; background: currentColor; }
  .eb--mid { justify-content: center; }
  .eb--mid::before { display: none; }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.85rem 0.85rem 0.85rem 1.4rem;
    border-radius: 999px;
    background: var(--green-deep);
    color: #fff;
    font-size: 0.9375rem;
    font-weight: 700;
    transition: background-color var(--t2) var(--ease);
  }
  .btn:hover { background: #26551f; }
  .btn__i {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.2);
    transition: transform var(--t2) var(--ease);
  }
  .btn:hover .btn__i { transform: translateX(3px); }
  .btn--light { background: #fff; color: #10301a; }
  .btn--light:hover { background: var(--green-bright); }
  .btn--light .btn__i { background: rgb(16 48 26 / 0.14); }

  .film {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    min-width: 0;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    text-align: left;
  }
  .film i {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    flex: none;
    border-radius: 50%;
    background: var(--green-deep);
    color: #fff;
    transition: transform var(--t2) var(--ease);
  }
  .film:hover i { transform: scale(1.08); }
  .film:focus-visible i { outline: 2px solid var(--green-deep); outline-offset: 3px; }
  .film > span { display: grid; min-width: 0; font-size: 0.9375rem; font-weight: 700; }
  .film small {
    overflow-wrap: anywhere;
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    font-weight: 400;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  /* ───────── 02 featured ───────── */
  /* First section on the page now, so it carries the header
     clearance the hero used to. */
  .pf {
    position: relative;
    isolation: isolate;
    background:
      radial-gradient(1100px 620px at 52% 62%, #e9f4ea 0%, rgb(233 244 234 / 0) 68%),
      linear-gradient(180deg, #f6fbf7 0%, #ffffff 62%);
    padding-block: clamp(5rem, 9vw, 7rem) clamp(2rem, 4vw, 3.25rem);
  }
  /* Same as every other heading block on the site: a leading rule, left
     aligned, and the emphasis on its own line in green. */
  .eb {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--green-deep);
  }
  .eb::before { content: ''; width: 28px; height: 1px; background: currentColor; }
  .eb--low { margin-top: clamp(2.25rem, 4.5vw, 3.5rem); }
  .pf__h em { font-style: normal; color: var(--green-deep); }
  .pf__h {
    margin-top: var(--s4);
    font-size: clamp(2.1rem, 4.4vw, 3.3rem);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 1.04;
  }
  .pf__sub {
    max-width: 46ch;
    margin-top: var(--s4);
    font-size: var(--lead);
    line-height: 1.62;
    color: var(--text-2);
  }
  .pf__over {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem clamp(0.9rem, 2.4vw, 2rem);
    margin-top: var(--s5);
  }
  .pf__over li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--text-2);
  }
  .pf__over li + li {
    padding-left: clamp(0.9rem, 2.4vw, 2rem);
    border-left: 1px solid var(--line-light);
  }
  .pf__over i { display: grid; place-items: center; color: var(--green-deep); }

  .pf__grid {
    display: grid;
    gap: clamp(1.25rem, 2.6vw, 2rem);
    margin-top: clamp(1.25rem, 2.6vw, 1.75rem);
    align-items: center;
  }

  /* the category column */
  .pf__nav {
    display: grid;
    align-content: start;
    padding: 0.5rem;
    border-radius: 22px;
    background: var(--white);
    box-shadow: 0 2px 4px rgb(10 30 12 / 0.04), 0 26px 54px -34px rgb(10 30 12 / 0.4);
  }
  .pf__nav li + li { border-top: 1px solid var(--line-light); }
  .pf__nav button {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.85rem;
    width: 100%;
    padding: 0.95rem 1rem;
    border: 0;
    border-radius: 14px;
    background: none;
    text-align: left;
    cursor: pointer;
    transition: background-color var(--t2) var(--ease);
  }
  .pf__nav i { display: grid; place-items: center; color: var(--green-deep); }
  .pf__nav b { font-size: 0.9375rem; font-weight: 700; color: var(--text); }
  .pf__nav em { display: grid; place-items: center; color: var(--text-3); opacity: 0; }
  .pf__nav button:hover { background: #eef6ef; }
  .pf__nav [data-on] { background: var(--green-deep); }
  .pf__nav [data-on] i, .pf__nav [data-on] em { color: #fff; opacity: 1; }
  .pf__nav [data-on] b { color: #fff; }
  .pf__nav button:focus-visible { outline: 2px solid var(--green-deep); outline-offset: -2px; }

  /* the fan */
  .pf__stage { position: relative; aspect-ratio: 1 / 0.66; perspective: 1400px; }
  .pf__deck {
    position: absolute;
    z-index: 2;
    inset: 2% 0 20% 0;
    transform-style: preserve-3d;
  }
  .pf__slide {
    position: absolute;
    left: 50%;
    /* Anchored to the FLOOR of the deck, not its middle, so every item
       stands on the stage instead of hanging in the middle of its own
       box. transform-origin follows, or scaling lifts the feet off. */
    bottom: 0;
    translate: -50% 0;
    transform-origin: bottom center;
