---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import PageLayout from '@layouts/PageLayout.astro';
import Icon from '@components/ui/Icon.astro';
import { site, whatsappLink } from '@data/site';
import { serviceMedia, fallbackMedia } from '@data/serviceMedia';

const services = (await getCollection('services')).sort(
  (a, b) => a.data.index - b.data.index
);
---

<PageLayout
  title="Services"
  description="Computer repair, printer services, CCTV, networking, data recovery and IT support across Oman — from four branches."
>
  <!-- ─────────── head ─────────── -->
  <section class="sx">
    <div class="shell">
      <nav class="sx__crumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">Services</span>
      </nav>

      <div class="sx__head">
        <div>
          <p class="label sx__l">All services</p>
          <h1 class="sx__h">
            Everything we do,<br /><em>in one place.</em>
          </h1>
        </div>
        <p class="sx__p">
          {services.length} services, all handled in-house by our own
          technicians from {site.stats.branches} branches. Diagnosis is free
          and you get a fixed price before any work starts.
        </p>
      </div>
    </div>
  </section>

  <!-- ─────────── list ─────────── -->
  <section class="sl section" data-tone="light">
    <ul class="shell sl__grid">
      {services.map((s, i) => {
        const media = serviceMedia[s.id] ?? fallbackMedia;
        return (
          <li data-rise style={`--d:${(i % 3) * 70}ms`}>
            <a class="sl__card" href={`/services/${s.id}`}>
              <span class="sl__media">
                <Image
                  src={media.img}
                  alt={media.alt}
                  widths={[400, 700, 1000]}
                  sizes="(max-width: 48rem) 100vw, (max-width: 72rem) 50vw, 33vw"
                  quality={80}
                  format="webp"
                  loading={i < 3 ? 'eager' : 'lazy'}
                />
                <span class="sl__n">{String(s.data.index).padStart(2, '0')}</span>
              </span>

              <span class="sl__body">
                <span class="sl__t">{s.data.title}</span>
                <span class="sl__s">{s.data.summary}</span>
              </span>

              <span class="sl__foot">
                <span>Read more</span>
                <span class="sl__go" aria-hidden="true"><Icon name="arrow" size={15} /></span>
              </span>
            </a>
          </li>
        );
      })}
    </ul>
  </section>

  <!-- ─────────── cta ─────────── -->
  <section class="sc" data-tone="ink">
    <div class="shell sc__in">
      <div>
        <p class="label">Not sure which you need?</p>
        <h2 class="sc__h">Describe the problem.<br /><em>We will tell you.</em></h2>
      </div>
      <a class="sc__wa" href={whatsappLink()} target="_blank" rel="noopener noreferrer"
        title="Chat on WhatsApp" aria-label="Chat with Danat on WhatsApp">
        <Icon name="whatsapp" size={20} />
      </a>
    </div>
  </section>
</PageLayout>

<style>
  /* ---------- head ---------- */

  .sx {
    background: var(--off);
    padding-block: clamp(7rem, 12vw, 10rem) clamp(2.5rem, 5vw, 4rem);
  }

  .sx__crumb {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.8125rem;
    color: var(--text-3);
  }
  .sx__crumb a { transition: color var(--t2) var(--ease); }
  .sx__crumb a:hover { color: var(--green-deep); }
  .sx__crumb [aria-current] { color: var(--text); }

  .sx__head {
    display: grid;
    gap: var(--s5);
    margin-top: var(--s5);
  }

  .sx__l { display: flex; }

  .sx__h {
    margin-top: var(--s4);
    font-size: clamp(2rem, 4vw, 3.4rem);
    line-height: 1.04;
    letter-spacing: -0.038em;
    font-weight: 700;
  }
  .sx__h em { font-style: normal; color: var(--green-deep); }

  .sx__p {
    max-width: 46ch;
    align-self: end;
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--text-2);
  }

  /* ---------- list ---------- */

  .sl { background: var(--white); }

  .sl__grid {
    display: grid;
    gap: clamp(1.25rem, 2vw, 1.75rem);
    grid-template-columns: 1fr;
  }

  .sl__card {
    display: flex;
    flex-direction: column;
    height: 100%;
    border: 1px solid var(--line-light);
    border-radius: 12px;
    overflow: hidden;
    background: var(--white);
    transition:
      border-color var(--t2) var(--ease),
      box-shadow var(--t2) var(--ease),
      transform var(--t2) var(--ease);
  }

  .sl__media {
    position: relative;
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--off);
  }
  .sl__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 900ms var(--ease);
  }

  .sl__n {
    position: absolute;
    left: 0.85rem;
    top: 0.85rem;
    padding: 0.3rem 0.6rem;
    border-radius: 6px;
    background: rgb(255 255 255 / 0.94);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.14em;
    color: var(--text);
  }

  .sl__body { display: block; padding: 1.15rem 1.25rem 0; }

  .sl__t {
    display: block;
    font-size: 1.1875rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .sl__s {
    display: block;
    margin-top: 0.45rem;
    font-size: var(--small);
    line-height: 1.6;
    color: var(--text-2);
  }

  .sl__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s4);
    margin-top: auto;
    padding: 1.1rem 1.25rem 1.25rem;
    font-size: 0.875rem;
    font-weight: 500;
  }

  .sl__go {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    border: 1px solid var(--line-light);
    color: var(--text-2);
    transition:
      background-color var(--t2) var(--ease),
      border-color var(--t2) var(--ease),
      color var(--t2) var(--ease),
      transform var(--t2) var(--ease);
  }

  .sl__card:hover,
  .sl__card:focus-within {
    border-color: var(--green);
    box-shadow: 0 18px 40px -26px rgb(20 23 26 / 0.35);
    transform: translateY(-3px);
  }
  .sl__card:hover .sl__media :global(img) { transform: scale(1.05); }
  .sl__card:hover .sl__go {
    background: var(--green);
    border-color: var(--green);
    color: #fff;
    transform: translateX(3px);
  }

  /* ---------- cta ---------- */

  .sc {
    background: var(--ink);
    color: var(--text-inv);
    padding-block: clamp(2.5rem, 5vw, 4rem);
  }

  .sc__in {
    display: grid;
    gap: var(--s5);
    align-items: center;
  }

  .sc__h {
    margin-top: var(--s4);
    font-size: clamp(1.5rem, 2.8vw, 2.25rem);
    line-height: 1.1;
    letter-spacing: -0.035em;
    font-weight: 700;
  }
  .sc__h em { font-style: normal; color: var(--green-bright); }

  /* Mark only, no label. White on --green (#59AA54) is 2.88:1, under the
     3:1 WCAG asks of a non-text graphic, so these sit on --green-deep
     (7.06:1) instead. */
  .sc__wa {
    display: grid;
    place-items: center;
    justify-self: start;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--green-deep);
    color: #fff;
    transition: background-color var(--t2) var(--ease), transform var(--t2) var(--ease);
  }
  .sc__wa:hover { background: #fff; color: var(--ink); transform: translateY(-2px); }

  /* ---------- layout ---------- */

  @media (min-width: 48rem) {
    .sl__grid { grid-template-columns: repeat(2, 1fr); }
    .sx__head { grid-template-columns: 1.1fr 1fr; gap: var(--s7); }
  }

  @media (min-width: 72rem) {
    .sl__grid { grid-template-columns: repeat(3, 1fr); }
    .sc__in { grid-template-columns: 1fr auto; }
    .sc__wa { justify-self: end; }
  }
</style>
