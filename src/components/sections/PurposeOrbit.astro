---
import { Image } from 'astro:assets';
import Icon from '@components/ui/Icon.astro';
import shotTech from '@assets/photos/repair-solder.jpg';
import shotShop from '@assets/photos/retail-display.jpg';

/**
 * OUR PURPOSE — three panes on a 3D stage.
 *
 * The active pane stands square to the camera; the other two sit back
 * and turn inward on a real perspective, so the set reads as objects in
 * a space rather than three boxes in a row. Selecting one rotates the
 * set: whatever was chosen comes forward and the rest fall back.
 *
 * Everything is CSS 3D on a preserve-3d stage — no library, no canvas.
 * The orbital rings are SVG ellipses tipped in X and turning slowly,
 * which is what gives the depth something to read against.
 *
 * ⚠ The mission, vision and values wording is a DRAFT. Danat has never
 * published any of the three. The mission text is the client's own from
 * their mockup; the other two are written to match. The page says so.
 */
const faces = [
  {
    no: '01',
    key: 'Mission',
    kicker: 'Our mission',
    lead: 'A more connected tomorrow',
    h: ['Make technology', 'work better', 'for people.'],
    accent: [1, 2],
    p: 'We provide genuine products, expert service and practical technology solutions that help individuals, businesses and communities work smarter.',
  },
  {
    no: '02',
    key: 'Vision',
    kicker: 'Our vision',
    lead: 'A more connected tomorrow',
    h: ['An Oman that', 'repairs, not', 'replaces.'],
    accent: [1],
    p: 'Where a failed machine is worth mending, and the skill to mend it lives here rather than being shipped abroad with the hardware.',
  },
  {
    no: '03',
    key: 'Values',
    kicker: 'Our values',
    lead: 'What guides us always',
    h: ['Diagnose first.', 'Repair deeper.', 'Stand behind it.'],
    accent: [1],
    p: 'Free diagnosis before any quote. Faults traced to the component rather than the board. The same standard at all four counters.',
  },
];

const promises = [
  { icon: 'users', a: 'People', b: 'at the centre' },
  { icon: 'shield', a: 'Trusted', b: 'in every solution' },
  { icon: 'chart', a: 'Committed', b: 'to a better Oman' },
  { icon: 'heart', a: 'Always here', b: 'to support' },
];
---

<section class="po">
  <span class="po__sky" aria-hidden="true"></span>
  <span class="po__haze" aria-hidden="true"></span>

  <div class="shell po__grid">
    {/* ── left ── */}
    <div class="po__left">
      <p class="eb" data-rise><i class="eb__r" aria-hidden="true"></i>Our purpose</p>
      <h2 class="po__h" data-rise style="--d:70ms">
        Guided by<br /><em>a bigger<br />purpose.</em>
      </h2>
      <p class="po__p" data-rise style="--d:130ms">
        Our mission, vision and values reflect who we are, what we aim for,
        and how we work — every day, for a brighter Oman.
      </p>

      <ol class="po__idx" data-rise style="--d:190ms">
        {faces.map((f, i) => (
          <li>
            <button type="button" data-goto={i} data-on={i === 0 ? '' : undefined}>
              <b>{f.no}</b>
              <i class="po__dot" aria-hidden="true"></i>
              <span>{f.key}</span>
            </button>
          </li>
        ))}
      </ol>

      <p class="po__script" aria-hidden="true">
        Technology<br />for a<br />Brighter Oman
        <svg viewBox="0 0 160 14" fill="none">
          <path d="M4 10C40 3 118 2 156 7" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
        </svg>
      </p>
    </div>

    {/* ── stage ── */}
    <div class="po__stage" data-stage>
      {/* orbital rings, tipped back and turning */}
      <svg class="po__rings" viewBox="0 0 200 200" fill="none" aria-hidden="true">
        <ellipse class="po__ring po__ring--a" cx="100" cy="100" rx="94" ry="36"
          stroke="currentColor" stroke-width="0.7" />
        <ellipse class="po__ring po__ring--b" cx="100" cy="100" rx="78" ry="30"
          stroke="currentColor" stroke-width="0.5" stroke-dasharray="2 4" />
      </svg>

      {/* floating spheres */}
      <span class="orb" style="--x:8%;  --y:34%; --s:26px; --c:#e8efe9"></span>
      <span class="orb" style="--x:30%; --y:18%; --s:14px; --c:#e8efe9"></span>
      <span class="orb" style="--x:36%; --y:26%; --s:18px; --c:#2f6b2a"></span>
      <span class="orb" style="--x:88%; --y:46%; --s:22px; --c:#2f6b2a"></span>
      <span class="orb" style="--x:72%; --y:14%; --s:12px; --c:#e8efe9"></span>

      {/* photo cards that ride the orbit */}
      <figure class="po__shot po__shot--l">
        <Image src={shotTech} alt="" widths={[320, 520]} sizes="220px"
          quality={72} format="webp" loading="lazy" />
        <figcaption>People<br />Power<br />Progress</figcaption>
      </figure>
      <figure class="po__shot po__shot--r">
        <Image src={shotShop} alt="" widths={[320, 520]} sizes="220px"
          quality={72} format="webp" loading="lazy" />
        <figcaption>Rooted<br />in Oman</figcaption>
      </figure>

      {/* the three panes */}
      <div class="deck">
        {faces.map((f, i) => (
          <article class="pane" data-pos={i === 0 ? 'c' : i === 1 ? 'r' : 'l'} data-i={i}>
            <button class="pane__hit" type="button" aria-label={`Show ${f.key}`}></button>

            <p class="pane__no">{f.no}</p>
            <p class="pane__k">{f.kicker}</p>

            <h3 class="pane__h">
              {f.h.map((line, li) => (
                <>{f.accent.includes(li) ? <em>{line}</em> : line}<br /></>
              ))}
            </h3>

            <p class="pane__p">{f.p}</p>

            <a class="pane__cta" href="/services">
              Learn more<Icon name="arrow" size={15} />
            </a>

            <span class="pane__bar" aria-hidden="true">
              {faces.map((_, bi) => <i data-on={bi === i ? '' : undefined}></i>)}
            </span>
          </article>
        ))}
      </div>

      {/* the plinth the deck stands on */}
      <span class="po__plinth" aria-hidden="true"></span>
      <p class="po__ground" aria-hidden="true">From people<br />to a brighter<br />tomorrow</p>
    </div>

    {/* ── right rail ── */}
    <div class="po__right" aria-hidden="true">
      <p class="po__words">Technology<br />People<br />Progress<br />Together</p>
      <span class="po__rule"></span>
      <p class="po__scroll">Scroll<br />the story</p>
    </div>
  </div>

  {/* ── foot ── */}
  <ul class="shell po__proms">
    {promises.map((p, i) => (
      <li data-rise style={`--d:${i * 60}ms`}>
        <i aria-hidden="true"><Icon name={p.icon} size={19} /></i>
        <span><b>{p.a}</b>{p.b}</span>
      </li>
    ))}
  </ul>

  <p class="po__note" data-rise>
    Mission, vision and values wording is a draft for Danat to approve.
  </p>
</section>

<script is:inline>
  (() => {
    const stage = document.querySelector('[data-stage]');
    if (!stage) return;

    const panes = [...stage.querySelectorAll('.pane')];
    const idx = [...document.querySelectorAll('[data-goto]')];
    const n = panes.length;
    if (!n) return;

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let at = 0;
    let timer = null;

    const show = (next) => {
      at = ((next % n) + n) % n;
      panes.forEach((p, i) => {
        // centre, then right, then left, walking forward from the active
        const d = (((i - at) % n) + n) % n;
        p.setAttribute('data-pos', d === 0 ? 'c' : d === 1 ? 'r' : 'l');
        p.querySelectorAll('.pane__bar i').forEach((b, bi) =>
          b.toggleAttribute('data-on', bi === at)
        );
      });
      idx.forEach((el, i) => el.toggleAttribute('data-on', i === at));
    };

    const stop = () => { if (timer) clearInterval(timer); timer = null; };
    const start = () => { if (!reduced && !timer) timer = setInterval(() => show(at + 1), 5200); };

    panes.forEach((p, i) =>
      p.querySelector('.pane__hit')?.addEventListener('click', () => { stop(); show(i); })
    );
    idx.forEach((el, i) => el.addEventListener('click', () => { stop(); show(i); }));

    new IntersectionObserver(([e]) => (e.isIntersecting ? start() : stop()), { threshold: 0.25 })
      .observe(stage);

    show(0);
  })();
</script>

<style>
  .po {
    position: relative;
    padding-block: clamp(3rem, 6vw, 5rem);
    background: linear-gradient(180deg, #fbfdfc, #f2f7f4 54%, #fafcfb);
    overflow: hidden;
    isolation: isolate;
  }
  /* A soft horizon instead of the mockup's rendered mountains, which we
     have no photography for. */
  .po__sky {
    position: absolute;
    inset: 0 0 26% 0;
    z-index: -2;
    background: radial-gradient(120% 90% at 50% 100%, #e6efe9 0%, transparent 62%);
  }
  .po__haze {
    position: absolute;
    z-index: -1;
    left: 50%;
    top: 46%;
    translate: -50% -50%;
    width: min(62rem, 98vw);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in oklab, var(--green) 10%, transparent), transparent 66%);
    filter: blur(34px);
  }

  .eb {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--green-deep);
  }
  .eb__r { width: 26px; height: 1px; flex: none; background: currentColor; opacity: 0.6; }

  .po__grid { display: grid; gap: clamp(1.5rem, 3vw, 2.5rem); align-items: center; }

  /* ───── left ───── */
  .po__h {
    margin-top: var(--s4);
    font-size: clamp(2rem, 4vw, 3.1rem);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 1.04;
  }
  .po__h em { font-style: normal; color: var(--green-deep); }
  .po__p {
    margin-top: var(--s4);
    max-width: 32ch;
    font-size: 0.875rem;
    line-height: 1.7;
    color: var(--text-2);
  }

  .po__idx { display: grid; gap: 0; margin-top: var(--s5); }
  .po__idx li { position: relative; }
  /* The rail between the markers. */
  .po__idx li:not(:last-child)::after {
    content: '';
    position: absolute;
    left: calc(1.9rem + 5px);
    top: 1.85rem;
    bottom: -0.15rem;
    width: 1px;
    background: var(--line-light);
  }
  .po__idx button {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    width: 100%;
    padding: 0.5rem 0;
    border: 0;
    background: none;
    cursor: pointer;
    text-align: left;
    color: var(--text-3);
    transition: color var(--t2) var(--ease);
  }
  .po__idx b { width: 1.4rem; font-family: var(--font-mono); font-size: 0.6875rem; }
  .po__dot {
    width: 11px;
    height: 11px;
    flex: none;
    border-radius: 50%;
    background: var(--line-light);
    transition: background-color var(--t2) var(--ease), box-shadow var(--t2) var(--ease);
  }
  .po__idx span { font-size: 0.9375rem; font-weight: 600; letter-spacing: -0.02em; }
  .po__idx button:hover { color: var(--text-2); }
  .po__idx button[data-on] { color: var(--text); }
  .po__idx button[data-on] .po__dot {
    background: var(--green-deep);
    box-shadow: 0 0 0 4px color-mix(in oklab, var(--green) 20%, transparent);
  }
  .po__idx button:focus-visible { outline: 2px solid var(--green-deep); outline-offset: 2px; }

  .po__script {
    margin-top: clamp(1.5rem, 3.5vw, 2.5rem);
    font-family: var(--font-serif, Georgia, serif);
    font-style: italic;
    font-size: clamp(1.1rem, 2vw, 1.6rem);
    line-height: 1.3;
    color: var(--green-deep);
    rotate: -4deg;
    transform-origin: left center;
    pointer-events: none;
  }
  .po__script svg { display: block; width: 9rem; margin-top: 0.3rem; color: var(--green); }

  /* ───── stage ───── */
  .po__stage {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 0.92;
    perspective: 1700px;
    perspective-origin: 50% 42%;
  }

  .po__rings {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    color: color-mix(in oklab, var(--green) 34%, transparent);
  }
  .po__ring { transform-origin: 50% 50%; }
  @media (prefers-reduced-motion: no-preference) {
    .po__ring--a { animation: po-spin 48s linear infinite; }
    .po__ring--b { animation: po-spin 34s linear infinite reverse; }
  }
  @keyframes po-spin { to { transform: rotate(360deg); } }

  .orb {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: var(--s);
    height: var(--s);
    border-radius: 50%;
    background: radial-gradient(circle at 32% 28%, #fff, var(--c) 64%, color-mix(in oklab, var(--c) 70%, #000));
    box-shadow: 0 8px 18px -8px rgb(10 30 12 / 0.4);
  }
  @media (prefers-reduced-motion: no-preference) {
    .orb { animation: po-float 8s ease-in-out infinite alternate; }
    .orb:nth-of-type(2) { animation-duration: 10s; }
    .orb:nth-of-type(3) { animation-duration: 12s; }
    .orb:nth-of-type(4) { animation-duration: 9s; }
  }
  @keyframes po-float { to { transform: translate3d(0, -14px, 0); } }

  /* ---- photo cards riding the orbit ---- */
  .po__shot {
    position: absolute;
    top: 6%;
    width: clamp(7rem, 15vw, 10rem);
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 20px 44px -22px rgb(10 30 12 / 0.5);
  }
  .po__shot :global(img) { width: 100%; height: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  .po__shot figcaption {
    position: absolute;
    left: 0.6rem;
    bottom: 0.5rem;
    font-size: 0.6875rem;
    font-weight: 600;
    line-height: 1.25;
    color: #fff;
    text-shadow: 0 1px 6px rgb(0 0 0 / 0.8);
  }
  .po__shot--l { left: 2%; rotate: -5deg; }
  .po__shot--r { right: 2%; rotate: 5deg; }

  /* ---- the three panes ---- */
  .deck {
    position: absolute;
    inset: 14% 6% 18%;
    transform-style: preserve-3d;
  }

  .pane {
    position: absolute;
    inset: 0;
    display: grid;
    align-content: center;
    justify-items: center;
    padding: clamp(1rem, 2.6vw, 2rem);
    border-radius: 24px;
    /* Frosted glass, so the rings and orbs read through it. */
    background: rgb(255 255 255 / 0.72);
    backdrop-filter: blur(16px) saturate(1.1);
    border: 1px solid rgb(255 255 255 / 0.8);
    box-shadow: 0 30px 70px -34px rgb(10 30 12 / 0.5);
    text-align: center;
    transition:
      transform 760ms cubic-bezier(0.55, 0, 0.2, 1),
      opacity 520ms var(--ease),
      filter 520ms var(--ease);
  }

  /* Centre: square to the camera and forward. */
  .pane[data-pos='c'] {
    transform: translate3d(0, 0, 60px);
    opacity: 1;
    z-index: 3;
  }
  /* Sides: pushed out, back, and turned inward. */
  .pane[data-pos='l'] {
    transform: translate3d(-62%, 4%, -150px) rotateY(34deg) scale(0.82);
    opacity: 0.94;
    z-index: 1;
  }
  .pane[data-pos='r'] {
    transform: translate3d(62%, 4%, -150px) rotateY(-34deg) scale(0.82);
    opacity: 0.94;
    z-index: 1;
  }
  /* A side pane shows only its heading — the body would be unreadable
     at that angle anyway, and hiding it keeps the centre the subject. */
  .pane[data-pos='l'] :is(.pane__p, .pane__cta, .pane__bar),
  .pane[data-pos='r'] :is(.pane__p, .pane__cta, .pane__bar) {
    opacity: 0;
    pointer-events: none;
  }

  .pane__hit {
    position: absolute;
    inset: 0;
    border: 0;
    border-radius: 24px;
    background: none;
    cursor: pointer;
  }
  .pane[data-pos='c'] .pane__hit { pointer-events: none; }
  .pane__hit:focus-visible { outline: 2px solid var(--green-deep); outline-offset: 3px; }

  .pane__no {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-3);
  }
  .pane__k {
    margin-top: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--green-deep);
  }
  .pane__h {
    margin-top: 0.7rem;
    font-size: clamp(1rem, 2.1vw, 1.65rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.14;
  }
  .pane__h em { font-style: normal; color: var(--green-deep); }
  .pane__p {
    margin-top: 0.7rem;
    max-width: 32ch;
    font-size: clamp(0.6875rem, 1.05vw, 0.8125rem);
    line-height: 1.6;
    color: var(--text-2);
    transition: opacity var(--t3) var(--ease);
  }
  .pane__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1rem;
    padding: 0.7rem 1.4rem;
    border-radius: 999px;
    /* white is 8.73:1 on #27551f and 4.90:1 on #3d7f35 */
    background: linear-gradient(100deg, #27551f, #3d7f35);
    color: #fff;
    font-size: 0.8125rem;
    font-weight: 600;
    transition: transform var(--t2) var(--ease), opacity var(--t3) var(--ease);
  }
  .pane__cta:hover { transform: translateY(-2px); }

  .pane__bar {
    display: flex;
    gap: 0.35rem;
    margin-top: 1rem;
    transition: opacity var(--t3) var(--ease);
  }
  .pane__bar i {
    width: 26px;
    height: 4px;
    border-radius: 4px;
    background: var(--line-light);
    transition: background-color var(--t2) var(--ease), width var(--t3) var(--ease);
  }
  .pane__bar i[data-on] { width: 40px; background: var(--green-deep); }

  /* ---- plinth ---- */
  .po__plinth {
    position: absolute;
    left: 50%;
    bottom: 9%;
    translate: -50% 0;
    width: 58%;
    height: 14px;
    border-radius: 50%;
    background: radial-gradient(ellipse, color-mix(in oklab, var(--green) 26%, transparent), transparent 70%);
    filter: blur(5px);
  }
  .po__ground {
    position: absolute;
    left: 50%;
    bottom: 1%;
    translate: -50% 0;
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    line-height: 1.9;
    text-align: center;
    color: var(--text-3);
  }

  /* ───── right rail ───── */
  .po__right { display: none; justify-items: end; gap: var(--s5); text-align: right; }
  .po__words,
  .po__scroll {
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    line-height: 2.1;
    color: var(--text-3);
  }
  .po__rule { width: 1px; height: 4rem; background: var(--line-light); justify-self: end; }

  /* ───── foot ───── */
  .po__proms {
    display: grid;
    gap: var(--s4);
    margin-top: clamp(1.75rem, 4vw, 2.75rem);
    padding-top: clamp(1.25rem, 3vw, 2rem);
    border-top: 1px solid var(--line-light);
  }
  .po__proms li { display: flex; align-items: center; gap: 0.7rem; }
  .po__proms i { color: var(--green-deep); display: grid; place-items: center; flex: none; }
  .po__proms span { display: grid; font-size: 0.8125rem; line-height: 1.3; color: var(--text-3); }
  .po__proms b { font-weight: 700; color: var(--text); }

  .po__note {
    margin-top: var(--s5);
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  /* ───── responsive ───── */
  @media (min-width: 48rem) {
    .po__proms { grid-template-columns: repeat(2, 1fr); }
  }

  @media (min-width: 76rem) {
    .po__grid { grid-template-columns: minmax(0, 0.8fr) minmax(0, 2fr) auto; }
    .po__right { display: grid; }
    .po__proms { grid-template-columns: repeat(4, 1fr); }
  }

  /* Below this the 3D turn costs more than it gives: the side panes are
     mostly edge-on and the text in them unreadable. Flatten to a stack
     of one. */
  @media (max-width: 48rem) {
    .po__stage { perspective: none; aspect-ratio: 1 / 1.15; }
    .po__shot, .po__ground { display: none; }
    .deck { inset: 8% 0 14%; transform-style: flat; }
    .pane[data-pos='c'] { transform: none; }
    .pane[data-pos='l'], .pane[data-pos='r'] { transform: none; opacity: 0; pointer-events: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .po__ring, .orb { animation: none; }
    .pane, .pane__cta, .pane__cta:hover { transition: none; transform: none; }
    .pane[data-pos='c'] { transform: translate3d(0, 0, 60px); }
    .pane[data-pos='l'] { transform: translate3d(-62%, 4%, -150px) rotateY(34deg) scale(0.82); }
    .pane[data-pos='r'] { transform: translate3d(62%, 4%, -150px) rotateY(-34deg) scale(0.82); }
  }
</style>
