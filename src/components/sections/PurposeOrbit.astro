---
import { Image } from 'astro:assets';
import Icon from '@components/ui/Icon.astro';
import shotTech from '@assets/photos/repair-solder.jpg';
/* NOT retail-display.jpg — that file was deleted as unusable and every
   package keeps importing it, which fails the build outright (500 on
   /about). This card reads "Rooted in Oman"; an engineer on site is the
   closest thing in the library. A real Ruwi shop-floor photograph is
   still the asset that would fill it properly. */
import shotShop from '@assets/photos/network-eng.jpg';

/**
 * OUR PURPOSE — three panes on a 3D stage.
 *
 * The active pane stands square to the camera; the other two sit back
 * and turn inward on a real perspective, so the set reads as objects in
 * a space rather than three boxes in a row. Selecting one rotates the
 * set: whatever was chosen comes forward and the rest fall back.
 *
 * Everything is CSS 3D on a preserve-3d stage — no library, no canvas.
 * The orbital rings are SVG ellipses tipped in X and turning slowly,
 * which is what gives the depth something to read against.
 *
 * The Mission and Vision texts are Danat's own, word for word from the
 * old danatcomputers.com About page. ⚠ The Values wording is still a
 * draft written to match.
 */
const faces = [
  {
    no: '01',
    key: 'Mission',
    kicker: 'Our mission',
    lead: 'A more connected tomorrow',
    h: ['Excellence and', 'customer satisfaction.'],
    accent: [1],
    icon: 'compass', tone: 'mint',
    summary: 'At Danat Computer Supermarket, we take pride in our unwavering commitment to excellence and customer satisfaction.',
    quote: 'Our unwavering commitment to excellence and customer satisfaction.',
    points: ['Computer sales', 'Printer servicing', 'CCTV installation', 'Computer networking', 'Data recovery'],
    pointsTitle: 'Where we give top-tier assistance',
    p: 'At Danat Computer Supermarket, we take pride in our unwavering commitment to excellence and customer satisfaction. With a team of passionate and skilled professionals, we are dedicated to providing top-tier assistance in various areas, including computer sales, printer servicing, CCTV installation, computer networking, and data recovery.',
  },
  {
    no: '02',
    key: 'Vision',
    kicker: 'Our vision',
    lead: 'A more connected tomorrow',
    h: ['A global leader in', 'technological solutions.'],
    accent: [1],
    icon: 'eye', tone: 'sky',
    summary: 'Our vision at Danat Group is to be a global leader in providing comprehensive and advanced technological solutions.',
    quote: 'A future where technology seamlessly integrates into every aspect of life, making it more efficient and enjoyable.',
    points: ['Consistently innovating and adapting to emerging trends', 'Fostering a culture of continuous improvement', 'Pushing boundaries and exceeding customer expectations', 'Recognised as a symbol of trust and reliability'],
    pointsTitle: 'How we get there',
    p: 'Our vision at Danat Group is to be a global leader in providing comprehensive and advanced technological solutions. We aspire to create a future where technology seamlessly integrates into every aspect of life, making it more efficient and enjoyable. By consistently innovating and adapting to emerging trends, we envision ourselves as pioneers in shaping the digital landscape. We are dedicated to fostering a culture of continuous improvement, pushing boundaries, and exceeding customer expectations. Through our global presence, we aim to be recognized as a symbol of trust and reliability, making a positive impact on societies and contributing to the progress of the world.',
  },
  {
    no: '03',
    key: 'Values',
    kicker: 'Our values',
    lead: 'What guides us always',
    h: ['Diagnose first.', 'Repair deeper.', 'Stand behind it.'],
    accent: [1],
    icon: 'heart', tone: 'lilac',
    summary: 'Free diagnosis before any quote. Faults traced to the component, not the board.',
    quote: 'Diagnose first. Repair deeper. Stand behind it.',
    points: ['Free diagnosis before any quote', 'Faults traced to the component rather than the board', 'Genuine parts from the same stock we sell', 'The same standard at every branch'],
    pointsTitle: 'What that means in practice',
    p: 'Free diagnosis before any quote. Faults traced to the component rather than the board. The same standard at every branch.',
  },
];

const promises = [
  { icon: 'users', a: 'People', b: 'at the centre' },
  { icon: 'shield', a: 'Trusted', b: 'in every solution' },
  { icon: 'chart', a: 'Committed', b: 'to a better Oman' },
  { icon: 'heart', a: 'Always here', b: 'to support' },
];
---

<section class="po">
  <span class="po__sky" aria-hidden="true"></span>
  <span class="po__haze" aria-hidden="true"></span>

  <div class="shell po__grid">
    {/* ── left ── */}
    <div class="po__left">
      <p class="eb" data-rise><i class="eb__r" aria-hidden="true"></i>Our purpose</p>
      <h2 class="po__h" data-rise style="--d:70ms">
        Guided by<br /><em>a bigger<br />purpose.</em>
      </h2>
      <p class="po__p" data-rise style="--d:130ms">
        Our mission, vision and values reflect who we are, what we aim for,
        and how we work — every day, for a brighter Oman.
      </p>

      <ol class="po__idx" data-rise style="--d:190ms">
        {faces.map((f, i) => (
          <li>
            <button type="button" data-goto={i} data-on={i === 0 ? '' : undefined}>
              <b>{f.no}</b>
              <i class="po__dot" aria-hidden="true"></i>
              <span>{f.key}</span>
            </button>
          </li>
        ))}
      </ol>

      <p class="po__script" aria-hidden="true">
        Technology<br />for a<br />Brighter Oman
        <svg viewBox="0 0 160 14" fill="none">
          <path d="M4 10C40 3 118 2 156 7" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
        </svg>
      </p>
    </div>

    {/* ── stage ── */}
    <div class="po__stage" data-stage>
      {/* orbital rings, tipped back and turning */}
      <svg class="po__rings" viewBox="0 0 200 200" fill="none" aria-hidden="true">
        <ellipse class="po__ring po__ring--a" cx="100" cy="100" rx="94" ry="36"
          stroke="currentColor" stroke-width="0.7" />
        <ellipse class="po__ring po__ring--b" cx="100" cy="100" rx="78" ry="30"
          stroke="currentColor" stroke-width="0.5" stroke-dasharray="2 4" />
      </svg>

      {/* floating spheres */}
      <span class="orb" style="--x:8%;  --y:34%; --s:26px; --c:#e8efe9"></span>
      <span class="orb" style="--x:30%; --y:18%; --s:14px; --c:#e8efe9"></span>
      <span class="orb" style="--x:36%; --y:26%; --s:18px; --c:#2f6b2a"></span>
      <span class="orb" style="--x:88%; --y:46%; --s:22px; --c:#2f6b2a"></span>
      <span class="orb" style="--x:72%; --y:14%; --s:12px; --c:#e8efe9"></span>

      {/* photo cards that ride the orbit */}
      <figure class="po__shot po__shot--l">
        <Image src={shotTech} alt="" widths={[320, 520]} sizes="220px"
          quality={72} format="webp" loading="lazy" />
        <figcaption>People<br />Power<br />Progress</figcaption>
      </figure>
      <figure class="po__shot po__shot--r">
        <Image src={shotShop} alt="" widths={[320, 520]} sizes="220px"
          quality={72} format="webp" loading="lazy" />
        <figcaption>Rooted<br />in Oman</figcaption>
      </figure>

      {/* the three panes */}
      <div class="deck">
        {faces.map((f, i) => (
          <article class="pane" data-pos={i === 0 ? 'c' : i === 1 ? 'r' : 'l'} data-i={i}>
            <button class="pane__hit" type="button" aria-label={`Show ${f.key}`}></button>

            <span class="pane__face" aria-hidden="true">
              <b>{f.no}</b>
              <i>{f.key}</i>
            </span>

            <p class="pane__no">{f.no}</p>
            <p class="pane__k">{f.kicker}</p>

            <h3 class="pane__h">
              {f.h.map((line, li) => (
                <>{f.accent.includes(li) ? <em>{line}</em> : line}<br /></>
              ))}
            </h3>

            <p class="pane__p">{(f as any).summary ?? f.p}</p>

            <button class="pane__cta" type="button" data-po-open={i} aria-haspopup="dialog">
              Learn more<Icon name="arrow" size={15} />
            </button>

            <span class="pane__bar" aria-hidden="true">
              {faces.map((_, bi) => <i data-on={bi === i ? '' : undefined}></i>)}
            </span>
          </article>
        ))}
      </div>

      {/* the plinth the deck stands on */}
      <span class="po__plinth" aria-hidden="true"></span>
      <p class="po__ground" aria-hidden="true">From people<br />to a brighter<br />tomorrow</p>
    </div>

    {/* ── right rail ── */}
    <div class="po__right" aria-hidden="true">
      <p class="po__words">Technology<br />People<br />Progress<br />Together</p>
      <span class="po__rule"></span>
      <p class="po__scroll">Scroll<br />the story</p>
    </div>
  </div>

  {/* ── foot ── */}
  <ul class="shell po__proms">
    {promises.map((p, i) => (
      <li data-rise style={`--d:${i * 60}ms`}>
        <i aria-hidden="true"><Icon name={p.icon} size={19} /></i>
        <span><b>{p.a}</b>{p.b}</span>
      </li>
    ))}
  </ul>

  <p class="po__note" data-rise>
    Mission, vision and values wording is a draft for Danat to approve.
  </p>

  {/* the detail view: opens from any card's Learn more */}
  <dialog class="pod" data-pod aria-labelledby="pod-title">
    <button class="pod__x" type="button" data-pod-close aria-label="Close"><span aria-hidden="true">×</span></button>
    {faces.map((f: any, i) => (
      <article class={`pod__page pod--${f.tone}`} data-pod-page={i} hidden={i !== 0}>
        <aside class="pod__side">
          <span class="pod__big" aria-hidden="true">{f.no}</span>
          <span class="pod__ic" aria-hidden="true"><Icon name={f.icon} size={26} /></span>
          <p class="pod__k">{f.kicker}</p>
          <h3 class="pod__h" id={i === 0 ? 'pod-title' : undefined}>{f.h.map((l: string, li: number) => <>{f.accent.includes(li) ? <em>{l}</em> : l}{' '}</>)}</h3>
          <nav class="pod__tabs" aria-label="Purpose">
            {faces.map((g, gi) => <button type="button" data-pod-go={gi} aria-current={gi === i ? 'true' : undefined}><b>{g.no}</b>{g.key}</button>)}
          </nav>
        </aside>
        <div class="pod__main">
          <p class="pod__lead">{f.p}</p>
          <blockquote class="pod__quote"><span aria-hidden="true">“</span>{f.quote}</blockquote>
          <p class="pod__pt">{f.pointsTitle}</p>
          <ul class="pod__list">
            {f.points.map((pt: string, pi: number) => <li style={`--j:${pi}`}><Icon name="check" size={14} />{pt}</li>)}
          </ul>
          <div class="pod__nav">
            <button type="button" data-pod-go={(i + faces.length - 1) % faces.length}><span aria-hidden="true">←</span> {faces[(i + faces.length - 1) % faces.length].key}</button>
            <button type="button" data-pod-go={(i + 1) % faces.length}>{faces[(i + 1) % faces.length].key} <span aria-hidden="true">→</span></button>
          </div>
        </div>
      </article>
    ))}
  </dialog>
</section>

<script>
  /* the detail view: open from a card, move between Mission / Vision / Values, close */
  function podStart() {
    const dlg = document.querySelector<HTMLDialogElement>('[data-pod]');
    if (!dlg || dlg.dataset.wired) return;
    dlg.dataset.wired = '1';
    const pages = [...dlg.querySelectorAll<HTMLElement>('[data-pod-page]')];
    const go = (i: number) => {
      pages.forEach((p) => { const on = Number(p.dataset.podPage) === i; p.hidden = !on; p.classList.remove('is-in'); if (on) { void p.offsetWidth; p.classList.add('is-in'); } });
    };
    document.querySelectorAll<HTMLElement>('[data-po-open]').forEach((b) => b.addEventListener('click', (e) => {
      e.stopPropagation(); go(Number(b.dataset.poOpen)); dlg.showModal(); document.documentElement.style.overflow = 'hidden';
    }));
    dlg.querySelectorAll<HTMLElement>('[data-pod-go]').forEach((b) => b.addEventListener('click', () => go(Number(b.dataset.podGo))));
    const close = () => { dlg.classList.add('is-closing'); setTimeout(() => { dlg.close(); dlg.classList.remove('is-closing'); }, 220); };
    dlg.querySelector('[data-pod-close]')!.addEventListener('click', close);
    dlg.addEventListener('click', (e) => { if (e.target === dlg) close(); });
    dlg.addEventListener('close', () => { document.documentElement.style.overflow = ''; });
    dlg.addEventListener('cancel', (e) => { e.preventDefault(); close(); });
  }
  document.addEventListener('astro:page-load', podStart);
</script>

<script is:inline>
  /* <ClientRouter /> swaps the body on a nav click without a page load,
     and an is:inline script runs once on the first load and never again
     — so everything below was binding to elements that had already been
     thrown away. astro:page-load fires on the first load and after every
     swap. */
  (() => {
    const setup = () => {
    (() => {
      const stage = document.querySelector('[data-stage]');
      if (!stage) return;

      const panes = [...stage.querySelectorAll('.pane')];
      const idx = [...document.querySelectorAll('[data-goto]')];
      const n = panes.length;
      if (!n) return;

      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let at = 0;
      let timer = null;

      const show = (next) => {
        at = ((next % n) + n) % n;
        panes.forEach((p, i) => {
          // centre, then right, then left, walking forward from the active
          const d = (((i - at) % n) + n) % n;
          p.setAttribute('data-pos', d === 0 ? 'c' : d === 1 ? 'r' : 'l');
          p.querySelectorAll('.pane__bar i').forEach((b, bi) =>
            b.toggleAttribute('data-on', bi === at)
          );
        });
        idx.forEach((el, i) => el.toggleAttribute('data-on', i === at));
      };

      const stop = () => { if (timer) clearInterval(timer); timer = null; };
      const start = () => { if (!reduced && !timer) timer = setInterval(() => show(at + 1), 3200); };

      panes.forEach((p, i) =>
        p.querySelector('.pane__hit')?.addEventListener('click', () => { stop(); show(i); })
      );
      idx.forEach((el, i) => el.addEventListener('click', () => { stop(); show(i); }));

      new IntersectionObserver(([e]) => (e.isIntersecting ? start() : stop()), { threshold: 0.25 })
        .observe(stage);

      show(0);
    })();
    };

    let ran = false;
    document.addEventListener('astro:page-load', () => { ran = true; setup(); });
    window.addEventListener('load', () => { if (!ran) { ran = true; setup(); } });
  })();
</script>

<style>
  .po {
    position: relative;
    padding-block: clamp(3rem, 6vw, 5rem);
    background: linear-gradient(180deg, #fbfdfc, #f2f7f4 54%, #fafcfb);
    overflow: hidden;
    isolation: isolate;
  }
  /* A soft horizon instead of the mockup's rendered mountains, which we
     have no photography for. */
  .po__sky {
    position: absolute;
    inset: 0 0 26% 0;
    z-index: -2;
    background: radial-gradient(120% 90% at 50% 100%, #e6efe9 0%, transparent 62%);
  }
  .po__haze {
    position: absolute;
    z-index: -1;
    left: 50%;
    top: 46%;
    translate: -50% -50%;
    width: min(62rem, 98vw);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in oklab, var(--green) 10%, transparent), transparent 66%);
    filter: blur(34px);
  }

  .eb {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--green-deep);
  }
  .eb__r { width: 26px; height: 1px; flex: none; background: currentColor; opacity: 0.6; }

  /* minmax(0, 1fr), not the default 1fr: a grid item's automatic
     minimum is its content size, so without this the stage refused to
     shrink below its intrinsic width and burst out of the column —
     which on a phone pushed the pane past the right edge and dragged
     every centred element on the page with it. */
  .po__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(1.5rem, 3vw, 2.5rem);
    align-items: center;
  }
  .po__stage { max-width: 100%; }

  /* ───── left ───── */
  .po__h {
    margin-top: var(--s4);
    font-size: var(--d4);
    font-weight: 700;
    letter-spacing: var(--tr4);
    line-height: 1.04;
  }
  .po__h em { font-style: normal; color: var(--green-deep); }
  .po__p {
    margin-top: var(--s4);
    max-width: 32ch;
    font-size: 0.875rem;
    line-height: 1.7;
    color: var(--text-2);
  }

  .po__idx { display: grid; gap: 0; margin-top: var(--s5); }
  .po__idx li { position: relative; }
  /* The rail between the markers. */
  .po__idx li:not(:last-child)::after {
    content: '';
    position: absolute;
    left: calc(1.9rem + 5px);
    top: 1.85rem;
    bottom: -0.15rem;
    width: 1px;
    background: var(--line-light);
  }
  .po__idx button {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    width: 100%;
    padding: 0.5rem 0;
    border: 0;
    background: none;
    cursor: pointer;
    text-align: left;
    color: var(--text-3);
    transition: color var(--t2) var(--ease);
  }
  .po__idx b { width: 1.4rem; font-family: var(--font-mono); font-size: 0.6875rem; }
  .po__dot {
    width: 11px;
    height: 11px;
    flex: none;
    border-radius: 50%;
    background: var(--line-light);
    transition: background-color var(--t2) var(--ease), box-shadow var(--t2) var(--ease);
  }
  .po__idx span { font-size: 0.9375rem; font-weight: 600; letter-spacing: -0.02em; }
  .po__idx button:hover { color: var(--text-2); }
  .po__idx button[data-on] { color: var(--text); }
  .po__idx button[data-on] .po__dot {
    background: var(--green-deep);
    box-shadow: 0 0 0 4px color-mix(in oklab, var(--green) 20%, transparent);
  }
  .po__idx button:focus-visible { outline: 2px solid var(--green-deep); outline-offset: 2px; }

  .po__script {
    margin-top: clamp(1.5rem, 3.5vw, 2.5rem);
    font-family: var(--font-serif, Georgia, serif);
    font-style: italic;
    font-size: var(--d7);
    line-height: 1.3;
    color: var(--green-deep);
    rotate: -4deg;
    transform-origin: left center;
    pointer-events: none;
  }
  .po__script svg { display: block; width: 9rem; margin-top: 0.3rem; color: var(--green); }

  /* ───── stage ───── */
  .po__stage {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 0.74;
    perspective: 1500px;
    perspective-origin: 50% 42%;
  }

  .po__rings {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    color: color-mix(in oklab, var(--green) 34%, transparent);
  }
  .po__ring { transform-origin: 50% 50%; }
  @media (prefers-reduced-motion: no-preference) {
    .po__ring--a { animation: po-spin 48s linear infinite; }
    .po__ring--b { animation: po-spin 34s linear infinite reverse; }
  }
  @keyframes po-spin { to { transform: rotate(360deg); } }

  .orb {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: var(--s);
    height: var(--s);
    border-radius: 50%;
    background: radial-gradient(circle at 32% 28%, #fff, var(--c) 64%, color-mix(in oklab, var(--c) 70%, #000));
    box-shadow: 0 8px 18px -8px rgb(10 30 12 / 0.4);
  }
  @media (prefers-reduced-motion: no-preference) {
    .orb { animation: po-float 8s ease-in-out infinite alternate; }
    .orb:nth-of-type(2) { animation-duration: 10s; }
    .orb:nth-of-type(3) { animation-duration: 12s; }
    .orb:nth-of-type(4) { animation-duration: 9s; }
  }
  @keyframes po-float { to { transform: translate3d(0, -14px, 0); } }

  /* ---- photo cards riding the orbit ---- */
  .po__shot {
    position: absolute;
    top: 5%;
    z-index: 4;
    width: clamp(6rem, 11vw, 8.5rem);
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 20px 44px -22px rgb(10 30 12 / 0.5);
  }
  .po__shot :global(img) { width: 100%; height: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  .po__shot figcaption {
    position: absolute;
    left: 0.6rem;
    bottom: 0.5rem;
    font-size: 0.6875rem;
    font-weight: 600;
    line-height: 1.25;
    z-index: 1;
    color: #fff;
  }
  /* A text-shadow is not a contrast mechanism — it cannot be composited
     and measured, and over the pale corner of the bench photo the white
     caption was effectively unreadable. A real scrim can be checked
     against the actual pixels, which is the standard on this site. */
  .po__shot::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgb(8 13 9 / 0.88) 0%,
      rgb(8 13 9 / 0.7) 40%,
      rgb(8 13 9 / 0.18) 74%,
      rgb(8 13 9 / 0) 100%
    );
  }
  .po__shot--l { left: -2%; rotate: -6deg; }
  .po__shot--r { right: -2%; rotate: 6deg; }

  /* ---- the three panes ---- */
  .deck {
    position: absolute;
    /* 21% side inset makes the deck 58% of the stage; the offsets below
       are a percentage of THAT, so the side panes stay in the column. */
    inset: 13% 21% 17%;
    transform-style: preserve-3d;
  }

  .pane {
    position: absolute;
    inset: 0;
    display: grid;
    align-content: center;
    justify-items: center;
    padding: clamp(0.9rem, 2vw, 1.5rem);
    border-radius: 22px;
    /* OPAQUE, deliberately. An earlier pass made these frosted glass so
       the rings read through them — but on a deck the panes overlap, and
       translucency meant the back pane's text showed through the front
       one. A card in space occludes what is behind it; that occlusion is
       most of what sells the depth. */
    background: #fff;
    border: 1px solid var(--line-light);
    box-shadow:
      0 2px 4px rgb(10 30 12 / 0.05),
      0 34px 70px -30px rgb(10 30 12 / 0.42);
    text-align: center;
    transition:
      transform 540ms cubic-bezier(0.55, 0, 0.2, 1),
      opacity 360ms var(--ease),
      filter 360ms var(--ease);
  }

  /* Centre: square to the camera and forward. */
  .pane[data-pos='c'] {
    box-shadow:
      0 2px 4px rgb(10 30 12 / 0.06),
      0 50px 90px -34px rgb(10 30 12 / 0.5);
    transform: translate3d(0, 0, 60px);
    opacity: 1;
    z-index: 3;
  }
  /* Sides: pushed out, back, and turned inward. */
  .pane[data-pos='l'] {
    transform: translate3d(-58%, 3%, -170px) rotateY(36deg) scale(0.84);
    background: #f4f8f5;
    z-index: 1;
  }
  .pane[data-pos='r'] {
    transform: translate3d(58%, 3%, -170px) rotateY(-36deg) scale(0.84);
    background: #f4f8f5;
    z-index: 1;
  }
  /* A side pane is roughly half covered by the centre one. Its own text
     is centred, which is exactly the part that gets covered — so it was
     rendering as sliced half-words ("Diagno…", "Repair…"). A side pane
     therefore shows none of its real content and puts .pane__face in the
     strip that IS visible instead. The text stays in the DOM at opacity
     0, so a screen reader still reads all three. */
