---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from '@components/ui/Icon.astro';
import { site } from '@data/site';

/**
 * TEARDOWN — the machine comes apart, part by part, as you scroll.
 *
 * Six stages. Each one is a band: the stage number on a rail at the
 * left, the render in the middle, the spec at the right. Scrolling
 * moves you through the disassembly rather than playing a video, which
 * means it stays sharp at any screen size, weighs a fraction of a video
 * file, and every word in it is real text that Google can read.
 *
 * RENDERS: drop six images into src/assets/renders/ named
 *   01.png  02.png  03.png  04.png  05.png  06.png
 * (.jpg/.webp also fine). They are picked up automatically, converted to
 * WebP and sized per device at build time. Until a file is there, its
 * stage shows a marked empty frame rather than a broken one.
 *
 * Best results: transparent PNG, ~2000px wide, the part lit against
 * near-black with a green edge glow, shot from the same angle each time
 * so the six read as one machine coming apart.
 */
const files = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/renders/*.{png,jpg,jpeg,webp,avif}',
  { eager: true }
);
const render = (n: string): ImageMetadata | null =>
  Object.entries(files).find(([p]) => p.includes(`/${n}.`))?.[1].default ?? null;

const stages = [
  {
    n: '01',
    rail: 'The complete system',
    sub: null,
    icon: 'laptop',
    title: 'Brilliant display',
    lead: 'Crystal clear visuals for a better viewing experience.',
    specs: ['Full HD / 2K / 4K options', 'Anti-glare display', 'Vivid colour accuracy'],
    hero: true,
  },
  {
    n: '02',
    rail: 'Display',
    sub: 'See more.\nDo more.',
    icon: 'laptop',
    title: 'Brilliant display',
    lead: 'Crystal clear visuals for a better viewing experience.',
    specs: ['Full HD / 2K / 4K options', 'Anti-glare display', 'Vivid colour accuracy'],
    hero: false,
  },
  {
    n: '03',
    rail: 'Performance',
    sub: 'Built to\nkeep up.',
    icon: 'chip',
    title: 'Powerful performance',
    lead: 'Latest Intel and AMD processors for seamless multitasking.',
    specs: ['Intel Core / AMD Ryzen', 'High-speed RAM', 'Optimised for work, study and gaming'],
    hero: false,
  },
  {
    n: '04',
    rail: 'Storage',
    sub: 'Your data.\nAlways with you.',
    icon: 'ssd',
    title: 'Fast, reliable storage',
    lead: 'More speed. More space. More possibilities.',
    specs: ['SSD for faster performance', 'Large storage options', 'Secure data handling'],
    hero: false,
  },
  {
    n: '05',
    rail: 'Cooling',
    sub: 'Stay cool.\nPerform better.',
    icon: 'fan',
    title: 'Advanced cooling',
    lead: 'Efficient thermal design for long-lasting performance.',
    specs: ['Optimised airflow', 'Quieter operation', 'Stable performance'],
    hero: false,
  },
  {
    n: '06',
    rail: 'Connectivity',
    sub: 'Stay connected.\nEverywhere.',
    icon: 'ports',
    title: 'All the connections you need',
    lead: 'Plug in, connect and get more done.',
    specs: ['USB-C / USB-A', 'HDMI / display support', 'Audio and more'],
    hero: false,
  },
];


/** The opening block is its own thing; the deck cycles the rest. */
const parts = stages.filter((s) => !s.hero);
---

<section class="td" data-tone="ink">
  {/* ── the opening: this stays a block of its own ── */}
  <div class="shell td__grid td__intro">
    <div class="td__rail" data-rise>
      <span class="td__n">01</span>
      <span class="td__line" aria-hidden="true"></span>
      <span class="td__k">The complete system</span>
    </div>

    <figure class="td__fig">
      <span class="td__glow" aria-hidden="true"></span>
      <div class="td__part">
        {/* Plays on a click, never on its own. */}
        <div class="td__film" data-film>
          <video src="/film/ecosystem.mp4" poster="/film/ecosystem.jpg"
            muted loop playsinline preload="none"
            aria-label="Danat: printers, laptops, accessories, tools and servers"></video>
          <button type="button" data-film-play aria-label="Play the film">
            <Icon name="play" size={18} />
            <span>Watch</span>
          </button>
        </div>
      </div>
    </figure>

    <div class="td__body">
      <p class="td__eb" data-rise>{site.nameFull}</p>
      <h2 class="td__h1" data-rise style="--d:80ms">
        More than<br />just <em>a laptop</em>
      </h2>
      <p class="td__lead" data-rise style="--d:150ms">
        Complete technology solutions to power your work, study and business.
      </p>
    </div>

    <p class="td__script" aria-hidden="true">
      Technology<br />for a Brighter<br />Tomorrow.
    </p>
  </div>

  {/* ── the machine, on ONE stage ──
      It used to be five more full-height bands you scrolled through. It
      is one panel now, and the parts change on it. Same six stages, same
      words, a fifth of the page height. */}
  <div class="shell td__grid td__deck" data-deck>
    <div class="td__rail">
      {parts.map((s, i) => (
        <span class="td__slide" data-i={i} data-on={i === 0 ? '' : undefined}>
          <span class="td__n">{s.n}</span>
          <span class="td__line" aria-hidden="true"></span>
          <span class="td__k">{s.rail}</span>
          {s.sub && <span class="td__sub">{s.sub}</span>}
        </span>
      ))}
    </div>

    <figure class="td__fig">
      <span class="td__glow" aria-hidden="true"></span>
      <div class="td__part td__part--deck">
        {parts.map((s, i) => {
          const img = render(s.n);
          return (
            <span class="td__slide" data-i={i} data-on={i === 0 ? '' : undefined}>
              {img ? (
                <Image src={img} alt="" widths={[420, 640, 900]}
                  sizes="(min-width: 62rem) 46vw, 92vw"
                  quality={82} format="webp" loading={i === 0 ? 'eager' : 'lazy'} />
              ) : (
                <span class="td__slot">
                  <b>{s.n}</b><i>{s.rail} render</i><em>src/assets/renders/{s.n}.png</em>
                </span>
              )}
            </span>
          );
        })}
      </div>
    </figure>

    <div class="td__body">
      {parts.map((s, i) => (
        <span class="td__slide" data-i={i} data-on={i === 0 ? '' : undefined}>
          <span class="td__ic" aria-hidden="true"><Icon name={s.icon} size={22} /></span>
          <h3 class="td__h">{s.title}</h3>
          <p class="td__p">{s.lead}</p>
          <ul class="td__specs">
            {s.specs.map((sp) => <li><Icon name="check" size={14} />{sp}</li>)}
          </ul>
        </span>
      ))}

      <ol class="td__dots" role="tablist" aria-label="Parts of the machine">
        {parts.map((s, i) => (
          <li>
            <button type="button" data-go={i} data-on={i === 0 ? '' : undefined}
              role="tab" aria-selected={i === 0 ? 'true' : 'false'}
              aria-label={s.rail}><i></i></button>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<script is:inline>
  /* One stage, five parts, turning on their own.
     It used to scroll the page from band to band by itself — that is the
     behaviour this replaces, not an animation added on top of it. */
  (() => {
    const setup = () => {
      const deck = document.querySelector('[data-deck]');
      if (!deck || deck.dataset.wired) return;
      deck.dataset.wired = '1';

      const groups = [...deck.querySelectorAll('.td__rail, .td__part--deck, .td__body')];
      const dots = [...deck.querySelectorAll('[data-go]')];
      const N = dots.length;
      let at = 0;
      let timer = null;

      const show = (next) => {
        at = ((next % N) + N) % N;
        for (const g of groups) {
          g.querySelectorAll(':scope > .td__slide').forEach((el, i) =>
            el.toggleAttribute('data-on', i === at)
          );
        }
        dots.forEach((d, i) => {
          d.toggleAttribute('data-on', i === at);
          d.setAttribute('aria-selected', i === at ? 'true' : 'false');
        });
      };

      const stop = () => { if (timer) clearInterval(timer); timer = null; };
      const start = () => {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        if (!timer) timer = setInterval(() => show(at + 1), 3600);
      };

      dots.forEach((d, i) => d.addEventListener('click', () => { show(i); stop(); start(); }));

      /* Holds only while someone is working the dots, not for a pointer
         resting anywhere near the section. */
      deck.querySelector('.td__dots')?.addEventListener('pointerenter', stop);
      deck.querySelector('.td__dots')?.addEventListener('pointerleave', start);
      deck.addEventListener('focusin', stop);
      deck.addEventListener('focusout', start);

      /* Nothing turns while it is off screen. */
      new IntersectionObserver(([e]) => (e.isIntersecting ? start() : stop()), {
        threshold: 0.25,
      }).observe(deck);

      show(0);
    };

    document.addEventListener('astro:page-load', setup);
    window.addEventListener('load', setup);
  })();
</script>

<style>
  .td {
    position: relative;
    background: #07090a;
    color: #fff;
    overflow: hidden;
  }

  /* Each part gets its own band; the rules between them are what makes
     it read as a sequence rather than one long picture. */




  /* Shown only while the sequence is driving itself. */
  .td::after {
    content: 'Playing — scroll to take over';
    position: fixed;
    left: 50%;
    bottom: 1.25rem;
    z-index: 40;
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    border: 1px solid rgb(255 255 255 / 0.18);
    background: rgb(7 9 10 / 0.82);
    backdrop-filter: blur(8px);
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.72);
    translate: -50% 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--t2) var(--ease);
  }
  :global(html[data-td-playing]) .td::after { opacity: 1; }

  .td__grid {
    display: grid;
    gap: clamp(1.25rem, 3vw, 2.5rem);
    align-items: center;
  }

  /* ---------- rail ---------- */

  .td__rail {
    display: grid;
    justify-items: start;
    gap: 0.5rem;
  }
  .td__n {
    font-size: 0.9375rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: rgb(255 255 255 / 0.85);
  }
  .td__line {
    width: 1px;
    height: 2.2rem;
    background: linear-gradient(to bottom, var(--green), transparent);
  }
  .td__k {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.62);
  }
  .td__sub {
    font-size: 0.8125rem;
    line-height: 1.45;
    white-space: pre-line;
    color: rgb(255 255 255 / 0.45);
  }

  /* ---------- the part ---------- */

  .td__fig {
    position: relative;
    display: grid;
    place-items: center;
    min-height: clamp(11rem, 26vw, 20rem);
    /* A real camera. Without this the rotations below are flat shears. */
    perspective: 1100px;
    perspective-origin: 50% 50%;
  }

  /* The part is a plane in space, not a picture sliding up the page.
     --t runs 0 -> 1 as the figure crosses the viewport, so the part
     swings through face-on at the halfway point and away again.

     translateZ uses t*(1-t), which peaks at 0.25 when t is 0.5 — so the
     part reaches the viewer exactly when it is square to the camera, and
     recedes at both ends. --dir alternates per stage so consecutive
     parts turn opposite ways.

     --t is never published under reduced motion or with JS off; the
     fallback of 0.5 is the neutral pose, square to the camera. */
  /* ---- one stage, five parts ---- */
  .td__intro { padding-block: clamp(5.5rem, 10vw, 8rem) clamp(2rem, 4vw, 3rem); }
  .td__deck {
    position: relative;
    padding-block: clamp(2rem, 4vw, 3rem) clamp(3.5rem, 7vw, 5.5rem);
    border-top: 1px solid rgb(255 255 255 / 0.07);
  }

  /* Every part is stacked in the same cell; one is up at a time. Grid
     rather than absolute, so the panel is as tall as its tallest part and
     nothing jumps as they change. */
  .td__deck .td__rail,
  .td__deck .td__part--deck,
  .td__deck .td__body { display: grid; }
  .td__deck .td__rail > .td__slide,
  .td__deck .td__part--deck > .td__slide,
  .td__deck .td__body > .td__slide {
    grid-area: 1 / 1;
    opacity: 0;
    visibility: hidden;
    transition: opacity 520ms var(--ease), transform 640ms var(--ease),
      visibility 0s linear 520ms;
    pointer-events: none;
  }
  /* The active rule has to match the SAME chain length as the one that
     hides them. Astro stamps its scope attribute on every compound in a
     selector, so a three-level chain carries three of them and a
     two-level chain only two — the shorter rule loses and every slide
     stayed hidden. */
  .td__deck .td__rail > .td__slide[data-on],
  .td__deck .td__part--deck > .td__slide[data-on],
  .td__deck .td__body > .td__slide[data-on] {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition: opacity 520ms var(--ease), transform 640ms var(--ease);
    pointer-events: auto;
  }
  /* The part turns in; the words rise. Different motions so the panel
     does not read as one crossfade. */
  .td__deck .td__part--deck > .td__slide { transform: rotateY(-12deg) scale(0.94); }
  .td__deck .td__rail > .td__slide,
  .td__deck .td__body > .td__slide { transform: translateY(14px); }
  .td__deck .td__part--deck { perspective: 1200px; }
  /* Each slide is a <span>, so without this its number, label and copy
     all flow inline and land on top of one another. */
  .td__deck .td__rail > .td__slide { display: grid; align-content: start; gap: 0.5rem; }
  .td__deck .td__body > .td__slide { display: grid; align-content: center; }
  .td__deck .td__rail { align-content: start; }
  /* Two rows, so the dots sit under the copy rather than in the same
     cell as every slide. */
  .td__deck .td__body { grid-template-rows: minmax(0, 1fr) auto; align-content: stretch; }
  .td__deck .td__body > .td__slide { grid-row: 1; }
  .td__deck .td__dots { grid-row: 2; grid-column: 1; }
  .td__deck .td__slide :global(img) { width: 100%; height: auto; }

  .td__dots {
    align-self: end;
    display: flex;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: var(--s5);
    z-index: 1;
  }
  .td__dots button {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }
  .td__dots i {
    width: 100%;
    height: 3px;
    border-radius: 2px;
    background: rgb(255 255 255 / 0.22);
    transition: background-color var(--t2) var(--ease);
  }
  .td__dots [data-on] i { background: var(--green-bright); }
  .td__dots button:focus-visible { outline: 2px solid var(--green-bright); outline-offset: 2px; }

  /* The film panel. Sized by its own aspect so nothing jumps when the
     poster swaps for the video. */
  .td__film { position: relative; display: block; }
  /* The header floats over this frame, and the film's top band carries
     near-white neon: white nav text measured 1.03:1 against it. The
     scrim below takes the worst pixel well clear of AA. */
  .td__film::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 60%;
    z-index: 1;
    border-radius: 14px 14px 0 0;
    /* Held near full strength across the band the nav actually occupies
       — a straight fade was down to 0.52 by then and left white text at
       3.48:1. Holding to 22% keeps the worst pixel above 12:1. */
    background: linear-gradient(
      180deg,
      rgb(7 9 10 / 0.86) 0%,
      rgb(7 9 10 / 0.82) 22%,
      rgb(7 9 10 / 0) 100%
    );
    pointer-events: none;
  }
  .td__film button { z-index: 2; }
  .td__film video {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 14px;
    background: #07090a;
  }
  .td__film button {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.85rem 1.4rem;
    border: 0;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.94);
    color: #07090a;
    font: inherit;
    font-size: 0.875rem;
    font-weight: 700;
    cursor: pointer;
    backdrop-filter: blur(8px);
    box-shadow: 0 18px 40px -18px rgb(0 0 0 / 0.7);
    transition: transform var(--t2) var(--ease), opacity 260ms var(--ease);
  }
  .td__film button:hover { transform: translate(-50%, -50%) scale(1.05); }
  .td__film button:focus-visible { outline: 2px solid var(--green-bright); outline-offset: 3px; }
  .td__film[data-playing] button { opacity: 0; pointer-events: none; }

  .td__part {
    position: relative;
    z-index: 1;
    width: 100%;
    transform-style: preserve-3d;
    will-change: transform;
    transform:
      translateZ(calc(var(--t, 0.5) * (1 - var(--t, 0.5)) * 520px))
      rotateY(calc((var(--t, 0.5) - 0.5) * -52deg * var(--dir, 1)))
      rotateX(calc((var(--t, 0.5) - 0.5) * 18deg))
      rotateZ(calc((var(--t, 0.5) - 0.5) * 6deg * var(--dir, 1)));
  }

  .td__part :global(img) {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
    /* Grounds the part instead of letting it float flat. */
    filter: drop-shadow(0 30px 40px rgb(0 0 0 / 0.55));
  }

  /* The green bloom behind the part. This is what carries the look while
     the renders are still missing. */
  .td__glow {
    position: absolute;
    inset: 8% 4%;
    z-index: 0;
    border-radius: 50%;
    background: radial-gradient(
      ellipse at 50% 55%,
      rgb(89 170 84 / 0.26) 0%,
      rgb(89 170 84 / 0.08) 42%,
      transparent 70%
    );
    filter: blur(24px);
    opacity: calc(0.45 + var(--t, 0.5) * (1 - var(--t, 0.5)) * 2.2);
    transform: scale(calc(0.86 + var(--t, 0.5) * (1 - var(--t, 0.5)) * 0.9));
  }

  /* Marked, not broken. Disappears the moment a render lands. */
  .td__slot {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: center;
    gap: 0.4rem;
    width: 100%;
    padding: clamp(2rem, 5vw, 3.5rem) 1rem;
    border: 1px dashed rgb(255 255 255 / 0.18);
    border-radius: 14px;
    text-align: center;
  }
  .td__slot b {
    font-size: 1.6rem;
    font-weight: 700;
    letter-spacing: -0.04em;
    color: rgb(255 255 255 / 0.28);
  }
  .td__slot i {
    font-style: normal;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--green-bright);
  }
  .td__slot em {
    font-style: normal;
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.06em;
    /* 0.32 measured 2.79:1 — under AA. 0.55 is 5.87:1. */
    color: rgb(255 255 255 / 0.55);
  }

  /* ---------- spec column ---------- */

  .td__eb {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--green-bright);
  }

  .td__h1 {
    margin-top: var(--s4);
    font-size: clamp(2.1rem, 4.6vw, 3.4rem);
    line-height: 1.04;
    letter-spacing: -0.042em;
    font-weight: 700;
  }
  .td__h1 em { font-style: normal; color: var(--green-bright); }

  .td__lead {
    margin-top: var(--s4);
    max-width: 34ch;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: rgb(255 255 255 / 0.74);
  }


  .td__ic {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    color: var(--green-bright);
  }

  .td__h {
    margin-top: 0.4rem;
    font-size: clamp(1.15rem, 2.2vw, 1.5rem);
    font-weight: 700;
    letter-spacing: -0.03em;
  }
  .td__p {
    margin-top: 0.45rem;
    max-width: 34ch;
    font-size: 0.875rem;
    line-height: 1.6;
    color: rgb(255 255 255 / 0.66);
  }

  .td__specs { display: grid; gap: 0.5rem; margin-top: var(--s4); }
  .td__specs li {
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: rgb(255 255 255 / 0.8);
  }
  .td__specs :global(svg) { flex: none; margin-top: 3px; color: var(--green-bright); }

  /* ---------- handwritten aside ---------- */

  .td__script {
    position: absolute;
    right: clamp(1rem, 3vw, 3rem);
    top: 32%;
    max-width: 10rem;
    font-family: var(--font-serif, Georgia, serif);
    font-style: italic;
    font-size: clamp(1rem, 1.7vw, 1.35rem);
    line-height: 1.3;
    color: rgb(255 255 255 / 0.5);
    rotate: -8deg;
    pointer-events: none;
    display: none;
  }

  /* ---------- closing ---------- */

  /* ---------- responsive ---------- */

  @media (min-width: 62rem) {
    .td__grid {
      grid-template-columns: minmax(0, 0.42fr) minmax(0, 1.25fr) minmax(0, 0.9fr);
      gap: clamp(1.5rem, 3vw, 3rem);
    }
    .td__script { display: block; }
  }

  @media (prefers-reduced-motion: reduce) {
    /* No turning: every part is shown, stacked, as the bands used to be. */
    .td__deck .td__rail, .td__deck .td__part--deck, .td__deck .td__body { display: block; }
    .td__deck .td__slide {
      opacity: 1;
      visibility: visible;
      transform: none;
      transition: none;
      margin-bottom: var(--s5);
    }
    .td__dots { display: none; }
    /* It only ever plays on a click, so it is already safe here; the
       hover scale is the only thing to drop. */
    .td__film button:hover { transform: translate(-50%, -50%); }
    /* Square to the camera, no motion. --t is never set, so this only
       needs to drop the will-change hint. */
    .td__part { will-change: auto; }
  }
</style>

<script is:inline>
  (() => {
    const setup = () => {
      const box = document.querySelector('[data-film]');
      if (!box || box.dataset.wired) return;
      box.dataset.wired = '1';

      const v = box.querySelector('video');
      const btn = box.querySelector('[data-film-play]');

      btn.addEventListener('click', () => {
        box.setAttribute('data-playing', '');
        v.play().catch(() => box.removeAttribute('data-playing'));
      });

      /* Scrolled away mid-play is decode work for nobody. It resumes only
         if it was already playing — it never starts itself. */
      new IntersectionObserver(([e]) => {
        if (!box.hasAttribute('data-playing')) return;
        if (e.isIntersecting) v.play().catch(() => {});
        else v.pause();
      }, { threshold: 0.2 }).observe(box);
    };

    document.addEventListener('astro:page-load', setup);
    window.addEventListener('load', setup);
  })();
</script>
