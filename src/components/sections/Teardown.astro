---
import { site } from '@data/site';

/**
 * THE OPENING — the film, the headline, and nothing else.
 *
 * This was six scrolling bands, then one turning panel. Both are gone at
 * the client's instruction: the film carries the message on its own and
 * the parts below it were repeating what it already shows.
 *
 * The renders in src/assets/renders/ are untouched and still on disk, so
 * the sequence can come back from git without re-sourcing artwork.
 */
---

<section class="td" data-tone="ink">
  {/*
    THE OPENING IS THE FILM. Full bleed, full height, nothing beside it.

    The headline and standfirst that used to sit in a column here are
    gone at the client's instruction — the film's own frames already
    carry the words ("01 · DIAGNOSE — Full hardware scan"), so the
    column was captioning something that captions itself, and a film in
    a box beside a paragraph reads as a video embedded in a page rather
    than as the page opening.

    The heading stays in the markup, unseen. A homepage whose first
    section announces nothing to a screen reader or a crawler is a
    different kind of broken from one that looks wrong.
  */}
  <h2 class="td__sr">{site.nameFull} — more than just a laptop</h2>

  <div class="td__intro">
    {/*
      Motion, not a video player. Nothing here says "video": no
      controls, no play button, no picture-in-picture, no context
      menu — pointer-events are off, so there is nothing on it to
      click at all. It runs by itself and loops.

      `controlsList` and `disablePictureInPicture` remove the
      browser's own download and pop-out affordances. They do NOT
      make the file private: it is still fetched over HTTP and can
      be pulled from the network panel or by asking for
      /film/ecosystem.mp4 directly. Nothing served to a browser can
      be stopped from being saved.
    */}
    <div class="td__film" data-film>
      <video src="/film/ecosystem.mp4" poster="/film/ecosystem.jpg"
        autoplay muted loop playsinline preload="auto"
        controlslist="nodownload noplaybackrate noremoteplayback"
        disablepictureinpicture disableremoteplayback
        aria-label="Danat: printers, laptops, accessories, tools and servers"></video>
    </div>
  </div>
</section>

<style>
  .td {
    position: relative;
    /* Light, at the client's instruction. The green tokens below swap
       with it: --green-bright is built for near-black and drops to
       1.9:1 on white, so the deep green is what reads here. */
    background: linear-gradient(180deg, #ffffff 0%, var(--off) 100%);
    color: var(--text);
    overflow: hidden;
  }

  /* Each part gets its own band; the rules between them are what makes
     it read as a sequence rather than one long picture. */




  /* A fixed "Playing — scroll to take over" pill used to sit here. It
     belonged to the scroll-driven sequence that is gone, nothing has
     set data-td-playing since, and a status pill is exactly what makes
     a film read as an embedded player rather than part of the page. */


  .td__grid {
    display: grid;
    gap: clamp(1.25rem, 3vw, 2.5rem);
    align-items: center;
  }

  /* ---------- rail ---------- */

  .td__rail {
    display: grid;
    justify-items: start;
    gap: 0.5rem;
  }
  .td__n {
    font-size: 0.9375rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: rgb(255 255 255 / 0.85);
  }
  .td__line {
    width: 1px;
    height: 2.2rem;
    background: linear-gradient(to bottom, var(--green), transparent);
  }
  .td__k {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.62);
  }
  .td__sub {
    font-size: 0.8125rem;
    line-height: 1.45;
    white-space: pre-line;
    color: rgb(255 255 255 / 0.45);
  }

  /* ---------- the part ---------- */

  .td__fig {
    position: relative;
    display: grid;
    place-items: center;
    min-height: clamp(11rem, 26vw, 20rem);
    /* A real camera. Without this the rotations below are flat shears. */
    perspective: 1100px;
    perspective-origin: 50% 50%;
  }

  /* The part is a plane in space, not a picture sliding up the page.
     --t runs 0 -> 1 as the figure crosses the viewport, so the part
     swings through face-on at the halfway point and away again.

     translateZ uses t*(1-t), which peaks at 0.25 when t is 0.5 — so the
     part reaches the viewer exactly when it is square to the camera, and
     recedes at both ends. --dir alternates per stage so consecutive
     parts turn opposite ways.

     --t is never published under reduced motion or with JS off; the
     fallback of 0.5 is the neutral pose, square to the camera. */
  /* Two columns now the numbered rail is gone, and centred on each
     other — the film was floating above a headline that started higher
     than it did. */
  /* A post, not a backdrop. The film is a centred column on a black
     band that runs the full width — so the page keeps the white theme
     above and below it, and the film has something dark to sit on.

     --hd-h is measured and published by the script below, because the
     header's height is set by its own contents and a magic number here
     would drift the first time anything in it changes. */
  .td__intro {
    margin-top: var(--hd-h, 5.4rem);
    padding: clamp(1.5rem, 3.5vw, 3rem) var(--gut, 1.25rem);
    background: #0a0d0e;
    display: grid;
    justify-items: center;
  }

  /* Present to a screen reader and a crawler, absent to the eye. */
  .td__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
  /* .td__fig centres its contents, which is right when the part is a
     render with its own size. The film has none — its width is 100% of
     its parent — so a centred parent shrink-wraps and the whole thing
     collapses to a thumbnail. Stretch it, and the film fills the column. */
  .td__intro .td__fig { justify-items: stretch; }
  /* No swing left to make: --t came from data-travel on the old
     scrolling figures. Unset it defaults to 0.5, which is a standing
     translateZ(130px) against an 1100px perspective — a 1.13x
     magnification that pushed the film out past its own column. */
  .td__intro .td__part { width: 100%; transform: none; }

  /* The film panel. Sized by its own aspect so nothing jumps when the
     poster swaps for the video. */
  .td__film {
    position: relative;
    display: block;
    width: 100%;
    /* LinkedIn's landscape post. The source is 16:9, so this trims a
       little off the top and bottom and leaves the framing — and the
       captions burned into the bottom-left of each shot — alone. A
       square or 4:5 crop would take 44-55% off the SIDES of a 16:9
       film, which is most of every shot. */
    aspect-ratio: 1.91 / 1;
    max-width: 62rem;
    /* The slow zoom below would otherwise spill past the corners. */
    overflow: hidden;
    /* Just enough of a corner to read as a post rather than a hole cut
       in the band. No shadow: there is nothing lighter behind it for a
       shadow to fall on. */
    border-radius: 10px;
    animation: tdFilmIn 800ms var(--ease) both;
  }
  @keyframes tdFilmIn { from { opacity: 0; } }
  /* Arrives, holds, then creeps in — the zoom starts only once it has
     settled, so the two do not fight. */
  .td__film video {
    animation: tdFilmZoom 18s ease-in-out 900ms infinite alternate;
  }
  @keyframes tdFilmZoom { to { transform: scale(1.08); } }
  .td__film video {
    display: block;
    width: 100%;    height: 100%;
    /* Cover, so the trim comes off the edges rather than leaving bars. */
    object-fit: cover;
    /* What shows for the moment before the first frame paints. Black
       was right under a black section; on a light one it flashes as a
       hole. */
    background: var(--off-2);
    /* Nothing to click, so no context menu, no player chrome, no
       "save video as". It reads as part of the page rather than
       something embedded in it. */
    pointer-events: none;
    -webkit-user-select: none;
    user-select: none;
  }
  .td__part {
    position: relative;
    z-index: 1;
    width: 100%;
    transform-style: preserve-3d;
    will-change: transform;
    transform:
      translateZ(calc(var(--t, 0.5) * (1 - var(--t, 0.5)) * 520px))
      rotateY(calc((var(--t, 0.5) - 0.5) * -52deg * var(--dir, 1)))
      rotateX(calc((var(--t, 0.5) - 0.5) * 18deg))
      rotateZ(calc((var(--t, 0.5) - 0.5) * 6deg * var(--dir, 1)));
  }

  .td__part :global(img) {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
    /* Grounds the part instead of letting it float flat. */
    filter: drop-shadow(0 30px 40px rgb(0 0 0 / 0.55));
  }

  /* The green bloom behind the part. This is what carries the look while
     the renders are still missing. */
  .td__glow {
    position: absolute;
    inset: 8% 4%;
    z-index: 0;
    border-radius: 50%;
    background: radial-gradient(
      ellipse at 50% 55%,
      rgb(89 170 84 / 0.26) 0%,
      rgb(89 170 84 / 0.08) 42%,
      transparent 70%
    );
    filter: blur(24px);
    opacity: calc(0.45 + var(--t, 0.5) * (1 - var(--t, 0.5)) * 2.2);
    transform: scale(calc(0.86 + var(--t, 0.5) * (1 - var(--t, 0.5)) * 0.9));
  }

  /* Marked, not broken. Disappears the moment a render lands. */
  .td__slot {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: center;
    gap: 0.4rem;
    width: 100%;
    padding: clamp(2rem, 5vw, 3.5rem) 1rem;
    border: 1px dashed rgb(255 255 255 / 0.18);
    border-radius: 14px;
    text-align: center;
  }
  .td__slot b {
    font-size: 1.6rem;
    font-weight: 700;
    letter-spacing: -0.04em;
    color: rgb(255 255 255 / 0.28);
  }
  .td__slot i {
    font-style: normal;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--green-bright);
  }
  .td__slot em {
    font-style: normal;
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.06em;
    /* 0.32 measured 2.79:1 — under AA. 0.55 is 5.87:1. */
    color: rgb(255 255 255 / 0.55);
  }

  /* ---------- spec column ---------- */

  /* Was 11px mono caps, which is a label. This is the company's name, so
     it is set as one: the display face, title case, and big enough to be
     read rather than scanned. */
  .td__eb {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    font-size: clamp(1rem, 1.5vw, 1.25rem);
    font-weight: 600;
    letter-spacing: -0.015em;
    /* 6.8:1 on white; --green-bright would be 1.9:1. */
    color: var(--green-deep);
  }
  .td__eb::before {
    content: '';
    width: 34px;
    height: 2px;
    border-radius: 2px;
    background: var(--green);
  }

  .td__h1 {
    margin-top: var(--s4);
    /* Tracks the copy column, not the viewport: the film took most of
       the row, so a vw-scaled headline overflowed what was left. */
    font-size: clamp(1.9rem, 3.4vw, 3rem);
    line-height: 1.06;
    letter-spacing: -0.042em;
    font-weight: 700;
  }
  .td__h1 em { font-style: normal; color: var(--green-deep); white-space: nowrap; }

  .td__lead {
    margin-top: var(--s4);
    max-width: 34ch;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--text-2);
  }


  .td__ic {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    color: var(--green-bright);
  }

  .td__h {
    margin-top: 0.4rem;
    font-size: clamp(1.15rem, 2.2vw, 1.5rem);
    font-weight: 700;
    letter-spacing: -0.03em;
  }
  .td__p {
    margin-top: 0.45rem;
    max-width: 34ch;
    font-size: 0.875rem;
    line-height: 1.6;
    color: rgb(255 255 255 / 0.66);
  }

  .td__specs { display: grid; gap: 0.5rem; margin-top: var(--s4); }
  .td__specs li {
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: rgb(255 255 255 / 0.8);
  }
  .td__specs :global(svg) { flex: none; margin-top: 3px; color: var(--green-bright); }

  /* ---------- handwritten aside ---------- */

  .td__script {
    position: absolute;
    right: clamp(1rem, 3vw, 3rem);
    top: 32%;
    max-width: 10rem;
    font-family: var(--font-serif, Georgia, serif);
    font-style: italic;
    font-size: clamp(1rem, 1.7vw, 1.35rem);
    line-height: 1.3;
    color: rgb(255 255 255 / 0.5);
    rotate: -8deg;
    pointer-events: none;
    display: none;
  }

  /* ---------- closing ---------- */

  /* ---------- responsive ---------- */

  @media (min-width: 62rem) {
    .td__grid {
      /* The film was leaving a column of empty green to the right of the
         copy. More of the row goes to the picture. */
      /* The film carries the opening; the copy beside it is three short
         lines. It takes as much of the row as the words will leave. */
      /* Not narrower than this: "just a laptop" breaks to three lines
         below roughly 17rem of copy column, and the em lands alone. */
      grid-template-columns: minmax(0, 2.3fr) minmax(0, 0.74fr);
      gap: clamp(1.25rem, 2.5vw, 2.25rem);
    }
    .td__script { display: block; }
  }

  @media (prefers-reduced-motion: reduce) {
    /* It only ever plays on a click, so it is already safe here; the
       hover scale is the only thing to drop. */
    .td__film, .td__film video { animation: none; }
    /* Square to the camera, no motion. --t is never set, so this only
       needs to drop the will-change hint. */
    .td__part { will-change: auto; }
  }
</style>

<script is:inline>
  (() => {
    const setup = () => {
      /* The header is fixed and sized by its own contents, so the film
         cannot know how much of the viewport is left to it without
         asking. Measured here and republished on resize. */
      const head = document.querySelector('header');
      const measure = () => {
        if (!head) return;
        document.documentElement.style.setProperty(
          '--hd-h',
          head.getBoundingClientRect().height + 'px'
        );
      };
      measure();
      if (head && 'ResizeObserver' in window) new ResizeObserver(measure).observe(head);
      window.addEventListener('resize', measure, { passive: true });

      const box = document.querySelector('[data-film]');
      if (!box || box.dataset.wired) return;
      box.dataset.wired = '1';

      const v = box.querySelector('video');

      /* It runs by itself and it keeps running. Muted autoplay is
         allowed everywhere, but a data-saving mode or a per-site
         setting can still refuse it — and there is no Watch button to
         fall back on any more, by design. So instead of asking, we
         retry quietly on the first thing the visitor does. */
      const nudge = () => v.play().catch(() => {});
      nudge();

      const armed = ['pointerdown', 'touchstart', 'keydown', 'scroll'];
      const once = () => {
        nudge();
        armed.forEach((t) => window.removeEventListener(t, once));
      };
      if (v.paused) armed.forEach((t) => window.addEventListener(t, once, { passive: true }));

      /* Decoding a film nobody is looking at costs battery for nothing,
         so it rests off screen — and picks straight back up, from where
         it left off, the moment it returns. */
      new IntersectionObserver(([e]) => {
        if (e.isIntersecting) nudge();
        else v.pause();
      }, { threshold: 0.15 }).observe(box);

      /* A tab restored from the back/forward cache comes back paused. */
      document.addEventListener('visibilitychange', () => {
        if (!document.hidden) nudge();
      });
    };

    document.addEventListener('astro:page-load', setup);
    window.addEventListener('load', setup);
  })();
</script>
