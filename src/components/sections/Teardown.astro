---
import { site, whatsappLink } from '@data/site';
/**
 * THE OPENING — the film, full width, ending in a wave.
 *
 * At the client's instruction the film is no longer a card beside the
 * headline: it runs edge to edge and its lower edge is a moving wave, so
 * it reads as part of the page rather than a video pasted into a box.
 * The film is shown whole (16:9, never cropped) because its own captions
 * sit near the left and bottom edges.
 *
 * The wave is a CSS mask on the film. It is shallow on the left, where
 * the film's "Get Support" button sits, and deep on the right.
 * A second, green-tinted wave trails just under it.
 * The brand strip's own top wave is switched off below this hero, since
 * the film now makes that boundary itself.
 */
---
<section class="td td--full" data-tone="light">
  <h1 class="td__sr">{site.nameFull}: more than just a laptop. Complete technology solutions to power your work, study and business.</h1>
  <div class="td__hero">
    {/*
      No controls and nothing to click. pointer-events are off the video,
      so there is no context menu; controlsList and
      disablePictureInPicture remove the browser's own download and
      pop-out affordances. That makes saving it inconvenient, not
      impossible: anything served to a browser can be saved.
    */}
    <div class="td__media" data-film>
      <video src="/film/danat-it-support.mp4" poster="/film/danat-it-support.jpg"
        autoplay muted loop playsinline preload="auto"
        controlslist="nodownload noplaybackrate noremoteplayback"
        disablepictureinpicture disableremoteplayback
        aria-label="Danat Computers IT support: hardware scans, chip-level repair, testing, upgrades and printers"></video>
    </div>
    {/* The film ends on its own "Get Support" button. This invisible link
        sits exactly over it and only becomes clickable while that button
        is on screen (about 12.4 s to 15.1 s of each loop). The numbers are
        measured from the film; re-measure if the film is re-cut. */}
    <a class="td__hot" href={whatsappLink()} data-support-open target="_blank" rel="noopener noreferrer"
      data-hot aria-label="Get Support" tabindex="-1"></a>
    {/* The same two-layer wave the brand strip used, turned over so the
        film sits above it: pale green band, then white. It swells slowly,
        exactly like the original. */}
    <div class="td__wave" aria-hidden="true">
      <svg viewBox="0 0 1440 130" preserveAspectRatio="none">
        <path class="td__wave-b" d="M0,38 C106,6 214,42 336,76 C524,130 712,80 908,38 C1104,-4 1276,116 1440,14 L1440,134 L0,134 Z"></path>
        <path class="td__wave-f" d="M0,58 C118,22 248,64 380,98 C570,146 760,100 950,52 C1140,4 1300,132 1440,34 L1440,134 L0,134 Z"></path>
      </svg>
    </div>
  </div>
</section>

<style>
  .td {
    position: relative;
    background: var(--white);
    /* Clears the fixed header; the script replaces this with its real
       height. */
    padding-top: var(--hdr, 5.5rem);
  }
  .td__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  /* Full width and the whole 16:9 frame, never cropped: the film's own
     captions and its Get Support button sit near the edges. */
  .td__hero {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--ink);
  }
  .td__media { position: absolute; inset: 0; }
  .td__media video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
    -webkit-user-select: none;
    user-select: none;
  }
  .td__hot {
    position: absolute;
    z-index: 3;
    left: 7.4%;
    top: 69.9%;
    width: 20.4%;
    height: 9.8%;
    border-radius: 999px;
    pointer-events: none;
    transition: box-shadow var(--t1) var(--ease);
  }
  .td__hot.is-live { pointer-events: auto; cursor: pointer; }
  .td__hot.is-live:hover,
  .td__hot.is-live:focus-visible {
    box-shadow: 0 0 0 3px rgb(255 255 255 / 0.85), 0 0 34px rgb(89 170 84 / 0.7);
    outline: none;
  }
  .td__wave {
    position: absolute;
    /* wider than the frame so the swell never uncovers an edge */
    left: -4%;
    right: -4%;
    bottom: -1px;
    height: clamp(44px, 6vw, 110px);
    z-index: 2;
    pointer-events: none;
  }
  .td__wave svg { display: block; width: 100%; height: 100%; }
  .td__wave-b {
    transform-origin: center bottom;
    fill: color-mix(in oklab, var(--white) 88%, var(--green));
    animation: td-swell-b 13s ease-in-out infinite alternate;
  }
  .td__wave-f {
    transform-origin: center bottom;
    fill: var(--white);
    animation: td-swell-f 9s ease-in-out infinite alternate;
  }
  @keyframes td-swell-b {
    from { transform: translate3d(-1.5%, -2px, 0) scaleY(1); }
    to   { transform: translate3d(1.5%, 3px, 0) scaleY(1.06); }
  }
  @keyframes td-swell-f {
    from { transform: translate3d(1.2%, 2px, 0) scaleY(1.04); }
    to   { transform: translate3d(-1.2%, -3px, 0) scaleY(1); }
  }

  /* The film now draws the boundary into the brand strip. */
  :global(body:has(.td--full) .bs__wave) { display: none; }
  :global(body:has(.td--full) .bs) { padding-top: clamp(2.5rem, 5vw, 4rem); }

  @media (prefers-reduced-motion: reduce) {
    .td__wave-b, .td__wave-f { animation: none; }
  }
</style>

<script is:inline>
  (() => {
    const setup = () => {
      const header = document.querySelector('header');
      const fit = () => header && document.documentElement.style.setProperty('--hdr', `${header.offsetHeight}px`);
      fit();
      addEventListener('resize', fit, { passive: true });

      const box = document.querySelector('[data-film]');
      if (!box || box.dataset.wired) return;
      box.dataset.wired = '1';
      const v = box.querySelector('video');

      /* It starts itself and loops. Muted autoplay is allowed everywhere,
         but a data-saving mode can still refuse it, so retry quietly on
         the visitor's first interaction. */
      const nudge = () => v.play().catch(() => {});
      nudge();
      const armed = ['pointerdown', 'touchstart', 'keydown', 'scroll'];
      const once = () => { nudge(); armed.forEach((t) => removeEventListener(t, once)); };
      if (v.paused) armed.forEach((t) => addEventListener(t, once, { passive: true }));

      /* Make the film's own Get Support button clickable while it shows. */
      const hot = document.querySelector('[data-hot]');
      if (hot) {
        const sync = () => {
          const live = v.currentTime >= 12.4 && v.currentTime <= 15.1;
          hot.classList.toggle('is-live', live);
          hot.tabIndex = live ? 0 : -1;
        };
        v.addEventListener('timeupdate', sync);
        v.addEventListener('seeked', sync);
      }

      /* Rest off screen, pick straight back up on return. */
      new IntersectionObserver(([e]) => (e.isIntersecting ? nudge() : v.pause()), { threshold: 0.15 }).observe(box);
      document.addEventListener('visibilitychange', () => { if (!document.hidden) nudge(); });
    };
    document.addEventListener('astro:page-load', setup);
    addEventListener('load', setup);
  })();
</script>
