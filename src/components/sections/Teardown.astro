---
import Icon from '@components/ui/Icon.astro';
import { site } from '@data/site';

/**
 * THE OPENING — the film, the headline, and nothing else.
 *
 * This was six scrolling bands, then one turning panel. Both are gone at
 * the client's instruction: the film carries the message on its own and
 * the parts below it were repeating what it already shows.
 *
 * The renders in src/assets/renders/ are untouched and still on disk, so
 * the sequence can come back from git without re-sourcing artwork.
 */
---

<section class="td" data-tone="ink">
  {/* ── the opening: this stays a block of its own ── */}
  <div class="shell td__grid td__intro">
    <figure class="td__fig">
      <span class="td__glow" aria-hidden="true"></span>
      <div class="td__part">
        {/* Plays on a click, never on its own. */}
        <div class="td__film" data-film>
          <video src="/film/ecosystem.mp4" poster="/film/ecosystem.jpg"
            autoplay muted loop playsinline preload="auto"
            aria-label="Danat: printers, laptops, accessories, tools and servers"></video>
          {/* Only a fallback now. Muted autoplay is allowed everywhere,
              but a browser or a data-saving setting can still refuse it,
              and a still frame with no way to start it is a dead end. */}
          <button type="button" data-film-play aria-label="Play the film">
            <Icon name="play" size={18} />
            <span>Watch</span>
          </button>
        </div>
      </div>
    </figure>

    <div class="td__body">
      <p class="td__eb" data-rise>{site.nameFull}</p>
      <h2 class="td__h1" data-rise style="--d:80ms">
        More than<br />just <em>a laptop</em>
      </h2>
      <p class="td__lead" data-rise style="--d:150ms">
        Complete technology solutions to power your work, study and business.
      </p>
    </div>

    <p class="td__script" aria-hidden="true">
      Technology<br />for a Brighter<br />Tomorrow.
    </p>
  </div>

</section>

<style>
  .td {
    position: relative;
    background: #07090a;
    color: #fff;
    overflow: hidden;
  }

  /* Each part gets its own band; the rules between them are what makes
     it read as a sequence rather than one long picture. */




  /* Shown only while the sequence is driving itself. */
  .td::after {
    content: 'Playing — scroll to take over';
    position: fixed;
    left: 50%;
    bottom: 1.25rem;
    z-index: 40;
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    border: 1px solid rgb(255 255 255 / 0.18);
    background: rgb(7 9 10 / 0.82);
    backdrop-filter: blur(8px);
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.72);
    translate: -50% 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--t2) var(--ease);
  }
  :global(html[data-td-playing]) .td::after { opacity: 1; }

  .td__grid {
    display: grid;
    gap: clamp(1.25rem, 3vw, 2.5rem);
    align-items: center;
  }

  /* ---------- rail ---------- */

  .td__rail {
    display: grid;
    justify-items: start;
    gap: 0.5rem;
  }
  .td__n {
    font-size: 0.9375rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: rgb(255 255 255 / 0.85);
  }
  .td__line {
    width: 1px;
    height: 2.2rem;
    background: linear-gradient(to bottom, var(--green), transparent);
  }
  .td__k {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.62);
  }
  .td__sub {
    font-size: 0.8125rem;
    line-height: 1.45;
    white-space: pre-line;
    color: rgb(255 255 255 / 0.45);
  }

  /* ---------- the part ---------- */

  .td__fig {
    position: relative;
    display: grid;
    place-items: center;
    min-height: clamp(11rem, 26vw, 20rem);
    /* A real camera. Without this the rotations below are flat shears. */
    perspective: 1100px;
    perspective-origin: 50% 50%;
  }

  /* The part is a plane in space, not a picture sliding up the page.
     --t runs 0 -> 1 as the figure crosses the viewport, so the part
     swings through face-on at the halfway point and away again.

     translateZ uses t*(1-t), which peaks at 0.25 when t is 0.5 — so the
     part reaches the viewer exactly when it is square to the camera, and
     recedes at both ends. --dir alternates per stage so consecutive
     parts turn opposite ways.

     --t is never published under reduced motion or with JS off; the
     fallback of 0.5 is the neutral pose, square to the camera. */
  /* Two columns now the numbered rail is gone, and centred on each
     other — the film was floating above a headline that started higher
     than it did. */
  .td__intro {
    padding-block: clamp(4.5rem, 8vw, 6.5rem) clamp(3rem, 6vw, 4.5rem);
    align-items: center;
  }
  /* .td__fig centres its contents, which is right when the part is a
     render with its own size. The film has none — its width is 100% of
     its parent — so a centred parent shrink-wraps and the whole thing
     collapses to a thumbnail. Stretch it, and the film fills the column. */
  .td__intro .td__fig { justify-items: stretch; }
  /* No swing left to make: --t came from data-travel on the old
     scrolling figures. Unset it defaults to 0.5, which is a standing
     translateZ(130px) against an 1100px perspective — a 1.13x
     magnification that pushed the film out past its own column. */
  .td__intro .td__part { width: 100%; transform: none; }

  /* The film panel. Sized by its own aspect so nothing jumps when the
     poster swaps for the video. */
  .td__film {
    position: relative;
    display: block;
    /* The slow zoom below would otherwise spill past the corners. */
    overflow: hidden;
    /* Not a rectangle, but the arch took a third of the picture with it.
       This cuts two opposite corners deeply and leaves the other two
       tight — the shape reads as deliberate while the subject, which
       sits across the middle, is untouched. */
    border-radius: 78px 14px 78px 14px;
    /* A framed panel rather than a bare rectangle: a hairline ring on the
       inside so the zoom cannot slide out from under it, a green cast in
       the near shadow, and a deep one to lift it off the section. */
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.14),
      0 0 0 1px rgb(111 201 106 / 0.16),
      0 24px 50px -24px rgb(111 201 106 / 0.28),
      0 50px 90px -40px rgb(0 0 0 / 0.85);
    animation: tdFilmIn 800ms var(--ease) both;
  }
  @keyframes tdFilmIn { from { opacity: 0; } }
  /* Arrives, holds, then creeps in — the zoom starts only once it has
     settled, so the two do not fight. */
  .td__film video {
    animation: tdFilmZoom 18s ease-in-out 900ms infinite alternate;
  }
  @keyframes tdFilmZoom { to { transform: scale(1.08); } }
  /* The header floats over this frame, and the film's top band carries
     near-white neon: white nav text measured 1.03:1 against it. The
     scrim below takes the worst pixel well clear of AA. */
  .td__film::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 60%;
    z-index: 1;
    border-radius: 14px 14px 0 0;
    /* Held near full strength across the band the nav actually occupies
       — a straight fade was down to 0.52 by then and left white text at
       3.48:1. Holding to 22% keeps the worst pixel above 12:1. */
    background: linear-gradient(
      180deg,
      rgb(7 9 10 / 0.86) 0%,
      rgb(7 9 10 / 0.82) 22%,
      rgb(7 9 10 / 0) 100%
    );
    pointer-events: none;
  }
  .td__film button { z-index: 2; }
  .td__film video {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 14px;
    background: #07090a;
  }
  .td__film button {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.85rem 1.4rem;
    border: 0;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.94);
    color: #07090a;
    font: inherit;
    font-size: 0.875rem;
    font-weight: 700;
    cursor: pointer;
    backdrop-filter: blur(8px);
    box-shadow: 0 18px 40px -18px rgb(0 0 0 / 0.7);
    transition: transform var(--t2) var(--ease), opacity 260ms var(--ease);
  }
  .td__film button:hover { transform: translate(-50%, -50%) scale(1.05); }
  .td__film button:focus-visible { outline: 2px solid var(--green-bright); outline-offset: 3px; }
  .td__film[data-playing] button { opacity: 0; pointer-events: none; }
  /* Hidden the moment playback is under way, however it started. */
  .td__film[data-auto] button { opacity: 0; pointer-events: none; }

  .td__part {
    position: relative;
    z-index: 1;
    width: 100%;
    transform-style: preserve-3d;
    will-change: transform;
    transform:
      translateZ(calc(var(--t, 0.5) * (1 - var(--t, 0.5)) * 520px))
      rotateY(calc((var(--t, 0.5) - 0.5) * -52deg * var(--dir, 1)))
      rotateX(calc((var(--t, 0.5) - 0.5) * 18deg))
      rotateZ(calc((var(--t, 0.5) - 0.5) * 6deg * var(--dir, 1)));
  }

  .td__part :global(img) {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
    /* Grounds the part instead of letting it float flat. */
    filter: drop-shadow(0 30px 40px rgb(0 0 0 / 0.55));
  }

  /* The green bloom behind the part. This is what carries the look while
     the renders are still missing. */
  .td__glow {
    position: absolute;
    inset: 8% 4%;
    z-index: 0;
    border-radius: 50%;
    background: radial-gradient(
      ellipse at 50% 55%,
      rgb(89 170 84 / 0.26) 0%,
      rgb(89 170 84 / 0.08) 42%,
      transparent 70%
    );
    filter: blur(24px);
    opacity: calc(0.45 + var(--t, 0.5) * (1 - var(--t, 0.5)) * 2.2);
    transform: scale(calc(0.86 + var(--t, 0.5) * (1 - var(--t, 0.5)) * 0.9));
  }

  /* Marked, not broken. Disappears the moment a render lands. */
  .td__slot {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: center;
    gap: 0.4rem;
    width: 100%;
    padding: clamp(2rem, 5vw, 3.5rem) 1rem;
    border: 1px dashed rgb(255 255 255 / 0.18);
    border-radius: 14px;
    text-align: center;
  }
  .td__slot b {
    font-size: 1.6rem;
    font-weight: 700;
    letter-spacing: -0.04em;
    color: rgb(255 255 255 / 0.28);
  }
  .td__slot i {
    font-style: normal;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--green-bright);
  }
  .td__slot em {
    font-style: normal;
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.06em;
    /* 0.32 measured 2.79:1 — under AA. 0.55 is 5.87:1. */
    color: rgb(255 255 255 / 0.55);
  }

  /* ---------- spec column ---------- */

  .td__eb {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--green-bright);
  }

  .td__h1 {
    margin-top: var(--s4);
    font-size: clamp(2.1rem, 4.6vw, 3.4rem);
    line-height: 1.04;
    letter-spacing: -0.042em;
    font-weight: 700;
  }
  .td__h1 em { font-style: normal; color: var(--green-bright); }

  .td__lead {
    margin-top: var(--s4);
    max-width: 34ch;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: rgb(255 255 255 / 0.74);
  }


  .td__ic {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    color: var(--green-bright);
  }

  .td__h {
    margin-top: 0.4rem;
    font-size: clamp(1.15rem, 2.2vw, 1.5rem);
    font-weight: 700;
    letter-spacing: -0.03em;
  }
  .td__p {
    margin-top: 0.45rem;
    max-width: 34ch;
    font-size: 0.875rem;
    line-height: 1.6;
    color: rgb(255 255 255 / 0.66);
  }

  .td__specs { display: grid; gap: 0.5rem; margin-top: var(--s4); }
  .td__specs li {
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: rgb(255 255 255 / 0.8);
  }
  .td__specs :global(svg) { flex: none; margin-top: 3px; color: var(--green-bright); }

  /* ---------- handwritten aside ---------- */

  .td__script {
    position: absolute;
    right: clamp(1rem, 3vw, 3rem);
    top: 32%;
    max-width: 10rem;
    font-family: var(--font-serif, Georgia, serif);
    font-style: italic;
    font-size: clamp(1rem, 1.7vw, 1.35rem);
    line-height: 1.3;
    color: rgb(255 255 255 / 0.5);
    rotate: -8deg;
    pointer-events: none;
    display: none;
  }

  /* ---------- closing ---------- */

  /* ---------- responsive ---------- */

  @media (min-width: 62rem) {
    .td__grid {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.85fr);
      gap: clamp(2rem, 4vw, 3.5rem);
    }
    .td__script { display: block; }
  }

  @media (prefers-reduced-motion: reduce) {
    /* It only ever plays on a click, so it is already safe here; the
       hover scale is the only thing to drop. */
    .td__film button:hover { transform: translate(-50%, -50%); }
    .td__film, .td__film video { animation: none; }
    /* Square to the camera, no motion. --t is never set, so this only
       needs to drop the will-change hint. */
    .td__part { will-change: auto; }
  }
</style>

<script is:inline>
  (() => {
    const setup = () => {
      const box = document.querySelector('[data-film]');
      if (!box || box.dataset.wired) return;
      box.dataset.wired = '1';

      const v = box.querySelector('video');
      const btn = box.querySelector('[data-film-play]');

      /* If autoplay is allowed the button never needs to appear. */
      if (!v.paused) box.setAttribute('data-auto', '');
      v.addEventListener('playing', () => box.setAttribute('data-auto', ''));

      btn.addEventListener('click', () => {
        box.setAttribute('data-playing', '');
        v.play().catch(() => box.removeAttribute('data-playing'));
      });

      /* Scrolled away mid-play is decode work for nobody. It resumes only
         if it was already playing — it never starts itself. */
      new IntersectionObserver(([e]) => {
        if (!box.hasAttribute('data-playing') && !box.hasAttribute('data-auto')) return;
        if (e.isIntersecting) v.play().catch(() => {});
        else v.pause();
      }, { threshold: 0.2 }).observe(box);
    };

    document.addEventListener('astro:page-load', setup);
    window.addEventListener('load', setup);
  })();
</script>
