---
/**
 * PROTOTYPE — a real 3D scene, not a video.
 *
 * Live WebGL: the geometry is built in code and rendered every frame,
 * so it responds to the pointer and to scroll. Nothing here is footage.
 *
 * It is deliberately PROCEDURAL — every shape is made from primitives.
 * That means it costs nothing to look at and needs no purchased model,
 * which is the point of a prototype. A shipping version would load a
 * real GLB of the product; see the notes at the foot of the page.
 *
 * ⚠ This page is the only thing in the project that imports three. It
 * is not mounted on the homepage and nothing else depends on it, so
 * deleting this file and `npm uninstall three` reverses it completely.
 */
---

<section class="lb">
  <div class="lb__stage">
    <canvas data-lab3d></canvas>

    <noscript>
      <p class="lb__fallback">This demonstration needs JavaScript.</p>
    </noscript>

    <p class="lb__hint" data-lab-hint>
      <span>Drag to turn</span>
      <span>Wheel to zoom</span>
      <span>Scroll to explode</span>
    </p>

    {/* The verdict on whatever model is loaded. Empty until there is
        one, so an untested page says nothing rather than "0 parts". */}
    <div class="lb__out" data-lab-out hidden></div>

    <p class="lb__drop" aria-hidden="true">Drop a .glb here to test it</p>

    {/* Named on hover, once the machine is open enough for the parts to
        be distinguishable. */}
    <div class="lb__tip" data-lab-tip hidden>
      <b></b>
      <i></i>
    </div>

    {/* Shown instead of the canvas where WebGL is unavailable or the
        visitor has asked for reduced motion. */}
    <p class="lb__off" data-lab-off hidden>
      3D is switched off here — either this browser has no WebGL or the
      system is set to reduce motion.
    </p>
  </div>
</section>

<style>
  .lb {
    position: relative;
    background: radial-gradient(120% 90% at 50% 0%, #ffffff 0%, #f2f6f3 60%, #e9f1eb 100%);
  }

  .lb__stage {
    position: relative;
    height: min(78svh, 46rem);
    min-height: 24rem;
  }

  .lb__stage canvas {
    display: block;
    width: 100%;
    height: 100%;
    /* The scene is dragged, so the browser must not also pan the page
       under the finger on a touch screen. */
    touch-action: pan-y;
    cursor: grab;
  }
  .lb__stage canvas:active { cursor: grabbing; }

  .lb__hint {
    position: absolute;
    left: 50%;
    bottom: 1.5rem;
    translate: -50% 0;
    display: flex;
    gap: 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-3);
    pointer-events: none;
    transition: opacity 400ms var(--ease);
  }
  .lb__hint span { display: flex; align-items: center; gap: 0.5rem; }
  .lb__hint span + span::before {
    content: '';
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--green);
  }
  /* Once they have worked out that it moves, stop telling them. */
  .lb__hint[data-used] { opacity: 0; }

  /* The drop target and its verdict. */
  .lb__drop {
    position: absolute;
    left: 50%;
    top: 1.25rem;
    translate: -50% 0;
    padding: 0.4rem 0.9rem;
    border: 1px dashed var(--line-light);
    border-radius: 999px;
    background: rgb(255 255 255 / 0.8);
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-3);
    pointer-events: none;
    transition: border-color var(--t2) var(--ease), color var(--t2) var(--ease);
  }
  .lb__stage[data-over] .lb__drop { border-color: var(--green); color: var(--green-deep); }
  .lb__stage[data-over]::after {
    content: '';
    position: absolute;
    inset: 0.75rem;
    border: 2px dashed var(--green);
    border-radius: 18px;
    pointer-events: none;
  }

  .lb__tip {
    position: absolute;
    left: var(--x, 50%);
    top: var(--y, 50%);
    z-index: 4;
    translate: 14px -50%;
    max-width: 17rem;
    padding: 0.65rem 0.85rem 0.75rem;
    border-radius: 12px;
    border: 1px solid var(--line-light);
    background: rgb(255 255 255 / 0.94);
    backdrop-filter: blur(10px);
    box-shadow: 0 14px 30px -18px rgb(10 30 12 / 0.5);
    pointer-events: none;
  }
  .lb__tip b { display: block; font-size: 0.9375rem; font-weight: 700; color: var(--green-deep); }
  .lb__tip i {
    display: block;
    margin-top: 0.2rem;
    font-style: normal;
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--text-2);
  }

  .lb__out {
    position: absolute;
    left: 1rem;
    bottom: 1rem;
    z-index: 3;
    max-width: min(34rem, calc(100% - 2rem));
    /* Tall enough to screenshot in one go, capped so it cannot cover
       the model it is describing. */
    max-height: min(22rem, 60%);
    overflow-y: auto;
    padding: 0.9rem 1rem 1rem;
    border-radius: 14px;
    border: 1px solid var(--line-light);
    background: rgb(255 255 255 / 0.9);
    backdrop-filter: blur(12px);
  }
  .lb__v { font-size: 0.9375rem; font-weight: 700; letter-spacing: -0.01em; }
  /* Green for a model worth using, amber for thin, red for one that
     cannot come apart — the whole point of the page in one line. */
  .lb__out[data-verdict='good'] .lb__v { color: var(--green-deep); }
  .lb__out[data-verdict='thin'] .lb__v { color: #8a6100; }
  .lb__out[data-verdict='bad'] .lb__v { color: #a3271f; }
  .lb__f {
    margin-top: 0.15rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    color: var(--text-3);
    overflow-wrap: anywhere;
  }
  .lb__l {
    margin-top: 0.55rem;
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--text-2);
    overflow-wrap: anywhere;
  }

  .lb__off,
  .lb__fallback {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    padding: var(--s6);
    max-width: 30ch;
    margin-inline: auto;
    text-align: center;
    font-size: var(--small);
    line-height: 1.6;
    color: var(--text-2);
  }
</style>

<script>
  /* The scene itself now lives in scripts/laptopScene.ts, shared with
     the production section, so the two cannot drift. What is left here
     is the lab's own furniture: the drop target and the verdict panel.

     Bundled module scripts evaluate once. ClientRouter replaces the
     body on every client-side navigation, so this has to run again
     after each swap or the canvas arrives dead. */
  import { mountLaptop } from '@scripts/laptopScene';

  function boot() {
    const canvas = document.querySelector<HTMLCanvasElement>('[data-lab3d]');
    if (!canvas) return;
    const stage = canvas.parentElement as HTMLElement;
    mountLaptop({
      canvas,
      track: stage,
      off: document.querySelector('[data-lab-off]'),
      hint: document.querySelector('[data-lab-hint]'),
      out: document.querySelector('[data-lab-out]'),
      tip: document.querySelector('[data-lab-tip]'),
      allowDrop: true,
    });
  }

  boot();
  document.addEventListener('astro:page-load', boot);
</script>
