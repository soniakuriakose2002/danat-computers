---
/**
 * PROTOTYPE — a real 3D scene, not a video.
 *
 * Live WebGL: the geometry is built in code and rendered every frame,
 * so it responds to the pointer and to scroll. Nothing here is footage.
 *
 * It is deliberately PROCEDURAL — every shape is made from primitives.
 * That means it costs nothing to look at and needs no purchased model,
 * which is the point of a prototype. A shipping version would load a
 * real GLB of the product; see the notes at the foot of the page.
 *
 * ⚠ This page is the only thing in the project that imports three. It
 * is not mounted on the homepage and nothing else depends on it, so
 * deleting this file and `npm uninstall three` reverses it completely.
 */
---

<section class="lb">
  <div class="lb__stage">
    <canvas data-lab3d></canvas>

    <noscript>
      <p class="lb__fallback">This demonstration needs JavaScript.</p>
    </noscript>

    <p class="lb__hint" data-lab-hint>
      <span>Drag to turn</span>
      <span>Wheel to zoom</span>
      <span>Scroll to explode</span>
    </p>

    {/* The verdict on whatever model is loaded. Empty until there is
        one, so an untested page says nothing rather than "0 parts". */}
    <div class="lb__out" data-lab-out hidden></div>

    <p class="lb__drop" aria-hidden="true">Drop a .glb here to test it</p>

    {/* Named on hover, once the machine is open enough for the parts to
        be distinguishable. */}
    <div class="lb__tip" data-lab-tip hidden>
      <b></b>
      <i></i>
    </div>

    {/* Shown instead of the canvas where WebGL is unavailable or the
        visitor has asked for reduced motion. */}
    <p class="lb__off" data-lab-off hidden>
      3D is switched off here — either this browser has no WebGL or the
      system is set to reduce motion.
    </p>
  </div>
</section>

<style>
  .lb {
    position: relative;
    background: radial-gradient(120% 90% at 50% 0%, #ffffff 0%, #f2f6f3 60%, #e9f1eb 100%);
  }

  .lb__stage {
    position: relative;
    height: min(78svh, 46rem);
    min-height: 24rem;
  }

  .lb__stage canvas {
    display: block;
    width: 100%;
    height: 100%;
    /* The scene is dragged, so the browser must not also pan the page
       under the finger on a touch screen. */
    touch-action: pan-y;
    cursor: grab;
  }
  .lb__stage canvas:active { cursor: grabbing; }

  .lb__hint {
    position: absolute;
    left: 50%;
    bottom: 1.5rem;
    translate: -50% 0;
    display: flex;
    gap: 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-3);
    pointer-events: none;
    transition: opacity 400ms var(--ease);
  }
  .lb__hint span { display: flex; align-items: center; gap: 0.5rem; }
  .lb__hint span + span::before {
    content: '';
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--green);
  }
  /* Once they have worked out that it moves, stop telling them. */
  .lb__hint[data-used] { opacity: 0; }

  /* The drop target and its verdict. */
  .lb__drop {
    position: absolute;
    left: 50%;
    top: 1.25rem;
    translate: -50% 0;
    padding: 0.4rem 0.9rem;
    border: 1px dashed var(--line-light);
    border-radius: 999px;
    background: rgb(255 255 255 / 0.8);
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-3);
    pointer-events: none;
    transition: border-color var(--t2) var(--ease), color var(--t2) var(--ease);
  }
  .lb__stage[data-over] .lb__drop { border-color: var(--green); color: var(--green-deep); }
  .lb__stage[data-over]::after {
    content: '';
    position: absolute;
    inset: 0.75rem;
    border: 2px dashed var(--green);
    border-radius: 18px;
    pointer-events: none;
  }

  .lb__tip {
    position: absolute;
    left: var(--x, 50%);
    top: var(--y, 50%);
    z-index: 4;
    translate: 14px -50%;
    max-width: 17rem;
    padding: 0.65rem 0.85rem 0.75rem;
    border-radius: 12px;
    border: 1px solid var(--line-light);
    background: rgb(255 255 255 / 0.94);
    backdrop-filter: blur(10px);
    box-shadow: 0 14px 30px -18px rgb(10 30 12 / 0.5);
    pointer-events: none;
  }
  .lb__tip b { display: block; font-size: 0.9375rem; font-weight: 700; color: var(--green-deep); }
  .lb__tip i {
    display: block;
    margin-top: 0.2rem;
    font-style: normal;
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--text-2);
  }

  .lb__out {
    position: absolute;
    left: 1rem;
    bottom: 1rem;
    z-index: 3;
    max-width: min(34rem, calc(100% - 2rem));
    /* Tall enough to screenshot in one go, capped so it cannot cover
       the model it is describing. */
    max-height: min(22rem, 60%);
    overflow-y: auto;
    padding: 0.9rem 1rem 1rem;
    border-radius: 14px;
    border: 1px solid var(--line-light);
    background: rgb(255 255 255 / 0.9);
    backdrop-filter: blur(12px);
  }
  .lb__v { font-size: 0.9375rem; font-weight: 700; letter-spacing: -0.01em; }
  /* Green for a model worth using, amber for thin, red for one that
     cannot come apart — the whole point of the page in one line. */
  .lb__out[data-verdict='good'] .lb__v { color: var(--green-deep); }
  .lb__out[data-verdict='thin'] .lb__v { color: #8a6100; }
  .lb__out[data-verdict='bad'] .lb__v { color: #a3271f; }
  .lb__f {
    margin-top: 0.15rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    color: var(--text-3);
    overflow-wrap: anywhere;
  }
  .lb__l {
    margin-top: 0.55rem;
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--text-2);
    overflow-wrap: anywhere;
  }

  .lb__off,
  .lb__fallback {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    padding: var(--s6);
    max-width: 30ch;
    margin-inline: auto;
    text-align: center;
    font-size: var(--small);
    line-height: 1.6;
    color: var(--text-2);
  }
</style>

<script>
  import * as THREE from 'three';
  import { RoundedBoxGeometry } from 'three/examples/jsm/geometries/RoundedBoxGeometry.js';
  import { RoomEnvironment } from 'three/examples/jsm/environments/RoomEnvironment.js';
  import { GLTFLoader } from 'three/examples/jsm/loaders/GLTFLoader.js';
  import { DRACOLoader } from 'three/examples/jsm/loaders/DRACOLoader.js';
  import { MeshoptDecoder } from 'three/examples/jsm/libs/meshopt_decoder.module.js';
  import { OrbitControls } from 'three/examples/jsm/controls/OrbitControls.js';

  const GREEN = 0x59aa54;

  function boot() {
    const canvas = document.querySelector<HTMLCanvasElement>('[data-lab3d]');
    if (!canvas || canvas.dataset.wired) return;

    const off = document.querySelector<HTMLElement>('[data-lab-off]');
    const hint = document.querySelector<HTMLElement>('[data-lab-hint]');
    const out = document.querySelector<HTMLElement>('[data-lab-out]');
    const tip = document.querySelector<HTMLElement>('[data-lab-tip]');
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

    /* Neither of these is a failure worth a broken page: say so and
       leave the section as a quiet panel. */
    let renderer: THREE.WebGLRenderer;
    try {
      renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
    } catch {
      canvas.hidden = true;
      if (off) off.hidden = false;
      return;
    }
    if (reduced) {
      // Still render — once, held still. The object is the content.
    }
    canvas.dataset.wired = '1';

    renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
    renderer.shadowMap.enabled = true;
    renderer.shadowMap.type = THREE.PCFSoftShadowMap;
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.05;

    const scene = new THREE.Scene();

    /* A room, generated in code, used only for reflections. This is what
       makes the metal look like metal — without it the body reads as
       flat grey plastic. No HDR file to download. */
    const pmrem = new THREE.PMREMGenerator(renderer);
    scene.environment = pmrem.fromScene(new RoomEnvironment(), 0.04).texture;

    const camera = new THREE.PerspectiveCamera(32, 1, 0.1, 100);
    /* Raised to about 30 degrees of elevation. OrbitControls keeps
       whatever direction it starts with, and from 15 degrees a laptop
       is edge-on: you see its rim and none of the deck. */
    camera.position.set(0, 4.2, 7.4);
    /* Without this the camera stares along -Z from its own height and
       the machine sits low and uncentred: a camera that is raised must
       also be aimed. */
    camera.lookAt(0, 0.1, 0);

    // ── lights ────────────────────────────────────────────────────
    const key = new THREE.DirectionalLight(0xffffff, 2.2);
    key.position.set(3.5, 6, 4.5);
    key.castShadow = true;
    key.shadow.mapSize.set(1024, 1024);
    key.shadow.camera.near = 1;
    key.shadow.camera.far = 20;
    key.shadow.camera.left = -5;
    key.shadow.camera.right = 5;
    key.shadow.camera.top = 5;
    key.shadow.camera.bottom = -5;
    key.shadow.bias = -0.0008;
    key.shadow.radius = 4;
    scene.add(key);

    /* The brand green, used as a rim from behind — the one place the
       colour appears, and what stops this looking like every other
       laptop render. */
    const rim = new THREE.DirectionalLight(GREEN, 2.6);
    rim.position.set(-4, 2, -3.5);
    scene.add(rim);

    scene.add(new THREE.AmbientLight(0xffffff, 0.35));

    // ── materials ─────────────────────────────────────────────────
    const shell = new THREE.MeshPhysicalMaterial({
      color: 0xb9bfc2,
      metalness: 0.95,
      roughness: 0.28,
      clearcoat: 0.6,
      clearcoatRoughness: 0.3,
    });
    const dark = new THREE.MeshPhysicalMaterial({
      color: 0x16191b,
      metalness: 0.5,
      roughness: 0.55,
    });
    /* Near-black glass with the faintest green in it. The emissive was
       carrying the whole colour before, which on a pale ground read as
       a flat olive panel rather than a screen that is switched off. */
    const screenMat = new THREE.MeshStandardMaterial({
      color: 0x0a0f12,
      roughness: 0.08,
      metalness: 0.35,
      emissive: new THREE.Color(GREEN),
      emissiveIntensity: 0.04,
    });

    // ── the machine ───────────────────────────────────────────────
    const laptop = new THREE.Group();
    scene.add(laptop);

    const W = 3.4, D = 2.3, T = 0.16;

    /* A STAND-IN THAT ACTUALLY COMES APART.
       This used to be a base, a keyboard well and a hinged lid — it
       could open, so the staged teardown had nothing to demonstrate
       until a real GLB arrived.

       It is built as named parts now, with the same names a bought
       model would use, and it is handed to the SAME installer the GLB
       goes through. So the sequence on screen is the real one, and the
       rig gets exercised end to end before any money is spent.

       Still a stand-in: these are primitives, not a product. */
    const green = new THREE.MeshPhysicalMaterial({ color: 0x2f6429, metalness: 0.25, roughness: 0.6 });
    const copper = new THREE.MeshPhysicalMaterial({ color: 0xb87333, metalness: 0.9, roughness: 0.35 });

    const name = (o: THREE.Object3D, n: string) => { o.name = n; return o; };
    /* position is READ-ONLY on Object3D — three defines it once and the
       matrix code holds that same Vector3. Object.assign silently
       replaces nothing and throws in strict mode, so it is set. */
    const at = (o: THREE.Object3D, x: number, y: number, z: number) => {
      o.position.set(x, y, z);
      return o;
    };
    /* RoundedBoxGeometry cannot build a corner larger than half the
       smallest side, and several of these parts are 3 cm thick against
       a 2 cm radius. Unclamped it throws and takes the whole scene with
       it — the canvas sizes, nothing draws, and there is no error on
       the page to explain why. */
    const slab = (w: number, h: number, d: number, m: THREE.Material, r = 0.02) =>
      new THREE.Mesh(
        new RoundedBoxGeometry(w, h, d, 2, Math.min(r, Math.min(w, h, d) / 2 - 0.001)),
        m
      );

    const build = () => {
      const g = new THREE.Group();
      const deck = T / 2;

      /* A TRAY, not a plate. Four low walls around a floor is the
         single cheapest thing that stops the exploded view reading as a
         stack of chopping boards. */
      const tray = new THREE.Group();
      tray.add(at(slab(W, 0.04, D, shell, 0.06), 0, -T * 0.42, 0));
      const wallH = T * 0.42;
      tray.add(at(slab(W, wallH, 0.05, shell, 0.02), 0, -T * 0.22, -D / 2 + 0.025));
      tray.add(at(slab(W, wallH, 0.05, shell, 0.02), 0, -T * 0.22, D / 2 - 0.025));
      tray.add(at(slab(0.05, wallH, D, shell, 0.02), -W / 2 + 0.025, -T * 0.22, 0));
      tray.add(at(slab(0.05, wallH, D, shell, 0.02), W / 2 - 0.025, -T * 0.22, 0));
      g.add(name(tray, 'BottomCase'));
      g.add(name(at(slab(W * 0.9, 0.05, D * 0.5, green), 0, -T * 0.08, -D * 0.14), 'Motherboard'));
      g.add(name(at(slab(W * 0.62, 0.09, D * 0.3, dark), 0, -T * 0.08, D * 0.22), 'Battery'));

      for (const sx of [-1, 1]) {
        /* Housing, hub and blades. A bare cylinder is a hockey puck. */
        const fan = new THREE.Group();
        fan.add(new THREE.Mesh(new THREE.CylinderGeometry(D * 0.15, D * 0.15, 0.05, 30), dark));
        const hub = new THREE.Mesh(new THREE.CylinderGeometry(D * 0.045, D * 0.045, 0.062, 20), shell);
        fan.add(hub);
        for (let i = 0; i < 9; i++) {
          const blade = new THREE.Mesh(new THREE.BoxGeometry(D * 0.092, 0.012, 0.022), shell);
          const ang = (i / 9) * Math.PI * 2;
          blade.position.set(Math.cos(ang) * D * 0.095, 0.02, Math.sin(ang) * D * 0.095);
          blade.rotation.y = -ang + 0.5;
          fan.add(blade);
        }
        fan.position.set(sx * W * 0.3, -T * 0.02, -D * 0.26);
        g.add(name(fan, `Fan_${sx < 0 ? 'L' : 'R'}`));

        const pipe = new THREE.Mesh(new THREE.BoxGeometry(W * 0.22, 0.035, 0.09), copper);
        pipe.position.set(sx * W * 0.14, -T * 0.02, -D * 0.26);
        g.add(name(pipe, `Heatsink_${sx < 0 ? 'L' : 'R'}`));

        const stick = slab(W * 0.2, 0.035, D * 0.07, dark);
        stick.position.set(sx * W * 0.2, -T * 0.01, D * 0.02);
        g.add(name(stick, `RAM_${sx < 0 ? '1' : '2'}`));

        const spk = slab(W * 0.14, 0.05, D * 0.08, dark);
        spk.position.set(sx * W * 0.38, -T * 0.06, D * 0.3);
        g.add(name(spk, `Speaker_${sx < 0 ? 'L' : 'R'}`));
      }

      g.add(name(at(slab(W * 0.24, 0.03, D * 0.16, green), W * 0.3, -T * 0.02, D * 0.06), 'SSD'));

      const top = slab(W, T * 0.3, D, shell, 0.05);
      top.position.set(0, deck - T * 0.15, 0);
      /* Keycaps. Instanced, because 84 of them as separate meshes is a
         draw call each for something that is pure texture at this
         distance — and it is the detail that makes the deck read as a
         keyboard rather than a black rectangle. */
      const kb = new THREE.Group();
      kb.add(at(slab(W * 0.86, 0.02, D * 0.52, dark), 0, deck + 0.005, -D * 0.16));
      const cols = 14, rows = 5;
      const cap = new THREE.InstancedMesh(
        new RoundedBoxGeometry(W * 0.052, 0.016, D * 0.072, 1, 0.006),
        new THREE.MeshPhysicalMaterial({ color: 0x24282b, roughness: 0.75 }),
        cols * rows
      );
      const mtx = new THREE.Matrix4();
      let n = 0;
      for (let r = 0; r < rows; r++) {
        for (let c = 0; c < cols; c++) {
          mtx.setPosition(
            (c - (cols - 1) / 2) * W * 0.06,
            deck + 0.024,
            -D * 0.16 + (r - (rows - 1) / 2) * D * 0.088
          );
          cap.setMatrixAt(n++, mtx);
        }
      }
      cap.instanceMatrix.needsUpdate = true;
      cap.castShadow = true;
      kb.add(cap);
      const pad = slab(W * 0.3, 0.02, D * 0.26, shell);
      pad.position.set(0, deck + 0.009, D * 0.26);
      const topCase = new THREE.Group();
      topCase.add(top, kb, pad);
      g.add(name(topCase, 'TopCase'));

      /* The lid, flat on the deck. The installer takes it apart by
         translation, so it starts shut rather than hinged. */
      const lid = slab(W, T * 0.72, D, shell, 0.06);
      lid.position.set(0, deck + T * 0.5, 0);
      const display = new THREE.Mesh(new THREE.PlaneGeometry(W * 0.9, D * 0.86), screenMat);
      display.rotation.x = -Math.PI / 2;
      display.position.set(0, deck + T * 0.87, 0);
      const screenGrp = new THREE.Group();
      screenGrp.add(lid, display);
      g.add(name(screenGrp, 'Screen'));

      g.traverse((o) => {
        const m = o as THREE.Mesh;
        if (!m.isMesh) return;
        m.castShadow = true;
        m.receiveShadow = true;
      });
      return g;
    };


    /* ── a real model, if one has been supplied ──────────────────
       Drop a file at public/models/laptop.glb and it replaces
       everything above. Nothing else changes: same lights, same
       environment, same drag and scroll.

       The three decoders are all self-hosted — Draco from
       node_modules into /draco, meshopt bundled — so no CDN is hit and
       the site keeps its no-third-party-request rule. They are only
       fetched if the file actually uses that compression.

       A 404 is the normal case while no model exists, so it is handled
       quietly: the procedural machine stays and nothing is logged as an
       error. */
    const MODEL_URL = '/models/laptop.glb';

    /* WHERE EACH PART GOES, and in what order it leaves.
       A real exploded diagram does not send everything one way — the
       screen lifts, the base drops, the fans go out to their own sides.
       Sending them all straight up is legible but reads as a stack of
       plates, which is what this replaces.

       x is lateral, y vertical, z front-to-back, in units of the
       normalised body width. `side` means the offset is mirrored by
       which half of the machine the part actually sits in, so a pair of
       fans separates outwards instead of both going the same way.

       Matching is loose — letters only, partial — so "Bottom_Case_01"
       answers to "bottomcase". Anything matching nothing stays put and
       reads as the body. */
    const PARTS: { key: string; v: [number, number, number]; side?: boolean; whole?: boolean }[] = [
      { key: 'bezel',       v: [0, 1.14, -0.12] },
      { key: 'screen',      v: [0, 1.00, -0.10] },
      { key: 'display',     v: [0, 1.00, -0.10] },
      { key: 'lid',         v: [0, 1.00, -0.10] },
      { key: 'hinge',       v: [0.30, 0.66, -0.34], side: true },
      { key: 'keyboard',    v: [0, 0.58, 0] },
      { key: 'palmrest',    v: [0, 0.54, 0.10] },
      { key: 'topcase',     v: [0, 0.58, 0] },
      { key: 'trackpad',    v: [0, 0.48, 0.36] },
      { key: 'touchpad',    v: [0, 0.48, 0.36] },
      { key: 'speaker',     v: [0.62, 0.34, 0.06], side: true },
      { key: 'fan',         v: [0.58, 0.26, -0.14], side: true },
      { key: 'cooler',      v: [0.58, 0.26, -0.14], side: true },
      { key: 'heatsink',    v: [0.58, 0.26, -0.14], side: true },
      /* RAM and Wi-Fi card sit ON the board, so they leave just above
         it and slightly out — otherwise they travel through it. */
      { key: 'memory',      v: [0.34, 0.30, 0.30], side: true },
      { key: 'dimm',        v: [0.34, 0.30, 0.30], side: true },
      /* 'ram' must match a WHOLE word. As a substring it is inside
         "frame", and a chassis frame would fly off as a memory
         module. */
      { key: 'ram',         v: [0.34, 0.30, 0.30], side: true, whole: true },
      { key: 'wifi',        v: [0.40, 0.24, -0.28], side: true },
      { key: 'wlan',        v: [0.40, 0.24, -0.28], side: true },
      { key: 'motherboard', v: [0, 0.12, 0.46] },
      { key: 'mainboard',   v: [0, 0.12, 0.46] },
      { key: 'logicboard',  v: [0, 0.12, 0.46] },
      { key: 'storage',     v: [0.46, 0.04, 0.30], side: true },
      { key: 'ssd',         v: [0.46, 0.04, 0.30], side: true },
      { key: 'drive',       v: [0.46, 0.04, 0.30], side: true },
      { key: 'battery',     v: [0, -0.34, 0.22] },
      { key: 'bottomcase',  v: [0, -0.62, 0] },
      { key: 'base',        v: [0, -0.62, 0] },
    ];

    /* How far the teardown throws its parts, against the offsets in
       PARTS. At 1 the stack runs about 1.6 body-widths tall, which does
       not fit the frame — the screen leaves the top and the base leaves
       the bottom. 0.62 keeps the whole exploded assembly inside the
       viewport at the distance below, which is the point of an exploded
       diagram: you have to be able to see all of it at once. */
    const SPREAD = 0.62;

    type Part = {
      obj: THREE.Object3D;
      home: THREE.Vector3;
      move: THREE.Vector3;
      /* The slice of the scroll during which this piece leaves. */
      a: number;
      b: number;
      /* Which entry in PARTS matched, so the label knows what to say. */
      key: string;
      /* Eased hover lift, 1 at rest. */
      pull?: number;
    };
    let parts: Part[] = [];

    /* WHAT EACH PART SELLS.
       The point of the scene: an exploded laptop that names Danat's
       services as you touch it.

       Keyed on the PARTS entry that matched, not on the object's own
       name, so it is model-agnostic — a file calling its battery
       "Bat_01_geo" still lands on 'battery' and still says the right
       thing. Only the matcher needs touching when a model names things
       oddly; this table does not.

       Every line maps to a service the project documents — computer
       repair, hardware troubleshooting, data recovery. Nothing here is
       offered that the content does not already claim. */
    const SELLS: Record<string, [string, string]> = {
      screen:      ['Screen replacement', 'Cracked, flickering or dim panels, matched to your model'],
      bezel:       ['Screen replacement', 'Cracked, flickering or dim panels, matched to your model'],
      display:     ['Screen replacement', 'Cracked, flickering or dim panels, matched to your model'],
      lid:         ['Screen replacement', 'Cracked, flickering or dim panels, matched to your model'],
      topcase:     ['Keyboard and trackpad', 'Stuck keys, spills, and trackpads that stop responding'],
      keyboard:    ['Keyboard and trackpad', 'Stuck keys, spills, and trackpads that stop responding'],
      trackpad:    ['Keyboard and trackpad', 'Stuck keys, spills, and trackpads that stop responding'],
      touchpad:    ['Keyboard and trackpad', 'Stuck keys, spills, and trackpads that stop responding'],
      palmrest:    ['Body and hinges', 'Cracked casing and broken screw mounts'],
      hinge:       ['Body and hinges', 'Stiff or loose hinges, repaired or replaced'],
      battery:     ['Battery replacement', 'For laptops that die early or stop charging'],
      motherboard: ['Board-level repair', 'No power, no display, charging faults, liquid damage'],
      mainboard:   ['Board-level repair', 'No power, no display, charging faults, liquid damage'],
      logicboard:  ['Board-level repair', 'No power, no display, charging faults, liquid damage'],
      fan:         ['Cleaning and thermal service', 'Overheating, shutdowns and loud fans'],
      cooler:      ['Cleaning and thermal service', 'Overheating, shutdowns and loud fans'],
      heatsink:    ['Cleaning and thermal service', 'Overheating, shutdowns and loud fans'],
      ram:         ['Memory upgrade', 'So heavy apps and many tabs stop slowing you down'],
      memory:      ['Memory upgrade', 'So heavy apps and many tabs stop slowing you down'],
      dimm:        ['Memory upgrade', 'So heavy apps and many tabs stop slowing you down'],
      ssd:         ['SSD upgrade and data recovery', 'Faster storage, or files off a failed drive'],
      storage:     ['SSD upgrade and data recovery', 'Faster storage, or files off a failed drive'],
      drive:       ['SSD upgrade and data recovery', 'Faster storage, or files off a failed drive'],
      speaker:     ['Hardware troubleshooting', 'Audio faults traced to the component'],
      wifi:        ['Hardware troubleshooting', 'Wireless cards tested and replaced'],
      wlan:        ['Hardware troubleshooting', 'Wireless cards tested and replaced'],
      bottomcase:  ['Body and hinges', 'Cracked casing and broken screw mounts'],
      base:        ['Body and hinges', 'Cracked casing and broken screw mounts'],
    };

    const gltf = new GLTFLoader()
      .setDRACOLoader(new DRACOLoader().setDecoderPath('/draco/'))
      .setMeshoptDecoder(MeshoptDecoder);

    /* One installer for both routes: the file committed to
       public/models, and a file dropped onto the page. Dropping is how
       you judge a model you have not bought yet — it needs no rebuild
       and nothing is written to the repo. */
    function install(m: THREE.Object3D, label: string) {
      /* Exports arrive at wildly different scales and origins — a
         Blender default is metres, a CAD export often millimetres.
         Normalise to the box the procedural machine occupies, or the
         camera framing means nothing. */
      const box = new THREE.Box3().setFromObject(m);
      const size = box.getSize(new THREE.Vector3());
      const centre = box.getCenter(new THREE.Vector3());
      const scale = W / Math.max(size.x, 0.0001);
      m.scale.setScalar(scale);
      m.position.sub(centre.multiplyScalar(scale));
      m.position.y += (size.y * scale) / 2 - T / 2;

      m.traverse((o) => {
        const mesh = o as THREE.Mesh;
        if (!mesh.isMesh) return;
        mesh.castShadow = true;
        mesh.receiveShadow = true;
      });

      /* THE WHOLE THING TURNS ON THIS.
         A teardown needs the file to hold its parts as separate, named
         objects. Most models sold as "laptop" are one welded shell with
         no interior — they render beautifully and they cannot come
         apart. Collecting by name means such a model degrades to a
         solid object that still turns, rather than to a broken page. */
      const found: Part[] = [];
      const missed: string[] = [];
      /* Centre in the model's own space, so `side` can ask which half a
         part sits in. */
      const mid = new THREE.Box3().setFromObject(m).getCenter(new THREE.Vector3());
      const unit = W;

      m.traverse((o) => {
        const raw = o.name.toLowerCase();
        const key = raw.replace(/[^a-z]/g, '');
        if (!key) return;
        /* Whole-word matching needs the separators, which `key` has
           thrown away — so the split happens on the raw name. */
        const words = raw.split(/[^a-z]+/).filter(Boolean);
        const spec = PARTS.find((t) =>
          t.whole ? words.includes(t.key) : key.includes(t.key)
        );
        if (!spec) {
          if ((o as THREE.Mesh).isMesh) missed.push(o.name);
          return;
        }
        /* Skip anything under a part already taken, or a child and its
           parent separate by different amounts and the piece tears
           itself apart. */
        for (let p: THREE.Object3D | null = o.parent; p; p = p.parent) {
          if (found.some((f) => f.obj === p)) return;
        }

        const here = o.getWorldPosition(new THREE.Vector3());
        /* Default to the right where a part sits dead on the centre
           line, so a lone fan still travels somewhere. */
        const sign = spec.side ? (here.x < mid.x ? -1 : 1) : 1;

        found.push({
          obj: o,
          home: o.position.clone(),
          move: new THREE.Vector3(
            spec.v[0] * sign * unit * SPREAD,
            spec.v[1] * unit * SPREAD,
            spec.v[2] * unit * SPREAD
          ),
          a: 0,
          b: 1,
          key: spec.key,
          order: PARTS.indexOf(spec),
        } as Part & { order: number });
      });

      /* IN SEQUENCE, NOT ALL AT ONCE.
         The client's storyboard is five stages — shut, open, screen
         off, keyboard and top case off, everything off — so the pieces
         have to leave one after another. Moving them all in proportion
         to one value reads as the machine drifting apart, which is a
         different and much weaker thing.

         Sorted into teardown order, then each given a window of the
         scroll: the screen goes first and the base last, with the
         windows overlapping enough that the motion never stops dead
         between parts. */
      (found as (Part & { order: number })[]).sort((x, y) => x.order - y.order);
      const n = Math.max(1, found.length);
      found.forEach((f, i) => {
        f.a = 0.10 + (i / n) * 0.70;
        f.b = Math.min(1, f.a + 0.34);
      });

      parts = found;
      laptop.clear();
      laptop.add(m);
      controls.autoRotate = false;

      canvas.dataset.model = 'glb';
      canvas.dataset.parts = String(found.length);
      canvas.dataset.partNames = found.map((f) => f.obj.name).join(',');

      report(label, found.map((f) => f.obj.name), missed);
    }

    /* The verdict, on the page rather than in the inspector. A model is
       judged on two things: how many parts the rig recognised, and what
       it could not place — a file full of Object_001 reads as a long
       "not matched" list and no matches at all, which is the answer. */
    function report(label: string, hit: string[], missed: string[]) {
      if (!out) return;
      out.hidden = false;
      const verdict = hit.length >= 5 ? 'good' : hit.length ? 'thin' : 'bad';
      out.dataset.verdict = verdict;
      out.innerHTML = '';

      const h = document.createElement('p');
      h.className = 'lb__v';
      h.textContent =
        verdict === 'good'
          ? `${hit.length} parts recognised — usable`
          : verdict === 'thin'
            ? `Only ${hit.length} parts recognised — thin`
            : 'No parts recognised — not usable';
      out.append(h);

      const f = document.createElement('p');
      f.className = 'lb__f';
      f.textContent = label;
      out.append(f);

      const list = (title: string, names: string[]) => {
        if (!names.length) return;
        const d = document.createElement('p');
        d.className = 'lb__l';
        /* Every name, not the first two dozen. The point of this panel
           is that a screenshot of it is the whole evidence — a
           truncated list means another round trip to find out what was
           in the "+14 more".

           textContent, not innerHTML: these strings come out of a file
           somebody downloaded from the internet. */
        d.textContent = `${title} (${names.length}): ${names.join(', ')}`;
        out.append(d);
      };
      list('Matched', hit);
      list('Not matched', missed);
    }

    /* The committed model, if there is one. A 404 is the normal state
       while none exists, so it is handled quietly. */
    fetch(MODEL_URL, { method: 'HEAD' })
      .then((r) => {
        if (!r.ok) return;
        gltf.load(MODEL_URL, (g) => install(g.scene, MODEL_URL));
      })
      .catch(() => {});

    /* Drop any .glb or .gltf onto the page to try it. */
    const stop = (e: DragEvent) => { e.preventDefault(); e.stopPropagation(); };
    const host = canvas.closest('.lb__stage') as HTMLElement;
    host.addEventListener('dragover', (e) => { stop(e); host.dataset.over = ''; });
    host.addEventListener('dragleave', (e) => { stop(e); delete host.dataset.over; });
    host.addEventListener('drop', (e) => {
      stop(e);
      delete host.dataset.over;
      const file = e.dataTransfer?.files?.[0];
      if (!file || !/\.(glb|gltf)$/i.test(file.name)) return;
      file.arrayBuffer().then((buf) => {
        gltf.parse(
          buf,
          '',
          (g) => install(g.scene, file.name),
          () => report(file.name, [], ['file could not be read as glTF'])
        );
      });
    });

    /* The shadow the machine sits on. A plane that takes shadow only —
       invisible itself, so the section's own background shows through
       and the object is not stuck on a grey card. */
    const floor = new THREE.Mesh(
      new THREE.PlaneGeometry(40, 40),
      /* 0.18 vanished against this near-white ground and the machine
         read as floating. */
      new THREE.ShadowMaterial({ opacity: 0.34 })
    );
    floor.rotation.x = -Math.PI / 2;
    floor.position.y = -T / 2 - 0.01;
    floor.receiveShadow = true;
    scene.add(floor);

    // ── input ─────────────────────────────────────────────────────
    let openTarget = 0;
    let open = 0;
    const used = () => hint?.setAttribute('data-used', '');

    /* Drag, zoom and pinch from three's own controls rather than the
       pointer maths this replaces. The plan asks for zoom, and
       OrbitControls already has wheel, pinch and inertia. */
    const controls = new OrbitControls(camera, canvas);
    controls.target.set(0, 0.1, 0);
    controls.enableDamping = true;
    controls.dampingFactor = 0.075;
    controls.enablePan = false;
    controls.minDistance = 4;
    /* A portrait phone needs about 18.7 to fit the exploded stack, so
       the ceiling has to clear that or resize() is clamped and the
       parts go off-screen anyway. */
    controls.maxDistance = 30;
    /* Stopped short of both poles: under a laptop there is nothing, and
       straight down loses the object against its own shadow. */
    controls.minPolarAngle = 0.3;
    controls.maxPolarAngle = Math.PI / 2 - 0.04;
    controls.autoRotate = !reduced;
    controls.autoRotateSpeed = 0.55;
    controls.addEventListener('start', () => {
      controls.autoRotate = false;
      used();
    });

    /* Scroll through the section opens the lid. 0 when the section
       arrives at the bottom of the viewport, 1 when it leaves the top. */
    const stage = canvas.parentElement!;
    const onScroll = () => {
      const r = stage.getBoundingClientRect();
      /* Shut until the section has properly arrived, then open over
         about three quarters of a viewport. The earlier mapping counted
         from the section's BOTTOM, so the lid was already half up
         before the machine was even on screen. */
      const p = (innerHeight * 0.45 - r.top) / (innerHeight * 0.7);
      openTarget = Math.max(0, Math.min(1, p));
      if (openTarget > 0.02) used();
    };
    addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    // ── size ──────────────────────────────────────────────────────
    const resize = () => {
      const w = stage.clientWidth;
      const h = stage.clientHeight;
      if (!w || !h) return;
      renderer.setSize(w, h, false);
      camera.aspect = w / h;
      camera.updateProjectionMatrix();

      /* Distance, not position. OrbitControls owns camera.position — it
         recomputes it from its own spherical coordinates on every
         update — so assigning a z here was overwritten on the next
         frame and the machine never pulled back. Move it ALONG the
         direction it is already looking from, and the controls keep it.

         Framed for the exploded state, not the closed one: the screen
         travels a full body-width up, so a distance that suits the shut
         laptop loses the top of the stack the moment you scroll. */
      /* Framed on the EXPLODED assembly, in BOTH axes.
         Height alone is not enough: the speakers and fans throw the
         stack about 6 body-units wide, and on a portrait phone the
         viewport is barely 3 units across — so a height-only fit sends
         them off both sides of the screen. Fit each axis, take the
         larger. */
      const k = 2 * Math.tan((camera.fov * Math.PI) / 360);
      const tall = W * 1.62 * SPREAD + T * 4;
      const wide = W + 2 * (0.62 * W * SPREAD);
      const want = Math.max(
        (tall / k) * 1.18,
        wide / (k * Math.max(0.35, camera.aspect)) * 1.12
      );
      const dir = camera.position.clone().sub(controls.target).normalize();
      camera.position.copy(controls.target).addScaledVector(dir, want);
      controls.update();
    };
    new ResizeObserver(resize).observe(stage);
    resize();

    /* ── hover: which part is this, and what does Danat do to it ──
       Raycast against the whole model, then WALK UP from whatever mesh
       was hit until an ancestor is one of the collected parts. A real
       GLB nests its geometry — a battery can be three meshes under a
       group under an armature — so testing the hit object's own name
       would miss almost everything. This way the hierarchy does the
       work and hundreds of meshes cost nothing extra. */
    const ray = new THREE.Raycaster();
    const ndc = new THREE.Vector2();
    let hover: Part | null = null;
    let hoverAt = 0;

    const owner = (o: THREE.Object3D | null): Part | null => {
      for (let n = o; n; n = n.parent) {
        const hit = parts.find((f) => f.obj === n);
        if (hit) return hit;
      }
      return null;
    };

    canvas.addEventListener('pointermove', (e) => {
      const r = canvas.getBoundingClientRect();
      ndc.x = ((e.clientX - r.left) / r.width) * 2 - 1;
      ndc.y = -((e.clientY - r.top) / r.height) * 2 + 1;
      hoverAt = e.clientY - r.top;

      /* Shut, the parts are stacked inside each other and whatever is
         on top wins every time — which reads as random. */
      if (open < 0.3 || !parts.length) {
        hover = null;
        if (tip) tip.hidden = true;
        return;
      }

      ray.setFromCamera(ndc, camera);
      const hits = ray.intersectObject(laptop, true);
      const found = hits.length ? owner(hits[0].object) : null;
      if (found === hover) return;
      hover = found;

      if (!tip) return;
      const sell = found ? SELLS[found.key] : null;
      if (!sell) {
        tip.hidden = true;
        return;
      }
      tip.hidden = false;
      tip.querySelector('b')!.textContent = sell[0];
      tip.querySelector('i')!.textContent = sell[1];
      tip.style.setProperty('--x', `${e.clientX - r.left}px`);
      tip.style.setProperty('--y', `${hoverAt}px`);
    });

    canvas.addEventListener('pointerleave', () => {
      hover = null;
      if (tip) tip.hidden = true;
    });

    /* The stand-in goes through the installer too, so what is on screen
       before any model arrives is the real sequence.

       It has to happen HERE, not beside the loader: install() touches
       `controls`, and called any earlier it runs in that const's
       temporal dead zone and throws the whole boot away. The GLB paths
       get away with it because they are asynchronous. */
    /* Surfaced, not swallowed. A scene that throws leaves a sized
       canvas and nothing drawn, which looks identical to "WebGL is
       fine, the model is just invisible" — and costs an hour. */
    try {
      install(build(), 'built-in placeholder');
    } catch (err) {
      if (out) {
        out.hidden = false;
        out.dataset.verdict = 'bad';
        out.textContent = `Scene error: ${(err as Error)?.message ?? err}`;
      }
    }

    // ── loop ──────────────────────────────────────────────────────
    let visible = true;
    new IntersectionObserver(([e]) => (visible = e.isIntersecting), { threshold: 0.01 }).observe(stage);

    const clock = new THREE.Clock();
    const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
    /* Smoothstep across a window. Linear travel starts and stops with a
       jolt, which is what makes a staged sequence look mechanical
       rather than assembled. */
    const ease = (a: number, b: number, p: number) => {
      const t = Math.min(1, Math.max(0, (p - a) / (b - a)));
      return t * t * (3 - 2 * t);
    };

    const frame = () => {
      requestAnimationFrame(frame);
      /* Rendering a scene nobody is looking at is the single biggest
         waste WebGL makes on a long page. */
      if (!visible) return;

      open = lerp(open, openTarget, 0.07);
      controls.update();

      if (parts.length) {
        /* A real model: every named part travels its own way — screen
           up, base down, fans out to their own sides — and each within
           its own slice of the scroll, so they leave in sequence. */
        for (const f of parts) {
          const t = ease(f.a, f.b, open);
          /* Hovered parts lift a little further along the way they were
             already going. A transform, not a material change: the
             materials belong to a file we did not write, and several
             parts routinely share one — recolouring a battery would
             recolour the speakers with it. */
          const want = f === hover ? 1.12 : 1;
          f.pull = lerp(f.pull ?? 1, want, 0.18);
          const k = t * f.pull;
          f.obj.position.set(
            f.home.x + f.move.x * k,
            f.home.y + f.move.y * k,
            f.home.z + f.move.z * k
          );
        }
      }
      screenMat.emissiveIntensity = 0.04 + open * 0.3;

      renderer.render(scene, camera);
      canvas.dataset.frames = String((+(canvas.dataset.frames || 0)) + 1);
    };
    frame();
  }

  /* Bundled module scripts evaluate once. ClientRouter replaces the
     body on every client-side navigation, so this has to run again
     after each swap or the canvas arrives dead. */
  boot();
  document.addEventListener('astro:page-load', boot);
</script>
