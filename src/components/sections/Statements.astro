---
/**
 * IN DANAT'S OWN WORDS — the four statements from the company's live
 * about page, reproduced verbatim.
 *
 * Their layout sets the first word of each heading in an accent colour;
 * that idea is kept, in Danat green rather than their orange, since the
 * orange belongs to the old template and nothing else here uses it.
 *
 * Two columns on desktop, the same pairing as their page: About beside
 * the Director's message, Mission beside the Vision. The prose is long,
 * so measure is held at 58ch and the columns collapse early -- long
 * paragraphs in a narrow column are the one thing that makes a statement
 * page unreadable.
 *
 * The copy lives in src/data/statements.ts and must not be edited here.
 */
import { statements } from '@data/statements';

/** First word takes the accent, exactly as their own page does. */
const split = (t: string) => {
  const i = t.indexOf(' ');
  return i === -1 ? [t, ''] : [t.slice(0, i), t.slice(i + 1)];
};
---

<section class="st" id="statements" aria-labelledby="st-title">
  <div class="shell">
    <p class="eb" data-rise><i class="eb__r" aria-hidden="true"></i>In our own words</p>
    <h2 class="st__title" id="st-title" data-rise style="--d:70ms">
      Who we are, <em>in Danat&rsquo;s words.</em>
    </h2>

    <div class="st__grid">
      {statements.map((s, i) => {
        const [first, rest] = split(s.title);
        return (
          <article class="st__c" data-rise style={`--d:${120 + i * 70}ms`}>
            <h3 class="st__h"><em>{first}</em>{rest && ` ${rest}`}</h3>
            <p class="st__p">{s.body}</p>
          </article>
        );
      })}
    </div>
  </div>
</section>

<style>
  .st { background: var(--off); padding-block: clamp(4.5rem, 9vw, 7rem); }

  .st__title { margin-top: var(--s4); font-size: var(--d5); font-weight: 700; letter-spacing: var(--tr5); line-height: 1.1; }
  /* --green-deep is 6.41:1 on --off; raw --green is 2.61:1 and is
     fills-only per tokens.css. */
  .st__title em { font-style: normal; color: var(--green-deep); }

  .st__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2rem, 4vw, 3.5rem) clamp(2rem, 5vw, 5rem);
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
  }

  .st__c { border-top: 1px solid rgb(20 40 25 / 0.12); padding-top: clamp(1.1rem, 2vw, 1.6rem); }
  .st__h { font-size: var(--d6); font-weight: 700; letter-spacing: var(--tr6); line-height: 1.15; }
  .st__h em { font-style: normal; color: var(--green-deep); }
  .st__p {
    margin-top: 0.85rem;
    /* 58ch, not the 34ch the rest of the page uses: these are five- and
       nine-sentence paragraphs, and a narrow measure turns them into a
       column of slivers. */
    max-width: 58ch;
    color: var(--text-2);
    line-height: 1.72;
  }

  /* Collapses at 62rem rather than the usual 56 -- two columns of
     nine-sentence prose are already too narrow before that. */
  @media (max-width: 62rem) {
    .st__grid { grid-template-columns: 1fr; }
  }
</style>
