---
import Icon from '@components/ui/Icon.astro';

/**
 * VALUE DIAL — the four principles on a rotating ring.
 *
 * Four nodes sit at the quarter points of a circle. Selecting one turns
 * the whole ring so that node arrives at the top, and the centre
 * cross-fades to its text. It advances on its own until you touch it,
 * then it is yours.
 *
 * The ring rotates; the node contents counter-rotate by the same amount,
 * so every label stays upright through the turn. That counter-rotation
 * is the whole trick — without it the labels cartwheel.
 *
 * ~50 lines of JavaScript, no library. Keyboard reachable: each node is
 * a real button and the arrows are real buttons.
 */
const values = [
  {
    icon: 'search',
    t: 'We diagnose before we quote',
    p: 'Free, and before anything is agreed. You are told what failed, what it costs and how long it takes — then you decide.',
  },
  {
    icon: 'chip',
    t: 'We repair the board, not the box',
    p: 'Most shops trace a fault to the mainboard and quote a replacement. We trace it to the component. That is what this business is built on.',
  },
  {
    icon: 'box',
    t: 'We already have the part',
    p: 'Thousands of lines held across four branches, so most repairs do not wait on an order arriving from outside Oman.',
  },
  {
    icon: 'shield',
    t: 'The same standard at every counter',
    p: 'Ruwi, Sohar, Al Hail and Salalah run the same diagnosis, the same stock and the same technicians. A branch is not a lesser shop.',
  },
];
---

<section class="vd section">
  <span class="vd__wash" aria-hidden="true"></span>

  <div class="shell vd__head">
    <p class="eb" data-rise><i class="eb__r" aria-hidden="true"></i>What we stand on</p>
    <h2 class="vd__h" data-rise style="--d:70ms">
      Four things we<br /><em>do not compromise on.</em>
    </h2>
  </div>

  <div class="shell vd__stage" data-rise style="--d:130ms">
    <button class="vd__arrow" type="button" data-step="-1" aria-label="Previous value">
      <Icon name="arrow" size={17} />
    </button>

    <div class="dial" data-dial>
      <span class="dial__ring" aria-hidden="true"></span>
      <span class="dial__sweep" aria-hidden="true"></span>

      {/* The ring that turns. Node contents counter-rotate to stay level. */}
      <div class="dial__rot">
        {values.map((v, i) => (
          <button
            class="dial__node"
            type="button"
            style={`--th:${i * 90}deg`}
            data-i={i}
            data-on={i === 0 ? '' : undefined}
            aria-label={v.t}
          >
            <span class="dial__lvl">
              <i aria-hidden="true"><Icon name={v.icon} size={19} /></i>
              <b>{String(i + 1).padStart(2, '0')}</b>
            </span>
          </button>
        ))}
      </div>

      {/* Centre. Only the selected panel is shown to assistive tech. */}
      <div class="dial__core">
        {values.map((v, i) => (
          <article class="dial__panel" data-i={i} data-on={i === 0 ? '' : undefined}
            aria-hidden={i === 0 ? undefined : 'true'}>
            <span class="dial__ic" aria-hidden="true"><Icon name={v.icon} size={24} /></span>
            <h3>{v.t}</h3>
            <p>{v.p}</p>
          </article>
        ))}
      </div>
    </div>

    <button class="vd__arrow vd__arrow--next" type="button" data-step="1" aria-label="Next value">
      <Icon name="arrow" size={17} />
    </button>
  </div>

  <div class="shell vd__dots" role="tablist" aria-label="Values">
    {values.map((v, i) => (
      <button class="vd__dot" type="button" data-i={i} data-on={i === 0 ? '' : undefined}
        role="tab" aria-selected={i === 0 ? 'true' : 'false'} aria-label={v.t}></button>
    ))}
  </div>
</section>

<script is:inline>
  (() => {
    const dial = document.querySelector('[data-dial]');
    if (!dial) return;

    const rot = dial.querySelector('.dial__rot');
    const nodes = [...dial.querySelectorAll('.dial__node')];
    const panels = [...dial.querySelectorAll('.dial__panel')];
    const dots = [...document.querySelectorAll('.vd__dot')];
    const n = nodes.length;
    if (!rot || !n) return;

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let at = 0;
    let turns = 0; // keeps rotation monotonic so it never spins backwards
    let timer = null;

    const show = (next) => {
      // shortest way round, then accumulate so 3 -> 0 turns forward
      let d = ((next - at) % n + n) % n;
      if (d > n / 2) d -= n;
      turns += d;
      at = ((next % n) + n) % n;

      rot.style.setProperty('--a', `${-turns * (360 / n)}deg`);
      nodes.forEach((el, i) => el.toggleAttribute('data-on', i === at));
      dots.forEach((el, i) => {
        el.toggleAttribute('data-on', i === at);
        el.setAttribute('aria-selected', i === at ? 'true' : 'false');
      });
      panels.forEach((el, i) => {
        const on = i === at;
        el.toggleAttribute('data-on', on);
        if (on) el.removeAttribute('aria-hidden');
        else el.setAttribute('aria-hidden', 'true');
      });
    };

    const stop = () => {
      if (timer) clearInterval(timer);
      timer = null;
      dial.removeAttribute('data-auto');
    };

    const start = () => {
      if (reduced || timer) return;
      dial.setAttribute('data-auto', '');
      timer = setInterval(() => show(at + 1), 4200);
    };

    nodes.forEach((el, i) => el.addEventListener('click', () => { stop(); show(i); }));
    dots.forEach((el, i) => el.addEventListener('click', () => { stop(); show(i); }));
    document.querySelectorAll('[data-step]').forEach((b) =>
      b.addEventListener('click', () => {
        stop();
        show(at + Number(b.getAttribute('data-step')));
      })
    );

    // Only spin while it is actually on screen.
    const io = new IntersectionObserver(
      ([e]) => (e.isIntersecting ? start() : stop()),
      { threshold: 0.35 }
    );
    io.observe(dial);
  })();
</script>

<style>
  .vd {
    position: relative;
    background: linear-gradient(185deg, #fbfdfb, #f0f7f0 58%, #f8fbf8);
    overflow: hidden;
    isolation: isolate;
  }
  .vd__wash {
    position: absolute;
    z-index: -1;
    left: 50%;
    top: 44%;
    translate: -50% -50%;
    width: min(46rem, 90vw);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      color-mix(in oklab, var(--green) 16%, transparent) 0%,
      color-mix(in oklab, var(--clay) 7%, transparent) 46%,
      transparent 70%
    );
    filter: blur(26px);
  }

  .eb {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--green-deep);
  }
  .eb__r { width: 26px; height: 1px; flex: none; background: currentColor; opacity: 0.6; }

  .vd__head { text-align: center; }
  .vd__head .eb { justify-content: center; }
  .vd__h {
    margin-top: var(--s4);
    font-size: clamp(1.7rem, 3.2vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.08;
  }
  .vd__h em { font-style: normal; color: var(--clay-deep); }

  /* ───── stage ───── */

  .vd__stage {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(0.5rem, 2vw, 1.5rem);
    margin-top: clamp(1.75rem, 4vw, 2.75rem);
  }

  .vd__arrow {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    flex: none;
    border: 1px solid var(--line-light);
    border-radius: 50%;
    background: var(--white);
    color: var(--text-2);
    cursor: pointer;
    transition:
      background-color var(--t2) var(--ease),
      border-color var(--t2) var(--ease),
      color var(--t2) var(--ease),
      transform var(--t2) var(--ease);
  }
  .vd__arrow :global(svg) { transform: rotate(180deg); }
  .vd__arrow--next :global(svg) { transform: none; }
  .vd__arrow:hover {
    transform: translateY(-2px);
    border-color: var(--green-deep);
    background: var(--green-deep);
    color: #fff;
  }
  .vd__arrow:focus-visible { outline: 2px solid var(--green-deep); outline-offset: 3px; }

  /* ───── dial ───── */

  .dial {
    position: relative;
    width: min(30rem, 78vw);
    aspect-ratio: 1;
    flex: none;
    --r: 42%;
  }

  .dial__ring {
    position: absolute;
    inset: 8%;
    border-radius: 50%;
    border: 1px solid color-mix(in oklab, var(--green) 32%, transparent);
  }
  /* A faint arc that sits under the active node, so the top of the dial
     reads as the selected position. */
  .dial__sweep {
    position: absolute;
    inset: 8%;
    border-radius: 50%;
    border: 2px solid transparent;
    border-top-color: var(--clay);
    rotate: -45deg;
    opacity: 0.85;
  }

  .dial__rot {
    position: absolute;
    inset: 0;
    transform: rotate(var(--a, 0deg));
    transition: transform 900ms cubic-bezier(0.65, 0, 0.35, 1);
  }

  .dial__node {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 64px;
    height: 64px;
    margin: -32px 0 0 -32px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    /* place on the ring, then hand the level-keeping to the child */
    transform: rotate(var(--th)) translateY(calc(var(--r) * -1));
  }
  .dial__node:focus-visible { outline: none; }

  .dial__lvl {
    display: grid;
    place-items: center;
    gap: 0.1rem;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: var(--white);
    color: var(--text-3);
    box-shadow: 0 1px 2px rgb(10 30 12 / 0.06), 0 10px 24px -16px rgb(10 30 12 / 0.4);
    /* undo both the node's own angle and the ring's, so it stays upright */
    transform: rotate(calc((var(--th) + var(--a, 0deg)) * -1));
    transition:
      transform 900ms cubic-bezier(0.65, 0, 0.35, 1),
      background-color var(--t3) var(--ease),
      color var(--t3) var(--ease),
      box-shadow var(--t3) var(--ease),
      scale var(--t3) var(--ease);
  }
  .dial__lvl b {
    font-family: var(--font-mono);
    font-size: 0.5rem;
    letter-spacing: 0.1em;
  }
  .dial__node:hover .dial__lvl { scale: 1.06; }
  .dial__node:focus-visible .dial__lvl {
    outline: 2px solid var(--green-deep);
    outline-offset: 3px;
  }
  .dial__node[data-on] .dial__lvl {
    scale: 1.12;
    background: var(--green-deep);
    color: #fff;
    box-shadow: 0 1px 2px rgb(10 30 12 / 0.1), 0 16px 34px -14px rgb(47 100 41 / 0.6);
  }

  /* ───── centre ───── */

  .dial__core {
    position: absolute;
    inset: 24%;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.9);
    backdrop-filter: blur(10px);
    box-shadow: 0 1px 2px rgb(10 30 12 / 0.05), 0 26px 54px -30px rgb(10 30 12 / 0.45);
    text-align: center;
    padding: clamp(0.75rem, 3vw, 1.75rem);
  }

  .dial__panel {
    grid-area: 1 / 1;
    display: grid;
    justify-items: center;
    opacity: 0;
    scale: 0.94;
    pointer-events: none;
    transition: opacity var(--t3) var(--ease), scale var(--t3) var(--ease);
  }
  .dial__panel[data-on] { opacity: 1; scale: 1; pointer-events: auto; }

  .dial__ic {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 14px;
    color: var(--clay-deep);
    background: var(--clay-wash);
  }
  .dial__panel h3 {
    margin-top: 0.7rem;
    font-size: clamp(0.9375rem, 1.6vw, 1.15rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.2;
    max-width: 16ch;
  }
  .dial__panel p {
    margin-top: 0.45rem;
    max-width: 30ch;
    font-size: clamp(0.75rem, 1.2vw, 0.875rem);
    line-height: 1.55;
    color: var(--text-2);
  }

  /* ───── dots ───── */

  .vd__dots {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin-top: clamp(1.25rem, 3vw, 2rem);
  }
  .vd__dot {
    width: 30px;
    height: 4px;
    padding: 0;
    border: 0;
    border-radius: 4px;
    background: var(--line-light);
    cursor: pointer;
    transition: background-color var(--t2) var(--ease), width var(--t3) var(--ease);
  }
  .vd__dot[data-on] { width: 46px; background: var(--clay); }
  .vd__dot:focus-visible { outline: 2px solid var(--green-deep); outline-offset: 3px; }

  /* ───── small screens ───── */

  @media (max-width: 40rem) {
    .dial { --r: 40%; }
    .dial__node { width: 50px; height: 50px; margin: -25px 0 0 -25px; }
    .dial__core { inset: 20%; }
  }

  @media (prefers-reduced-motion: reduce) {
    /* No auto-advance, no spin — the arrows and dots still work, and the
       ring simply jumps to position. */
    .dial__rot, .dial__lvl, .dial__panel { transition: none; }
    .vd__arrow, .vd__arrow:hover { transform: none; transition: none; }
  }
</style>
