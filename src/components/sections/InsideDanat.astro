---
import { Image } from 'astro:assets';
import Icon from '@components/ui/Icon.astro';
import Brush from '@components/ui/Brush.astro';

/* NOT repair-board.jpg: its technician wears a uniform branded
   ТЕХНОБЫТСЕРВИС, another repair company, and it is legible at this
   size. */
import imgBoard from '@assets/photos/repair-solder.jpg';
import imgParts from '@assets/photos/network-patch.jpg';
import imgDrive from '@assets/photos/datarecovery-drive.jpg';
import imgShop from '@assets/photos/retail-display.jpg';
import imgTeam from '@assets/photos/support-agent.jpg';
import imgPrinter from '@assets/photos/printer-machine.jpg';

/**
 * Every claim here is drawn from Danat's own ERP records.
 *
 * ⚠ Each card used to carry a long `body` paragraph shown in a hover
 * overlay that replaced the whole card. The client's comp puts a short
 * blurb and an arrow on the face of the card instead, so the overlay
 * is gone and those six paragraphs with it. The same ground is covered
 * at length on each linked service page — but if any of that writing
 * is wanted back on the homepage it needs a section of its own.
 */
const items = [
  {
    kicker: 'Repair capability',
    title: 'We fix the board, not just the machine.',
    sub: 'Skilled technicians and component-level repair for longer life.',
    icon: 'wrench' as const,
    href: '/services/computer-repair',
    img: imgBoard,
    alt: 'Technician repairing a laptop mainboard',
  },
  {
    kicker: 'Stock depth',
    title: '5,430 lines on the shelf, not on order.',
    sub: 'A wide range of parts and accessories, ready when you need them.',
    icon: 'box' as const,
    href: '/services/computer-sales',
    img: imgParts,
    alt: 'Network patch panel with dense cabling',
  },
  {
    kicker: 'Data recovery',
    title: 'We tell you what is recoverable before you pay.',
    sub: 'Transparent assessment and professional data recovery services.',
    /* NOT 'drive': that one is a platter inside an enclosure and at this
       size the head arm reads as a magnifying glass. */
    icon: 'ssd' as const,
    href: '/services/data-recovery',
    img: imgDrive,
    alt: 'Inside an opened hard disk drive',
  },
  {
    kicker: 'New and refurbished',
    title: 'Refurbished is not a lesser shelf.',
    sub: 'Tested, warranted machines standing beside the new ones.',
    icon: 'laptop' as const,
    href: '/services/computer-sales',
    img: imgShop,
    alt: 'Retail display of computer products',
  },
  {
    kicker: 'Business supply',
    title: 'Hospitals and retailers buy from us at trade.',
    sub: 'Reliable supply of genuine products for your business needs.',
    icon: 'headset' as const,
    href: '/business',
    img: imgTeam,
    alt: 'Support team at their workstations',
  },
  {
    kicker: 'Consumables',
    title: 'The cartridge is here when the printer needs it.',
    sub: 'Original consumables to keep your printing smooth and worry-free.',
    icon: 'printer' as const,
    href: '/services/printer-services',
    img: imgPrinter,
    alt: 'Internal rollers of a printing machine',
  },
];

/* Tripled so the rail can loop seamlessly: [clones][real][clones].
   The viewport starts on the middle set. */
const loop = [...items, ...items, ...items];
const N = items.length;
---

<section class="gk section" data-tone="off" data-gk>
  <span class="gk__blob" aria-hidden="true"></span>

  <div class="shell gk__head">
    <div>
      <p class="label" data-rise>Inside Danat</p>
      <h2 class="gk__title" data-rise style="--d:70ms">
        Twenty years of<br />
        <Brush>doing the hard part.</Brush>
      </h2>
    </div>

    <div class="gk__nav" data-rise style="--d:150ms">
      <p class="gk__intro">
        From supply to repair, we keep businesses and homes running with
        genuine products, expert care and long-term support.
      </p>

      <div class="gk__bar">
      <div class="gk__dots" role="tablist" aria-label="Choose a topic">
        {items.map((it, i) => (
          <button
            type="button"
            class="gk__dot"
            data-dot={i}
            data-on={i === 0 ? '' : undefined}
            role="tab"
            aria-selected={i === 0 ? 'true' : 'false'}
            aria-label={it.title}
          ></button>
        ))}
      </div>

      <div class="gk__arrows">
        <button type="button" class="gk__arrow" data-prev aria-label="Previous">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor"
            stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
            <path d="M19 12H5M11 6l-6 6 6 6" />
          </svg>
        </button>
        <button type="button" class="gk__arrow" data-next aria-label="Next">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor"
            stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </button>
      </div>
      </div>
    </div>
  </div>

  <div class="gk__vp">
    <ul class="gk__rail" data-rail>
      {loop.map((it, i) => (
        <li class="gk__slide" data-slide={i} data-real={i % N}>
          <div class="gk__card">
            {/* The photograph is inset with the card's own padding, not
                bled to its edges, and the tile below overlaps its
                bottom-left corner — so .gk__shot cannot clip. */}
            <span class="gk__shot">
              <span class="gk__img">
                <Image
                  src={it.img}
                  alt={it.alt}
                  widths={[340, 600, 900]}
                  sizes="22rem"
                  quality={78}
                  format="webp"
                  loading={i >= N && i < N + 3 ? 'eager' : 'lazy'}
                />
              </span>
              <span class="gk__badge"><Icon name={it.icon} size={26} /></span>
            </span>

            <span class="gk__cap">
              <span class="gk__kick">{it.kicker}</span>
              <span class="gk__ct">{it.title}</span>
              <span class="gk__sub">{it.sub}</span>
            </span>

            {/* The whole card is the link — the circle is where it shows
                itself. data-hit centres the slide before following, so a
                click on an off-centre card reads as navigation either
                way. */}
            <a class="gk__go" href={it.href} data-hit={i} aria-label={it.title}>
              <span class="gk__ring" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor"
                  stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14M13 6l6 6-6 6" />
                </svg>
              </span>
            </a>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .gk {
    position: relative;
    /* The comp sets this band on the same pale wash as the free
       diagnosis band rather than the flat --off slab it was. */
    background: linear-gradient(180deg, #ffffff 0%, #f3faf4 45%, #eef7f0 100%);
    color: var(--text);
    padding-block: clamp(3.5rem, 6vw, 6rem);
    overflow: hidden;
    isolation: isolate;
  }

  .gk__blob {
    position: absolute;
    z-index: -1;
    right: -8%;
    top: -12%;
    width: 38rem;
    height: 30rem;
    border-radius: 50%;
    background: radial-gradient(circle at 45% 45%, rgb(89 170 84 / 0.14), rgb(89 170 84 / 0) 68%);
  }

  /* ---------- head ---------- */

  .gk__head {
    position: relative;
    z-index: 1;
    display: grid;
    gap: var(--s5);
    padding-bottom: clamp(1.75rem, 3vw, 2.5rem);
  }

  .gk__title {
    margin-top: var(--s4);
    font-size: clamp(1.75rem, 3.2vw, 2.75rem);
    line-height: 1.14;
    letter-spacing: -0.035em;
    font-weight: 800;
    max-width: 22ch;
  }

  .gk__title :global(.brush) {
    --brush-size: 1.26em;
    margin-top: 0.14em;
  }

  .gk__nav {
    display: grid;
    gap: var(--s5);
  }

  .gk__intro {
    max-width: 44ch;
    font-size: var(--small);
    line-height: 1.62;
    color: var(--text-2);
  }

  .gk__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s5);
    flex-wrap: wrap;
  }

  .gk__dots {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .gk__arrows {
    display: flex;
    gap: 0.5rem;
  }

  .gk__arrow {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    border: 1px solid var(--line-light);
    background: var(--white);
    color: var(--text-2);
    transition:
      border-color var(--t2) var(--ease),
      background-color var(--t2) var(--ease),
      color var(--t2) var(--ease);
  }

  .gk__arrow:hover {
    border-color: var(--green);
    background: var(--green);
    color: #fff;
  }

  .gk__dot {
    width: 1.75rem;
    height: 4px;
    border-radius: 999px;
    background: var(--line-light);
    transition:
      width 420ms var(--ease),
      background-color var(--t2) var(--ease);
  }

  .gk__dot:hover {
    background: var(--text-3);
  }

  .gk__dot[data-on] {
    width: 3.5rem;
    background: var(--green);
  }

  /* ---------- rail ---------- */

  .gk__vp {
    position: relative;
    z-index: 1;
    overflow: hidden;
  }

  .gk__rail {
    /* Narrower and taller than before: the comp's card is a portrait
       panel carrying a blurb under the title, not a landscape tile. */
    --cw: clamp(14.5rem, 20vw, 19rem);
    --cg: clamp(0.85rem, 1.4vw, 1.4rem);
    display: flex;
    gap: var(--cg);
    align-items: stretch;
    /* Room for the floating tile to hang below the photograph. */
    padding: 0.75rem 0 2.25rem;
    will-change: transform;
    transition: transform 700ms var(--ease);
  }

  .gk__rail[data-nosnap] {
    transition: none;
  }

  /* Every slide is the same width. The active one is not wider — the
     dots and arrows move the rail, they do not resize it. */
  .gk__slide {
    flex: 0 0 var(--cw);
    width: var(--cw);
    display: flex;
  }

  /* ---------- the card ---------- */

  .gk__card {
    position: relative;
    display: grid;
    /* Caption takes the slack so every arrow lines up across the rail
       however many lines a title runs to. */
    grid-template-rows: auto minmax(0, 1fr) auto;
    width: 100%;
    padding: 0.85rem 0.85rem 1.15rem;
    border-radius: 22px;
    background: var(--white);
    box-shadow:
      0 1px 2px rgb(10 30 12 / 0.05),
      0 20px 38px -24px rgb(10 30 12 / 0.3);
    transition: transform var(--t2) var(--ease), box-shadow var(--t2) var(--ease);
  }
  .gk__card:hover,
  .gk__card:focus-within {
    transform: translateY(-6px);
    box-shadow:
      0 1px 2px rgb(10 30 12 / 0.06),
      0 34px 58px -26px rgb(10 30 12 / 0.4);
  }

  /* Not clipped: the tile overlaps its bottom-left corner. */
  .gk__shot {
    position: relative;
    display: block;
    /* Space for the tile that hangs past it. */
    padding-bottom: 2.1rem;
  }

  .gk__img {
    display: block;
    aspect-ratio: 5 / 4;
    overflow: hidden;
    /* The one soft corner the comp gives the picture. */
    border-radius: 18px 18px 18px 34px;
    background: var(--off-2);
  }
  .gk__img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: scale 600ms var(--ease);
  }
  .gk__card:hover .gk__img :global(img) { scale: 1.05; }

  .gk__badge {
    position: absolute;
    left: 0.35rem;
    bottom: 0.55rem;
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 18px;
    background: #e7f1e9;
    color: var(--green-deep);
    box-shadow:
      0 0 0 5px var(--white),
      0 12px 22px -14px rgb(10 30 12 / 0.45);
    transition: transform var(--t2) var(--ease);
  }
  .gk__card:hover .gk__badge { transform: translateY(-3px); }

  .gk__cap {
    display: grid;
    align-content: start;
    gap: 0.5rem;
    padding: 0 0.3rem;
  }

  .gk__kick {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--green-deep);
  }

  .gk__ct {
    font-size: 1.0625rem;
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.28;
    color: var(--text);
  }

  .gk__sub {
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--text-2);
  }

  /* The circle is the affordance; the anchor around it covers the card
     so the whole panel is clickable. */
  .gk__go {
    justify-self: end;
    padding: 0.3rem 0.3rem 0;
  }
  .gk__go::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
  }
  .gk__ring {
    position: relative;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    background: #e7f1e9;
    color: var(--green-deep);
    transition:
      background-color var(--t2) var(--ease),
      color var(--t2) var(--ease),
      transform var(--t2) var(--ease);
  }
  .gk__card:hover .gk__ring {
    background: var(--green);
    color: #fff;
    transform: translateX(3px);
  }
  .gk__go:focus-visible .gk__ring {
    outline: 2px solid var(--green-deep);
    outline-offset: 3px;
  }


  /* ---------- mobile ---------- */

  @media (min-width: 62rem) {
    .gk__head {
      grid-template-columns: 1fr auto;
      align-items: end;
    }
  }

  @media (max-width: 40rem) {
    .gk__rail {
      --cw: min(78vw, 18rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gk__rail,
    .gk__card,
    .gk__badge,
    .gk__ring,
    .gk__img :global(img) {
      transition: none !important;
    }
    .gk__card:hover,
    .gk__card:hover .gk__badge,
    .gk__card:hover .gk__ring {
      transform: none;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-gk]');
  const rail = root?.querySelector<HTMLElement>('[data-rail]');
  const vp = root?.querySelector<HTMLElement>('.gk__vp');

  if (root && rail && vp) {
    const slides = [...rail.querySelectorAll<HTMLElement>('[data-slide]')];
    const dots = [...root.querySelectorAll<HTMLElement>('[data-dot]')];
    const N = dots.length;

    // Start on the middle copy so there is always a set either side.
    let idx = N;

    /* Measure the rendered slide rather than reading --cw: that token is a
       clamp() expression, so getPropertyValue returns the literal text. */
    const metrics = () => {
      const cw = slides[0].getBoundingClientRect().width;
      const gap = parseFloat(getComputedStyle(rail).gap) || 16;
      return { step: cw + gap, cw };
    };

    /* Centre the active slide in the viewport — the reference uses
       Swiper's centeredSlides, and centring is what keeps the open card
       in the same place every time. */
    const place = (animate = true) => {
      const { step, cw } = metrics();
      const x = idx * step - (vp.clientWidth - cw) / 2;

      rail.toggleAttribute('data-nosnap', !animate);
      rail.style.transform = `translate3d(${-x}px, 0, 0)`;
      if (!animate) void rail.offsetWidth; // flush before re-enabling
    };

    const paint = () => {
      const real = ((idx % N) + N) % N;
      slides.forEach((s, n) => s.toggleAttribute('data-on', n === idx));
      dots.forEach((d, n) => {
        d.toggleAttribute('data-on', n === real);
        d.setAttribute('aria-selected', String(n === real));
      });
    };

    const go = (next: number) => {
      idx = next;
      paint();
      place(true);
    };

    /* After the slide finishes, jump silently back into the middle copy
       so the rail can run forever in either direction. */
    rail.addEventListener('transitionend', (e) => {
      if (e.propertyName !== 'transform') return;
      if (idx < N || idx >= N * 2) {
        idx = (((idx % N) + N) % N) + N;
        paint();
        place(false);
      }
    });

    /* The card is a link now. A click on one that is already centred
       follows it; a click on one off to the side brings it to the
       middle first, which is what a person reaching for a half-visible
       card at the edge of the rail actually means. */
    slides.forEach((s, i) => {
      const hit = s.querySelector<HTMLAnchorElement>('[data-hit]');
      hit?.addEventListener('click', (e) => {
        if (i === idx) return;
        e.preventDefault();
        go(i);
      });
    });

    dots.forEach((d, i) =>
      d.addEventListener('click', () => {
        // Move to the nearest copy of that item, so it never jumps far.
        const base = Math.floor(idx / N) * N;
        go(base + i);
      })
    );

    root.querySelector('[data-next]')?.addEventListener('click', () => go(idx + 1));
    root.querySelector('[data-prev]')?.addEventListener('click', () => go(idx - 1));

    window.addEventListener('resize', () => place(false), { passive: true });
    window.addEventListener('load', () => place(false));

    paint();
    place(false);
  }
</script>
