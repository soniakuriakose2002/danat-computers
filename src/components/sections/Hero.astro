---
import { Image } from 'astro:assets';
import Icon from '@components/ui/Icon.astro';
import { site } from '@data/site';
import { hubServices, nodePos } from '@data/services';

import imgRepair from '@assets/photos/repair-board.jpg';
import imgPrinter from '@assets/photos/printer-machine.jpg';
import imgCctv from '@assets/photos/cctv-wall.jpg';
import imgNetwork from '@assets/photos/network-patch.jpg';
import imgData from '@assets/photos/datarecovery-drive.jpg';
import imgSupport from '@assets/photos/support-agent.jpg';

const media = {
  repair: { img: imgRepair, alt: 'Technician repairing a laptop mainboard' },
  printer: { img: imgPrinter, alt: 'Office printing machine in service' },
  cctv: { img: imgCctv, alt: 'Security cameras mounted on a wall' },
  network: { img: imgNetwork, alt: 'Network patch panel and cabling' },
  data: { img: imgData, alt: 'Inside an opened hard disk drive' },
  support: { img: imgSupport, alt: 'Support agent with a headset at a workstation' },
};

const headline = [
  [{ t: 'Technology' }],
  [{ t: 'that keeps' }],
  [{ t: 'you ' }, { t: 'moving.', accent: true }],
];

const branchNames = ['Muscat', 'Sohar', 'Salalah'];
---

<section class="hx" data-tone="ink" data-hub id="main">
  <!-- ─── backdrop: one frame per service, cross-fading ─── -->
  <div class="hx__bg" aria-hidden="true">
    {hubServices.map((s, i) => {
      const m = media[s.key as keyof typeof media];
      return (
        <div class="hx__bgframe" data-bg={i} data-on={i === 0 ? '' : undefined}>
          <Image
            src={m.img}
            alt=""
            widths={[900, 1400, 1920, 2400]}
            sizes="100vw"
            quality={72}
            format="webp"
            loading={i === 0 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : undefined}
          />
        </div>
      );
    })}
    <div class="hx__veil"></div>
    <div class="hx__glow"></div>
  </div>

  <!-- ─── left index rail ─── -->
  <div class="hx__rail" aria-hidden="true">
    <ol>
      {hubServices.map((s, i) => (
        <li data-rail={i} data-on={i === 0 ? '' : undefined}>{s.n}</li>
      ))}
    </ol>
    <span class="hx__railcue"><i></i>Scroll</span>
  </div>

  <!-- ─── right vertical branch list ─── -->
  <div class="hx__side" aria-hidden="true">
    {branchNames.map((b, i) => (
      <>
        {i > 0 && <span class="hx__sidedot">&middot;</span>}
        <span>{b}</span>
      </>
    ))}
  </div>

  <div class="hx__grid">
    <!-- ─── copy ─── -->
    <div class="hx__copy">
      <p class="hx__kicker" data-rise>One company.<br />Many solutions.</p>

      <h1 class="hx__title">
        {headline.map((line, li) => (
          <span class="mask">
            <span class="mask__i" style={`--d:${140 + li * 110}ms`}>
              {line.map((w) => (w.accent ? <em>{w.t}</em> : w.t))}
            </span>
          </span>
        ))}
      </h1>

      <p class="hx__lead" data-rise style="--d:520ms">
        Repair. Protect. Connect. Recover. Support.<br />
        Danat Computers delivers reliable IT solutions for individuals and
        businesses across Oman.
      </p>

      <a class="hx__cta" href="/services" data-rise style="--d:600ms">
        Explore Our Services
        <span><Icon name="arrow" size={15} /></span>
      </a>

      <dl class="hx__stats" data-rise style="--d:680ms">
        <div>
          <dt>20<span>+</span></dt>
          <dd>Years of Experience</dd>
        </div>
        <div>
          <dt>{site.stats.branches}</dt>
          <dd>Branches Across Oman</dd>
        </div>
      </dl>
    </div>

    <!-- ─── the hub ─── -->
    <div class="hx__hub" data-rise style="--d:400ms">
      <div class="hx__ring hx__ring--1"></div>
      <div class="hx__ring hx__ring--2"></div>

      <svg class="hx__spokes" viewBox="-50 -50 100 100" aria-hidden="true">
        {hubServices.map((s, i) => {
          const p = nodePos(s.angle, 33);
          return (
            <line
              x1="0" y1="0" x2={p.x} y2={p.y}
              data-spoke={i}
              data-on={i === 0 ? '' : undefined}
            />
          );
        })}
      </svg>

      <div class="hx__core">
        <img src="/brand/danat-logo.webp" alt="" width="100" height="100" />
        <span class="hx__corepulse"></span>
      </div>

      {hubServices.map((s, i) => {
        const p = nodePos(s.angle, 38);
        return (
          <button
            type="button"
            class="hx__node"
            data-node={i}
            data-on={i === 0 ? '' : undefined}
            style={`--x:${p.x}; --y:${p.y}`}
            aria-label={`Show ${s.title}`}
          >
            <span class="hx__nodenum">{s.n}</span>
            <span class="hx__nodedisc"><Icon name={s.icon} size={26} /></span>
            <span class="hx__nodelabel">{s.title}</span>
          </button>
        );
      })}
    </div>

    <!-- ─── active service panel ─── -->
    <div class="hx__panel" data-rise style="--d:560ms">
      <p class="hx__count"><b data-panel-n>01</b> / 06</p>

      {hubServices.map((s, i) => (
        <div class="hx__detail" data-detail={i} data-on={i === 0 ? '' : undefined}>
          <h2 class="hx__dtitle">{s.title}</h2>
          <p class="hx__dtag">{s.tagline}</p>
          <p class="hx__dbody">{s.body}</p>
          <a class="hx__dlink" href={s.href}>
            Learn More <Icon name="arrow" size={14} />
          </a>
        </div>
      ))}

      <div class="hx__arrows">
        <button type="button" data-prev aria-label="Previous service">
          <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor"
            stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M19 12H5M11 6l-6 6 6 6" />
          </svg>
        </button>
        <button type="button" data-next aria-label="Next service">
          <Icon name="arrow" size={17} />
        </button>
      </div>
    </div>
  </div>

  <!-- ─── bottom thumbnail strip ─── -->
  <div class="hx__strip">
    <div class="hx__striptrack">
      {hubServices.map((s, i) => {
        const m = media[s.key as keyof typeof media];
        return (
          <button
            type="button"
            class="hx__thumb"
            data-thumb={i}
            data-on={i === 0 ? '' : undefined}
            aria-label={`Show ${s.title}`}
          >
            <span class="hx__thumbimg">
              <Image src={m.img} alt="" widths={[200, 400]} sizes="180px"
                quality={70} format="webp" loading="lazy" />
            </span>
            <span class="hx__thumbmeta">
              <b>{s.title}</b>
              <i>{s.n}</i>
            </span>
          </button>
        );
      })}
    </div>
  </div>
</section>

<style>
  .hx {
    position: relative;
    min-height: 100svh;
    display: grid;
    grid-template-rows: 1fr auto;
    background: var(--ink);
    color: var(--text-inv);
    overflow: clip;
    isolation: isolate;
  }

  /* ---------- backdrop ---------- */

  .hx__bg {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  /* Cross-fade without a gap.
     Fading both frames at once leaves them each at ~50% mid-transition,
     so the dark section shows through and the image appears to blink.
     Instead the incoming frame sits ON TOP and fades in, while the
     outgoing one holds at full opacity and only fades out afterwards —
     underneath, where it is no longer visible. */
  .hx__bgframe {
    position: absolute;
    inset: 0;
    opacity: 0;
    z-index: 0;
    transform: scale(1.06);
    transition:
      opacity 600ms var(--ease) 620ms,
      transform 1600ms var(--ease);
  }

  .hx__bgframe[data-on] {
    opacity: 1;
    z-index: 1;
    transition:
      opacity 600ms var(--ease) 0ms,
      transform 1600ms var(--ease);
    transform: scale(1);
  }

  .hx__bgframe :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 70% 40%;
  }

  /* Heavy graded veil — the photo is atmosphere, not the subject.
     NOTE: the cross-fade gives the active frame z-index 1, so the veil
     and glow must sit explicitly above it or the photo paints over them. */
  .hx__veil {
    position: absolute;
    inset: 0;
    z-index: 2;
    background:
      linear-gradient(100deg, rgb(8 12 11 / 0.97) 0%, rgb(8 12 11 / 0.86) 38%,
        rgb(8 12 11 / 0.55) 62%, rgb(8 12 11 / 0.72) 100%),
      linear-gradient(to top, rgb(6 9 9 / 0.95) 0%, transparent 42%);
  }

  .hx__glow {
    position: absolute;
    z-index: 3;
    left: 50%;
    top: 46%;
    width: min(60vw, 46rem);
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    background: radial-gradient(circle,
      color-mix(in oklab, var(--green) 30%, transparent) 0%,
      transparent 62%);
    filter: blur(60px);
    pointer-events: none;
  }

  /* ---------- rails ---------- */

  .hx__rail {
    position: absolute;
    left: clamp(0.75rem, 2vw, 2rem);
    top: 50%;
    transform: translateY(-50%);
    display: none;
    flex-direction: column;
    align-items: center;
    gap: var(--s5);
    z-index: 2;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
  }

  .hx__rail ol {
    display: grid;
    gap: 0.85rem;
    color: var(--text-inv-3);
  }

  .hx__rail li {
    transition: color var(--t2) var(--ease), transform var(--t2) var(--ease);
  }

  .hx__rail li[data-on] {
    color: #fff;
    transform: scale(1.18);
  }

  .hx__railcue {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.5625rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--text-inv-3);
  }

  .hx__railcue i {
    width: 1px;
    height: 3.5rem;
    background: linear-gradient(to bottom, transparent, var(--green-bright));
  }

  .hx__side {
    position: absolute;
    right: clamp(0.5rem, 1.6vw, 1.5rem);
    top: 50%;
    transform: translateY(-50%) rotate(180deg);
    writing-mode: vertical-rl;
    display: none;
    align-items: center;
    gap: 0.75rem;
    z-index: 2;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--text-inv-3);
  }

  .hx__sidedot {
    color: var(--green-bright);
  }

  /* ---------- grid ---------- */

  .hx__grid {
    display: grid;
    gap: var(--s7);
    align-items: center;
    width: 100%;
    max-width: 110rem;
    margin-inline: auto;
    padding: 7.5rem clamp(1.25rem, 4vw, 4rem) 2rem;
  }

  /* ---------- copy ---------- */

  .hx__kicker {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    line-height: 1.7;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-inv-2);
    padding-left: 3.25rem;
    position: relative;
    margin-bottom: var(--s5);
  }

  .hx__kicker::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 2.25rem;
    height: 2px;
    background: var(--green-bright);
  }

  .hx__title {
    font-size: clamp(2.6rem, 5.4vw, 5.25rem);
    line-height: 1.02;
    letter-spacing: -0.035em;
    font-weight: 600;
    color: #fff;
  }

  .hx__title em {
    font-style: normal;
    color: var(--green-bright);
  }

  .hx__lead {
    max-width: 42ch;
    margin-top: var(--s5);
    font-size: clamp(0.9375rem, 1vw, 1.0625rem);
    line-height: 1.65;
    color: var(--text-inv-2);
  }

  .hx__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    margin-top: var(--s6);
    padding: 0.9rem 0.9rem 0.9rem 1.6rem;
    border: 1px solid rgb(255 255 255 / 0.28);
    border-radius: 999px;
    font-size: 0.9375rem;
    font-weight: 500;
    transition: border-color var(--t2) var(--ease), background-color var(--t2) var(--ease);
  }

  .hx__cta span {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--green);
    color: #fff;
    transition: transform var(--t2) var(--ease);
  }

  .hx__cta:hover {
    border-color: var(--green-bright);
    background: rgb(89 170 84 / 0.12);
  }

  .hx__cta:hover span {
    transform: translateX(3px);
  }

  .hx__stats {
    display: flex;
    gap: var(--s6);
    margin-top: var(--s7);
  }

  .hx__stats > div + div {
    padding-left: var(--s6);
    border-left: 1px solid rgb(255 255 255 / 0.16);
  }

  .hx__stats dt {
    font-size: clamp(1.75rem, 2.4vw, 2.25rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .hx__stats dt span {
    color: var(--green-bright);
  }

  .hx__stats dd {
    margin-top: 0.4rem;
    font-size: 0.75rem;
    color: var(--text-inv-2);
  }

  /* ---------- the hub ---------- */

  .hx__hub {
    position: relative;
    display: none;
    aspect-ratio: 1;
    width: 100%;
    max-width: 34rem;
    justify-self: center;
  }

  .hx__ring {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    border-radius: 50%;
    border: 1px dashed rgb(255 255 255 / 0.13);
  }

  .hx__ring--1 {
    width: 76%;
    aspect-ratio: 1;
    animation: spin 90s linear infinite;
  }

  .hx__ring--2 {
    width: 44%;
    aspect-ratio: 1;
    border-style: solid;
    border-color: rgb(111 201 106 / 0.18);
    animation: spin 60s linear infinite reverse;
  }

  @keyframes spin {
    to {
      rotate: 360deg;
    }
  }

  .hx__spokes {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .hx__spokes line {
    stroke: rgb(255 255 255 / 0.16);
    stroke-width: 0.35;
    stroke-dasharray: 1.6 1.6;
    transition: stroke var(--t2) var(--ease), stroke-width var(--t2) var(--ease);
  }

  .hx__spokes line[data-on] {
    stroke: var(--green-bright);
    stroke-width: 0.6;
  }

  .hx__core {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    display: grid;
    place-items: center;
    width: 33%;
    aspect-ratio: 1;
    border-radius: 50%;
    background:
      radial-gradient(circle, rgb(12 20 16 / 0.95) 0%, rgb(8 12 11 / 0.9) 70%);
    border: 1px solid rgb(111 201 106 / 0.45);
    box-shadow:
      0 0 0 6px rgb(111 201 106 / 0.05),
      0 0 50px rgb(89 170 84 / 0.35),
      inset 0 0 30px rgb(89 170 84 / 0.12);
  }

  .hx__core img {
    width: 58%;
    height: auto;
  }

  .hx__corepulse {
    position: absolute;
    inset: -1px;
    border-radius: 50%;
    border: 1px solid var(--green-bright);
    opacity: 0;
    animation: corepulse 3.4s var(--ease) infinite;
  }

  @keyframes corepulse {
    0% { transform: scale(1); opacity: 0.5; }
    70% { transform: scale(1.22); opacity: 0; }
    100% { transform: scale(1.22); opacity: 0; }
  }

  .hx__node {
    position: absolute;
    left: calc(50% + var(--x) * 1%);
    top: calc(50% + var(--y) * 1%);
    translate: -50% -50%;
    display: grid;
    justify-items: center;
    gap: 0.5rem;
    width: 8.5rem;
    color: var(--text-inv-2);
  }

  .hx__nodenum {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.14em;
    color: var(--text-inv-3);
    transition: color var(--t2) var(--ease);
  }

  .hx__nodedisc {
    display: grid;
    place-items: center;
    width: 4.25rem;
    height: 4.25rem;
    border-radius: 50%;
    border: 1px solid rgb(255 255 255 / 0.2);
    background: rgb(10 16 14 / 0.72);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    transition:
      border-color var(--t2) var(--ease),
      box-shadow var(--t2) var(--ease),
      transform var(--t2) var(--ease),
      color var(--t2) var(--ease);
  }

  .hx__nodelabel {
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.3;
    text-align: center;
    transition: color var(--t2) var(--ease);
  }

  .hx__node:hover .hx__nodedisc,
  .hx__node:focus-visible .hx__nodedisc {
    transform: scale(1.06);
    border-color: rgb(111 201 106 / 0.6);
  }

  .hx__node[data-on] .hx__nodenum {
    color: var(--green-bright);
  }

  .hx__node[data-on] .hx__nodedisc {
    color: var(--green-bright);
    border-color: var(--green-bright);
    box-shadow:
      0 0 0 5px rgb(111 201 106 / 0.08),
      0 0 26px rgb(89 170 84 / 0.5);
  }

  .hx__node[data-on] .hx__nodelabel {
    color: #fff;
  }

  /* ---------- panel ---------- */

  .hx__panel {
    position: relative;
    padding-left: var(--s5);
    border-left: 2px solid var(--green);
    max-width: 24rem;
  }

  .hx__count {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    color: var(--text-inv-3);
    margin-bottom: var(--s4);
  }

  .hx__count b {
    color: #fff;
    font-weight: 500;
  }

  .hx__detail {
    display: none;
  }

  .hx__detail[data-on] {
    display: block;
    animation: fade-up var(--t3) var(--ease) both;
  }

  .hx__dtitle {
    font-size: clamp(1.5rem, 2vw, 2rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.08;
    color: #fff;
  }

  .hx__dtag {
    margin-top: 0.7rem;
    font-size: 1rem;
    font-weight: 500;
    color: var(--green-bright);
  }

  .hx__dbody {
    margin-top: 0.6rem;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--text-inv-2);
  }

  .hx__dlink {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: var(--s5);
    padding: 0.75rem 1.4rem;
    border-radius: 999px;
    background: var(--green);
    color: #fff;
    font-size: 0.875rem;
    font-weight: 500;
    transition: background-color var(--t2) var(--ease);
  }

  .hx__dlink:hover {
    background: #fff;
    color: var(--ink);
  }

  .hx__arrows {
    display: flex;
    gap: 0.7rem;
    margin-top: var(--s6);
  }

  .hx__arrows button {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    border: 1px solid rgb(255 255 255 / 0.25);
    color: var(--text-inv-2);
    transition:
      border-color var(--t2) var(--ease),
      color var(--t2) var(--ease),
      background-color var(--t2) var(--ease);
  }

  .hx__arrows button:hover {
    border-color: var(--green-bright);
    color: #fff;
    background: rgb(89 170 84 / 0.16);
  }

  /* ---------- thumbnail strip ---------- */

  .hx__strip {
    position: relative;
    z-index: 2;
    padding: 0 clamp(1.25rem, 4vw, 4rem) clamp(1.25rem, 3vw, 2.25rem);
    overflow-x: auto;
    scrollbar-width: none;
  }

  .hx__strip::-webkit-scrollbar {
    display: none;
  }

  .hx__striptrack {
    display: flex;
    gap: 0.75rem;
    min-width: max-content;
    justify-content: center;
  }

  .hx__thumb {
    position: relative;
    width: 11rem;
    border-radius: 6px;
    overflow: hidden;
    border: 1.5px solid transparent;
    background: rgb(10 16 14 / 0.6);
    text-align: left;
    transition: border-color var(--t2) var(--ease), transform var(--t2) var(--ease);
  }

  .hx__thumb:hover {
    transform: translateY(-3px);
  }

  .hx__thumb[data-on] {
    border-color: var(--green-bright);
  }

  .hx__thumbimg {
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }

  .hx__thumbimg :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.8) brightness(0.72);
    transition: filter var(--t2) var(--ease);
  }

  .hx__thumb[data-on] .hx__thumbimg :global(img),
  .hx__thumb:hover .hx__thumbimg :global(img) {
    filter: saturate(1) brightness(0.95);
  }

  .hx__thumbmeta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.6rem 0.7rem 0.7rem;
  }

  .hx__thumbmeta b {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--text-inv);
  }

  .hx__thumbmeta i {
    font-style: normal;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: var(--text-inv-3);
  }

  .hx__thumb[data-on] .hx__thumbmeta i {
    color: var(--green-bright);
  }

  /* ---------- responsive ---------- */

  @media (min-width: 60rem) {
    .hx__rail,
    .hx__side {
      display: flex;
    }
    .hx__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.95fr);
      padding-inline: clamp(4rem, 7vw, 7rem);
    }
    .hx__panel {
      grid-column: 2;
      justify-self: end;
    }
  }

  @media (min-width: 86rem) {
    .hx__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr) minmax(0, 0.75fr);
      gap: var(--s6);
    }
    .hx__hub {
      display: block;
    }
    .hx__panel {
      grid-column: auto;
    }
  }

  @media (max-width: 60rem) {
    .hx__striptrack {
      justify-content: flex-start;
    }
    .hx__thumb {
      width: 9.5rem;
    }
    .hx__grid {
      padding-top: 6.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hx__ring--1,
    .hx__ring--2,
    .hx__corepulse {
      animation: none;
    }
    .hx__bgframe {
      transition: opacity 1ms !important;
      transform: none;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-hub]');
  if (root) {
    const q = <T extends Element>(s: string) => [...root.querySelectorAll<T>(s)];
    const nodes = q<HTMLElement>('[data-node]');
    const details = q<HTMLElement>('[data-detail]');
    const thumbs = q<HTMLElement>('[data-thumb]');
    const bgs = q<HTMLElement>('[data-bg]');
    const spokes = q<SVGLineElement>('[data-spoke]');
    const rails = q<HTMLElement>('[data-rail]');
    const counter = root.querySelector<HTMLElement>('[data-panel-n]');
    const total = nodes.length;

    let active = 0;
    let timer: number | undefined;

    const show = (i: number) => {
      active = (i + total) % total;
      const on = (el: Element, n: number) => el.toggleAttribute('data-on', n === active);
      nodes.forEach(on);
      details.forEach(on);
      thumbs.forEach(on);
      bgs.forEach(on);
      spokes.forEach(on);
      rails.forEach(on);
      if (counter) counter.textContent = String(active + 1).padStart(2, '0');
    };

    // Gentle auto-advance; any interaction stops it for good.
    const stop = () => {
      if (timer) window.clearInterval(timer);
      timer = undefined;
    };
    const start = () => {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      stop();
      timer = window.setInterval(() => show(active + 1), 3600);
    };

    const pick = (i: number) => {
      stop();
      show(i);
    };

    nodes.forEach((el, i) => {
      el.addEventListener('click', () => pick(i));
      el.addEventListener('pointerenter', () => pick(i));
    });
    thumbs.forEach((el, i) => {
      el.addEventListener('click', () => pick(i));
      el.addEventListener('pointerenter', () => pick(i));
    });
    root.querySelector('[data-next]')?.addEventListener('click', () => pick(active + 1));
    root.querySelector('[data-prev]')?.addEventListener('click', () => pick(active - 1));

    // Pause while the hero is off-screen — no work when not visible.
    const io = new IntersectionObserver(
      ([e]) => (e.isIntersecting && timer !== null ? start() : stop()),
      { threshold: 0.25 }
    );
    io.observe(root);

    start();
  }
</script>
