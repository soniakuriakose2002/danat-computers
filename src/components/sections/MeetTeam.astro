---
/**
 * MEET OUR TEAM — soft pastel cards, one per person: a tinted photo panel
 * with a curved lower edge, a coloured department label, name, title, a
 * line about what they do, and LinkedIn / email buttons.
 * Filter by branch (All / Ruwi / Sohar / Salalah).
 * People and photos come from src/data/team.ts and src/assets/team/.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from '@components/ui/Icon.astro';
import Mark from '@components/ui/Mark.astro';
import { team, teamBranches, deptLabels } from '@data/team';

const files = import.meta.glob<{ default: ImageMetadata }>('/src/assets/team/*.{jpg,jpeg,png,webp,JPG,JPEG,PNG,WEBP}', { eager: true });
const photoFor = (name?: string) => {
  if (!name) return undefined;
  const hit = Object.entries(files).find(([k]) => k.endsWith('/' + name));
  return hit?.[1].default;
};
const people = team.map((m) => ({ ...m, img: photoFor(m.photo) }));
const complete = people.every((m) => m.name && m.img);
const tabs = [{ slug: 'all', name: 'All team' }, ...teamBranches];
---
<section class="mt" data-mt>
  <div class="shell">
    <header class="mt__head">
      <span class="mt__deco" aria-hidden="true"><i></i><i></i><b></b></span>
      <h2 class="mt__h">Meet Our <Mark as="underline"><em>Team</em></Mark></h2>
      <p class="mt__p">A passionate team of experts working together to deliver the best technology solutions and support across Oman.</p>
      <div class="mt__tabs" role="tablist" aria-label="Filter by branch">
        <span class="mt__pill" data-mt-pill aria-hidden="true"></span>
        {tabs.map((t, i) => (
          <button class="mt__tab" role="tab" type="button" aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-mt-tab={t.slug}>
            {t.name}<small>{t.slug === 'all' ? people.length : people.filter((p) => p.branch === t.slug).length}</small>
          </button>
        ))}
      </div>
    </header>

    <ul class="mt__grid is-on" data-mt-grid>
      {people.map((p, k) => (
        <li class:list={['mt__card', `mt--${p.dept}`]} data-branch={p.branch} data-tilt style={`--k:${k}`}>
          <figure class="mt__img">
            {p.img
              ? <Image src={p.img} alt={p.name || p.role} widths={[360, 560]} sizes="(min-width:62rem) 22vw, 45vw" quality={80} format="webp" loading="lazy" />
              : <svg class="mt__ph" viewBox="0 0 100 80" preserveAspectRatio="xMidYMax meet" aria-hidden="true"><circle cx="50" cy="33" r="15" fill="currentColor" opacity="0.3"/><path d="M20 80c2-20 14-30 30-30s28 10 30 30Z" fill="currentColor" opacity="0.3"/></svg>}
          </figure>
          <span class="mt__tag">{deptLabels[p.dept]}</span>
          <div class="mt__body">
            <b class:list={['mt__name', { 'is-empty': !p.name }]}>{p.name || 'Name'}</b>
            <span class="mt__role">{p.role}</span>
            {p.bio && <p class="mt__bio">{p.bio}</p>}
            <div class="mt__foot">
              <small class="mt__br">{teamBranches.find((b) => b.slug === p.branch)?.name}</small>
              <span class="mt__links">
                <a href={p.linkedin || undefined} target="_blank" rel="noopener noreferrer" aria-label={p.name ? `${p.name} on LinkedIn` : 'LinkedIn'} aria-disabled={p.linkedin ? undefined : 'true'}>in</a>
                <a href={p.email ? `mailto:${p.email}` : undefined} aria-label={p.name ? `Email ${p.name}` : 'Email'} aria-disabled={p.email ? undefined : 'true'}><Icon name="mail" size={13} /></a>
              </span>
            </div>
          </div>
        </li>
      ))}
    </ul>
    {!complete && <p class="mt__draft">Draft — add staff photos and names in src/data/team.ts before going live.</p>}
  </div>
</section>

<style>
  .mt { background: linear-gradient(180deg, #fbfcfb 0%, #f6f8fb 100%); padding-block: clamp(5rem, 10vw, 8rem); }
  .mt__head { display: grid; justify-items: center; text-align: center; margin-bottom: 2.6rem; }
  .mt__deco { display: flex; align-items: center; gap: 8px; }
  .mt__deco i { width: 30px; height: 3px; border-radius: 2px; background: #d4ebd5; }
  .mt__deco i + i { background: var(--green); }
  .mt__deco b { width: 7px; height: 7px; border-radius: 50%; background: var(--green-deep); }
  .mt__h { margin-top: 0.9rem; font-size: var(--d5); font-weight: 700; letter-spacing: var(--tr5); line-height: 1.1; }
  .mt__h em { font-style: normal; color: var(--green); }
  .mt__p { margin-top: 0.8rem; max-width: 52ch; font-size: 0.9375rem; line-height: 1.68; color: var(--text-2); }

  .mt__tabs { position: relative; margin-top: 1.6rem; display: inline-flex; padding: 5px; border-radius: 999px; background: #fff; border: 1px solid rgb(0 0 0 / 0.07); box-shadow: 0 10px 26px -20px rgb(20 40 25 / 0.4); }
  .mt__pill { position: absolute; top: 5px; bottom: 5px; left: 0; width: 0; border-radius: 999px; background: var(--green-deep); transition: transform 0.5s var(--ease), width 0.5s var(--ease); }
  .mt__tab { position: relative; z-index: 1; display: inline-flex; align-items: center; gap: 0.45rem; padding: 0.6rem 1.1rem; border: 0; border-radius: 999px; background: none;
    font-weight: 700; font-size: 0.9rem; color: var(--text-2); cursor: pointer; transition: color 0.3s; }
  .mt__tab small { display: grid; place-items: center; min-width: 20px; height: 20px; padding: 0 5px; border-radius: 999px; background: rgb(0 0 0 / 0.06); font-size: 0.7rem; }
  .mt__tab[aria-selected='true'] { color: #fff; }
  .mt__tab[aria-selected='true'] small { background: rgb(255 255 255 / 0.2); }

  /* pastel departments */
  .mt--ceo        { --tint: #d9ece0; --ink: #1f8a4c; }
  .mt--management { --tint: #f7dfe0; --ink: #d0364a; }
  .mt--sales      { --tint: #dde8f8; --ink: #2d6fd0; }
  .mt--technical  { --tint: #dcefe0; --ink: #1f8a4c; }
  .mt--service    { --tint: #e8e1f5; --ink: #7a4bd0; }
  .mt--admin      { --tint: #dcefe0; --ink: #1f8a4c; }
  .mt--accounts   { --tint: #faead4; --ink: #e07a10; }
  .mt--business   { --tint: #dde8f8; --ink: #2d6fd0; }

  .mt__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.4rem; perspective: 1200px; }
  .mt__card { position: relative; display: flex; flex-direction: column; border-radius: 20px; background: #fff; box-shadow: 0 1px 2px rgb(0 0 0 / 0.04), 0 18px 40px -26px rgb(30 40 60 / 0.3);
    transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg)) translateY(var(--ly, 0px)); transition: transform 0.5s var(--ease), box-shadow 0.5s var(--ease); }
  .mt__card[hidden] { display: none; }
  .mt__card:hover { --ly: -6px; box-shadow: 0 1px 2px rgb(0 0 0 / 0.04), 0 30px 56px -28px rgb(30 40 60 / 0.4); }
  .mt__grid.is-on .mt__card:not([hidden]) { animation: mtIn 0.75s cubic-bezier(0.2, 0.9, 0.25, 1) both; animation-delay: calc(var(--o, 0) * 80ms); }
  @keyframes mtIn { from { opacity: 0; transform: translateY(28px) scale(0.97); } to { opacity: 1; transform: none; } }

  /* the tinted photo panel with a soft, uneven curve along its lower edge */
  .mt__img { position: relative; margin: 0; aspect-ratio: 5 / 4; overflow: hidden; color: var(--ink);
    border-radius: 20px 20px 58% 42% / 20px 20px 14% 9%; background: var(--tint); }
  .mt__img :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 50% 18%; transition: transform 0.7s var(--ease); }
  .mt__card:hover .mt__img :global(img) { transform: scale(1.05); }
  .mt__ph { position: absolute; left: 0; right: 0; bottom: 0; width: 100%; height: 90%; }
  .mt__tag { position: relative; z-index: 1; align-self: flex-start; margin: -1.15rem 0 0 1.1rem; padding: 0.35rem 0.85rem; border-radius: 999px; background: #fff;
    border: 1.5px solid var(--ink); color: var(--ink); font-size: 0.76rem; font-weight: 600; transition: background 0.3s, color 0.3s; }
  .mt__card:hover .mt__tag { background: var(--ink); color: #fff; }
  .mt__body { display: grid; gap: 0.2rem; padding: 0.85rem 1.2rem 1.1rem; flex: 1; }
  .mt__name { font-size: 1.1rem; letter-spacing: -0.02em; }
  .mt__name.is-empty { color: var(--text-3); }
  .mt__role { font-size: 0.85rem; color: var(--text-2); }
  .mt__bio { margin-top: 0.4rem; font-size: 0.84rem; line-height: 1.5; color: var(--text-2); }
  .mt__foot { display: flex; align-items: center; justify-content: space-between; margin-top: auto; padding-top: 0.9rem; }
  .mt__br { font-family: var(--font-mono); font-size: 0.64rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-3); }
  .mt__links { display: flex; gap: 0.45rem; }
  .mt__links a { display: grid; place-items: center; width: 32px; height: 32px; border-radius: 50%; border: 1.5px solid rgb(0 0 0 / 0.55); font-size: 0.78rem; font-weight: 800; color: var(--text);
    transition: background 0.2s, color 0.2s, border-color 0.2s, transform 0.2s; }
  .mt__links a:not([aria-disabled]):hover { background: var(--ink); border-color: var(--ink); color: #fff; transform: translateY(-2px); }
  .mt__links a[aria-disabled] { opacity: 0.35; pointer-events: none; }
  .mt__draft { margin-top: 1.4rem; text-align: center; font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.08em; color: #b26a00; }

  @media (max-width: 62rem) { .mt__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 48rem) { .mt__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; } .mt__tabs { max-width: 100%; overflow-x: auto; } }
  @media (prefers-reduced-motion: reduce) { .mt__grid.is-on .mt__card { animation: none; } .mt__pill { transition: none; } }
</style>

<script>
  function start() {
    const sec = document.querySelector<HTMLElement>('[data-mt]');
    if (!sec || sec.dataset.wired) return;
    sec.dataset.wired = '1';
    const tabs = [...sec.querySelectorAll<HTMLButtonElement>('[data-mt-tab]')];
    const pill = sec.querySelector<HTMLElement>('[data-mt-pill]')!;
    const grid = sec.querySelector<HTMLElement>('[data-mt-grid]')!;
    const cards = [...grid.querySelectorAll<HTMLElement>('.mt__card')];
    const place = (t: HTMLElement) => { if (t.offsetWidth) { pill.style.width = `${t.offsetWidth}px`; pill.style.transform = `translateX(${t.offsetLeft - 5}px)`; } };
    const select = (t: HTMLButtonElement) => {
      tabs.forEach((x) => { const on = x === t; x.setAttribute('aria-selected', String(on)); x.tabIndex = on ? 0 : -1; });
      const key = t.dataset.mtTab;
      let o = 0;
      cards.forEach((c) => { const show = key === 'all' || c.dataset.branch === key; c.hidden = !show; if (show) c.style.setProperty('--o', String(o++)); });
      grid.classList.remove('is-on'); void grid.offsetWidth; grid.classList.add('is-on');
      place(t);
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(t));
      t.addEventListener('keydown', (e) => {
        const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (!d) return; const n = tabs[(i + d + tabs.length) % tabs.length]; n.focus(); select(n);
      });
    });
    cards.forEach((c, i) => c.style.setProperty('--o', String(i)));
    const cur = () => tabs.find((t) => t.getAttribute('aria-selected') === 'true') ?? tabs[0];
    requestAnimationFrame(() => place(cur()));
    addEventListener('resize', () => place(cur()));
  }
  document.addEventListener('astro:page-load', start);
</script>
