---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from '@components/ui/Icon.astro';

import imgPrinter from '@assets/photos/printer-machine.jpg';
import imgPatch from '@assets/photos/network-patch.jpg';
import imgBench from '@assets/photos/repair-solder.jpg';
import imgParts from '@assets/products/scene/parts.png';
import imgRouter from '@assets/products/scene/router.png';
import imgDesktop from '@assets/products/scene/desktop.png';

/**
 * THE JOURNEY — one pinned track, five scenes, scrubbed by scroll.
 *
 * This picks up where the teardown leaves off. That section already runs
 * laptop → display → performance → storage → cooling → CONNECTIVITY, so
 * the story starts at the port it ends on: a cable leaves the USB, finds
 * the printer, and the rest of the estate gathers around it.
 *
 * DRIVEN BY THE SITE'S OWN ENGINE, NOT GSAP. initScrollLink already
 * publishes --p across a pinned track (height − viewport) and fires a
 * `track` event with the same number. That is what ScrollTrigger's scrub
 * and pin give you, in about a kilobyte, and the homepage JS budget is
 * 45 KB total. Adding GSAP + ScrollTrigger would be roughly 70 KB to
 * duplicate a capability already here.
 *
 * MISSING ASSETS: a server and mobile accessories have no photograph.
 * Drop files into src/assets/journey/ named server.* and mobile.* and
 * they appear automatically, same as the teardown renders. Until then
 * those two ride as labels on the flow rather than as hatched boxes —
 * an empty frame is a gap that reads as a fault.
 */
const extra = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/journey/*.{png,jpg,jpeg,webp,avif}',
  { eager: true }
);
const pick = (n: string): ImageMetadata | null =>
  Object.entries(extra).find(([p]) => p.includes(`/${n}.`))?.[1].default ?? null;

const imgServer = pick('server');
const imgMobile = pick('mobile');

/** What gathers in scene 03, and which way each one comes in. */
const estate = [
  { k: 'desktop', from: 'left', img: imgDesktop, label: 'Desktops & monitors' },
  { k: 'router', from: 'right', img: imgRouter, label: 'Networking' },
  { k: 'parts', from: 'bottom', img: imgParts, label: 'Components & spares' },
  { k: 'server', from: 'back', img: imgServer, label: 'Servers & storage' },
  { k: 'mobile', from: 'bottom', img: imgMobile, label: 'Mobile accessories' },
];

const scenes = [
  { n: '01', k: 'Connected', t: 'It never stops at the laptop.', p: 'A port, a cable, and the next machine on the desk.' },
  { n: '02', k: 'Printers', t: 'Printers, supplied and serviced.', p: 'Inkjet, laser, thermal and barcode — sold, installed and repaired.' },
  { n: '03', k: 'The estate', t: 'Everything around it, too.', p: 'Desktops, networking, servers, storage, accessories and spares.' },
  { n: '04', k: 'Support', t: 'And the bench behind all of it.', p: 'Diagnosis before a quote. Board-level repair, not a swapped box.' },
  { n: '05', k: 'Together', t: 'One partner for your complete IT needs.', p: null },
];
---

<section class="jy" data-progress aria-label="What Danat supplies and supports">
  <div class="jy__stage">
    {/* The flow the scenes hang from. One stroke, drawn as you scroll. */}
    <svg class="jy__flow" viewBox="0 0 1200 700" fill="none" aria-hidden="true"
      preserveAspectRatio="xMidYMid slice">
      <path class="jy__wire"
        d="M120 150 C 300 150 320 300 480 320 S 760 300 860 420 S 980 600 1080 600" />
      <circle class="jy__head" r="7" />
    </svg>

    {/* ── 01 · the cable leaves the port ── */}
    <figure class="jy__sc" data-sc="0">
      <span class="jy__port" aria-hidden="true">
        <b></b><b></b><b></b>
      </span>
      <figcaption class="jy__plug">USB-C · USB-A · HDMI</figcaption>
    </figure>

    {/* ── 02 · and finds the printer ── */}
    <figure class="jy__sc" data-sc="1">
      <Image class="jy__shot" src={imgPrinter}
        alt="The inside of a printer being serviced" widths={[640, 1000]}
        sizes="(min-width: 62rem) 46vw, 88vw" quality={78} format="webp" loading="lazy" />
    </figure>

    {/* ── 03 · the rest of the estate gathers ── */}
    <figure class="jy__sc" data-sc="2">
      <span class="jy__orbit" aria-hidden="true"></span>
      {estate.map((e) => (
        <span class="jy__item" data-from={e.from} data-has={e.img ? '' : undefined}>
          {e.img ? (
            <Image src={e.img} alt="" widths={[220, 380]} sizes="200px"
              quality={76} format="webp" loading="lazy" />
          ) : null}
          <em>{e.label}</em>
        </span>
      ))}
    </figure>

    {/* ── 04 · the bench ── */}
    <figure class="jy__sc" data-sc="3">
      <Image class="jy__shot" src={imgBench}
        alt="A technician probing a laptop mainboard with a multimeter"
        widths={[640, 1000]} sizes="(min-width: 62rem) 46vw, 88vw"
        quality={78} format="webp" loading="lazy" />
      <Image class="jy__shot jy__shot--b" src={imgPatch}
        alt="A structured cabling patch panel" widths={[420, 700]} sizes="30vw"
        quality={76} format="webp" loading="lazy" />
    </figure>

    {/* ── 05 · it settles ── */}
    <figure class="jy__sc" data-sc="4">
      <ul class="jy__final">
        {['Laptops', 'Desktops', 'Printers', 'Networking', 'Servers', 'Accessories', 'Spares', 'Support'].map((t) => (
          <li>{t}</li>
        ))}
      </ul>
    </figure>

    {/* The words, one set per scene, cross-faded by the same number. */}
    <div class="jy__copy">
      {scenes.map((s, i) => (
        <div class="jy__cp" data-cp={i}>
          <p class="jy__k"><b>{s.n}</b>{s.k}</p>
          <h2 class="jy__t">{s.t}</h2>
          {s.p ? <p class="jy__p">{s.p}</p> : null}
          {i === 4 ? (
            <a class="jy__cta" href="/products">
              Explore our solutions
              <span aria-hidden="true"><Icon name="arrow" size={15} /></span>
            </a>
          ) : null}
        </div>
      ))}
    </div>

    <ol class="jy__ticks" aria-hidden="true">
      {scenes.map((s) => <li><i></i>{s.k}</li>)}
    </ol>
  </div>
</section>

<script is:inline>
  (() => {
    const setup = () => {
      const sec = document.querySelector('.jy');
      if (!sec || sec.dataset.wired) return;
      sec.dataset.wired = '1';

      const stage = sec.querySelector('.jy__stage');
      const wire = sec.querySelector('.jy__wire');
      const head = sec.querySelector('.jy__head');
      const len = wire ? wire.getTotalLength() : 0;
      if (wire) {
        wire.style.strokeDasharray = String(len);
        wire.style.strokeDashoffset = String(len);
      }

      const N = 5;
      /* Each scene owns a window of the track. Its own 0→1 runs inside
         that window, so motion continues while the scene is up rather
         than snapping at the boundary. */
      const apply = (p) => {
        const at = Math.min(N - 1, Math.floor(p * N));
        stage.dataset.act = String(at);
        const inner = p * N - at;
        stage.style.setProperty('--s', inner.toFixed(4));
        stage.style.setProperty('--p', p.toFixed(4));

        if (wire) {
          const drawn = Math.min(1, p * 1.25);
          wire.style.strokeDashoffset = String(len * (1 - drawn));
          if (head && len) {
            const pt = wire.getPointAtLength(len * drawn);
            head.setAttribute('cx', pt.x);
            head.setAttribute('cy', pt.y);
          }
        }
      };

      sec.addEventListener('track', (e) => apply(e.detail));
      apply(0);
    };

    /* Both of these fire on a first load; the flag on the section keeps
       the second one from binding a duplicate listener. */
    document.addEventListener('astro:page-load', setup);
    window.addEventListener('load', setup);
  })();
</script>

<style>
  .jy {
    position: relative;
    /* The track. Five scenes need room to breathe; the stage pins inside
       it and --p runs 0→1 across whatever is left after one viewport. */
    height: 460vh;
    background: linear-gradient(180deg, var(--ink) 0%, #0a1b0f 42%, var(--ink) 100%);
    color: #fff;
  }
  .jy__stage {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
    isolation: isolate;
  }

  /* ---- the flow ---- */
  .jy__flow { position: absolute; inset: 0; width: 100%; height: 100%; }
  .jy__wire {
    stroke: rgb(111 201 106 / 0.55);
    stroke-width: 2;
    stroke-linecap: round;
    filter: drop-shadow(0 0 10px rgb(111 201 106 / 0.45));
  }
  .jy__head { fill: var(--green-bright); filter: drop-shadow(0 0 10px rgb(111 201 106 / 0.9)); }

  /* ---- scenes ---- */
  .jy__sc {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity 520ms var(--ease), visibility 0s linear 520ms;
  }
  .jy__stage[data-act='0'] .jy__sc[data-sc='0'],
  .jy__stage[data-act='1'] .jy__sc[data-sc='1'],
  .jy__stage[data-act='2'] .jy__sc[data-sc='2'],
  .jy__stage[data-act='3'] .jy__sc[data-sc='3'],
  .jy__stage[data-act='4'] .jy__sc[data-sc='4'] {
    opacity: 1;
    visibility: visible;
    transition: opacity 520ms var(--ease);
  }

  /* The photographs drift toward the camera while their scene is up —
     --s is that scene's own 0→1, so the move does not reset at a
     boundary the way a whole-track number would. */
  .jy__shot {
    width: min(38rem, 78vw);
    height: auto;
    border-radius: 18px;
    box-shadow: 0 50px 90px -40px rgb(0 0 0 / 0.8);
    transform: scale(calc(1 + var(--s, 0) * 0.08)) translateY(calc(var(--s, 0) * -1.5rem));
  }
  .jy__shot--b {
    position: absolute;
    right: 8%;
    bottom: 12%;
    width: min(16rem, 34vw);
    transform: scale(calc(1 + var(--s, 0) * 0.05)) translateY(calc(var(--s, 0) * 1rem));
  }

  /* 01 — the port the cable leaves from */
  .jy__port {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 1.1rem 1.4rem;
    border: 1px solid rgb(255 255 255 / 0.16);
    border-radius: 14px;
    background: rgb(255 255 255 / 0.04);
    backdrop-filter: blur(6px);
  }
  .jy__port b {
    width: 34px;
    height: 12px;
    border-radius: 3px;
    background: rgb(255 255 255 / 0.22);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.25);
  }
  .jy__port b:first-child { background: var(--green-bright); box-shadow: 0 0 16px rgb(111 201 106 / 0.8); }
  .jy__plug {
    margin-top: 0.9rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.6);
    text-align: center;
  }

  /* 03 — the estate gathers */
  .jy__orbit {
    position: absolute;
    width: min(34rem, 80vw);
    aspect-ratio: 1;
    border-radius: 50%;
    border: 1px dashed rgb(111 201 106 / 0.22);
  }
  .jy__item {
    position: absolute;
    display: grid;
    justify-items: center;
    gap: 0.5rem;
    width: min(11rem, 30vw);
    /* Each arrives from its own side, the distance easing out with --s. */
    translate:
      calc(var(--dx) * (1 - var(--s, 0)))
      calc(var(--dy) * (1 - var(--s, 0)));
    opacity: calc(0.15 + var(--s, 0) * 0.85);
  }
  .jy__item[data-from='left'] { --dx: -46vw; --dy: 0vh; left: 4%; top: 26%; }
  .jy__item[data-from='right'] { --dx: 46vw; --dy: 0vh; right: 4%; top: 22%; }
  .jy__item[data-from='bottom'] { --dx: 0vw; --dy: 40vh; left: 24%; bottom: 12%; }
  .jy__item[data-from='bottom'] ~ [data-from='bottom'] { left: auto; right: 22%; }
  .jy__item[data-from='back'] { --dx: 0vw; --dy: 0vh; left: 50%; top: 40%; translate: -50% 0; }
  .jy__item :global(img) { width: 100%; height: auto; filter: drop-shadow(0 18px 24px rgb(0 0 0 / 0.5)); }
  .jy__item em {
    font-style: normal;
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-align: center;
    color: rgb(255 255 255 / 0.72);
  }
  /* Nothing to show yet: the label carries the point on its own rather
     than sitting under an empty frame. */
  .jy__item:not([data-has]) em {
    padding: 0.5rem 0.8rem;
    border: 1px solid rgb(111 201 106 / 0.3);
    border-radius: 999px;
    background: rgb(111 201 106 / 0.08);
  }

  /* 05 — it settles */
  .jy__final {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    max-width: min(46rem, 88vw);
  }
  .jy__final li {
    padding: 0.55rem 1rem;
    border: 1px solid rgb(255 255 255 / 0.16);
    border-radius: 999px;
    background: rgb(255 255 255 / 0.05);
    font-size: 0.875rem;
    /* They land one after another as the last scene plays. */
    opacity: calc(var(--s, 0) * 3 - var(--i, 0) * 0.28);
    translate: 0 calc((1 - var(--s, 0)) * 1.2rem);
  }
  .jy__final li:nth-child(1) { --i: 0; } .jy__final li:nth-child(2) { --i: 1; }
  .jy__final li:nth-child(3) { --i: 2; } .jy__final li:nth-child(4) { --i: 3; }
  .jy__final li:nth-child(5) { --i: 4; } .jy__final li:nth-child(6) { --i: 5; }
  .jy__final li:nth-child(7) { --i: 6; } .jy__final li:nth-child(8) { --i: 7; }

  /* ---- the words ---- */
  .jy__copy {
    position: absolute;
    left: clamp(1.25rem, 6vw, 5rem);
    bottom: clamp(3rem, 10vh, 7rem);
    width: min(28rem, 82vw);
  }
  .jy__cp {
    grid-area: 1 / 1;
    opacity: 0;
    translate: 0 14px;
    transition: opacity 420ms var(--ease), translate 520ms var(--ease);
    pointer-events: none;
  }
  .jy__copy { display: grid; }
  .jy__stage[data-act='0'] [data-cp='0'],
  .jy__stage[data-act='1'] [data-cp='1'],
  .jy__stage[data-act='2'] [data-cp='2'],
  .jy__stage[data-act='3'] [data-cp='3'],
  .jy__stage[data-act='4'] [data-cp='4'] {
    opacity: 1;
    translate: 0 0;
    pointer-events: auto;
  }
  .jy__k {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--green-bright);
  }
  .jy__k b { font-weight: 500; color: rgb(255 255 255 / 0.45); }
  .jy__t {
    margin-top: var(--s4);
    font-size: clamp(1.6rem, 3.4vw, 2.6rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.08;
  }
  .jy__p {
    margin-top: var(--s4);
    font-size: 0.9375rem;
    line-height: 1.6;
    color: rgb(255 255 255 / 0.72);
  }
  .jy__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: var(--s5);
    padding: 0.85rem 1.5rem;
    border-radius: 999px;
    background: var(--green);
    color: #07090a;
    font-size: 0.9375rem;
    font-weight: 600;
  }
  .jy__cta:hover { background: var(--green-bright); }

  /* ---- where you are ---- */
  .jy__ticks {
    position: absolute;
    right: clamp(1rem, 3vw, 2.5rem);
    top: 50%;
    translate: 0 -50%;
    display: grid;
    gap: 0.9rem;
  }
  .jy__ticks li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.35);
    transition: color var(--t2) var(--ease);
  }
  .jy__ticks i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.25);
    transition: background-color var(--t2) var(--ease), scale var(--t2) var(--ease);
  }
  .jy__stage[data-act='0'] .jy__ticks li:nth-child(1),
  .jy__stage[data-act='1'] .jy__ticks li:nth-child(2),
  .jy__stage[data-act='2'] .jy__ticks li:nth-child(3),
  .jy__stage[data-act='3'] .jy__ticks li:nth-child(4),
  .jy__stage[data-act='4'] .jy__ticks li:nth-child(5) { color: #fff; }
  .jy__stage[data-act='0'] .jy__ticks li:nth-child(1) i,
  .jy__stage[data-act='1'] .jy__ticks li:nth-child(2) i,
  .jy__stage[data-act='2'] .jy__ticks li:nth-child(3) i,
  .jy__stage[data-act='3'] .jy__ticks li:nth-child(4) i,
  .jy__stage[data-act='4'] .jy__ticks li:nth-child(5) i {
    background: var(--green-bright);
    scale: 1.5;
  }

  @media (max-width: 61.999rem) {
    /* A phone does not get the pinned camera. The track collapses, the
       stage stops sticking, and the scenes stack as a sequence — same
       content, same order, none of the scrubbing. */
    .jy { height: auto; }
    .jy__stage { position: static; height: auto; overflow: visible; }
    .jy__flow, .jy__ticks, .jy__orbit { display: none; }
    .jy__sc {
      position: relative;
      inset: auto;
      opacity: 1;
      visibility: visible;
      min-height: 46vh;
      padding: clamp(2rem, 8vw, 3rem) 1.25rem 0;
    }
    .jy__shot, .jy__shot--b { position: relative; right: auto; bottom: auto; transform: none; width: 100%; }
    .jy__shot--b { margin-top: 0.75rem; width: 60%; }
    .jy__item {
      position: relative;
      left: auto !important;
      right: auto !important;
      top: auto;
      bottom: auto;
      translate: none;
      opacity: 1;
      width: 8rem;
    }
    .jy__sc[data-sc='2'] { display: flex; flex-wrap: wrap; justify-content: center; gap: 1rem; }
    .jy__copy { position: relative; left: auto; bottom: auto; width: auto; padding: 1.5rem 1.25rem 2.5rem; }
    .jy__cp { opacity: 1; translate: 0; pointer-events: auto; }
    .jy__final li { opacity: 1; translate: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    /* --p and --s are never published, so everything below has to stand
       on its own without them. */
    .jy { height: auto; }
    .jy__stage { position: static; height: auto; overflow: visible; }
    .jy__flow, .jy__ticks { display: none; }
    .jy__sc {
      position: relative;
      inset: auto;
      opacity: 1;
      visibility: visible;
      transition: none;
      padding-block: clamp(2rem, 6vw, 3.5rem);
    }
    .jy__shot, .jy__shot--b, .jy__item, .jy__final li { transform: none; translate: none; opacity: 1; }
    .jy__shot--b { position: relative; right: auto; bottom: auto; }
    .jy__item { position: relative; left: auto; right: auto; top: auto; bottom: auto; }
    .jy__cp { opacity: 1; translate: 0; pointer-events: auto; }
    .jy__copy { position: relative; left: auto; bottom: auto; display: grid; gap: 2rem; }
  }
</style>
