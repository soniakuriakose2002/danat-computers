---
import { Image } from 'astro:assets';

import fOpen from '@assets/teardown/laptop-open.jpg';
import fScreen from '@assets/teardown/laptop-screen.jpg';
import fTop from '@assets/teardown/laptop-topcase.jpg';
import fExploded from '@assets/teardown/laptop-exploded.jpg';

/**
 * LAPTOP SERVICE — the client's layout, with real photographs in it.
 *
 * The layout is the one he sent: a rail down the left carrying the
 * headline and a numbered index, the picture filling the rest, a card
 * bottom-right reading "02 of 04", and a labelled progress bar along
 * the foot. The accent is Danat green, not that file's orange.
 *
 * What differs is what is being shown. His version draws its laptop
 * from primitives; this scrubs the photographic teardown he supplied,
 * so the machine is real.
 *
 * FRAMES. Sliced from his reference sheet and each FITTED onto a shared
 * 1600x900 canvas rather than cropped to it — the open shot is 888x304,
 * nearly 3:1, and cropping that to 16:9 turned it into a close-up of a
 * keyboard, which is what "why is this so large" was. Each is padded
 * with its own border colour, measured from its edge ring, and the
 * stage takes that same colour so the padding cannot be seen.
 *
 * ⚠ Panel 1 of that sheet — the closed lid — is deliberately unused: it
 * carries an HP logo, and Danat sells HP rather than speaks for it.
 *
 * ⚠ The panels are ~600px originals. Re-export the sheet larger and
 * re-slice; nothing in this file changes.
 */
const frames = [
  {
    img: fOpen,
    bg: '#426d7e',
    n: 'Open',
    t: 'Free diagnosis',
    p: 'We tell you what failed, what it costs and how long it takes — before you agree to anything.',
    tag: 'Free diagnosis',
    alt: 'A laptop open on a bench',
  },
  {
    img: fScreen,
    bg: '#396175',
    n: 'Screen',
    t: 'Screen replacement',
    p: 'Cracked, flickering or dim panels, replaced with one matched to your model.',
    tag: 'Screen replacement',
    alt: 'The screen separated from the body of a laptop',
  },
  {
    img: fTop,
    bg: '#446d7e',
    n: 'Keyboard',
    t: 'Keyboard and trackpad',
    p: 'Stuck or missing keys, liquid spills, and trackpads that stop responding.',
    tag: 'Keyboard and trackpad repair',
    alt: 'The keyboard and top case lifted away from a laptop',
  },
  {
    img: fExploded,
    bg: '#3d606e',
    n: 'Inside',
    t: 'Board-level repair',
    p: 'Battery, memory, storage, cooling and the board itself. Most shops replace it. We repair it.',
    tag: 'Chip-level diagnosis',
    alt: 'A laptop fully exploded into its components',
  },
];
const total = String(frames.length).padStart(2, '0');
---

<section class="sq" data-sq style={`--n:${frames.length}`}>
  <div class="sq__track" data-sq-track>
    <div class="sq__pin">
      {frames.map((f, i) => (
        <figure class="sq__f" data-f={i} data-bg={f.bg} data-on={i === 0 ? '' : undefined}>
          <Image src={f.img} alt={f.alt} widths={[1100, 1600]} sizes="100vw"
            quality={86} format="webp" loading={i === 0 ? 'eager' : 'lazy'} />
        </figure>
      ))}

      {/* Under the rail only. The right of the picture is the product
          and is left alone. */}
      <span class="sq__veil" aria-hidden="true"></span>

      <aside class="sq__rail">
        <p class="sq__eb">Laptop service</p>
        <h2 class="sq__h">Every part of<br />your laptop,<br />repaired in&#8209;house.</h2>

        <ol class="sq__ix">
          {frames.map((f, i) => (
            <li data-i={i} data-on={i === 0 ? '' : undefined}>
              <b>{String(i + 1).padStart(2, '0')}</b><span>{f.n}</span>
            </li>
          ))}
        </ol>

        <a class="sq__cta" href="/contact">Book a laptop repair</a>
      </aside>

      <div class="sq__cards" aria-live="polite">
        {frames.map((f, i) => (
          <article data-c={i} data-on={i === 0 ? '' : undefined}>
            <p class="sq__of">{String(i + 1).padStart(2, '0')} of {total}</p>
            <h3>{f.t}</h3>
            <p class="sq__d">{f.p}</p>
            <span class="sq__tag">{f.tag}</span>
          </article>
        ))}
      </div>

      <div class="sq__foot">
        <span class="sq__now" data-sq-now>{frames[0].n}</span>
        <span class="sq__bar"><i data-sq-bar></i></span>
      </div>
    </div>
  </div>
</section>

<style>
  /* 88svh a frame. Short deliberately: the note was that the scrolling
     is too slow, and a frame that needs a screen and a half to change
     is what makes a teardown feel like work. */
  .sq { --pane: 88svh; --rail: clamp(19rem, 27vw, 26rem); background: #426d7e; }
  .sq__track { height: calc(var(--n) * var(--pane)); }
  .sq__pin {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    /* Takes the active frame's own padding colour, so the area around
       the photograph cannot be told from the photograph. */
    background: var(--bg, #426d7e);
    transition: background-color 380ms linear;
  }
  /* A soft floor shadow under the machine — his sits in a lit space
     rather than on a flat colour, and this is what supplies that. */
  .sq__pin::after {
    content: '';
    position: absolute;
    left: calc(var(--rail) + 6%);
    right: 12%;
    bottom: 5.5rem;
    height: 5rem;
    z-index: 0;
    background: radial-gradient(closest-side, rgb(4 12 16 / 0.5), transparent);
    pointer-events: none;
  }

  /* THE PICTURE SITS IN THE STAGE, NOT OVER THE WHOLE PIN.
     Filling the pin edge to edge put the machine under the rail text
     and ran it off all four sides. His version gives the product room
     and keeps the left column clear, which is most of why it reads as
     calmer. So the frame starts where the rail ends and is inset, and
     the machine is contained inside that. */
  .sq__f {
    position: absolute;
    inset: 4.5rem clamp(1.5rem, 4vw, 4rem) 6.5rem var(--rail);
    margin: 0;
    opacity: 0;
    transition: opacity 360ms linear;
  }
  .sq__f[data-on] { opacity: 1; }
  .sq__f :global(img) {
    width: 100%;
    height: 100%;
    /* Contained, so the whole machine is always visible with space
       around it. The pin is painted the frame's own backdrop colour, so
       that space cannot be told from the photograph. */
    object-fit: contain;
    /* A slow push across each frame's turn, tied to scroll rather than a
       timer, so a still never sits completely dead. */
    scale: calc(1.01 + var(--z, 0) * 0.045);
    transform-origin: 62% 50%;
  }

  /* A column, not a wash across the product. Its edge is feathered over
     the last 4rem so it does not draw a hard line down the picture. */
  .sq__veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgb(9 20 26 / 0.62) 0%,
      rgb(9 20 26 / 0.62) calc(var(--rail) - 4rem),
      rgb(9 20 26 / 0) var(--rail)
    );
  }

  .sq__rail {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    z-index: 2;
    width: var(--rail);
    display: flex;
    flex-direction: column;
    padding: calc(var(--hd-h, 5.4rem) + 2.2rem) 1.6rem 2.2rem var(--gut, 1.6rem);
  }

  .sq__eb {
    font-size: 0.9375rem;
    font-weight: 600;
    /* --green-bright is built for near-black; on this ground it reads. */
    color: var(--green-bright);
  }
  .sq__h {
    margin-top: var(--s4);
    font-size: clamp(1.8rem, 2.7vw, 2.6rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.04;
    color: #fff;
  }

  .sq__ix {
    margin-top: var(--s6);
    border-top: 1px solid rgb(255 255 255 / 0.16);
  }
  .sq__ix li {
    display: grid;
    grid-template-columns: 2.4rem minmax(0, 1fr);
    gap: 0.5rem;
    padding: 0.55rem 0;
    border-bottom: 1px solid rgb(255 255 255 / 0.16);
    font-size: 0.9375rem;
    color: rgb(255 255 255 / 0.55);
    transition: color 300ms var(--ease);
  }
  .sq__ix li[data-on] { color: #fff; }
  .sq__ix b {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    color: rgb(255 255 255 / 0.5);
  }
  .sq__ix li[data-on] b { color: var(--green-bright); }

  .sq__cta {
    align-self: start;
    margin-top: auto;
    padding: 0.85rem 1.5rem;
    border-radius: 999px;
    /* white on #2f6429 is 6.8:1 */
    background: var(--green-deep);
    color: #fff;
    font-size: 0.9375rem;
    font-weight: 600;
    transition: background-color var(--t2) var(--ease), transform var(--t2) var(--ease);
  }
  .sq__cta:hover { background: var(--green); transform: translateY(-2px); }

  /* One card at a time, in one grid cell so nothing reflows. */
  .sq__cards {
    position: absolute;
    right: clamp(1.25rem, 3vw, 3rem);
    bottom: 5.5rem;
    z-index: 2;
    display: grid;
    width: min(24rem, calc(100% - var(--rail) - 4rem));
  }
  .sq__cards article {
    grid-area: 1 / 1;
    padding: 1.35rem 1.5rem 1.5rem;
    border-radius: 18px;
    border: 1px solid rgb(255 255 255 / 0.14);
    background: rgb(10 22 28 / 0.72);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    opacity: 0;
    translate: 0 12px;
    transition: opacity 320ms var(--ease), translate 320ms var(--ease);
  }
  .sq__cards article[data-on] { opacity: 1; translate: 0 0; }
  .sq__of {
    font-size: 0.8125rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--green-bright);
  }
  .sq__cards h3 {
    margin-top: 0.35rem;
    font-size: 1.4rem;
    font-weight: 700;
    letter-spacing: -0.025em;
    color: #fff;
  }
  .sq__d {
    margin-top: 0.5rem;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: rgb(255 255 255 / 0.78);
  }
  .sq__tag {
    display: inline-block;
    margin-top: 1rem;
    padding: 0.42rem 0.9rem;
    border-radius: 999px;
    background: rgb(89 170 84 / 0.22);
    font-size: 0.875rem;
    font-weight: 600;
    color: #fff;
  }

  .sq__foot {
    position: absolute;
    left: var(--rail);
    right: clamp(1.25rem, 3vw, 3rem);
    bottom: 2rem;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 0.9375rem;
    color: rgb(255 255 255 / 0.72);
  }
  .sq__bar {
    flex: 1;
    height: 2px;
    border-radius: 2px;
    background: rgb(255 255 255 / 0.2);
    overflow: hidden;
  }
  .sq__bar i { display: block; height: 100%; width: 0; background: var(--green-bright); }

  @media (max-width: 62rem) {
    /* No room for a rail beside the picture: the copy goes over it, the
       index goes, and the card sits below. */
    .sq { --rail: 0px; }
    .sq__rail {
      width: 100%;
      padding: calc(var(--hd-h, 5rem) + 1.25rem) var(--gut, 1.25rem) 0;
    }
    .sq__ix, .sq__cta { display: none; }
    .sq__veil {
      background: linear-gradient(0deg, rgb(7 18 24 / 0.92) 0%, rgb(7 18 24 / 0.5) 46%, rgb(7 18 24 / 0.2) 100%);
    }
    .sq__cards { left: var(--gut, 1.25rem); right: var(--gut, 1.25rem); width: auto; bottom: 4.6rem; }
    .sq__foot { left: var(--gut, 1.25rem); bottom: 1.4rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .sq__f, .sq__cards article, .sq__pin { transition: none; }
    .sq__f :global(img) { scale: 1.01; }
  }
</style>

<script>
  function boot() {
    const root = document.querySelector<HTMLElement>('[data-sq]');
    const track = root?.querySelector<HTMLElement>('[data-sq-track]');
    if (!root || !track || root.dataset.wired) return;
    root.dataset.wired = '1';

    const pin = root.querySelector<HTMLElement>('.sq__pin')!;
    const figs = [...root.querySelectorAll<HTMLElement>('[data-f]')];
    const cards = [...root.querySelectorAll<HTMLElement>('[data-c]')];
    const ix = [...root.querySelectorAll<HTMLElement>('[data-i]')];
    const bar = root.querySelector<HTMLElement>('[data-sq-bar]');
    const now = root.querySelector<HTMLElement>('[data-sq-now]');
    const n = figs.length;
    let active = -1;

    const paint = () => {
      const r = track.getBoundingClientRect();
      const span = r.height - innerHeight;
      /* Straight from scroll position — no smoothing. Any lerp here is
         exactly the lag the client asked to be rid of. */
      const p = span > 0 ? Math.min(1, Math.max(0, -r.top / span)) : 0;
      if (bar) bar.style.width = `${(p * 100).toFixed(1)}%`;

      /* Each frame's own 0-1 progress drives its push, so the picture
         keeps moving between changes instead of holding still. */
      const at = p * n;
      figs.forEach((el, i) =>
        el.style.setProperty('--z', Math.min(1, Math.max(0, at - i)).toFixed(3))
      );

      const k = Math.min(n - 1, Math.floor(p * n * 0.999));
      if (k === active) return;
      active = k;
      figs.forEach((el, i) => el.toggleAttribute('data-on', i === k));
      cards.forEach((el, i) => el.toggleAttribute('data-on', i === k));
      ix.forEach((el, i) => el.toggleAttribute('data-on', i === k));

      const bg = figs[k].dataset.bg;
      if (bg) pin.style.setProperty('--bg', bg);
      if (now) now.textContent = ix[k]?.querySelector('span')?.textContent ?? '';
    };

    addEventListener('scroll', paint, { passive: true });
    addEventListener('resize', paint, { passive: true });
    paint();
  }

  boot();
  document.addEventListener('astro:page-load', boot);
</script>
