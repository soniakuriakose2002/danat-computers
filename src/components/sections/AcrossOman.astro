---
import Icon from '@components/ui/Icon.astro';
import { whatsappLink, branches as allBranches } from '@data/site';
import { OMAN_PATH, OMAN_VIEWBOX, OMAN_PINS, OMAN_ROUTES } from '@data/omanMap';

/** Where each photo card sits, nudged clear of its pin. */
const cardPos: Record<string, { x: number; y: number }> = {
  sohar: { x: 33, y: 13 },
  ruwi: { x: 86, y: 20 },
  hail: { x: 84, y: 45 },
  salalah: { x: 20, y: 77 },
};

const order = ['ruwi', 'sohar', 'salalah'];
const list = order.map((s) => allBranches.find((b) => b.slug === s)!);

const stats = [
  { icon: 'pin' as const, value: '4', label: 'Branches', known: true },
  { icon: 'users' as const, value: '20+', label: 'Years of Service', known: true },
  { icon: 'heart' as const, value: null, label: 'Happy Customers', known: false },
];
---

<section class="ao" data-oman>
  <div class="ao__grid shell">
    <!-- ══════════ LEFT ══════════ -->
    <div class="ao__side">
      <p class="label" data-rise>Our reach</p>

      <h2 class="ao__title" data-rise style="--d:70ms">
        Across Oman.<br /><em>Closer to you.</em>
      </h2>

      <p class="ao__sub" data-rise style="--d:130ms">
        Three locations. One commitment. Serving individuals, businesses and
        communities across the Sultanate for over twenty years.
      </p>

      <div class="ao__tabs" role="tablist" aria-label="Branches" data-rise style="--d:190ms">
        {list.map((b, i) => (
          <button
            type="button"
            class="ao__tab"
            data-tab={b.slug}
            data-on={i === 0 ? '' : undefined}
            role="tab"
            aria-selected={i === 0 ? 'true' : 'false'}
          >
            <Icon name="pin" size={14} />
            {b.city.split(',')[0]}
          </button>
        ))}
      </div>

      <div class="ao__cards" data-rise style="--d:240ms">
        {list.map((b, i) => (
          <article class="ao__card" data-card={b.slug} data-on={i === 0 ? '' : undefined}>
            <div class="ao__info">
              <h3 class="ao__cn">{b.name}</h3>
              <p class="ao__city">{b.city}</p>

              {b.verified ? (
                <address>{b.address.split('\n').map((l) => <>{l}<br /></>)}</address>
              ) : (
                <div class="ao__slot ao__slot--addr"><span>Address to be confirmed</span></div>
              )}

              <div class="ao__hours">
                <Icon name="clock" size={17} />
                <ul data-unverified={!b.hoursVerified ? '' : undefined}>
                  {b.hours.map((h) => <li>{h}</li>)}
                </ul>
              </div>

              <div class="ao__acts">
                <a
                  class="ao__wa"
                  href={whatsappLink(`Hello Danat — I'd like to contact your ${b.name} branch about`)}
                  target="_blank"
                  rel="noopener noreferrer"
                  title={`WhatsApp ${b.name}`}
                  aria-label={`Message ${b.name} on WhatsApp`}
                >
                  <Icon name="whatsapp" size={18} />
                </a>
                <span class="ao__dir" aria-disabled="true" title="Map link to be added">
                  Get Directions <Icon name="send" size={14} />
                </span>
              </div>
            </div>

            <!-- shopfront photo — empty until real photography arrives -->
            <div class="ao__shot">
              <div class="ao__slot ao__slot--photo">
                <Icon name="camera" size={20} />
                <span>Shopfront photo</span>
              </div>
              <span class="ao__chip">
                <Icon name="pin" size={12} />{b.city.split(',')[0]} Branch
              </span>
            </div>
          </article>
        ))}
      </div>

      <a class="ao__all" href="/branches" data-rise style="--d:300ms">
        View all locations <Icon name="arrow" size={14} />
      </a>

      <p class="ao__script ao__script--low" aria-hidden="true">Technology<br />Across Oman</p>
    </div>

    <!-- ══════════ RIGHT ══════════ -->
    <div class="ao__mapwrap" data-rise="fade" style="--d:140ms">
      <p class="ao__script ao__script--high" aria-hidden="true">
        Same Trust<br />Across Every City
      </p>

      <div class="ao__map">
        <svg viewBox={OMAN_VIEWBOX} role="img"
          aria-label="Map of Oman showing Danat branches in Ruwi, Sohar and Salalah">
          <path class="ao__land" d={OMAN_PATH} />
          {OMAN_ROUTES.map(([from, to]) => {
            const a = OMAN_PINS[from];
            const b = OMAN_PINS[to];
            return (
              <path class="ao__route"
                d={`M${a.x},${a.y} Q${(a.x + b.x) / 2 + 70},${(a.y + b.y) / 2} ${b.x},${b.y}`} />
            );
          })}
          {list.map((b, i) => (
            <g class="ao__pin" data-pin={b.slug} data-on={i === 0 ? '' : undefined}
              style={`--i:${i}`} transform={`translate(${OMAN_PINS[b.slug].x} ${OMAN_PINS[b.slug].y})`}>
              <circle class="ao__halo" r="46"></circle>
              <circle class="ao__dot" r="14"></circle>
            </g>
          ))}
        </svg>

        {list.map((b) => (
          <button type="button" class="ao__mcard" data-mcard={b.slug}
            data-on={b.slug === 'ruwi' ? '' : undefined}
            style={`--x:${cardPos[b.slug].x}%; --y:${cardPos[b.slug].y}%`}
            aria-label={`Show ${b.name}`}>
            <span class="ao__slot ao__slot--thumb"><Icon name="camera" size={16} /></span>
            <span class="ao__mlabel">
              <Icon name="pin" size={11} />{b.city.split(',')[0]}
            </span>
          </button>
        ))}
      </div>

      <dl class="ao__stats">
        {stats.map((s) => (
          <div>
            <dt><Icon name={s.icon} size={22} /></dt>
            <dd>
              {s.known ? <b>{s.value}</b> : <b class="ao__blank" aria-hidden="true"></b>}
              <i>{s.label}</i>
            </dd>
          </div>
        ))}
      </dl>

      <p class="ao__compass" aria-hidden="true">
        <Icon name="compass" size={30} />
        <span>Serving<br />a Connected<br />Oman</span>
      </p>
    </div>
  </div>

  <!-- landmark strip — left empty until artwork is supplied -->
  <div class="ao__strip" aria-hidden="true"></div>
</section>

<style>
  /* A slanted cut carries the green band down into this section —
     angular, where the section above uses a curve. */
  .ao::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: clamp(42px, 6vw, 96px);
    background: #27551f;
    clip-path: polygon(0 0, 100% 0, 100% 0, 0 100%);
    z-index: 2;
    pointer-events: none;
  }

  .ao {
    position: relative;
    background: linear-gradient(180deg, var(--white) 0%, #f7faf8 62%, var(--white) 100%);
    padding-block: clamp(6rem, 11vw, 10rem) 0;
    overflow: hidden;
    isolation: isolate;
  }

  /* ---------- grid ---------- */

  .ao__grid {
    position: relative;
    z-index: 1;
    display: grid;
    gap: var(--s7);
    align-items: start;
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }

  /* ---------- left ---------- */

  .ao__title {
    margin-top: var(--s4);
    font-size: clamp(2rem, 3.6vw, 3.1rem);
    line-height: 1.04;
    letter-spacing: -0.038em;
    font-weight: 700;
  }
  .ao__title em { font-style: normal; color: var(--green); }

  .ao__sub {
    margin-top: var(--s4);
    max-width: 40ch;
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--text-2);
  }

  .ao__tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: var(--s5);
  }

  .ao__tab {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.6rem 1.1rem;
    border: 1px solid var(--line-light);
    border-radius: 999px;
    background: var(--white);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-2);
    transition:
      background-color var(--t2) var(--ease),
      border-color var(--t2) var(--ease),
      color var(--t2) var(--ease);
  }
  .ao__tab:hover { border-color: var(--green); color: var(--green-deep); }
  .ao__tab[data-on] { background: var(--green); border-color: var(--green); color: #fff; }

  .ao__cards { position: relative; display: grid; margin-top: 0.85rem; }

  .ao__card {
    grid-area: 1 / 1;
    display: none;
    border: 1px solid var(--line-light);
    border-left: 3px solid var(--green);
    border-radius: 12px;
    background: var(--white);
    box-shadow: 0 18px 40px -28px rgb(20 23 26 / 0.3);
    overflow: hidden;
  }
  .ao__card[data-on] { display: grid; animation: ao-in 300ms var(--ease) both; }
  @keyframes ao-in {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: none; }
  }

  .ao__info { padding: 1.35rem 1.4rem; }
  .ao__cn { font-size: 1.2rem; font-weight: 700; letter-spacing: -0.025em; }

  .ao__city {
    margin-top: 0.2rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--green-deep);
  }

  .ao__card address {
    display: block;
    margin-top: 0.85rem;
    font-style: normal;
    font-size: var(--small);
    line-height: 1.65;
    color: var(--text-2);
  }

  .ao__hours {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    margin-top: 0.9rem;
    color: var(--text-3);
  }
  .ao__hours ul {
    display: grid;
    gap: 0.15rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.03em;
  }
  .ao__hours ul[data-unverified] { opacity: 0.55; }

  .ao__acts {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1.1rem;
  }

  /* Mark only, no label. White on --green (#59AA54) is 2.88:1, under the
     3:1 WCAG asks of a non-text graphic, so these sit on --green-deep
     (7.06:1) instead. */
  .ao__wa {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    flex: none;
    border-radius: 50%;
    background: var(--green-deep);
    color: #fff;
    transition: background-color var(--t2) var(--ease), transform var(--t2) var(--ease);
  }
  .ao__wa:hover { background: var(--text); transform: translateY(-2px); }

  /* Inert until real map links exist — shown as pending, not clickable. */
  .ao__dir {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1.2rem;
    border: 1px solid var(--line-light);
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-3);
    cursor: not-allowed;
  }

  .ao__shot { position: relative; min-height: 11rem; }

  .ao__chip {
    position: absolute;
    right: 0.7rem;
    bottom: 0.7rem;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.35rem 0.7rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.94);
    box-shadow: 0 4px 12px -6px rgb(20 23 26 / 0.4);
    font-size: 0.6875rem;
    font-weight: 500;
  }

  /* ---------- reserved space for missing data ---------- */

  .ao__slot {
    display: grid;
    place-items: center;
    gap: 0.35rem;
    border: 1px dashed var(--line-light);
    border-radius: 8px;
    background: repeating-linear-gradient(45deg, #fafafa 0 8px, #f4f4f2 8px 16px);
    color: var(--text-3);
    font-size: 0.6875rem;
    text-align: center;
  }
  .ao__slot--addr { margin-top: 0.85rem; padding: 0.85rem; }
  .ao__slot--photo { height: 100%; min-height: 11rem; border-radius: 0; border-width: 0 0 0 1px; }
  .ao__slot--thumb { width: 100%; aspect-ratio: 4 / 3; border-radius: 6px; }

  /* ---------- scripts ---------- */

  .ao__script {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(1rem, 1.5vw, 1.35rem);
    line-height: 1.25;
    color: var(--green-deep);
    opacity: 0.9;
  }
  .ao__script--low { margin-top: var(--s6); }
  .ao__script--high { position: absolute; right: 0; top: 0; text-align: right; z-index: 3; }

  .ao__all {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    justify-self: start;
    margin-top: var(--s5);
    padding-bottom: 0.3rem;
    border-bottom: 1px solid var(--text);
    font-size: 0.9375rem;
    font-weight: 500;
    transition: color var(--t2) var(--ease), border-color var(--t2) var(--ease);
  }
  .ao__all:hover { color: var(--green-deep); border-color: var(--green-deep); }

  /* ---------- map ---------- */

  .ao__mapwrap { position: relative; padding-top: 3rem; }

  .ao__map { position: relative; width: 100%; max-width: 30rem; margin-inline: auto; }
  .ao__map svg { width: 100%; height: auto; overflow: visible; }

  .ao__land {
    fill: color-mix(in oklab, var(--green) 16%, #fff);
    stroke: color-mix(in oklab, var(--green) 34%, #fff);
    stroke-width: 3;
  }

  .ao__route {
    fill: none;
    stroke: var(--green);
    stroke-width: 3;
    stroke-dasharray: 3 14;
    stroke-linecap: round;
    opacity: 0.5;
    animation: ao-flow 3s linear infinite;
  }
  @keyframes ao-flow { to { stroke-dashoffset: -17; } }

  .ao__dot { fill: var(--green); stroke: #fff; stroke-width: 5; }
  .ao__halo { fill: var(--green); opacity: 0; transform-box: fill-box; transform-origin: center; }
  .ao__pin[data-on] .ao__halo { animation: ao-ping 2.8s var(--ease) infinite; }
  @keyframes ao-ping {
    0% { opacity: 0.3; transform: scale(0.35); }
    70% { opacity: 0; transform: scale(1); }
    100% { opacity: 0; transform: scale(1); }
  }

  .ao__mcard {
    position: absolute;
    left: var(--x);
    top: var(--y);
    translate: -50% -50%;
    width: clamp(5rem, 8vw, 7rem);
    padding: 0.3rem;
    border-radius: 10px;
    border: 1px solid var(--line-light);
    background: var(--white);
    box-shadow: 0 10px 24px -14px rgb(20 23 26 / 0.45);
    text-align: left;
    transition: transform var(--t2) var(--ease), border-color var(--t2) var(--ease);
  }
  .ao__mcard:hover { transform: translateY(-3px); }
  .ao__mcard[data-on] { border-color: var(--green); }

  .ao__mlabel {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.3rem 0.1rem 0.1rem;
    font-size: 0.625rem;
    font-weight: 600;
    color: var(--text);
  }
  .ao__mcard[data-on] .ao__mlabel { color: var(--green-deep); }

  /* ---------- stats ---------- */

  .ao__stats { display: grid; gap: var(--s5); margin-top: var(--s6); }
  .ao__stats > div { display: flex; align-items: center; gap: 0.85rem; }
  .ao__stats dt { color: var(--green); display: grid; place-items: center; }
  .ao__stats dd b {
    display: block;
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .ao__stats dd i {
    display: block;
    margin-top: 0.2rem;
    font-style: normal;
    font-size: 0.8125rem;
    color: var(--text-2);
  }

  /* Unverified figure: reserved blank rather than an invented number. */
  .ao__blank {
    width: 6.5rem;
    height: 1.5rem;
    border-radius: 4px;
    border: 1px dashed var(--line-light);
    background: repeating-linear-gradient(45deg, #fafafa 0 8px, #f4f4f2 8px 16px);
  }

  .ao__compass {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin-top: var(--s6);
    color: var(--text-3);
    font-size: 0.75rem;
    line-height: 1.45;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* ---------- landmark strip ---------- */

  .ao__strip {
    height: clamp(4rem, 9vw, 8.5rem);
    border-top: 1px dashed var(--line-light);
    background: repeating-linear-gradient(45deg, #fbfbfa 0 10px, #f5f6f4 10px 20px);
  }

  /* ---------- layout ---------- */

  @media (min-width: 48rem) {
    .ao__card[data-on] { grid-template-columns: 1.15fr 1fr; }
  }

  @media (min-width: 68rem) {
    .ao__grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); gap: var(--s8); }
    .ao__stats { position: absolute; right: 0; top: 32%; margin: 0; width: 11rem; }
    .ao__compass { position: absolute; right: 0; bottom: 4%; margin: 0; width: 11rem; }
    .ao__map { max-width: 25rem; margin-left: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .ao__route, .ao__halo { animation: none !important; }
    .ao__card[data-on] { animation: none; }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-oman]');
  if (root) {
    const q = <T extends Element>(s: string) => [...root.querySelectorAll<T>(s)];
    const tabs = q<HTMLElement>('[data-tab]');
    const cards = q<HTMLElement>('[data-card]');
    const pins = q<SVGGElement>('[data-pin]');
    const mcards = q<HTMLElement>('[data-mcard]');

    /* One function drives tabs, pins and map cards alike. */
    const show = (slug: string) => {
      const on = (el: Element, key?: string) => el.toggleAttribute('data-on', key === slug);
      tabs.forEach((el) => {
        on(el, el.dataset.tab);
        el.setAttribute('aria-selected', String(el.dataset.tab === slug));
      });
      cards.forEach((el) => on(el, el.dataset.card));
      pins.forEach((el) => on(el, el.dataset.pin));
      mcards.forEach((el) => on(el, el.dataset.mcard));
    };

    tabs.forEach((el) => el.addEventListener('click', () => show(el.dataset.tab!)));
    mcards.forEach((el) => {
      el.addEventListener('click', () => show(el.dataset.mcard!));
      el.addEventListener('pointerenter', () => show(el.dataset.mcard!));
    });
  }
</script>
