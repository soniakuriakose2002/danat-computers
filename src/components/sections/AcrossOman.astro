---
import { Image } from 'astro:assets';
import Icon from '@components/ui/Icon.astro';
import imgMap from '@assets/photos/oman-map.png';
import { site, whatsappLink, branches as allBranches } from '@data/site';
import { OMAN_PATH, OMAN_VIEWBOX, OMAN_PINS, OMAN_ROUTES } from '@data/omanMap';

/** Where each photo card sits, nudged clear of its pin. */
const cardPos: Record<string, { x: number; y: number }> = {
  sohar: { x: 33, y: 13 },
  ruwi: { x: 86, y: 20 },
  hail: { x: 84, y: 45 },
  salalah: { x: 20, y: 77 },
};

/**
 * Where each branch falls on oman-map.png, as a % of that image.
 *
 * NOT eyeballed. The image is an OSM tile render cropped to
 * lon 51.3–60.7, lat 15.9–27.2 at zoom 7, and these come out of the
 * same Web Mercator projection that produced the crop. If the map is
 * ever re-rendered at different bounds these must be recomputed with
 * it — a linear guess is wrong, because Mercator is not linear in
 * latitude.
 */
const SPOTS: Record<string, { x: number; y: number }> = {
  ruwi: { x: 77.19, y: 32.8 },
  sohar: { x: 57.54, y: 26.03 },
  salalah: { x: 29.67, y: 90.42 },
};

const order = ['ruwi', 'sohar', 'salalah'];
const list = order.map((s) => allBranches.find((b) => b.slug === s)!);

const stats = [
  /* Typed in as '4' and '20+', so neither followed the data — the branch
     count stayed at four after Hail was withdrawn, and the years had not
     moved since they were written. The customer figure is dropped rather
     than held open: nobody has given us one, and an empty bar is just a
     gap that looks like a fault. */
  { icon: 'pin' as const, value: String(site.stats.branches), label: 'Branches', known: true },
  {
    icon: 'users' as const,
    value: `${new Date().getFullYear() - site.stats.since}+`,
    label: 'Years of Service',
    known: true,
  },
];
---

<section class="ao" data-oman>
  <div class="ao__grid shell">
    <!-- ══════════ LEFT ══════════ -->
    <div class="ao__side">
      <p class="label" data-rise>Our reach</p>

      <h2 class="ao__title" data-rise style="--d:70ms">
        Across Oman.<br /><em>Closer to you.</em>
      </h2>

      <p class="ao__sub" data-rise style="--d:130ms">
        Three locations. One commitment. Serving individuals, businesses and
        communities across the Sultanate for over twenty years.
      </p>

      <dl class="ao__stats" data-rise style="--d:190ms">
        {stats.map((s) => (
          <div>
            <dt><Icon name={s.icon} size={20} /></dt>
            <dd>
              {s.known ? <b>{s.value}</b> : <b class="ao__blank" aria-hidden="true"></b>}
              <i>{s.label}</i>
            </dd>
          </div>
        ))}
        <div>
          <dt><Icon name="compass" size={20} /></dt>
          <dd><b class="ao__word">Oman</b><i>Wherever you are</i></dd>
        </div>
      </dl>

      <a class="ao__all" href="/branches" data-rise style="--d:260ms">
        View all locations <Icon name="arrow" size={14} />
      </a>

      <p class="ao__script ao__script--low" aria-hidden="true">Technology<br />Across Oman</p>
    </div>

    <!-- ══════════ RIGHT ══════════ -->
    <div class="ao__mapwrap" data-rise="fade" style="--d:140ms">
      <p class="ao__script ao__script--high" aria-hidden="true">
        Same Trust<br />Across Every City
      </p>

      {/* ONE map, three spots.
          OpenStreetMap's embed takes a single `marker`, so three
          branches meant three iframes — which is not a map of where the
          business is, it is three maps of three towns. This is a real
          OSM render of Oman, stitched from tiles once at build time and
          served as our own image, with the pins placed from the same
          Web Mercator maths that produced it. No key, no tile request
          per visitor, no cookie banner, and the pins cannot drift. */}
      <figure class="ao__map">
        <Image src={imgMap} alt="Map of Oman marking the Danat branches in Ruwi, Sohar and Salalah"
          widths={[428, 856]} sizes="(min-width: 68rem) 42rem, 92vw"
          quality={82} format="webp" loading="lazy" />

        {list.map((b) => (
          <a
            class="ao__spot"
            data-low={b.slug === 'salalah' ? '' : undefined}
            style={`--x:${SPOTS[b.slug].x}%; --y:${SPOTS[b.slug].y}%`}
            href={`https://www.openstreetmap.org/?mlat=${b.geo.lat}&mlon=${b.geo.lon}#map=${b.geo.precise ? 16 : 12}/${b.geo.lat}/${b.geo.lon}`}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="ao__halo" aria-hidden="true"></span>
            <span class="ao__dot" aria-hidden="true"></span>
            <span class="ao__lbl">{b.city.split(',')[0]}</span>
          </a>
        ))}

        {/* ODbL requires this to stay visible. */}
        <figcaption>&copy; OpenStreetMap contributors</figcaption>
      </figure>

    </div>
  </div>


  {/* All three, side by side. They used to be one card behind a row of
      tabs, so two of the three branches were never on screen. Each one
      carries its own OpenStreetMap embed with a real marker — the single
      overview map this replaces was rendering the whole world. */}
  <div class="ao__row shell">
    {list.map((b, i) => (
      <article class="ao__card" data-card={b.slug} data-rise style={`--d:${120 + i * 90}ms`}>
        <div class="ao__info">
          <h3 class="ao__cn">{b.name}</h3>
          <p class="ao__city">{b.city}</p>

          {b.verified ? (
            <address>{b.address.split(String.fromCharCode(10)).map((l) => <>{l}<br /></>)}</address>
          ) : (
            <div class="ao__slot ao__slot--addr"><span>Address to be confirmed</span></div>
          )}

          <div class="ao__hours">
            <Icon name="clock" size={17} />
            <ul data-unverified={!b.hoursVerified ? '' : undefined}>
              {b.hours.map((h) => <li>{h}</li>)}
            </ul>
          </div>

          <div class="ao__acts">
            <a
              class="ao__wa"
              href={whatsappLink(`Hello Danat — I'd like to contact your ${b.name} branch about`)}
              target="_blank"
              rel="noopener noreferrer"
              title={`WhatsApp ${b.name}`}
              aria-label={`Message ${b.name} on WhatsApp`}
            >
              <Icon name="whatsapp" size={18} />
            </a>
            <a
              class="ao__dir"
              href={`https://www.openstreetmap.org/?mlat=${b.geo.lat}&mlon=${b.geo.lon}#map=${b.geo.precise ? 17 : 13}/${b.geo.lat}/${b.geo.lon}`}
              target="_blank"
              rel="noopener noreferrer"
            >
              Open in maps <Icon name="send" size={14} />
            </a>
          </div>
        </div>
      </article>
    ))}
  </div>

</section>

<style>
  /* The slanted green cut that used to sit here carried the band above
     down into this section. That band is light now, so the wedge was a
     dark shape belonging to nothing. */

  .ao {
    position: relative;
    background: linear-gradient(180deg, var(--white) 0%, #f7faf8 62%, var(--white) 100%);
    padding-block: clamp(6rem, 11vw, 10rem) 0;
    overflow: hidden;
    isolation: isolate;
  }

  /* ---------- grid ---------- */

  .ao__grid {
    position: relative;
    z-index: 1;
    display: grid;
    gap: var(--s7);
    align-items: start;
    padding-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }

  /* ---------- left ---------- */

  .ao__title {
    margin-top: var(--s4);
    font-size: clamp(2rem, 3.6vw, 3.1rem);
    line-height: 1.04;
    letter-spacing: -0.038em;
    font-weight: 700;
  }
  .ao__title em { font-style: normal; color: var(--green); }

  .ao__sub {
    margin-top: var(--s4);
    max-width: 40ch;
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--text-2);
  }

  .ao__tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: var(--s5);
  }

  .ao__tab {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.6rem 1.1rem;
    border: 1px solid var(--line-light);
    border-radius: 999px;
    background: var(--white);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-2);
    transition:
      background-color var(--t2) var(--ease),
      border-color var(--t2) var(--ease),
      color var(--t2) var(--ease);
  }
  .ao__tab:hover { border-color: var(--green); color: var(--green-deep); }
  .ao__tab[data-on] { background: var(--green); border-color: var(--green); color: #fff; }

  /* ---------- the three branches ---------- */

  .ao__row {
    position: relative;
    z-index: 1;
    display: grid;
    gap: clamp(1rem, 1.8vw, 1.6rem);
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }

  .ao__card {
    display: grid;
    /* The card ends where its words end; the info block takes the slack
       so the three action rows line up across the row. */
    grid-template-rows: auto minmax(0, 1fr);
    border: 1px solid var(--line-light);
    border-radius: 18px;
    background: var(--white);
    box-shadow:
      0 1px 2px rgb(10 30 12 / 0.05),
      0 20px 40px -26px rgb(10 30 12 / 0.3);
    overflow: hidden;
    transition: transform var(--t2) var(--ease), box-shadow var(--t2) var(--ease);
  }
  .ao__card:hover {
    transform: translateY(-4px);
    box-shadow:
      0 1px 2px rgb(10 30 12 / 0.06),
      0 32px 56px -28px rgb(10 30 12 / 0.4);
  }

  /* ---------- the one map ---------- */

  .ao__map {
    position: relative;
    width: 100%;
    border-radius: 20px;
    overflow: hidden;
    background: var(--off-2);
    box-shadow:
      0 1px 2px rgb(10 30 12 / 0.05),
      0 24px 46px -28px rgb(10 30 12 / 0.34);
  }
  .ao__map :global(img) { display: block; width: 100%; height: auto; }

  .ao__map figcaption {
    position: absolute;
    right: 0;
    bottom: 0;
    padding: 0.3rem 0.55rem;
    border-top-left-radius: 8px;
    background: rgb(255 255 255 / 0.86);
    font-size: 0.625rem;
    color: var(--text-3);
  }

  /* Anchored by its pin tip, which is what --x/--y describe. */
  .ao__spot {
    position: absolute;
    left: var(--x);
    top: var(--y);
    translate: -50% -100%;
    display: grid;
    justify-items: center;
  }

  .ao__dot {
    width: 15px;
    height: 15px;
    border-radius: 50%;
    background: var(--green-deep);
    box-shadow: 0 0 0 4px var(--white), 0 4px 10px -3px rgb(10 30 12 / 0.6);
  }

  .ao__halo {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 15px;
    height: 15px;
    translate: -50% -50%;
    border-radius: 50%;
    background: rgb(89 170 84 / 0.5);
    animation: ao-ping 2.8s var(--ease) infinite;
  }

  .ao__lbl {
    margin-top: 0.4rem;
    padding: 0.22rem 0.55rem;
    border-radius: 999px;
    background: var(--white);
    box-shadow: 0 4px 12px -5px rgb(20 23 26 / 0.45);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text);
    white-space: nowrap;
    transition: background-color var(--t2) var(--ease), color var(--t2) var(--ease);
  }
  .ao__spot:hover .ao__lbl { background: var(--green-deep); color: #fff; }

  /* Salalah sits at 90% of the height — its label would hang off the
     bottom edge, so it goes above the dot instead. */
  .ao__spot[data-low] {
    flex-direction: column-reverse;
  }
  .ao__spot[data-low] .ao__lbl {
    order: -1;
    margin: 0 0 0.4rem;
  }

  .ao__info {
    display: grid;
    align-content: start;
    padding: 1.35rem 1.4rem;
  }
  .ao__cn { font-size: 1.2rem; font-weight: 700; letter-spacing: -0.025em; }

  .ao__city {
    margin-top: 0.2rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--green-deep);
  }

  .ao__card address {
    display: block;
    margin-top: 0.85rem;
    font-style: normal;
    font-size: var(--small);
    line-height: 1.65;
    color: var(--text-2);
  }

  .ao__hours {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    margin-top: 0.9rem;
    color: var(--text-3);
  }
  .ao__hours ul {
    display: grid;
    gap: 0.15rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.03em;
  }
  .ao__hours ul[data-unverified] { opacity: 0.55; }

  .ao__acts {
    margin-top: auto;
    padding-top: 1.1rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1.1rem;
  }

  /* Mark only, no label. White on --green (#59AA54) is 2.88:1, under the
     3:1 WCAG asks of a non-text graphic, so these sit on --green-deep
     (7.06:1) instead. */
  .ao__wa {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    flex: none;
    border-radius: 50%;
    background: var(--green-deep);
    color: #fff;
    transition: background-color var(--t2) var(--ease), transform var(--t2) var(--ease);
  }
  .ao__wa:hover { background: var(--text); transform: translateY(-2px); }

  .ao__dir {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1.2rem;
    border: 1px solid var(--line-light);
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-2);
    transition: border-color var(--t2) var(--ease), color var(--t2) var(--ease);
  }
  .ao__dir:hover { border-color: var(--green); color: var(--green-deep); }

  .ao__shot { position: relative; min-height: 11rem; }

  .ao__chip {
    position: absolute;
    right: 0.7rem;
    bottom: 0.7rem;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.35rem 0.7rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.94);
    box-shadow: 0 4px 12px -6px rgb(20 23 26 / 0.4);
    font-size: 0.6875rem;
    font-weight: 500;
  }

  /* ---------- reserved space for missing data ---------- */

  .ao__slot {
    display: grid;
    place-items: center;
    gap: 0.35rem;
    border: 1px dashed var(--line-light);
    border-radius: 8px;
    background: repeating-linear-gradient(45deg, #fafafa 0 8px, #f4f4f2 8px 16px);
    color: var(--text-3);
    font-size: 0.6875rem;
    text-align: center;
  }
  .ao__slot--addr { margin-top: 0.85rem; padding: 0.85rem; }
  .ao__slot--photo { height: 100%; min-height: 11rem; border-radius: 0; border-width: 0 0 0 1px; }
  .ao__slot--thumb { width: 100%; aspect-ratio: 4 / 3; border-radius: 6px; }

  /* ---------- scripts ---------- */

  .ao__script {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(1rem, 1.5vw, 1.35rem);
    line-height: 1.25;
    color: var(--green-deep);
    opacity: 0.9;
  }
  .ao__script--low { margin-top: var(--s6); }
  .ao__script--high { text-align: right; }

  .ao__all {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    justify-self: start;
    margin-top: var(--s5);
    padding-bottom: 0.3rem;
    border-bottom: 1px solid var(--text);
    font-size: 0.9375rem;
    font-weight: 500;
    transition: color var(--t2) var(--ease), border-color var(--t2) var(--ease);
  }
  .ao__all:hover { color: var(--green-deep); border-color: var(--green-deep); }

  /* ---------- map ---------- */

  .ao__mapwrap { position: relative; display: grid; align-content: start; gap: var(--s5); }


  .ao__land {
    fill: color-mix(in oklab, var(--green) 16%, #fff);
    stroke: color-mix(in oklab, var(--green) 34%, #fff);
    stroke-width: 3;
  }

  .ao__route {
    fill: none;
    stroke: var(--green);
    stroke-width: 3;
    stroke-dasharray: 3 14;
    stroke-linecap: round;
    opacity: 0.5;
    animation: ao-flow 3s linear infinite;
  }
  @keyframes ao-flow { to { stroke-dashoffset: -17; } }

  .ao__dot { fill: var(--green); stroke: #fff; stroke-width: 5; }
  .ao__halo { fill: var(--green); opacity: 0; transform-box: fill-box; transform-origin: center; }
  .ao__pin[data-on] .ao__halo { animation: ao-ping 2.8s var(--ease) infinite; }
  @keyframes ao-ping {
    0% { opacity: 0.3; transform: scale(0.35); }
    70% { opacity: 0; transform: scale(1); }
    100% { opacity: 0; transform: scale(1); }
  }

  .ao__mcard {
    position: absolute;
    left: var(--x);
    top: var(--y);
    translate: -50% -50%;
    width: clamp(5rem, 8vw, 7rem);
    padding: 0.3rem;
    border-radius: 10px;
    border: 1px solid var(--line-light);
    background: var(--white);
    box-shadow: 0 10px 24px -14px rgb(20 23 26 / 0.45);
    text-align: left;
    transition: transform var(--t2) var(--ease), border-color var(--t2) var(--ease);
  }
  .ao__mcard:hover { transform: translateY(-3px); }
  .ao__mcard[data-on] { border-color: var(--green); }

  .ao__mlabel {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.3rem 0.1rem 0.1rem;
    font-size: 0.625rem;
    font-weight: 600;
    color: var(--text);
  }
  .ao__mcard[data-on] .ao__mlabel { color: var(--green-deep); }

  /* ---------- stats ---------- */

  /* A row of three, not a stranded stack. */
  .ao__stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s4);
    margin-top: clamp(1.75rem, 3.5vw, 2.5rem);
    padding-top: var(--s5);
    border-top: 1px solid var(--line-light);
  }
  .ao__stats > div { display: flex; align-items: center; gap: 0.7rem; }
  .ao__stats dt { color: var(--green); display: grid; place-items: center; }
  .ao__stats dd b {
    display: block;
    font-size: 1.4rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .ao__stats dd i {
    display: block;
    margin-top: 0.2rem;
    font-style: normal;
    font-size: 0.8125rem;
    color: var(--text-2);
  }

  .ao__word { font-size: 1.15rem !important; letter-spacing: -0.02em; }

  /* Unverified figure: reserved blank rather than an invented number. */
  .ao__blank {
    width: 6.5rem;
    height: 1.5rem;
    border-radius: 4px;
    border: 1px dashed var(--line-light);
    background: repeating-linear-gradient(45deg, #fafafa 0 8px, #f4f4f2 8px 16px);
  }

  /* ---------- layout ---------- */

  @media (min-width: 48rem) {
    .ao__row { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  @media (min-width: 68rem) {
    /* The map carries the section, so it takes the wider track. The two
       columns meet at the top rather than being centred against each
       other, because the map is much the taller of the pair. */
    .ao__grid { grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.18fr); gap: var(--s7); }
  }

  @media (prefers-reduced-motion: reduce) {
    .ao__route, .ao__halo { animation: none !important; }
    .ao__card, .ao__card:hover { transition: none; transform: none; }
  }
</style>

{/* The selector script is gone with the tabs. All three branches are
    on screen at once, so there is nothing left to switch between. */}
