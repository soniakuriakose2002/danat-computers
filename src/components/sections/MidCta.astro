---
import { Image } from 'astro:assets';
import Icon from '@components/ui/Icon.astro';
import { site, whatsappLink } from '@data/site';

/* A clean macro on white — no people, no branded workwear, and it sits
   on the same light ground as the band instead of punching a dark
   cluttered rectangle into it.
   NOT repair-board.jpg: its technician wears a uniform branded
   ТЕХНОБЫТСЕРВИС, a competing repair company, legible at this size. */
import imgBench from '@assets/photos/drive-macro.jpg';

/**
 * FREE DIAGNOSIS — built to the client's mockup.
 *
 * Light, not the green slab it was. Figures are ERP-derived, not
 * marketing rounding.
 *
 * ⚠ The three steps here are the first three of the four on
 * HowItWorks. That section is removed from the homepage rather than
 * left to repeat them — but its fourth step, Verify ("tested under
 * load, with a warranty on the work and the parts"), has nowhere else
 * on the page and is worth a home.
 */
const figures = [
  { icon: 'box' as const, n: site.stats.parts, suffix: '', l: 'Parts in stock' },
  { icon: 'chart' as const, n: site.stats.categories, suffix: '', l: 'Categories' },
  { icon: 'pin' as const, n: site.stats.branches, suffix: '', l: 'Branches' },
  {
    icon: 'award' as const,
    n: new Date().getFullYear() - site.stats.since,
    suffix: '+',
    l: 'Years trading',
  },
];

const steps = [
  { n: '01', icon: 'search' as const, t: 'Diagnose', p: 'Free, before anything is quoted' },
  { n: '02', icon: 'mail' as const, t: 'Quote', p: 'Fixed price, agreed with you first' },
  { n: '03', icon: 'wrench' as const, t: 'Repair', p: 'To the component, not the whole board' },
];
---

<section class="fd section" data-tone="light">
  {/* The soft shapes the mockup sets everything on. */}
  <span class="fd__blob fd__blob--a" aria-hidden="true"></span>
  <span class="fd__blob fd__blob--b" aria-hidden="true"></span>
  <span class="fd__dots" aria-hidden="true"></span>

  <div class="shell fd__grid">
    {/* ── left ── */}
    <div class="fd__copy">
      <p class="fd__eb" data-rise>Free diagnosis</p>

      <h2 class="fd__h" data-rise style="--d:70ms">
        Something stopped working?<br />
        {/*
          The client's comp sets the emphasised half of a headline in a
          brush hand over a painted stroke, with a few ticks thrown off
          one corner. Three parts, and all three have to be here or it
          reads as a highlighter pen: the hand, the stroke that is
          brushed rather than rounded, and the ticks.

          The stroke is a path, not a border-radius — a pill has two
          equal ends and a brush has none. preserveAspectRatio is off so
          it stretches to whatever the line measures.
        */}
        <em>
          <svg class="fd__brush" viewBox="0 0 420 80" preserveAspectRatio="none" aria-hidden="true">
            <path
              d="M6 50C52 22 140 12 236 14c76 2 136 6 178-6-4 18-10 24-18 26-40 10-96 14-162 16-88 3-180 10-224 6-4-2-5-4-4-6Z"
            />
            <path class="fd__brush-2" d="M26 40c50-14 128-18 214-15 52 2 100 2 142-7" />
          </svg>
          <svg class="fd__spark" viewBox="0 0 44 44" aria-hidden="true">
            <path d="M15 29 30 14M21 36 41 31M11 23 17 3" />
          </svg>
          <span>Bring it in.</span>
        </em>
      </h2>

      <p class="fd__p" data-rise style="--d:130ms">
        We tell you what failed, what it costs and how long it takes — before
        you agree to anything.
      </p>

      <dl class="fd__figs" data-rise style="--d:190ms">
        {figures.map((f) => (
          <div>
            <dt><span class="fd__ic"><Icon name={f.icon} size={20} /></span></dt>
            <dd>
              <b><span data-count={f.n}>0</span>{f.suffix}</b>
              <i>{f.l}</i>
            </dd>
          </div>
        ))}
      </dl>
    </div>

    {/* ── right ── */}
    <div class="fd__side">
      <figure class="fd__shot" data-rise style="--d:160ms">
        {/* The frame clips; the figure does not, because the two tiles
            have to hang off its edges. The source leaves a lot of white
            around the board, so the image is scaled up inside the frame
            rather than sitting in the middle of an empty tile. */}
        <span class="fd__frame">
          <Image src={imgBench} alt="A laptop drive controller board, photographed close"
            widths={[560, 900, 1200]} sizes="(min-width: 62rem) 40vw, 92vw"
            quality={78} format="webp" loading="lazy" />
        </span>
        <span class="fd__chip fd__chip--a" aria-hidden="true"><Icon name="laptop" size={22} /></span>
        <span class="fd__chip fd__chip--b" aria-hidden="true"><Icon name="wrench" size={22} /></span>
      </figure>

      <ol class="fd__steps" data-rise style="--d:220ms">
        {steps.map((s) => (
          <li>
            <span class="fd__sic"><Icon name={s.icon} size={19} /></span>
            <span class="fd__st">
              <b>{s.n}</b><strong>{s.t}</strong>
              <em>{s.p}</em>
            </span>
          </li>
        ))}

        <li class="fd__call">
          <a href={whatsappLink()} target="_blank" rel="noopener noreferrer">
            <span class="fd__wa"><Icon name="whatsapp" size={20} /></span>
            {site.phone.display}
            <span class="fd__go" aria-hidden="true"><Icon name="arrow" size={15} /></span>
          </a>
          <span class="fd__note">Sat&ndash;Thu &middot; three branches across Oman</span>
        </li>
      </ol>
    </div>
  </div>
</section>

<style>
  .fd {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    background: linear-gradient(170deg, #ffffff 0%, #f4faf5 62%, #eef7f0 100%);
    padding-block: clamp(3rem, 6vw, 4.75rem);
  }

  /* ---- the ground ---- */
  .fd__blob {
    position: absolute;
    z-index: -1;
    border-radius: 50%;
    filter: blur(2px);
  }
  .fd__blob--a {
    left: 42%;
    top: -14%;
    width: 26rem;
    height: 22rem;
    background: radial-gradient(circle at 40% 40%, rgb(89 170 84 / 0.16), rgb(89 170 84 / 0) 68%);
  }
  .fd__blob--b {
    right: -6%;
    bottom: -18%;
    width: 30rem;
    height: 26rem;
    background: radial-gradient(circle at 50% 50%, rgb(89 170 84 / 0.12), rgb(89 170 84 / 0) 70%);
  }
  .fd__dots {
    position: absolute;
    z-index: -1;
    right: 3%;
    top: 8%;
    width: 8rem;
    height: 6rem;
    background: radial-gradient(circle at 1px 1px, rgb(47 100 41 / 0.2) 1.4px, transparent 0) 0 0 / 14px 14px;
  }

  .fd__grid { display: grid; gap: clamp(2rem, 4vw, 3.5rem); align-items: center; }

  /* ---- left ---- */
  .fd__eb {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--green-deep);
  }
  .fd__eb::before {
    content: '';
    width: 30px;
    height: 2px;
    border-radius: 2px;
    background: var(--green);
  }

  .fd__h {
    margin-top: var(--s4);
    font-size: clamp(1.9rem, 4vw, 3.1rem);
    font-weight: 800;
    letter-spacing: -0.045em;
    line-height: 1.1;
    color: var(--text);
  }
  /* The brush hand. It carries a lot of slant and very little
     x-height, so it needs to run larger than the grotesk above it and
     be given room for the B's ascender and the g's descender. */
  .fd__h em {
    position: relative;
    display: inline-block;
    margin-top: 0.2em;
    padding: 0.04em 0.3em 0.1em 0.16em;
    font-family: var(--font-script);
    font-style: normal;
    font-weight: 400;
    font-size: 1.34em;
    line-height: 1.12;
    letter-spacing: 0;
    /* --green-deep is 6.8:1 on white and 5.6:1 over the stroke below,
       comfortably past the 3:1 large text needs. */
    color: var(--green-deep);
  }
  .fd__h em > span { position: relative; z-index: 1; }

  .fd__brush {
    position: absolute;
    z-index: 0;
    left: -0.16em;
    right: -0.14em;
    bottom: 0.2em;
    height: 0.66em;
    overflow: visible;
    fill: rgb(89 170 84 / 0.24);
    /* Painted on, left to right, once the line has arrived. */
    clip-path: inset(0 100% 0 0);
  }
  /* The second, lighter pass a real brush leaves above the first. */
  .fd__brush-2 {
    fill: none;
    stroke: rgb(89 170 84 / 0.2);
    stroke-width: 13;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }
  .fd__h[data-in] .fd__brush {
    animation: fdPaint 640ms var(--ease) 430ms forwards;
  }
  @keyframes fdPaint {
    to { clip-path: inset(0 -3% 0 0); }
  }

  /* The ticks thrown off the corner. */
  .fd__spark {
    position: absolute;
    z-index: 2;
    right: -0.5em;
    top: -0.28em;
    width: 0.56em;
    height: 0.56em;
    fill: none;
    stroke: var(--green);
    stroke-width: 3.6;
    stroke-linecap: round;
    opacity: 0;
  }
  .fd__h[data-in] .fd__spark {
    animation: fdSpark 420ms var(--ease) 940ms forwards;
  }
  @keyframes fdSpark {
    0% { opacity: 0; transform: scale(0.4) rotate(-14deg); }
    60% { opacity: 1; transform: scale(1.14) rotate(5deg); }
    100% { opacity: 1; transform: scale(1) rotate(0deg); }
  }

  .fd__p {
    margin-top: var(--s4);
    max-width: 44ch;
    font-size: var(--lead);
    line-height: 1.62;
    color: var(--text-2);
  }

  .fd__figs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s5) 0;
    margin-top: clamp(1.75rem, 3.5vw, 2.75rem);
  }
  .fd__figs > div { padding-inline: clamp(0.9rem, 2vw, 1.6rem); }
  .fd__figs > div:first-child { padding-left: 0; }
  .fd__ic {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 13px;
    background: #e7f1e9;
    color: var(--green-deep);
  }
  .fd__figs dd { margin-top: 0.7rem; }
  .fd__figs b {
    display: block;
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    color: var(--text);
  }
  .fd__figs i {
    display: block;
    margin-top: 0.3rem;
    font-style: normal;
    font-size: 0.8125rem;
    color: var(--text-2);
  }

  /* ---- right ---- */
  .fd__side { position: relative; display: grid; }

  .fd__shot {
    position: relative;
    border-radius: 26px 90px 26px 26px;
    overflow: visible;
  }
  .fd__frame {
    display: block;
    overflow: hidden;
    border-radius: inherit;
    box-shadow: 0 34px 64px -34px rgb(10 30 12 / 0.45);
  }
  .fd__shot :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: 50% 52%;
    scale: 1.34;
  }
  /* The small white tiles that overlap the picture, as drawn. */
  .fd__chip {
    position: absolute;
    display: grid;
    place-items: center;
    width: 58px;
    height: 58px;
    border-radius: 17px;
    background: var(--white);
    color: var(--green-deep);
    box-shadow: 0 16px 30px -16px rgb(10 30 12 / 0.4);
  }
  .fd__chip--a { left: -1.6rem; top: 12%; }
  .fd__chip--b { left: 12%; bottom: -1.4rem; }

  .fd__steps { display: grid; gap: 0.6rem; margin-top: var(--s5); }
  .fd__steps li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 0.9rem;
    padding: 0.9rem 1.05rem;
    border: 1px solid #e3ece5;
    border-radius: 16px;
    background: var(--white);
    box-shadow: 0 14px 28px -20px rgb(10 30 12 / 0.3);
  }
  .fd__sic {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 12px;
    background: #e7f1e9;
    color: var(--green-deep);
  }
  .fd__st { display: grid; gap: 0.1rem; }
  .fd__st b {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    color: var(--green-deep);
  }
  .fd__st strong { font-size: 0.9375rem; font-weight: 700; color: var(--text); }
  .fd__st em {
    font-style: normal;
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--text-2);
  }

  /* the pill */
  /* Its own single column: without this it inherits the two-column
     track from the step cards and the note is squeezed into a vertical
     sliver beside the pill instead of sitting under it. The selector
     has to out-rank `.fd__steps li` — Astro stamps its cid on every
     compound, so that chain scores (0,3,1) and a bare `.fd__call`
     scores (0,2,0) and loses. */
  .fd__steps li.fd__call {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.55rem;
    padding: 0;
    border: 0;
    background: none;
    box-shadow: none;
  }
  .fd__call a {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.85rem;
    padding: 0.6rem 0.6rem 0.6rem 0.65rem;
    border-radius: 999px;
    /* white on #27551f is 8.7:1 */
    background: linear-gradient(100deg, #27551f, #3d7f35);
    color: #fff;
    font-size: 1.0625rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    transition: transform var(--t2) var(--ease);
  }
  .fd__call a:hover { transform: translateY(-2px); }
  .fd__wa, .fd__go {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: var(--white);
    color: var(--green-deep);
  }
  .fd__go { width: 34px; height: 34px; }
  .fd__note {
    padding-left: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    /* --text-3 is AA on this ground at this size. */
    color: var(--text-3);
  }

  @media (min-width: 62rem) {
    .fd__grid { grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.18fr); }
    .fd__figs { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .fd__figs > div + div { border-left: 1px solid #dfe8e1; }
    .fd__side { grid-template-columns: minmax(0, 1.06fr) minmax(0, 1fr); gap: var(--s5); align-items: center; }
    .fd__steps { margin-top: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .fd__call a, .fd__call a:hover { transform: none; transition: none; }
    /* The stroke and the ticks are the design, not decoration on top of
       it — they arrive already painted rather than not at all. */
    .fd__brush, .fd__h[data-in] .fd__brush {
      animation: none;
      clip-path: none;
    }
    .fd__spark, .fd__h[data-in] .fd__spark {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>
