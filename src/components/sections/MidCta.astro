---
import { Image } from 'astro:assets';
import Icon from '@components/ui/Icon.astro';
import { site, whatsappLink } from '@data/site';
/* NOT repair-board.jpg. That photograph's technician wears a uniform
   branded ТЕХНОБЫТСЕРВИС — another repair company — and the wordmark is
   legible. It has no place on Danat's page. */
import imgBench from '@assets/photos/repair-solder.jpg';

/**
 * 05 — Mid-page CTA.
 *
 * A second conversion point roughly halfway down, so contacting Danat
 * does not require scrolling to the footer.
 *
 * Figures are ERP-derived, not marketing rounding.
 */
/* Held as numbers, not pre-formatted strings, so each can run up from
   zero. The counter writes the grouped form itself, and any suffix sits
   outside the counting span so it does not get overwritten. */
const figures = [
  { n: site.stats.parts, suffix: '', l: 'Parts in stock' },
  { n: site.stats.categories, suffix: '', l: 'Categories' },
  { n: site.stats.branches, suffix: '', l: 'Branches' },
  { n: new Date().getFullYear() - site.stats.since, suffix: '+', l: 'Years trading' },
];
---

<section class="mid" data-tone="dark">
  <!-- A flat colour block reads as a divider, not a moment. The photo
       gives the band texture and depth; the green tint keeps the text
       contrast where it needs to be. -->
  <div class="mid__bg" aria-hidden="true">
    <Image src={imgBench} alt="" widths={[1000, 1600, 2000]} sizes="100vw"
      quality={72} format="webp" loading="lazy" />
    <span class="mid__tint"></span>
  </div>
  <div class="mid__glow" aria-hidden="true"></div>

  <div class="shell">
    <!-- copy and actions share one row, so neither is stranded -->
    <div class="mid__top">
      <div class="mid__copy">
        <p class="label" data-rise>Free diagnosis</p>
        <h2 class="mid__h" data-rise style="--d:70ms">
          Something stopped working?<br /><em>Bring it in.</em>
        </h2>
        <p class="mid__p" data-rise style="--d:130ms">
          We tell you what failed, what it costs and how long it takes —
          before you agree to anything.
        </p>
      </div>

      {/* Three across, not stacked: the same promise in a third of the
         height. */}
      <ol class="mid__steps" data-rise style="--d:190ms">
        <li><b>01</b><span>Diagnose<em>Free, before anything is quoted</em></span></li>
        <li><b>02</b><span>Quote<em>Fixed price, agreed with you first</em></span></li>
        <li><b>03</b><span>Repair<em>To the component, not the whole board</em></span></li>
      </ol>
    </div>

    {/* One closing row: the figures, and the ways to reach us beside
        them, rather than each claiming a band of its own. */}
    <div class="mid__foot" data-rise style="--d:240ms">
      <dl class="mid__figs">
        {figures.map((f) => (
          <div>
            <dt><span data-count={f.n}>0</span>{f.suffix}</dt>
            <dd>{f.l}</dd>
          </div>
        ))}
      </dl>

      <div class="mid__acts">
        <a class="mid__wa" href={whatsappLink()} target="_blank" rel="noopener noreferrer"
          title="Chat on WhatsApp" aria-label="Chat with Danat on WhatsApp">
          <Icon name="whatsapp" size={20} />
        </a>
        <span class="mid__reach">
          <a class="mid__call" href={`tel:${site.phone.tel}`}>{site.phone.display}</a>
          <span class="mid__note">Sat&ndash;Thu &middot; three branches across Oman</span>
        </span>
      </div>
    </div>
  </div>
</section>

<style>
  /* Brand green rather than black: it breaks the run of white sections
     without adding a second dark slab to the page. */
  .mid {
    position: relative;
    background: #27551f;
    color: #fff;
    padding-block: clamp(1.75rem, 3vw, 2.5rem);
    overflow: hidden;
    isolation: isolate;
  }

  .mid__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .mid__bg :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 62% 45%;
  }

  /* Heaviest over the copy, lighter on the right so the photograph is
     actually visible. Every stop still clears AA for white text. */
  .mid__tint {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(100deg,
        #27551f 0%,
        rgb(39 85 31 / 0.97) 34%,
        rgb(47 100 41 / 0.9) 62%,
        /* Measured against the photograph underneath, not judged by eye:
           at 0.78 the brightest part of the bench put plain white at
           4.29:1 and the sub-text at 3.29:1. At 0.88 white is 5.36:1. */
        rgb(47 100 41 / 0.88) 100%),
      linear-gradient(to bottom, rgb(39 85 31 / 0.35), transparent 40%);
  }

  /* A soft light bloom, top-right. */
  .mid__glow {
    position: absolute;
    right: -8%;
    top: -55%;
    width: 46%;
    aspect-ratio: 1;
    z-index: 0;
    background: radial-gradient(circle, rgb(255 255 255 / 0.1) 0%, transparent 62%);
    filter: blur(60px);
    pointer-events: none;
  }

  /* Content must sit above the bloom, which is absolutely positioned. */
  .mid :global(.shell) {
    position: relative;
    z-index: 1;
  }

  /* ---------- top row ---------- */

  .mid__top {
    display: grid;
    gap: var(--s5);
    align-items: end;
    padding-bottom: clamp(1rem, 1.8vw, 1.5rem);
  }

  .mid__h {
    margin-top: var(--s4);
    font-size: clamp(1.5rem, 2.5vw, 2.1rem);
    line-height: 1.1;
    letter-spacing: -0.035em;
    font-weight: 700;
  }
  .mid__h em { font-style: normal; color: #d9f2d3; }

  .mid__p {
    margin-top: var(--s4);
    max-width: 42ch;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: rgb(255 255 255 / 0.84);
  }


  /* The three steps the headline promises. A number, the step, and what
     it actually means — the band used to say "free diagnosis" and then
     leave the right-hand half empty. */
  /* Across, not down: three stacked rows with rules between them were
     most of this band's height. */
  .mid__steps {
    display: grid;
    gap: 0.9rem clamp(0.9rem, 2vw, 1.6rem);
    width: 100%;
    text-align: left;
  }
  .mid__steps li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: start;
    gap: 0.7rem;
    padding-left: clamp(0.9rem, 2vw, 1.6rem);
    border-left: 1px solid rgb(255 255 255 / 0.22);
  }
  .mid__steps li:first-child { padding-left: 0; border-left: 0; }
  .mid__steps b {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    color: rgb(255 255 255 / 0.55);
    padding-top: 0.15rem;
  }
  .mid__steps span { display: grid; gap: 0.1rem; font-size: 0.9375rem; font-weight: 700; color: #fff; }
  .mid__steps em {
    font-style: normal;
    font-size: 0.8125rem;
    font-weight: 400;
    line-height: 1.45;
    /* 0.78 measured 3.97:1 over the brightest part of the photograph;
       0.9 is 4.7:1 and clears AA. */
    color: rgb(255 255 255 / 0.9);
  }

  .mid__foot {
    display: grid;
    gap: var(--s4);
    margin-top: var(--s4);
    padding-top: clamp(0.9rem, 1.6vw, 1.3rem);
    border-top: 1px solid rgb(255 255 255 / 0.26);
  }
  .mid__acts {
    display: flex;
    align-items: center;
    gap: var(--s4);
  }
  /* The opening days came off in the restructure; they belong with the
     number rather than nowhere. */
  .mid__reach { display: grid; gap: 0.2rem; }

  .mid__wa {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    flex: none;
    border-radius: 50%;
    background: #fff;
    color: #2f6429;
    box-shadow: 0 10px 24px -14px rgb(0 0 0 / 0.45);
    transition:
      background-color var(--t2) var(--ease),
      color var(--t2) var(--ease),
      transform var(--t2) var(--ease);
  }
  .mid__wa:hover { background: var(--ink); color: #fff; transform: translateY(-2px); }

  .mid__call {
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    letter-spacing: 0.04em;
    color: #fff;
    border-bottom: 1px solid rgb(255 255 255 / 0.5);
    padding-bottom: 2px;
    transition: border-color var(--t2) var(--ease);
  }
  .mid__call:hover { border-color: #fff; }

  .mid__note {
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.66);
  }

  /* ---------- figures ---------- */

  .mid__figs {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--s5) 0;
  }

  /* Hairline between figures rather than floating them in space. */
  .mid__figs > div { padding-inline: var(--s5); }
  .mid__figs > div:first-child { padding-left: 0; }
  .mid__figs > div + div { border-left: 1px solid rgb(255 255 255 / 0.26); }

  .mid__figs dt {
    font-size: clamp(1.4rem, 2.3vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    color: #fff;
  }

  .mid__figs dd {
    margin-top: 0.35rem;
    font-size: 0.75rem;
    letter-spacing: 0.02em;
    color: rgb(255 255 255 / 0.72);
  }

  @media (min-width: 40rem) {
    .mid__figs { grid-template-columns: repeat(4, 1fr); }
    .mid__steps { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .mid__foot { grid-template-columns: minmax(0, 1fr) auto; align-items: center; }
    .mid__figs > div:nth-child(3) { border-left: 1px solid rgb(255 255 255 / 0.26); }
  }

  @media (max-width: 40rem) {
    /* 2x2: the third cell starts a new row, so it has no left rule. */
    .mid__figs > div:nth-child(3) { padding-left: 0; border-left: 0; }
  }

  @media (min-width: 62rem) {
    .mid__top { grid-template-columns: minmax(0, 1fr) auto; gap: var(--s7); }
    .mid__acts { justify-items: end; text-align: right; }
  }
</style>
