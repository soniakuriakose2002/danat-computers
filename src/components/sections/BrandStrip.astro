---
import { site } from '@data/site';

/**
 * 02 — Credibility, immediately after the hero.
 *
 * Names and categories both come out of the company's own product
 * catalogue. Set large, because at small sizes a brand list reads as
 * filler; at this scale it reads as a statement of stock.
 */
const brands = [
  { n: 'HP', k: 'Laptops · Printers' },
  { n: 'Dell', k: 'Laptops · Monitors' },
  { n: 'Lenovo', k: 'Laptops · Desktops' },
  { n: 'ASUS', k: 'Laptops · Boards' },
  { n: 'Acer', k: 'Laptops · Monitors' },
  { n: 'Apple', k: 'MacBook · Parts' },
  { n: 'Canon', k: 'Printers · Toner' },
  { n: 'Epson', k: 'Printers · Ink' },
  { n: 'Hikvision', k: 'CCTV · NVR' },
  { n: 'Dahua', k: 'CCTV · DVR' },
  { n: 'Uniview', k: 'CCTV · NVR' },
  { n: 'EZVIZ', k: 'Wi-Fi cameras' },
  { n: 'TP-Link', k: 'Routers · Switches' },
  { n: 'Zebra', k: 'Barcode · Scanners' },
  { n: 'AOC', k: 'Monitors' },
  { n: 'Panasonic', k: 'Batteries · Projectors' },
];

const half = Math.ceil(brands.length / 2);
const rows = [brands.slice(0, half), brands.slice(half)];
---

<section class="bs" data-tone="light">
  <!-- Wavy boundary with the dark hero above. Two paths at different
       speeds so the crest never sits still. -->
  <div class="bs__wave" aria-hidden="true">
    <svg viewBox="0 0 1440 130" preserveAspectRatio="none">
      <path class="bs__wave-b" d="M0,-24 L1440,-24 L1440,34 C1300,132 1140,4 950,52 C760,100 570,146 380,98 C248,64 118,22 0,58 Z"></path>
      <path class="bs__wave-f" d="M0,-24 L1440,-24 L1440,14 C1276,116 1104,-4 908,38 C712,80 524,130 336,76 C214,42 106,6 0,38 Z"></path>
    </svg>
  </div>

  <div class="shell bs__head">
    <p class="label">What we carry</p>
    <p class="bs__count">
      <b><span data-count={brands.length}>0</span></b> brands
      <span aria-hidden="true">·</span>
      <b><span data-count={site.stats.parts}>0</span></b> lines in stock
    </p>
  </div>

  <!-- Full-bleed rails, opposing directions -->
  <div class="bs__rails">
    {rows.map((row, r) => (
      <div class="bs__rail" data-dir={r === 1 ? 'rev' : undefined}>
        <div class="bs__track">
          {[0, 1].map(() =>
            row.map((b) => (
              <span class="bs__item">
                <span class="bs__n">{b.n}</span>
                <span class="bs__k">{b.k}</span>
              </span>
            ))
          )}
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .bs {
    position: relative;
    z-index: 1;
    background: var(--white);
    padding-block: clamp(5.5rem, 10vw, 9rem) clamp(2.5rem, 5vw, 4.5rem);
    overflow: hidden;
    isolation: isolate;
  }

  /* ---------- wave ---------- */

  .bs__wave {
    position: absolute;
    top: -1px;
    left: 0;
    width: 100%;
    height: clamp(58px, 9vw, 130px);
    z-index: 2;
    pointer-events: none;
  }
  .bs__wave svg { width: 100%; height: 100%; }

  /* The front path must be the hero's own colour, or the seam shows —
     and the hero above is light now, not ink. */
  .bs__wave-b {
    transform-origin: center top;
    fill: color-mix(in oklab, var(--off) 92%, var(--green));
    animation: bs-swell-b 13s ease-in-out infinite alternate;
  }
  .bs__wave-f {
    transform-origin: center top;
    /* The hero above ends on --off, so the front path is that. It was
       --ink, which is what made the seam a dark band once the section
       above turned light. */
    fill: var(--off);
    animation: bs-swell-f 9s ease-in-out infinite alternate;
  }
  @keyframes bs-swell-b {
    from { transform: translate3d(-1.5%, 2px, 0) scaleY(1); }
    to   { transform: translate3d(1.5%, -3px, 0) scaleY(1.06); }
  }
  @keyframes bs-swell-f {
    from { transform: translate3d(1.2%, -2px, 0) scaleY(1.04); }
    to   { transform: translate3d(-1.2%, 3px, 0) scaleY(1); }
  }

  /* ---------- head ---------- */

  .bs__head {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s4);
    padding-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }

  .bs__count {
    font-size: 0.9375rem;
    color: var(--text-2);
  }
  .bs__count b {
    font-weight: 700;
    color: var(--text);
    font-variant-numeric: tabular-nums;
  }
  .bs__count span { margin-inline: 0.45rem; color: var(--green); }

  /* ---------- rails ---------- */

  .bs__rails {
    position: relative;
    z-index: 1;
    display: grid;
    gap: clamp(0.25rem, 0.8vw, 0.75rem);
  }

  .bs__rail {
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 5%, #000 95%, transparent);
  }

  .bs__track {
    display: flex;
    align-items: baseline;
    gap: clamp(2rem, 4.5vw, 4.5rem);
    width: max-content;
    animation: bs-run 44s linear infinite;
  }

  /* Second row runs the other way — the counter-motion is what stops it
     reading as one long ticker. */
  .bs__rail[data-dir='rev'] .bs__track {
    animation-direction: reverse;
    animation-duration: 56s;
  }

  .bs__rails:hover .bs__track { animation-play-state: paused; }

  @keyframes bs-run {
    from { transform: translate3d(0, 0, 0); }
    to { transform: translate3d(-50%, 0, 0); }
  }

  /* ---------- items ---------- */

  .bs__item {
    position: relative;
    display: block;
    flex: none;
    padding-bottom: 0.55rem;
    cursor: default;
  }

  /* Large and pale at rest: a wall of stock, not a caption. */
  .bs__n {
    display: block;
    font-size: clamp(1.6rem, 3.6vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
    white-space: nowrap;
    /* Was --off-2 (#ececea), which is 1.18:1 on white — the names were
       nearly invisible. #8b938f is 3.15:1, which clears AA for text this
       size while still reading as a marquee rather than body copy. */
    color: #8b938f;
    transition: color var(--t2) var(--ease);
  }

  /* Category is hidden until hover, then rises into the reserved space. */
  .bs__k {
    position: absolute;
    left: 0;
    bottom: -0.35rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--green-deep);
    opacity: 0;
    transform: translateY(6px);
    transition: opacity var(--t2) var(--ease), transform var(--t2) var(--ease);
  }

  /* Green rule wipes in under the hovered name. */
  .bs__item::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.15rem;
    height: 2px;
    background: var(--green);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--t3) var(--ease);
  }

  .bs__item:hover .bs__n { color: var(--text); }
  .bs__item:hover .bs__k { opacity: 1; transform: none; }
  .bs__item:hover::after { transform: scaleX(1); }

  @media (prefers-reduced-motion: reduce) {
    .bs__track { animation: none; }
    .bs__wave-b, .bs__wave-f { animation: none; }
    .bs__rail { overflow-x: auto; mask-image: none; }
  }
</style>
