---
import { site } from '@data/site';

/**
 * 02 — Credibility, immediately after the hero.
 *
 * Names and categories both come out of the company's own product
 * catalogue. Set large, because at small sizes a brand list reads as
 * filler; at this scale it reads as a statement of stock.
 */
const brands = [
  { n: 'HP', k: 'Laptops · Printers' },
  { n: 'Dell', k: 'Laptops · Monitors' },
  { n: 'Lenovo', k: 'Laptops · Desktops' },
  { n: 'ASUS', k: 'Laptops · Boards' },
  { n: 'Acer', k: 'Laptops · Monitors' },
  { n: 'Apple', k: 'MacBook · Parts' },
  { n: 'Canon', k: 'Printers · Toner' },
  { n: 'Epson', k: 'Printers · Ink' },
  { n: 'Hikvision', k: 'CCTV · NVR' },
  { n: 'Dahua', k: 'CCTV · DVR' },
  { n: 'Uniview', k: 'CCTV · NVR' },
  { n: 'EZVIZ', k: 'Wi-Fi cameras' },
  { n: 'TP-Link', k: 'Routers · Switches' },
  { n: 'Zebra', k: 'Barcode · Scanners' },
  { n: 'AOC', k: 'Monitors' },
  { n: 'Panasonic', k: 'Batteries · Projectors' },
];

const half = Math.ceil(brands.length / 2);
const rows = [brands.slice(0, half), brands.slice(half)];
---

<section class="bs" data-tone="light">
  <div class="shell bs__head">
    <p class="label">What we carry</p>
    <p class="bs__count">
      <b>{brands.length}</b> brands
      <span aria-hidden="true">·</span>
      <b>{site.stats.parts.toLocaleString('en-US')}</b> lines in stock
    </p>
  </div>

  <!-- Full-bleed rails, opposing directions -->
  <div class="bs__rails">
    {rows.map((row, r) => (
      <div class="bs__rail" data-dir={r === 1 ? 'rev' : undefined}>
        <div class="bs__track">
          {[0, 1].map(() =>
            row.map((b) => (
              <span class="bs__item">
                <span class="bs__n">{b.n}</span>
                <span class="bs__k">{b.k}</span>
              </span>
            ))
          )}
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  /* Rounded shoulders instead of a wave: the white sheet lifts over the
     dark hero. Each section boundary on this page uses a different
     treatment so none of them becomes a tic. */
  .bs {
    position: relative;
    z-index: 1;
    background: var(--white);
    border-radius: clamp(24px, 3.5vw, 52px) clamp(24px, 3.5vw, 52px) 0 0;
    margin-top: calc(clamp(24px, 3.5vw, 52px) * -1);
    padding-block: clamp(3.5rem, 6vw, 5.5rem) clamp(2.5rem, 5vw, 4.5rem);
    overflow: hidden;
    isolation: isolate;
  }

  /* ---------- head ---------- */

  .bs__head {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s4);
    padding-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }

  .bs__count {
    font-size: 0.9375rem;
    color: var(--text-2);
  }
  .bs__count b {
    font-weight: 700;
    color: var(--text);
    font-variant-numeric: tabular-nums;
  }
  .bs__count span { margin-inline: 0.45rem; color: var(--green); }

  /* ---------- rails ---------- */

  .bs__rails {
    position: relative;
    z-index: 1;
    display: grid;
    gap: clamp(0.25rem, 0.8vw, 0.75rem);
  }

  .bs__rail {
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 5%, #000 95%, transparent);
  }

  .bs__track {
    display: flex;
    align-items: baseline;
    gap: clamp(2rem, 4.5vw, 4.5rem);
    width: max-content;
    animation: bs-run 44s linear infinite;
  }

  /* Second row runs the other way — the counter-motion is what stops it
     reading as one long ticker. */
  .bs__rail[data-dir='rev'] .bs__track {
    animation-direction: reverse;
    animation-duration: 56s;
  }

  .bs__rails:hover .bs__track { animation-play-state: paused; }

  @keyframes bs-run {
    from { transform: translate3d(0, 0, 0); }
    to { transform: translate3d(-50%, 0, 0); }
  }

  /* ---------- items ---------- */

  .bs__item {
    position: relative;
    display: block;
    flex: none;
    padding-bottom: 0.55rem;
    cursor: default;
  }

  /* Large and pale at rest: a wall of stock, not a caption. */
  .bs__n {
    display: block;
    font-size: clamp(1.6rem, 3.6vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
    white-space: nowrap;
    color: var(--off-2);
    transition: color var(--t2) var(--ease);
  }

  /* Category is hidden until hover, then rises into the reserved space. */
  .bs__k {
    position: absolute;
    left: 0;
    bottom: -0.35rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--green-deep);
    opacity: 0;
    transform: translateY(6px);
    transition: opacity var(--t2) var(--ease), transform var(--t2) var(--ease);
  }

  /* Green rule wipes in under the hovered name. */
  .bs__item::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.15rem;
    height: 2px;
    background: var(--green);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--t3) var(--ease);
  }

  .bs__item:hover .bs__n { color: var(--text); }
  .bs__item:hover .bs__k { opacity: 1; transform: none; }
  .bs__item:hover::after { transform: scaleX(1); }

  @media (prefers-reduced-motion: reduce) {
    .bs__track { animation: none; }
    .bs__rail { overflow-x: auto; mask-image: none; }
  }
</style>
