---
interface Props {
  name:
    | 'laptop'
    | 'printer'
    | 'camera'
    | 'network'
    | 'drive'
    | 'headset'
    | 'search'
    | 'arrow'
    | 'pin'
    | 'clock'
    | 'send'
    | 'whatsapp'
    | 'users'
    | 'heart'
    | 'compass';
  size?: number;
  class?: string;
}
const { name, size = 24, class: klass = '' } = Astro.props;

const common = {
  fill: 'none',
  stroke: 'currentColor',
  'stroke-width': 1.5,
  'stroke-linecap': 'round' as const,
  'stroke-linejoin': 'round' as const,
};
---

<svg
  viewBox="0 0 24 24"
  width={size}
  height={size}
  class={klass}
  aria-hidden="true"
  {...common}
>
  {name === 'laptop' && (
    <>
      <rect x="3" y="5" width="18" height="11" rx="1.5" />
      <path d="M1.5 19h21" />
    </>
  )}

  {name === 'printer' && (
    <>
      <path d="M7 8V3.5h10V8" />
      <rect x="3" y="8" width="18" height="8" rx="1.5" />
      <path d="M7 14h10v6.5H7z" />
      <path d="M17.5 11.2h1.2" />
    </>
  )}

  {name === 'camera' && (
    <>
      <path d="M3.6 10.2 17 6.4a2 2 0 0 1 2.5 1.4l.5 1.8a2 2 0 0 1-1.4 2.5L5.2 15.8 3.6 10.2Z" />
      <path d="M7.5 14.5 9 19.8" />
      <path d="M5.5 20.2h6" />
      <path d="M20.2 12.4 22 13.9" />
    </>
  )}

  {name === 'network' && (
    <>
      <circle cx="17.5" cy="5.5" r="2.5" />
      <circle cx="17.5" cy="18.5" r="2.5" />
      <circle cx="6" cy="12" r="2.5" />
      <path d="M8.3 10.9 15.3 6.7" />
      <path d="M8.3 13.1l7 4.2" />
    </>
  )}

  {name === 'drive' && (
    <>
      <rect x="3" y="3.5" width="18" height="17" rx="2" />
      <circle cx="12" cy="12" r="4.5" />
      <circle cx="12" cy="12" r="1" />
      <path d="M15.4 15.1 18 17.6" />
    </>
  )}

  {name === 'headset' && (
    <>
      <path d="M4 13.5v-1.8a8 8 0 0 1 16 0v1.8" />
      <rect x="2.5" y="13" width="4" height="6" rx="1.6" />
      <rect x="17.5" y="13" width="4" height="6" rx="1.6" />
      <path d="M19.5 19v.6a2.4 2.4 0 0 1-2.4 2.4H13" />
    </>
  )}

  {name === 'search' && (
    <>
      <circle cx="11" cy="11" r="6.5" />
      <path d="M15.8 15.8 21 21" />
    </>
  )}

  {name === 'arrow' && <path d="M4 12h15M13 6l6 6-6 6" />}

  {name === 'pin' && (
    <>
      <path d="M12 21.5s7-6.2 7-11.3A7 7 0 0 0 5 10.2C5 15.3 12 21.5 12 21.5Z" />
      <circle cx="12" cy="10" r="2.6" />
    </>
  )}

  {name === 'clock' && (
    <>
      <circle cx="12" cy="12" r="8.6" />
      <path d="M12 7.2V12l3.2 1.9" />
    </>
  )}

  {name === 'send' && <path d="M21 3 10.5 13.5M21 3l-6.6 18-3.9-7.5L3 9.6 21 3Z" />}

  {name === 'whatsapp' && (
    <path
      d="M20.3 3.7A9.9 9.9 0 0 0 3.7 15.1L2.5 21l6-1.2a9.9 9.9 0 0 0 11.8-16.1ZM8.6 7.6c.2 0 .4 0 .5.4l.8 1.9c.1.2 0 .4-.1.5l-.6.7c-.1.2-.2.3 0 .6a8.4 8.4 0 0 0 3.6 3.1c.3.1.4 0 .6-.1l.8-.9c.1-.2.3-.2.5-.1l1.9.9c.2.1.3.3.3.5a2 2 0 0 1-1.4 1.6c-.6.2-1.6.2-4-1a12 12 0 0 1-4.3-4.5c-.7-1.4-.6-2.4-.4-2.9a2 2 0 0 1 1.3-1Z"
      fill="currentColor"
      stroke="none"
    />
  )}

  {name === 'users' && (
    <>
      <circle cx="9" cy="8" r="3.2" />
      <path d="M2.8 20a6.2 6.2 0 0 1 12.4 0" />
      <path d="M16.2 5.3a3.2 3.2 0 0 1 0 5.9" />
      <path d="M17.6 14.4A6.2 6.2 0 0 1 21.2 20" />
    </>
  )}

  {name === 'heart' && (
    <path d="M12 20.3 4.2 12.8a4.6 4.6 0 1 1 6.5-6.5l1.3 1.3 1.3-1.3a4.6 4.6 0 1 1 6.5 6.5Z" />
  )}

  {name === 'compass' && (
    <>
      <circle cx="12" cy="12" r="9" />
      <path d="M15.6 8.4 13.8 14l-5.4 1.8L10.2 10Z" />
    </>
  )}

  {name === 'building' && (
    <>
      <path d="M3 21h18" />
      <path d="M5.5 21V6.2a1.2 1.2 0 0 1 .8-1.1l7-2.4a.8.8 0 0 1 1.1.8V21" />
      <path d="M14.4 9.4h3.4a1.2 1.2 0 0 1 1.2 1.2V21" />
      <path d="M8.6 8.6h2.6M8.6 12.2h2.6M8.6 15.8h2.6" />
    </>
  )}

  {name === 'box' && (
    <>
      <path d="M20.5 7.8v8.4a1.4 1.4 0 0 1-.75 1.24l-7 3.6a1.4 1.4 0 0 1-1.5 0l-7-3.6A1.4 1.4 0 0 1 3.5 16.2V7.8a1.4 1.4 0 0 1 .75-1.24l7-3.6a1.4 1.4 0 0 1 1.5 0l7 3.6A1.4 1.4 0 0 1 20.5 7.8Z" />
      <path d="M3.7 7.1 12 11.4l8.3-4.3" />
      <path d="M12 11.4V21" />
    </>
  )}

  {name === 'mail' && (
    <>
      <rect x="2.6" y="4.8" width="18.8" height="14.4" rx="2" />
      <path d="m3.4 6.6 7.6 5.6a1.7 1.7 0 0 0 2 0l7.6-5.6" />
    </>
  )}

  {name === 'phone' && (
    <path d="M7.8 3.6a1.3 1.3 0 0 1 1.7.5l1.6 2.8a1.3 1.3 0 0 1-.2 1.6l-1.3 1.2a.6.6 0 0 0-.1.7 11.4 11.4 0 0 0 4.1 4.1.6.6 0 0 0 .7-.1l1.2-1.3a1.3 1.3 0 0 1 1.6-.2l2.8 1.6a1.3 1.3 0 0 1 .5 1.7l-.8 1.7a2.2 2.2 0 0 1-2.4 1.2C12 18.7 5.3 12 4.3 5.1a2.2 2.2 0 0 1 1.2-2.4Z" />
  )}

  {name === 'award' && (
    <>
      <circle cx="12" cy="9.2" r="5.7" />
      <path d="m8.3 13.8-1.5 6.9 5.2-2.6 5.2 2.6-1.5-6.9" />
    </>
  )}
</svg>
