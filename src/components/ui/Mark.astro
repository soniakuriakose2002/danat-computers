---
/**
 * MARK — a hand-drawn note on a word in a heading, drawn in when it
 * scrolls into view: a marker swipe behind it ("highlight"), a loose
 * pen circle around it ("circle"), or a curved stroke under it
 * ("underline"). Colour follows --mk (defaults per variant).
 */
interface Props { as?: 'highlight' | 'circle' | 'underline'; tone?: 'mint' | 'butter' | 'sky' | 'green' | 'blue' }
const { as = 'underline', tone } = Astro.props;
const toneVar = tone ? `--mk: var(--mk-${tone})` : '';
---
<span class:list={['mk', `mk--${as}`]} style={toneVar} data-mk>
  <span class="mk__t"><slot /></span>
  {as === 'highlight' && (
    <svg class="mk__s" viewBox="0 0 200 60" preserveAspectRatio="none" aria-hidden="true">
      <path d="M4 18c46-10 112-14 192-9-3 15-4 29-7 41-63 4-124 6-181 7-5-12-6-26-4-39Z" />
    </svg>
  )}
  {as === 'circle' && (
    <svg class="mk__s" viewBox="0 0 200 80" preserveAspectRatio="none" aria-hidden="true">
      <path pathLength="1" d="M150 10C104 1 30 6 12 30c-14 20 20 42 90 44 70 2 98-18 90-38-6-16-44-26-100-22" />
    </svg>
  )}
  {as === 'underline' && (
    <svg class="mk__s" viewBox="0 0 200 20" preserveAspectRatio="none" aria-hidden="true">
      <path pathLength="1" d="M4 14C60 5 130 4 196 9" />
    </svg>
  )}
</span>

<style>
  .mk { --mk-mint: #bfe6c7; --mk-butter: #ffd98a; --mk-sky: #bcd6f6; --mk-green: #3fa34d; --mk-blue: #2d7ff0;
    position: relative; display: inline-block; white-space: nowrap; }
  .mk__t { position: relative; z-index: 1; }
  .mk__s { position: absolute; pointer-events: none; overflow: visible; }

  .mk--highlight { --mk: var(--mk-butter); }
  .mk--highlight .mk__s { left: -0.18em; right: -0.18em; top: 0.02em; bottom: -0.04em; width: calc(100% + 0.36em); height: 100%; z-index: 0; }
  .mk--highlight path { fill: var(--mk); clip-path: inset(0 100% 0 0); transition: clip-path 0.9s cubic-bezier(0.6, 0, 0.2, 1) 0.15s; }
  .mk--highlight.is-drawn path { clip-path: inset(0 0 0 0); }

  .mk--circle { --mk: var(--mk-blue); }
  .mk--circle .mk__s { left: -0.3em; right: -0.3em; top: -0.18em; bottom: -0.22em; width: calc(100% + 0.6em); height: calc(100% + 0.4em); }
  .mk--underline { --mk: var(--mk-green); }
  .mk--underline .mk__s { left: -0.05em; right: -0.05em; bottom: -0.2em; width: calc(100% + 0.1em); height: 0.32em; }
  .mk--circle path, .mk--underline path { fill: none; stroke: var(--mk); stroke-width: 3.2; stroke-linecap: round; vector-effect: non-scaling-stroke;
    stroke-dasharray: 1; stroke-dashoffset: 1; transition: stroke-dashoffset 1.1s cubic-bezier(0.6, 0, 0.2, 1) 0.2s; }
  .mk--circle.is-drawn path, .mk--underline.is-drawn path { stroke-dashoffset: 0; }

  @media (prefers-reduced-motion: reduce) {
    .mk path { transition: none !important; clip-path: none !important; stroke-dashoffset: 0 !important; }
  }
</style>

<script>
  function start() {
    const marks = [...document.querySelectorAll<HTMLElement>('[data-mk]:not([data-mk-wired])')];
    if (!marks.length) return;
    const io = new IntersectionObserver((es) => es.forEach((e) => {
      if (e.isIntersecting) { e.target.classList.add('is-drawn'); io.unobserve(e.target); }
    }), { threshold: 0.6 });
    marks.forEach((m) => { m.dataset.mkWired = '1'; io.observe(m); });
  }
  document.addEventListener('astro:page-load', start);
</script>
