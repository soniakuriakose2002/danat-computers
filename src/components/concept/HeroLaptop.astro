---
/**
 * HERO — "More than just a laptop" with the original front-facing laptop
 * (laptop-front.png) playing the Danat film on its screen. The laptop
 * stands on the bottom edge and the wave covers where the photo is cut.
 *
 * Scrolling zooms smoothly into the screen until the film fills the page.
 * Once it has, it stays: no zooming back out, and when the hero scrolls
 * away the page simply carries on to the next section. Coming back from
 * Get Support arrives on the film directly (sessionStorage
 * 'danat-hero-done'); a reload starts from the laptop again.
 *
 * Glass on the 900x640 photo: x 221–680, y 171–429 (16:9, like the film).
 * The film's Get Support button is clickable while it shows (12.3–15.3 s).
 */
import { Image } from 'astro:assets';
import { site, whatsappLink } from '@data/site';
import laptop from '@assets/products/laptop-front.png';
---
<section class="hl" data-hl aria-label="Danat Computers">
  <div class="hl__stage">
    <div class="hl__view" data-hl-rise>
      <div class="hl__dev" data-hl-dev>
        <span class="hl__floor" aria-hidden="true"></span>
        <Image src={laptop} alt="Laptop playing the Danat Computers film" width={900} quality={90} loading="eager" class="hl__img" />
        <div class="hl__scr">
          <video src="/film/danat-it-support.mp4" poster="/film/danat-it-support.jpg"
            muted loop playsinline autoplay preload="auto"
            controlslist="nodownload noplaybackrate noremoteplayback" disablepictureinpicture disableremoteplayback
            aria-label="Danat Computers IT support film"></video>
          {/* data-support-open makes this behave like every other Get
          Support on the site: it opens the support drawer. The
          WhatsApp href stays as the fallback for no-JS, exactly
          as the header button does it. */}
    <a class="hl__hot" href={whatsappLink()} data-support-open target="_blank" rel="noopener noreferrer"
      data-hl-hot aria-label="Get Support" tabindex="-1"></a>
          <span class="hl__glare" aria-hidden="true"></span>
        </div>
      </div>
    </div>
    <div class="hl__copy" data-hl-title>
      <p class="hl__eb"><span class="hl__l"><span>{site.nameFull}</span></span></p>
      <h1 class="hl__title"><span class="hl__l"><span>More than</span></span><span class="hl__l"><span>just <em>a laptop</em></span></span></h1>
      <p class="hl__lead"><span class="hl__l"><span>Complete technology solutions to power your work, study and business.</span></span></p>
    </div>
    <div class="hl__hud hl__hud--tr mono-label" data-hl-hud><span>{site.nameFull}</span><span>Ruwi · Sohar · Salalah</span><span>23.59° N  58.55° E</span></div>
    <div class="hl__hud hl__hud--br mono-label" data-hl-hud><span class="hl__line"></span><span>Scroll to step inside</span></div>
    <div class="hl__hud hl__hud--bl mono-label" data-hl-hud>Since {site.stats.since}</div>
    <div class="hl__wave" data-hl-wave aria-hidden="true">
      <svg viewBox="0 0 1440 130" preserveAspectRatio="none"><path class="b" d="M0,38 C106,6 214,42 336,76 C524,130 712,80 908,38 C1104,-4 1276,116 1440,14 L1440,134 L0,134 Z"/><path class="f" d="M0,58 C118,22 248,64 380,98 C570,146 760,100 950,52 C1140,4 1300,132 1440,34 L1440,134 L0,134 Z"/></svg>
    </div>
  </div>
</section>

<style>
  .hl { position: relative; height: 420vh; background: radial-gradient(90% 70% at 70% 40%, #15301a 0%, var(--ink) 60%); color: #fff; }
  .hl__stage { position: sticky; top: 0; height: 100vh; height: 100svh; overflow: hidden; }
  /* the laptop rises in once, on arrival — not tied to scrolling */
  .hl__view { position: absolute; inset: 0; opacity: 0; transform: translate3d(0, 70px, 0) scale(0.94); transition: opacity 1.2s var(--ease), transform 1.4s var(--ease); }
  .hl.is-in .hl__view { opacity: 1; transform: none; }
  .hl__dev { position: absolute; left: 0; top: 0; width: min(56vw, 980px); aspect-ratio: 900 / 640; transform-origin: 0 0; will-change: transform; }
  .hl__dev :global(.hl__img) { position: absolute; inset: 0; width: 100%; height: 100%; filter: drop-shadow(0 40px 60px rgb(0 0 0 / 0.6)); }
  /* 1600x900 box mapped onto the photo's glass by the script */
  .hl__scr { position: absolute; left: 0; top: 0; width: 1600px; height: 900px; transform-origin: 0 0; overflow: hidden; background: #000; }
  .hl__scr video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: fill; pointer-events: none; }
  .hl__glare { position: absolute; inset: 0; pointer-events: none; opacity: var(--gl, 1);
    background: linear-gradient(115deg, rgb(255 255 255 / 0.1) 0%, rgb(255 255 255 / 0.03) 28%, transparent 45%);
    box-shadow: inset 0 0 60px rgb(0 0 0 / 0.45); }
  .hl__floor { position: absolute; left: 50%; top: 96%; width: 120%; height: 40%; transform: translateX(-50%); z-index: -1; opacity: var(--gl, 1);
    background: radial-gradient(closest-side, rgb(89 170 84 / 0.35), transparent); filter: blur(10px); }
  .hl__hot { position: absolute; left: 6.6%; top: 68.6%; width: 22%; height: 12.4%; z-index: 3; border-radius: 999px; pointer-events: none; }
  .hl__hot.is-live { pointer-events: auto; cursor: pointer; }
  .hl__hot.is-live:hover, .hl__hot.is-live:focus-visible { box-shadow: 0 0 0 3px rgb(255 255 255 / 0.85), 0 0 40px rgb(122 211 116 / 0.75); outline: none; }

  .hl__copy { position: absolute; left: var(--gut); bottom: 14vh; z-index: 3; max-width: 34rem; will-change: transform, opacity; pointer-events: none; }
  .hl__eb { display: flex; align-items: center; gap: 0.7rem; font-size: clamp(1rem, 1.5vw, 1.25rem); font-weight: 600; letter-spacing: -0.015em; color: var(--green-bright); }
  .hl__eb::before { content: ''; width: 34px; height: 2px; border-radius: 2px; background: var(--green-bright); }
  .hl__title { margin-top: var(--s4); font-weight: 700; font-size: clamp(2.6rem, 5.4vw, 5.25rem); line-height: 1.02; letter-spacing: -0.045em; }
  .hl__lead { margin-top: var(--s4); max-width: 34ch; font-size: 1rem; line-height: 1.6; color: rgb(255 255 255 / 0.72); }
  .hl__l { display: block; overflow: hidden; }
  .hl__l > span { display: block; transform: translateY(105%); transition: transform 1.3s var(--ease); }
  .hl__title .hl__l:nth-child(2) > span { transition-delay: 0.1s; }
  .hl__lead .hl__l > span { transition-delay: 0.2s; }
  .hl.is-in .hl__l > span { transform: none; }
  .hl__title em { font-style: normal; color: var(--green-bright); }
  .mono-label { font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.18em; text-transform: uppercase; }
  .hl__hud { position: absolute; z-index: 3; color: rgb(255 255 255 / 0.62); pointer-events: none; }
  .hl__hud--tr { top: calc(var(--hdr, 88px) + 24px); right: var(--gut); text-align: right; display: grid; gap: 0.4rem; }
  .hl__hud--br { right: var(--gut); bottom: 14vh; display: flex; align-items: center; gap: 0.8rem; }
  .hl__line { width: 46px; height: 1px; background: currentColor; }
  .hl__hud--bl { left: var(--gut); bottom: 5vh; }
  .hl__wave { position: absolute; left: -4%; right: -4%; bottom: -1px; z-index: 6; height: 0; pointer-events: none; }
  .hl__wave svg { display: block; width: 100%; height: 100%; }
  .hl__wave .b { fill: color-mix(in oklab, var(--white) 88%, var(--green)); }
  .hl__wave .f { fill: var(--white); }

  /* settled: the film in place, no fly-in, content below follows naturally */
  .hl.is-done { height: 100vh; height: 100svh; }
  .hl.is-done .hl__stage { position: relative; }
  .hl.is-done .hl__copy, .hl.is-done .hl__hud { display: none; }
  .hl.is-done .hl__view { transition: none; opacity: 1; transform: none; }
  /* no composite: only the original film, covering the hero at 16:9 */
  .hl.is-done :global(.hl__img), .hl.is-done .hl__floor, .hl.is-done .hl__glare { display: none; }
  .hl.is-done .hl__dev { inset: 0; width: 100%; height: 100%; aspect-ratio: auto; transform: none !important; }
  .hl.is-done .hl__scr { left: 50%; top: 50%; width: max(100%, 100svh * 16 / 9); height: auto; aspect-ratio: 16 / 9; transform: translate(-50%, -50%) !important; }
  .hl.is-done.is-seen .hl__view { animation: hlSettle 1.1s var(--ease) both; }
  @keyframes hlSettle { from { opacity: 0.35; transform: translate3d(0, 18px, 0) scale(1.02); } to { opacity: 1; transform: none; } }

  @media (max-width: 51.25rem) {
    .hl__dev { width: 140vw !important; } /* the photo has wide margins around the laptop */
    .hl__copy { top: calc(var(--hdr, 72px) + 1.5rem); bottom: auto; right: var(--gut); }
    .hl__hud--tr, .hl__hud--bl { display: none; }
    .hl__hud--br { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hl { height: auto; }
    .hl__stage { position: relative; }
    .hl__l > span { transform: none; transition: none; }
    .hl__hud { display: none; }
    .hl__view { opacity: 1; transform: none; transition: none; }
    .hl.is-done.is-seen .hl__view { animation: none; }
  }
</style>

<script>
  const clamp = (v: number, a = 0, b = 1) => Math.min(b, Math.max(a, v));
  const ease = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
  const lerp = (a: number, b: number, t: number) => a + (b - a) * t;

  type P = number[];
  /* glass corners on the 900x640 photo: TL, TR, BR, BL */
  /* glass of the original front-facing laptop (laptop-front.png, 900x640): a plain 16:9 rectangle */
  const GLASS: P[] = [[221, 171], [680, 171], [680, 429], [221, 429]];
  const RECT: P[] = [[0, 0], [1600, 0], [1600, 900], [0, 900]];

  /* 3x3 projective map taking four points onto four points */
  function homography(src: P[], dst: P[]): number[] {
    const A: number[][] = [], bb: number[] = [];
    for (let i = 0; i < 4; i++) {
      const [x, y] = src[i], [u, v] = dst[i];
      A.push([x, y, 1, 0, 0, 0, -u * x, -u * y]); bb.push(u);
      A.push([0, 0, 0, x, y, 1, -v * x, -v * y]); bb.push(v);
    }
    for (let c = 0; c < 8; c++) {
      let piv = c; for (let r = c + 1; r < 8; r++) if (Math.abs(A[r][c]) > Math.abs(A[piv][c])) piv = r;
      [A[c], A[piv]] = [A[piv], A[c]]; [bb[c], bb[piv]] = [bb[piv], bb[c]];
      for (let r = 0; r < 8; r++) if (r !== c) {
        const f = A[r][c] / A[c][c];
        for (let j = c; j < 8; j++) A[r][j] -= f * A[c][j];
        bb[r] -= f * bb[c];
      }
    }
    return bb.map((v, i) => v / A[i][i]);
  }
  const css = (h: number[]) => `matrix3d(${h[0]},${h[3]},0,${h[6]},${h[1]},${h[4]},0,${h[7]},0,0,1,0,${h[2]},${h[5]},0,1)`;

  function start() {
    const sec = document.querySelector<HTMLElement>('[data-hl]');
    if (!sec || sec.dataset.wired) return;
    sec.dataset.wired = '1';
    const header = document.querySelector('header');
    const fitHdr = () => header && document.documentElement.style.setProperty('--hdr', `${header.offsetHeight}px`);
    fitHdr(); addEventListener('resize', fitHdr, { passive: true });

    const dev = sec.querySelector<HTMLElement>('[data-hl-dev]')!;
    const scr = sec.querySelector<HTMLElement>('.hl__scr')!;
    let lastK = -1;
    const vid = sec.querySelector<HTMLVideoElement>('video')!;
    const hot = sec.querySelector<HTMLAnchorElement>('[data-hl-hot]')!;
    const title = sec.querySelector<HTMLElement>('[data-hl-title]')!;
    const huds = [...sec.querySelectorAll<HTMLElement>('[data-hl-hud]')];
    const wave = sec.querySelector<HTMLElement>('[data-hl-wave]')!;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

    const play = () => vid.play().catch(() => {});
    play();
    ['pointerdown', 'touchstart', 'keydown', 'wheel'].forEach((t) => addEventListener(t, play, { once: true, passive: true }));
    requestAnimationFrame(() => sec.classList.add('is-in'));

    const KEY = 'danat-hero-done';
    const stored = () => { try { return sessionStorage.getItem(KEY) === '1'; } catch { return false; } };
    /* FLY_IN = false: no zoom at all. The IT Support film simply appears in
       place, full width with the wave, and the page scrolls on normally.
       Set it to true to bring back the laptop fly-in. */
    const FLY_IN = true;
    let latched = !FLY_IN || stored(), done = false;
    let visible = true, raf = 0, seen = false;
    const lenis = () => (window as any).__lenis;
    const jump = (y: number) => { const l = lenis(); l ? l.scrollTo(y, { immediate: true, force: true }) : scrollTo(0, y); };
    /* collapse the fly-in track to one screen without the page jumping */
    function settle() {
      if (done && sec!.dataset.settled) return;
      sec!.dataset.settled = '1';
      const before = sec!.offsetHeight, top = sec!.getBoundingClientRect().top + scrollY, y = scrollY;
      sec!.classList.add('is-done'); done = true;
      const after = sec!.offsetHeight, track = before - innerHeight;
      if (y > top + track) jump(y - (before - after));      // below the hero: keep what is on screen
      else if (y > top) jump(top);                           // inside the old track: show the film
      loop();
    }
    /* reaching the full film latches it for this page view only; coming back
       from Get Support (remembered) arrives settled. A fresh visit or a
       reload shows the laptop again. */
    function latch() { latched = true; }
    hot.addEventListener('click', () => { latch(); try { sessionStorage.setItem(KEY, '1'); } catch {} });
    /* a reload is a fresh look: forget the Get Support return */
    const nav = performance.getEntriesByType('navigation')[0] as PerformanceNavigationTiming | undefined;
    const w = window as any;
    if (!w.__hlLoadChecked) {                       // only for the real page load, not in-site navigation
      w.__hlLoadChecked = true;
      if (FLY_IN && nav && nav.type === 'reload') { try { sessionStorage.removeItem(KEY); } catch {} latched = false; }
    }
    if (latched) settle();

    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      if (visible) {
        play(); loop();
        if (done && !seen) { seen = true; sec!.classList.add('is-seen'); }
      } else {
        vid.pause();
        if (latched && !done && sec!.getBoundingClientRect().bottom <= 0) settle();
      }
    }, { threshold: 0.12 }).observe(sec);

    function frame() {
      raf = 0;
      if (!visible || !sec!.isConnected) return;
      const r = sec!.getBoundingClientRect();
      const p = reduced ? 0 : clamp(-r.top / Math.max(1, r.height - innerHeight));
      let d = ease(clamp((p - 0.08) / 0.72)), w = 1;   // the wave is always there
      if (d > 0.97 && !latched) latch();
      if (latched) { d = 1; w = 1; }                    // once filled, never zoom back out
      title.style.opacity = latched ? '0' : String(1 - clamp(p / 0.16));
      title.style.transform = `translateY(${-clamp(p / 0.16) * 60}px)`;
      huds.forEach((h) => (h.style.opacity = latched ? '0' : String(1 - clamp(p / 0.25))));
      wave.style.height = `${w * Math.min(110, Math.max(44, innerWidth * 0.06))}px`;

      const W = innerWidth, H = innerHeight, dw = dev.offsetWidth, dh = dev.offsetHeight, k = dw / 900;
      const Q = GLASS.map(([x, y]) => [x * k, y * k]);
      const x0 = W > 900 ? W - dw - W * 0.03 : (W - dw) / 2;
      /* the laptop stands on the bottom edge; the wave covers where the photo is cut */
      const waveH = Math.min(110, Math.max(44, innerWidth * 0.06));
      const y0 = H - dh + waveH * 0.45;
      /* where the glass must end up: a 16:9 box covering the whole page */
      const cw = Math.max(W, H * 16 / 9) * 1.01, ch = cw * 9 / 16, cx = (W - cw) / 2, cy = (H - ch) / 2;
      const R = [[cx, cy], [cx + cw, cy], [cx + cw, cy + ch], [cx, cy + ch]];
      const T = Q.map(([x, y], i) => [lerp(x + x0, R[i][0], d), lerp(y + y0, R[i][1], d)]);
      if (k !== lastK) { scr.style.transform = css(homography(RECT, Q)); lastK = k; }
      dev.style.transform = css(homography(Q, T));
      dev.style.setProperty('--gl', (1 - d).toFixed(3));

      const live = d > 0.85 && vid.currentTime >= 12.3 && vid.currentTime <= 15.3;
      hot.classList.toggle('is-live', live);
      hot.tabIndex = live ? 0 : -1;
      loop();
    }
    function loop() { if (!raf) raf = requestAnimationFrame(frame); }
    addEventListener('resize', loop);
    loop();
  }
  document.addEventListener('astro:page-load', start);
</script>
