---
/**
 * NUMBERS — the ERP-backed figures. The brands themselves are shown by
 * the site's own BrandStrip ("What we carry"), placed just before this.
 */
import { site } from '@data/site';
/* Lines in stock and brands are already shown by the brand strip above. */
const figs = [
  { v: site.stats.categories, l: 'Product categories' },
  { v: site.stats.branches, l: 'Branches in Oman' },
  { v: site.stats.since, l: 'Trading since', plain: true },
];
---
<section class="nb" data-nb aria-label="Danat in numbers">
  <div class="shell">
    <div class="nb__grid">
      {figs.map((f) => (
        <div class="nb__c"><div class="nb__v">{f.plain ? f.v : <span data-count={f.v}>{f.v.toLocaleString('en-US')}</span>}</div><div class="nb__l">{f.l}</div></div>
      ))}
    </div>
  </div>
</section>

<style>
  .nb { background: var(--ink); color: #fff; padding-block: clamp(4rem, 7vw, 6rem); }
  .nb__grid { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid rgb(255 255 255 / 0.12); }
  .nb__c { padding: 2rem 1.5rem 2rem 0; border-right: 1px solid rgb(255 255 255 / 0.12); }
  .nb__c:last-child { border-right: 0; }
  .nb__v { font-size: clamp(2.2rem, 4.2vw, 4rem); font-weight: 700; letter-spacing: -0.045em; line-height: 1; }
  .nb__l { margin-top: 0.8rem; font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.18em; text-transform: uppercase; color: rgb(255 255 255 / 0.55); }
  @media (max-width: 51.25rem) { .nb__grid { grid-template-columns: 1fr; } .nb__c { border-right: 0; border-bottom: 1px solid rgb(255 255 255 / 0.12); } }
</style>

