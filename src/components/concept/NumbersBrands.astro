---
/**
 * NUMBERS — the ERP-backed figures. The brands themselves are shown by
 * the site's own BrandStrip ("What we carry"), placed just before this.
 */
import { site } from '@data/site';
/* Lines in stock and brands are already shown by the brand strip above. */
const figs = [
  { v: site.stats.categories, l: 'Product categories' },
  { v: site.stats.branches, l: 'Branches in Oman' },
  { v: site.stats.since, l: 'Trading since', plain: true },
];
---
<section class="nb" data-nb aria-label="Danat in numbers">
  <div class="shell">
    <div class="nb__grid">
      {figs.map((f) => (
        <div class="nb__c"><div class="nb__v">{f.plain ? <span data-count={f.v} data-count-plain>{f.v}</span> : <span data-count={f.v}>{f.v.toLocaleString('en-US')}</span>}</div><div class="nb__l">{f.l}</div></div>
      ))}
    </div>
  </div>
</section>

<style>
  /* three equal columns, each figure centred in its own column */
  .nb { background: var(--ink); color: #fff; padding-block: clamp(3.5rem, 6vw, 5rem); }
  .nb__grid { display: grid; grid-template-columns: repeat(3, 1fr); align-items: center; }
  .nb__c { display: grid; justify-items: center; text-align: center; padding: 0.5rem 1.5rem; border-left: 1px solid rgb(255 255 255 / 0.12); }
  .nb__c:first-child { border-left: 0; }
  .nb__v { font-size: clamp(2.2rem, 4.2vw, 4rem); font-weight: 700; letter-spacing: -0.045em; line-height: 1; }
  .nb__l { margin-top: 0.8rem; font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.18em; text-transform: uppercase; color: rgb(255 255 255 / 0.55); }
  @media (max-width: 51.25rem) {
    .nb__grid { grid-template-columns: 1fr; gap: 0; }
    .nb__c { border-left: 0; padding: 1.6rem 0; border-top: 1px solid rgb(255 255 255 / 0.12); }
    .nb__c:first-child { border-top: 0; }
  }
</style>


