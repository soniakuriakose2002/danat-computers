---
import Icon from '@components/ui/Icon.astro';
import Logo from '@components/global/Logo.astro';
import { Image } from 'astro:assets';
/* The bench, not the shop floor: the story's point is that a board
   fault is traced to the component rather than swapped wholesale, and
   this is that work. There is no photograph of the Ruwi shopfront. */
import imgShop from '@assets/photos/repair-solder.jpg';
import { site, branches } from '@data/site';

/**
 * OUR STORY — a card that opens over the page.
 *
 * Same <dialog> + showModal() foundation as the film: the platform gives
 * the inert background, the Escape handler, the focus trap and
 * ::backdrop, which is where hand-rolled overlays usually go wrong.
 *
 * The shield and each paragraph carry their own --d, and the reveal is
 * driven by a data attribute the open handler sets one frame later.
 * That one-frame delay matters: a transition cannot run from styles that
 * were applied in the same frame the element became visible, so without
 * it the card would simply appear.
 *
 * Every figure below traces to the company's own records. There is no
 * review score here because Danat has published none — the reference
 * layout has one, and inventing it is not an option.
 */
const years = new Date().getFullYear() - site.stats.since;
const cities = branches.map((b) => b.city.split(',')[0]).join(', ');

const paras = [
  `Danat Computers opened on Computer Street in Ruwi in ${site.stats.since}, and has traded there ever since. ${years} years on it runs four branches across Oman — ${cities} — under the registered name ${site.legalName}.`,
  `We sell, supply and repair: laptops and desktops, printers, CCTV, networking, and the parts that go inside all of them. ${site.stats.parts.toLocaleString('en-US')} lines across ${site.stats.categories} categories sit on the shelves, which is why most repairs do not wait on an order arriving from outside the country.`,
  'The part that sets the bench apart is what happens when a board fails. Most shops trace a fault that far, then quote a replacement mainboard — usually most of the value of the machine. We trace it to the component on the board and replace that instead.',
  'Diagnosis is free and comes before the quote. You are told what failed, what it will cost and how long it takes, and then you decide.',
];

const closing = 'Four counters, one standard — and a bench that opens the machine rather than replacing it.';
---

<dialog class="sc" data-story-modal aria-label="Our story">
  <div class="sc__box">
    <button class="sc__x" type="button" data-story-close aria-label="Close">
      <Icon name="plus" size={18} />
    </button>

    <div class="sc__grid">
      {/* The green half. A photograph behind a wash, rather than an empty
          panel with a device drawn on it. */}
      <div class="sc__badge" style="--d:60ms">
        <Image class="sc__shot" src={imgShop} alt=""
          widths={[560, 900]} sizes="(max-width: 56rem) 100vw, 34vw"
          quality={76} format="webp" loading="lazy" />
        <span class="sc__wash" aria-hidden="true"></span>

        <div class="sc__panel" style="--d:0ms">
          {/* The mark keeps its own colours on its own ground — it is a
              green and black raster and neither survives being laid on a
              dark green wash. */}
          <span class="sc__plate"><Logo /></span>
          <div>
            <p class="sc__tag">A journey that<br />keeps Oman running.</p>
            <span class="sc__rule" aria-hidden="true"></span>
          </div>
        </div>
      </div>

      {/* story */}
      <div class="sc__body">
        <p class="sc__k" style="--d:0ms">Our story</p>
        <h2 class="sc__h" style="--d:110ms">
          It started on<br /><em>Computer Street.</em>
        </h2>

        {paras.map((t, i) => (
          <p class="sc__p" style={`--d:${330 + i * 80}ms`}>{t}</p>
        ))}

        <p class="sc__close" style={`--d:${330 + paras.length * 80}ms`}>{closing}</p>

        <div class="sc__acts" style={`--d:${410 + paras.length * 80}ms`}>
          <a class="sc__cta" href="/branches">
            Our branches<Icon name="arrow" size={15} />
          </a>
          <button class="sc__alt" type="button" data-video-open>
            Watch the film
          </button>
        </div>
      </div>
    </div>
  </div>
</dialog>

<script is:inline>
  /* <ClientRouter /> swaps the body on a nav click without a page load,
     and an is:inline script runs once on the first load and never again
     — so everything below was binding to elements that had already been
     thrown away. astro:page-load fires on the first load and after every
     swap. */
  (() => {
    const setup = () => {
    (() => {
      const dlg = document.querySelector('[data-story-modal]');
      if (!dlg) return;

      const open = () => {
        dlg.removeAttribute('data-in');
        if (typeof dlg.showModal === 'function') dlg.showModal();
        else dlg.setAttribute('open', '');
        // Force a synchronous style recalc so the start state is real
        // before the transition is armed. A double rAF is the usual trick
        // but does not guarantee recalc for display:none -> visible.
        void dlg.offsetWidth;
        requestAnimationFrame(() => dlg.setAttribute('data-in', ''));
      };
      const close = () => {
        dlg.removeAttribute('data-in');
        if (typeof dlg.close === 'function') dlg.close();
        else dlg.removeAttribute('open');
      };

      document.querySelectorAll('[data-story-open]').forEach((b) =>
        b.addEventListener('click', (e) => { e.preventDefault(); open(); })
      );
      dlg.querySelector('[data-story-close]')?.addEventListener('click', close);
      dlg.addEventListener('click', (e) => { if (e.target === dlg) close(); });
      dlg.addEventListener('close', () => dlg.removeAttribute('data-in'));

      // "Watch the film" inside the card hands over to the video dialog.
      dlg.querySelector('[data-video-open]')?.addEventListener('click', close);
    })();
    };

    let ran = false;
    document.addEventListener('astro:page-load', () => { ran = true; setup(); });
    window.addEventListener('load', () => { if (!ran) { ran = true; setup(); } });
  })();
</script>

<style>
  .sc {
    width: min(64rem, 94vw);
    max-width: none;
    max-height: 92vh;
    padding: 0;
    border: 0;
    background: none;
    overflow: visible;
  }
  .sc::backdrop {
    background: rgb(7 9 10 / 0.8);
    backdrop-filter: blur(7px);
  }

  .sc__box {
    position: relative;
    opacity: 0;
    transition: opacity 160ms var(--ease);
    max-height: 92vh;
    overflow-y: auto;
    border-radius: 26px;
    background: transparent;
  }

  .sc[data-in] .sc__box { opacity: 1; transform: none; }

  .sc__x {
    position: absolute;
    top: 0.9rem;
    right: 0.9rem;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border: 1px solid var(--line-light);
    border-radius: 50%;
    background: var(--white);
    color: var(--text-2);
    cursor: pointer;
    opacity: 0;
    transition:
      opacity 260ms var(--ease) var(--join),
      background-color var(--t2) var(--ease),
      color var(--t2) var(--ease),
      transform var(--t2) var(--ease);
  }
  .sc[data-in] .sc__x { opacity: 1; }
  /* No dedicated close glyph in the set — the plus is turned into one. */
  .sc__x :global(svg) { transform: rotate(45deg); }
  .sc__x:hover { background: var(--ink); color: #fff; transform: rotate(90deg); }
  .sc__x:focus-visible { outline: 2px solid var(--green-deep); outline-offset: 3px; }

  .sc__grid { display: grid; }

  /* ---- shield ---- */

  .sc__badge {
    position: relative;
    z-index: 1;
    overflow: hidden;
    min-height: clamp(16rem, 34vw, 26rem);
    background: #10301a;
    box-shadow: 0 40px 90px -36px rgb(0 0 0 / 0.55);
  }
  .sc__shot {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Deep enough at the foot that white type clears AA over the brightest
     part of the photograph underneath — measured, not guessed. */
  .sc__wash {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(170deg, rgb(11 38 20 / 0.72) 0%, rgb(9 32 17 / 0.88) 52%, rgb(7 26 14 / 0.95) 100%);
  }
  .sc__panel {
    position: relative;
    z-index: 2;
    display: grid;
    align-content: space-between;
    gap: var(--s5);
    min-height: inherit;
    height: 100%;
    padding: clamp(1.5rem, 3.4vw, 2.4rem);
  }
  .sc__plate {
    justify-self: start;
    display: grid;
    place-items: center;
    padding: 0.6rem 0.9rem;
    border-radius: 12px;
    background: var(--white);
  }
  .sc__plate :global(img),
  .sc__plate :global(svg) { max-width: 100%; height: auto; }
  .sc__tag {
    font-size: clamp(1.05rem, 2.1vw, 1.4rem);
    font-weight: 500;
    line-height: 1.34;
    letter-spacing: -0.02em;
    color: #fff;
  }
  .sc__rule {
    display: block;
    width: 34px;
    height: 2px;
    margin-top: var(--s4);
    border-radius: 2px;
    background: rgb(255 255 255 / 0.6);
  }

  /* ---- story ---- */

  .sc__body {
    /* Its own surface, so the half is a thing that arrives rather than
       text sliding over a backdrop that was already there. */
    background: var(--white);
    padding: clamp(1.5rem, 4vw, 2.75rem);
    box-shadow: 0 40px 90px -36px rgb(0 0 0 / 0.55);
  }

  .sc__k {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--green-deep);
  }
  .sc__h {
    margin-top: var(--s4);
    font-size: clamp(1.5rem, 3vw, 2.2rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.08;
  }
  .sc__h em { font-style: normal; color: var(--green-deep); }

  .sc__p {
    margin-top: var(--s4);
    max-width: 62ch;
    font-size: 0.875rem;
    line-height: 1.68;
    color: var(--text-2);
  }
  .sc__close {
    margin-top: var(--s5);
    padding-top: var(--s4);
    border-top: 1px solid var(--line-light);
    max-width: 58ch;
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.5;
    color: var(--text);
  }

  .sc__acts {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s4) var(--s5);
    margin-top: var(--s5);
  }
  .sc__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.4rem;
    border-radius: 999px;
    /* white is 8.73:1 on #27551f and 4.90:1 on #3d7f35 */
    background: linear-gradient(100deg, #27551f, #3d7f35);
    color: #fff;
    font-size: 0.875rem;
    font-weight: 600;
    transition: transform var(--t2) var(--ease);
  }
  .sc__cta:hover { transform: translateY(-2px); }
  .sc__alt {
    padding: 0;
    border: 0;
    border-bottom: 1px solid var(--line-light);
    background: none;
    color: var(--text-2);
    font: inherit;
    font-size: 0.875rem;
    cursor: pointer;
    transition: color var(--t2) var(--ease), border-color var(--t2) var(--ease);
  }
  .sc__alt:hover { color: var(--green-deep); border-color: var(--green); }

  /* ---- the reveal ---- */

  /* The two halves fly in from opposite sides and meet in the middle,
     then the story stacks in behind them. The grid clips, so neither
     half is ever seen outside the card. */
  .sc__grid { overflow: hidden; border-radius: 26px; }

  .sc__badge,
  .sc__body {
    opacity: 0;
    transition:
      opacity 300ms var(--ease) 60ms,
      transform 820ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  /* vw, not %: a percentage is relative to each panel's own width, so
     the narrow green half travelled about a third as far as the wide
     white one and the two read as one sweep instead of a meeting. */
  .sc__badge { transform: translate3d(-42vw, 0, 0) rotate(-2.5deg); }
  .sc__body { transform: translate3d(42vw, 0, 0) rotate(2.5deg); }

  .sc[data-in] .sc__badge,
  .sc[data-in] .sc__body { opacity: 1; transform: none; }

  /* Nothing inside either half moves until they have met. The slide
     takes 720ms, so everything below waits on --join. */
  .sc { --join: 940ms; }

  /* The mark scales up once its panel has landed. */
  .sc[data-in] .sc__mark { opacity: 1; scale: 1; }

  /* The title DROPS in from above — it is the third beat, and coming
     down distinguishes it from the body, which rises. */
  .sc__k,
  .sc__h {
    opacity: 0;
    transform: translate3d(0, -26px, 0);
    transition:
      opacity 460ms var(--ease) calc(var(--join) + var(--d, 0ms)),
      transform 620ms cubic-bezier(0.22, 1.2, 0.36, 1) calc(var(--join) + var(--d, 0ms));
  }

  /* The body rises, after the title has landed. */
  .sc__p,
  .sc__close,
  .sc__acts {
    opacity: 0;
    transform: translate3d(0, 18px, 0);
    transition:
      opacity var(--t3) var(--ease) calc(var(--join) + var(--d, 0ms)),
      transform var(--t3) var(--ease) calc(var(--join) + var(--d, 0ms));
  }

  .sc[data-in] :is(.sc__k, .sc__h, .sc__p, .sc__close, .sc__acts) {
    opacity: 1;
    transform: none;
  }

  @media (min-width: 56rem) {
    .sc__grid { grid-template-columns: minmax(0, 0.78fr) minmax(0, 1.22fr); }
    /* The seam is an arc, not a straight rule: the green panel's right
       edge bows into the white, and the story is padded clear of it. */
    .sc__badge {
      border-radius: 0 30% 30% 0 / 0 50% 50% 0;
      z-index: 1;
    }
    /* The white runs 9rem back under the green so the curve reveals
       white rather than the backdrop. Its padding has to clear both the
       overlap and the deepest point of the arc. */
    .sc__body {
      margin-left: -9rem;
      padding-left: clamp(10.5rem, 16vw, 13rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sc__box, .sc__badge, .sc__body, .sc__panel, .sc__x,
    .sc__k, .sc__h, .sc__p, .sc__close, .sc__acts {
      opacity: 1;
      scale: 1;
      transform: none;
      transition: none;
    }
    .sc__x, .sc__x:hover, .sc__cta, .sc__cta:hover { transform: none; transition: none; }
  </style>
