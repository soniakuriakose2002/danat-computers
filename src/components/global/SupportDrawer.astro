---
import Icon from '@components/ui/Icon.astro';
import { site, whatsappLink, branches } from '@data/site';

/**
 * GET SUPPORT — a drawer off the right edge.
 *
 * Built on <dialog> + showModal() for the same reason as the video
 * modal: the platform already gives the inert background, the Escape
 * key, the focus trap and ::backdrop. A hand-rolled overlay gets at
 * least one of those wrong.
 *
 * There is no server on a static site, so the form does what the
 * contact page already does — composes the message and hands it to
 * WhatsApp, with email as the alternative. Nothing is posted anywhere
 * and nothing is stored.
 *
 * The header's button stays a real link to WhatsApp. This only takes
 * over the click when the script is running, so losing the JS costs
 * the drawer, not the ability to get in touch.
 */
const WA = site.phone.whatsapp;
---

<dialog class="sd" data-support data-wa={WA} data-mail={site.email}
  aria-label="Get support from Danat Computers">
  <div class="sd__panel">
    <button class="sd__x" type="button" data-support-close aria-label="Close">
      <Icon name="plus" size={18} />
    </button>

    <div class="sd__head">
      <p class="sd__eb">Get support</p>
      <h2 class="sd__h">Tell us what's<br /><em>not working.</em></h2>
      <p class="sd__p">
        Diagnosis is free, and nothing is touched until you agree the quote.
      </p>
    </div>

    {/* Straight through, for anyone who does not want a form. */}
    <div class="sd__now">
      <a class="sd__btn" href={`tel:${site.phone.tel}`}>
        <Icon name="headset" size={17} />
        <span>Call us<small>{site.phone.display}</small></span>
      </a>
      <a class="sd__btn" href={whatsappLink()} target="_blank" rel="noopener noreferrer">
        <Icon name="whatsapp" size={17} />
        <span>WhatsApp<small>Chat now</small></span>
      </a>
    </div>

    <p class="sd__or"><span>or send the details</span></p>

    <form class="sd__form" data-support-form novalidate>
      <div class="sd__row">
        <label class="sf">
          <span>Your name</span>
          <input type="text" name="name" required autocomplete="name" placeholder="Full name" />
        </label>
        <label class="sf">
          <span>Phone</span>
          <input type="tel" name="phone" required autocomplete="tel" placeholder="+968 …" />
        </label>
      </div>

      <label class="sf">
        <span>Nearest branch <i>optional</i></span>
        <select name="branch">
          <option value="">No preference</option>
          {branches.map((b) => <option value={b.name}>{b.name} — {b.city}</option>)}
        </select>
      </label>

      <label class="sf">
        <span>What's the problem?</span>
        <textarea name="message" required rows="4"
          placeholder="A laptop that won't start, a printer, a network, a quote for the office…"></textarea>
      </label>

      <button class="sd__send" type="submit">
        Send on WhatsApp
        <span aria-hidden="true"><Icon name="arrow" size={15} /></span>
      </button>

      <button class="sd__alt" type="button" data-support-mail>
        Send by email instead
      </button>

      <p class="sd__note">
        Goes straight to the Ruwi counter. Nothing is stored on this site.
      </p>
    </form>

    <p class="sd__sig" aria-hidden="true">
      Same People.<br />A Brighter Tomorrow.
    </p>
  </div>
</dialog>

{/* NOT define:vars. On an inline script Astro emits those as
    top-level consts in the page's shared global scope, so a second
    component declaring WA and MAIL threw "Identifier has already been
    declared" and one of the two scripts never ran at all. The values
    ride on the element instead, which cannot collide. */}
<script is:inline>
  (() => {
    /* This site renders <ClientRouter />, so a nav click swaps the body
       without a page load — and an is:inline script runs once, on the
       first load, and never again. Everything below was therefore bound
       to elements that had already been thrown away, and Get Support
       fell through to its href. Re-bind on every astro:page-load, which
       fires on the first load too. */
    const setup = () => {
      const dlg = document.querySelector('[data-support]');
      if (!dlg || typeof dlg.showModal !== 'function') return;

      const form = dlg.querySelector('[data-support-form]');
      const wa = dlg.dataset.wa;
      const mail = dlg.dataset.mail;

      const open = () => {
        // The phone menu is one of the places this opens from. Closing it
        // through its own button reuses whatever else that does — the
        // scroll lock, aria-expanded — rather than half-closing it here.
        const mnav = document.querySelector('[data-mnav]');
        if (mnav && !mnav.hidden) document.querySelector('[aria-controls="mnav"]')?.click();
        dlg.showModal();
        // display:none -> block gives the transition no previous state to
        // run from unless layout is flushed first. A double rAF is not
        // enough; forcing reflow is.
        void dlg.offsetWidth;
        dlg.setAttribute('data-in', '');
      };

      const close = () => {
        dlg.removeAttribute('data-in');
        const done = () => dlg.close();
        // Let the slide finish before the dialog disappears.
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) done();
        else setTimeout(done, 260);
      };

      // The trigger stays a working WhatsApp link; this only intercepts it.
      document.querySelectorAll('[data-support-open], .hd__cta').forEach((el) =>
        el.addEventListener('click', (e) => {
          e.preventDefault();
          open();
        })
      );

      dlg.querySelector('[data-support-close]')?.addEventListener('click', close);
      // A click whose target IS the dialog landed on the backdrop.
      dlg.addEventListener('click', (e) => { if (e.target === dlg) close(); });
      dlg.addEventListener('cancel', (e) => { e.preventDefault(); close(); });

      if (!form) return;

      const compose = () => {
        const d = new FormData(form);
        const val = (k) => String(d.get(k) || '').trim();
        const opt = (k, label) => (val(k) ? [label + ': ' + val(k)] : []);
        return [
          'Hello Danat — this is ' + val('name') + '.',
          '',
          ...opt('phone', 'Phone'),
          ...opt('branch', 'Branch'),
          '',
          val('message'),
        ].join(String.fromCharCode(10));
      };

      form.addEventListener('submit', (e) => {
        e.preventDefault();
        if (!form.reportValidity()) return;
        window.open('https://wa.me/' + wa + '?text=' + encodeURIComponent(compose()),
          '_blank', 'noopener');
      });

      dlg.querySelector('[data-support-mail]')?.addEventListener('click', () => {
        if (!form.reportValidity()) return;
        window.location.href =
          'mailto:' + mail + '?subject=' + encodeURIComponent('Support request')
          + '&body=' + encodeURIComponent(compose());
      });

    };

    let ran = false;
    document.addEventListener('astro:page-load', () => { ran = true; setup(); });
    // If the router is ever removed, that event never comes.
    window.addEventListener('load', () => { if (!ran) { ran = true; setup(); } });
  })();
</script>

<style>
  /* Pinned to the viewport's right edge outright. Relying on the
     dialog's auto margins plus a vw width put the panel ~40px past the
     right edge at 390px, cutting the close button and half the fields
     off the screen. inset does not care what the page's scroll width
     is. */
  .sd {
    position: fixed;
    inset: 0 0 0 auto;
    width: min(30rem, 100%);
    max-width: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    overflow: visible;
  }
  .sd::backdrop {
    background: rgb(12 18 13 / 0);
    backdrop-filter: blur(0px);
    transition: background-color 320ms var(--ease), backdrop-filter 320ms var(--ease);
  }
  .sd[data-in]::backdrop {
    background: rgb(12 18 13 / 0.5);
    backdrop-filter: blur(4px);
  }

  .sd__panel {
    display: flex;
    flex-direction: column;
    gap: var(--s4);
    height: 100%;
    padding: clamp(1.4rem, 3.4vw, 2.1rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    background: var(--white);
    box-shadow: -30px 0 70px -30px rgb(12 18 13 / 0.45);
    transform: translate3d(100%, 0, 0);
    transition: transform 420ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .sd[data-in] .sd__panel { transform: none; }

  .sd__x {
    position: absolute;
    top: clamp(1.4rem, 3.4vw, 2.1rem);
    right: clamp(1.4rem, 3.4vw, 2.1rem);
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 1px solid var(--line-light);
    border-radius: 50%;
    background: var(--white);
    color: var(--text-2);
    cursor: pointer;
    transition: background-color var(--t2) var(--ease), transform var(--t2) var(--ease);
  }
  /* No close glyph in the set, so the plus becomes one. */
  .sd__x :global(svg) { transform: rotate(45deg); }
  .sd__x:hover { background: var(--off); transform: rotate(90deg); }
  .sd__x:focus-visible { outline: 2px solid var(--green-deep); outline-offset: 3px; }

  .sd__eb {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--green-deep);
  }
  .sd__h {
    margin-top: 0.6rem;
    font-size: var(--d6);
    font-weight: 700;
    letter-spacing: var(--tr6);
    line-height: 1.08;
  }
  .sd__h em { font-style: normal; color: var(--green-deep); }
  .sd__p {
    max-width: 30ch;
    margin-top: 0.6rem;
    font-size: 0.8438rem;
    line-height: 1.6;
    color: var(--text-2);
  }

  .sd__now { display: grid; gap: 0.6rem; }
  .sd__btn {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 0.8rem;
    padding: 0.8rem 1rem;
    border: 1px solid var(--line-light);
    border-radius: 14px;
    background: var(--off);
    color: var(--green-deep);
    transition: background-color var(--t2) var(--ease), border-color var(--t2) var(--ease);
  }
  .sd__btn:hover { background: #eef5ef; border-color: #cfe0cd; }
  .sd__btn:focus-visible { outline: 2px solid var(--green-deep); outline-offset: 2px; }
  .sd__btn span { display: grid; font-size: 0.9375rem; font-weight: 700; color: var(--text); }
  .sd__btn small {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 400;
    letter-spacing: 0.08em;
    color: var(--text-3);
  }

  .sd__or {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 0.8rem;
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-3);
  }
  .sd__or::before, .sd__or::after {
    content: '';
    height: 1px;
    background: var(--line-light);
  }

  .sd__form { display: grid; gap: 0.75rem; }
  .sd__row { display: grid; gap: 0.75rem; }

  .sf { display: grid; gap: 0.35rem; }
  .sf > span {
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-3);
  }
  .sf i { font-style: normal; opacity: 0.75; }
  .sf :is(input, select, textarea) {
    width: 100%;
    padding: 0.75rem 0.85rem;
    border: 1px solid var(--line-light);
    border-radius: 11px;
    background: var(--off);
    color: var(--text);
    font: inherit;
    font-size: 0.9375rem;
    transition: border-color var(--t2) var(--ease), box-shadow var(--t2) var(--ease);
  }
  .sf textarea { resize: vertical; min-height: 5.5rem; line-height: 1.55; }
  .sf ::placeholder { color: var(--text-3); }
  .sf :is(input, select, textarea):focus-visible {
    outline: none;
    background: var(--white);
    border-color: var(--green-deep);
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--green) 26%, transparent);
  }

  .sd__send {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    margin-top: 0.25rem;
    padding: 0.9rem 1.3rem;
    border: 0;
    border-radius: 999px;
    background: var(--green-deep);
    color: #fff;
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 700;
    cursor: pointer;
    transition: background-color var(--t2) var(--ease);
  }
  .sd__send:hover { background: #26551f; }
  .sd__send:focus-visible { outline: 2px solid var(--green-deep); outline-offset: 3px; }
  .sd__send :global(svg) { transition: transform var(--t2) var(--ease); }
  .sd__send:hover :global(svg) { transform: translateX(3px); }

  .sd__alt {
    padding: 0.25rem;
    border: 0;
    background: none;
    color: var(--text-2);
    font: inherit;
    font-size: 0.8125rem;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }
  .sd__alt:hover { color: var(--green-deep); }
  .sd__alt:focus-visible { outline: 2px solid var(--green-deep); outline-offset: 2px; border-radius: 4px; }

  .sd__note {
    font-size: 0.75rem;
    line-height: 1.55;
    color: var(--text-3);
  }

  .sd__sig {
    margin-top: auto;
    padding-top: var(--s4);
    border-top: 1px solid var(--line-light);
    font-family: var(--font-serif, Georgia, serif);
    font-style: italic;
    font-size: 1rem;
    line-height: 1.35;
    color: var(--green-deep);
  }

  @media (min-width: 26rem) {
    .sd__row { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (prefers-reduced-motion: reduce) {
    .sd__panel, .sd::backdrop { transition: none; }
    .sd__panel { transform: none; }
    .sd__x:hover, .sd__send:hover :global(svg) { transform: none; }
    .sd__x :global(svg) { transform: rotate(45deg); }
  }
</style>
