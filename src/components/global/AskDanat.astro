---
import { getCollection } from 'astro:content';
import Icon from '@components/ui/Icon.astro';
import { site, branches, whatsappLink } from '@data/site';

/**
 * ASK DANAT — an on-page guide, not a live agent and not an LLM.
 *
 * The site is static with no backend, so anything that claimed to be a
 * real conversation would either be lying or be a third-party script
 * shipping visitor data off to someone else. This answers a fixed set of
 * questions from the site's own verified data and hands over to a person
 * for everything else. It says so in its opening line.
 *
 * Every figure, address, number and opening time below comes from
 * site.ts or the services collection. Where a branch's hours are not
 * confirmed (hoursVerified: false) the answer says so rather than
 * presenting them as fact.
 */
const services = (await getCollection('services')).sort(
  (a, b) => a.data.index - b.data.index
);

/* A real map rather than the drawn outline used elsewhere on the site.
   OpenStreetMap's own embed: no API key, no ad tracking and no cookie
   banner, which is why it is this and not Google tiles. The bbox frames
   Oman so all three cities are in view; it is deliberately not centred on
   a single pin, because we hold city coordinates and not shop ones. */
const mapEmbed =
  'https://www.openstreetmap.org/export/embed.html' +
  '?bbox=51.8,16.4,60.0,26.6&layer=mapnik';

const kb = {
  wa: whatsappLink(),
  map: mapEmbed,
  tel: site.phone.tel,
  telDisplay: site.phone.display,
  email: site.email,
  branches: branches.map((b) => ({
    name: b.name,
    city: b.city,
    /* Three of the four street addresses are still internal placeholders.
       They must not reach a visitor, so they are stripped here and the
       answer says the address is being confirmed instead. */
    address: /TODO/i.test(b.address) ? null : b.address.replace(/\n/g, ', '),
    phone: b.phone,
    hours: b.hours,
    hoursVerified: b.hoursVerified,
  })),
  services: services.map((s) => ({ t: s.data.title, s: s.data.summary, id: s.id })),
};
---

<button class="ab__open" type="button" data-ask-open aria-label="Ask Danat">
  {/* The same character as the panel header, cropped to the head so it
      still reads at button size. A speech bubble said "chat"; this says
      who you are about to talk to. */}
  <svg class="ab__face" viewBox="0 0 44 44" fill="none" aria-hidden="true">
    <path d="M8 22a14 14 0 0 1 28 0" stroke="#2f6429" stroke-width="3" stroke-linecap="round" />
    <path d="M22 8V4" stroke="#2f6429" stroke-width="2.4" stroke-linecap="round" />
    <circle cx="22" cy="3" r="2.4" fill="#59aa54" />
    <rect x="9" y="13" width="26" height="22" rx="9" fill="#fff" stroke="#2f6429" stroke-width="2" />
    <rect x="13" y="17" width="18" height="13" rx="6" fill="#17311c" />
    <circle cx="18.6" cy="23" r="1.9" fill="#8fdd8a" />
    <circle cx="25.4" cy="23" r="1.9" fill="#8fdd8a" />
    <path d="M19.6 26.6q2.4 2 4.8 0" stroke="#8fdd8a" stroke-width="1.6" stroke-linecap="round" />
    <rect x="3" y="18" width="7" height="12" rx="3.5" fill="#3d7f35" />
    <rect x="34" y="18" width="7" height="12" rx="3.5" fill="#3d7f35" />
  </svg>
  {/* The word is gone at the client's instruction — the character
      alone is the button now. It stays in the accessible name via
      aria-label above, so a screen reader still hears "Ask Danat". */}
</button>

<dialog class="ab" data-ask aria-label="Ask Danat">
  <div class="ab__panel">
    <header class="ab__top">
      <span class="ab__blob" aria-hidden="true"></span>
      {/* Drawn here rather than sourced: there is no Danat mascot asset,
          and a stock 3D render would be someone else's character. */}
      <svg class="ab__bot" viewBox="0 0 120 120" fill="none" aria-hidden="true">
        <ellipse cx="60" cy="108" rx="34" ry="7" fill="#2f6429" opacity=".10" />
        <rect x="34" y="64" width="52" height="38" rx="17" fill="#fff" stroke="#cfe1d4" stroke-width="2" />
        <circle cx="60" cy="86" r="7" fill="#e7f1e9" stroke="#59aa54" stroke-width="2" />
        <rect x="30" y="24" width="60" height="46" rx="18" fill="#fff" stroke="#cfe1d4" stroke-width="2" />
        <rect x="38" y="33" width="44" height="28" rx="12" fill="#17311c" />
        <circle cx="51" cy="46" r="3.4" fill="#8fdd8a" />
        <circle cx="69" cy="46" r="3.4" fill="#8fdd8a" />
        <path d="M54 54q6 5 12 0" stroke="#8fdd8a" stroke-width="2.4" stroke-linecap="round" />
        <path d="M26 44a34 34 0 0 1 68 0" stroke="#2f6429" stroke-width="4" stroke-linecap="round" />
        <rect x="18" y="40" width="14" height="22" rx="7" fill="#3d7f35" />
        <rect x="88" y="40" width="14" height="22" rx="7" fill="#3d7f35" />
        <path d="M60 24v-8" stroke="#2f6429" stroke-width="3" stroke-linecap="round" />
        <circle cx="60" cy="13" r="4" fill="#59aa54" />
        <path d="M86 74q16 2 18 14" stroke="#cfe1d4" stroke-width="2" stroke-linecap="round" />
        <circle cx="106" cy="90" r="6" fill="#fff" stroke="#cfe1d4" stroke-width="2" />
        <rect x="76" y="6" width="34" height="24" rx="9" fill="#3d7f35" />
        <path d="M84 30l4-6h6z" fill="#3d7f35" />
        <circle cx="86" cy="18" r="2.2" fill="#fff" />
        <circle cx="93" cy="18" r="2.2" fill="#fff" />
        <circle cx="100" cy="18" r="2.2" fill="#fff" />
      </svg>

      <div class="ab__id">
        <p class="ab__eyebrow">Ask</p>
        <p class="ab__who">Danat</p>
        <p class="ab__sub">Answers about our products and services</p>
      </div>

      <button class="ab__x" type="button" data-ask-close aria-label="Close">
        <Icon name="plus" size={18} />
      </button>
    </header>

    <div class="ab__scroll" data-ask-scroll>
      <div class="ab__row" data-who="bot">
        <span class="ab__av" aria-hidden="true">
          <svg viewBox="0 0 44 44" fill="none">
            <path d="M8 22a14 14 0 0 1 28 0" stroke="#2f6429" stroke-width="3" stroke-linecap="round" />
            <rect x="9" y="13" width="26" height="22" rx="9" fill="#fff" stroke="#2f6429" stroke-width="2" />
            <rect x="13" y="17" width="18" height="13" rx="6" fill="#17311c" />
            <circle cx="18.6" cy="23" r="1.9" fill="#8fdd8a" />
            <circle cx="25.4" cy="23" r="1.9" fill="#8fdd8a" />
            <rect x="3" y="18" width="7" height="12" rx="3.5" fill="#3d7f35" />
            <rect x="34" y="18" width="7" height="12" rx="3.5" fill="#3d7f35" />
          </svg>
        </span>
        <div>
          <p class="ab__msg">
            Hello! I am a guide on this page, not a person — I can help you with
            common questions about our products and services. For anything else,
            use <b>Chat on WhatsApp</b>.
          </p>
          <span class="ab__time" data-now></span>
        </div>
      </div>

      <ul class="ab__sugs" hidden>
        {[
          { i: 'pin', q: 'Where are your branches?' },
          { i: 'clock', q: 'What are your opening hours?' },
          { i: 'wrench', q: 'What can you repair?' },
          { i: 'laptop', q: 'Do you sell laptops?' },
          { i: 'chart', q: 'How much will a repair cost?' },
          { i: 'mail', q: 'I want a quote' },
        ].map((t, n) => (
          <li>
            <button class="ab__sug" type="button" data-topic={n}>
              <span class="ab__tile"><Icon name={t.i as any} size={18} /></span>
              <span class="ab__q">{t.q}</span>
              <span class="ab__go" aria-hidden="true"><Icon name="arrow" size={15} /></span>
            </button>
          </li>
        ))}
      </ul>

      <div data-ask-log role="log" aria-live="polite"></div>
    </div>

    <form class="ab__ask" data-ask-form>
      <span class="ab__field">
        <Icon name="chat" size={17} />
        <input type="text" name="q" autocomplete="off"
          placeholder="Ask about repairs, branches, hours…" aria-label="Ask a question" />
      </span>
      <button type="submit" aria-label="Send"><Icon name="send" size={17} /></button>
    </form>

    <footer class="ab__foot">
      <a class="ab__wa" href={kb.wa} target="_blank" rel="noopener noreferrer">
        <Icon name="whatsapp" size={19} /> Chat on WhatsApp
      </a>
      <p class="ab__note">Not a live agent. Confirm anything important with our team.</p>
    </footer>
  </div>
</dialog>

{/* Passed as JSON rather than define:vars — two components declaring the
    same top-level const in the page's shared inline scope throws, and one
    of the two scripts then never runs at all. */}
<script type="application/json" data-ask-kb set:html={JSON.stringify(kb)} />

<script is:inline>
  (() => {
    const setup = () => {
      const dlg = document.querySelector('[data-ask]');
      const raw = document.querySelector('[data-ask-kb]');
      if (!dlg || !raw || dlg.dataset.wired) return;
      dlg.dataset.wired = '1';

      const kb = JSON.parse(raw.textContent || '{}');
      const log = dlg.querySelector('[data-ask-log]');
      const scroll = dlg.querySelector('[data-ask-scroll]');

      const PIN =
        '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"' +
        ' stroke-linecap="round" stroke-linejoin="round">' +
        '<path d="M12 21s7-5.6 7-11a7 7 0 1 0-14 0c0 5.4 7 11 7 11Z"/><circle cx="12" cy="10" r="2.5"/></svg>';

      const esc = (t) =>
        String(t).replace(/[&<>"]/g, (c) =>
          ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]
        );

      /* A card per branch beside the map, as drawn. No storefront
         photographs exist, so each card leads with its pin instead of a
         picture we would have to invent. */
      const branchAnswer = () => {
        const cards = kb.branches
          .map((b) => {
            const where = b.address
              ? esc(b.address)
              : `${esc(b.city)} — address being confirmed`;
            /* Google Maps SEARCH, not a pinned coordinate. We hold city
               coordinates, not shop ones — dropping a pin from those would
               claim a precision we do not have. A search by name and city
               lands the visitor on a real map at the right place. */
            const q = encodeURIComponent(`Danat Computers ${b.city}`);
            const maps = `https://www.google.com/maps/search/?api=1&query=${q}`;
            return (
              `<a class="ab__bc" href="${maps}" target="_blank" rel="noopener noreferrer">` +
              `<span class="ab__bpin">${PIN}</span>` +
              `<span><b>${esc(b.name.replace(/^Danat /, ''))}</b>` +
              `<em>${where}</em><i>View on map ›</i></span></a>`
            );
          })
          .join('');
        return (
          `We have ${kb.branches.length} branches across Oman. You can visit any of ` +
          `them for sales and service support.` +
          `<span class="ab__branches">` +
          /* No loading="lazy": the iframe is only created when someone
                 asks for branches, so it is already deferred, and the
                 attribute simply stopped it loading inside the dialog. */
              `<span class="ab__map"><iframe src="${kb.map}" ` +
          `title="Map of Oman" referrerpolicy="no-referrer"></iframe></span>` +
          `<span class="ab__bl">${cards}</span></span>`
        );
      };

      const hoursAnswer = () =>
        kb.branches
          .map((b) => {
            const note = b.hoursVerified
              ? ''
              : '<br><i>These times are on our old site and we are confirming them — please call ahead.</i>';
            return `<b>${esc(b.name)}</b><br>${b.hours.map(esc).join('<br>')}${note}`;
          })
          .join('<hr>');

      const servicesAnswer = () =>
        kb.services
          .map((s) => `<b>${esc(s.t)}</b> — ${esc(s.s)} <a href="/services/${esc(s.id)}">Read more</a>`)
          .join('<br><br>');

      const WELCOME =
        '<b>Hello! 👋</b><br><b>Welcome to Danat.</b><br><br>' +
        'I can help with our branches, opening hours, repairs, products and quotes.' +
        '<br><br>How can I help you today?';

      const TOPICS = [
        { q: 'Where are your branches?', a: branchAnswer },
        { q: 'What are your opening hours?', a: hoursAnswer },
        { q: 'What can you repair?', a: servicesAnswer },
        {
          q: 'Do you sell laptops?',
          a: () =>
            'Yes — laptops and desktops, plus networking, security and spare parts. ' +
            'We do not publish prices, so the range lives on the ' +
            '<a href="/products">products page</a> and a quote comes from a conversation.',
        },
        {
          q: 'How much will a repair cost?',
          a: () =>
            'Diagnosis is free and comes before any quote. You are told what failed, what it ' +
            'will cost and how long it takes, and then you decide. Nothing is charged until you agree.',
        },
        {
          q: 'I want a quote',
          a: () =>
            'Tell us what you need and we will price it: ' +
            `<a href="${esc(kb.wa)}" target="_blank" rel="noopener noreferrer">message us on WhatsApp</a>, ` +
            `call <a href="tel:${esc(kb.tel)}">${esc(kb.telDisplay)}</a>, or ` +
            `email <a href="mailto:${esc(kb.email)}">${esc(kb.email)}</a>.`,
        },
      ];

      /* Typed questions are matched on keywords against the same answers
         the chips give. This is not a language model and does not claim
         to be one — anything it cannot place goes to a person. */
      const KEYS = [
        ['hi', 'hey', 'hello', 'salam', 'good morning', 'good evening', 'thanks', 'thank you'],
        ['branch', 'where', 'location', 'address', 'shop', 'ruwi', 'sohar', 'salalah', 'near', 'find'],
        ['hour', 'open', 'close', 'closing', 'time', 'timing', 'friday', 'weekend', 'today'],
        ['repair', 'fix', 'broken', 'service', 'printer', 'cctv', 'network', 'data', 'recovery', 'virus', 'screen'],
        ['buy', 'sell', 'laptop', 'desktop', 'product', 'stock', 'brand', 'hp', 'dell', 'lenovo', 'asus'],
        ['cost', 'charge', 'fee', 'expensive', 'cheap', 'diagnos'],
        ['quote', 'estimate', 'enquir', 'inquir', 'contact', 'email', 'call', 'price'],
      ];

      const answerFor = (text) => {
        const q = text.toLowerCase().trim();
        /* A bare greeting is matched whole, so "hi" is a hello and
           "which branch is high street" is not. */
        if (/^(hi|hey|hello|salam|hai)/.test(q)) return WELCOME;
        let best = -1;
        let score = 0;
        KEYS.forEach((words, i) => {
          const hits = words.reduce((n, w) => n + (q.includes(w) ? 1 : 0), 0);
          if (hits > score) { score = hits; best = i; }
        });
        if (best < 0) return null;
        /* KEYS[0] is the greeting row and has no topic behind it. */
        if (best === 0) return WELCOME;
        return TOPICS[best - 1].a();
      };

      const AV = dlg.querySelector('.ab__av')?.innerHTML || '';
      const clock = () =>
        new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

      /* One row per message: the bot keeps its face beside what it says,
         both sides get a tail and a time, which is what makes the log read
         as a conversation instead of a stack of panels. */
      const bubble = (who, html) => {
        const row = document.createElement('div');
        row.className = 'ab__row';
        row.setAttribute('data-who', who);
        row.innerHTML =
          (who === 'bot' ? `<span class="ab__av" aria-hidden="true">${AV}</span>` : '') +
          `<div><p class="ab__msg">${html}</p><span class="ab__time">${clock()}` +
          (who === 'you' ? ' <b class="ab__tick">✓✓</b>' : '') +
          `</span></div>`;
        log.appendChild(row);
        scroll.scrollTop = scroll.scrollHeight;
        return row.querySelector('.ab__msg');
      };

      /* Three dots while it "thinks", then the dots become the answer.
         Without it the reply simply materialises and the panel reads as a
         list of canned text rather than an exchange. */
      /* Held back until the conversation has started, as drawn: the panel
         opens with the greeting alone, and the prompts arrive with the
         first answer. */
      const sugs = dlg.querySelector('.ab__sugs');
      const showSugs = () => {
        if (!sugs || !sugs.hasAttribute('hidden')) return;
        log.appendChild(sugs);
        sugs.removeAttribute('hidden');
        scroll.scrollTop = scroll.scrollHeight;
      };

      const reply = (html) => {
        const p = bubble('bot', '<i class="ab__dots"><b></b><b></b><b></b></i>');
        p.setAttribute('data-typing', '');
        window.setTimeout(() => {
          p.removeAttribute('data-typing');
          p.innerHTML = html;
          showSugs();
          scroll.scrollTop = scroll.scrollHeight;
        }, 620);
      };

      /* The rows are real markup so they can carry real icons; the script
         only wires them to the answers. */
      dlg.querySelectorAll('[data-topic]').forEach((b) => {
        b.addEventListener('click', () => {
          const t = TOPICS[Number(b.dataset.topic)];
          if (!t) return;
          bubble('you', esc(t.q));
          reply(t.a());
        });
      });

      /* Stamped when the panel opens, not at build time — a cached page
         would otherwise show the hour it was generated. */
      const stampIntro = () => {
        const n = dlg.querySelector('[data-now]');
        if (n && !n.textContent) n.textContent = clock();
      };

      const open = () => {
        stampIntro();
        if (typeof dlg.showModal === 'function') dlg.showModal();
        else dlg.setAttribute('open', '');
        void dlg.offsetWidth;
        requestAnimationFrame(() => dlg.setAttribute('data-in', ''));
      };
      const close = () => {
        dlg.removeAttribute('data-in');
        if (typeof dlg.close === 'function') dlg.close();
        else dlg.removeAttribute('open');
      };

      const form = dlg.querySelector('[data-ask-form]');
      form?.addEventListener('submit', (e) => {
        e.preventDefault();
        const input = form.querySelector('input');
        const text = (input.value || '').trim();
        if (!text) return;
        bubble('you', esc(text));
        input.value = '';
        const a = answerFor(text);
        reply(
          a ||
            'I do not have an answer for that one — I only cover a few basics. ' +
              `<a href="${esc(kb.wa)}" target="_blank" rel="noopener noreferrer">Ask a person on WhatsApp</a> ` +
              `or call <a href="tel:${esc(kb.tel)}">${esc(kb.telDisplay)}</a>.`
        );
      });

      document
        .querySelectorAll('[data-ask-open]')
        .forEach((b) => b.addEventListener('click', open));
      dlg.querySelector('[data-ask-close]')?.addEventListener('click', close);
      dlg.addEventListener('click', (e) => { if (e.target === dlg) close(); });
      dlg.addEventListener('close', () => dlg.removeAttribute('data-in'));
    };

    /* ClientRouter swaps the body without a page load, so an is:inline
       script that ran once is bound to elements that no longer exist. */
    /* Both of these fire on a first load, and whichever lands second was
       still calling setup() — two closures, two click handlers on one
       button, and the greeting printed twice. The dialog itself carries
       the flag instead: a view transition brings a fresh one, so the next
       page still wires up. */
    document.addEventListener('astro:page-load', setup);
    window.addEventListener('load', setup);
  })();
</script>

<style>
  /* The launcher sits above the WhatsApp button, which keeps its corner. */
  .ab__open {
    position: fixed;
    right: clamp(0.9rem, 2vw, 1.75rem);
    bottom: calc(clamp(0.9rem, 2vw, 1.75rem) + 4.6rem);
    z-index: 119;
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    padding: 0;
    border: 1px solid var(--line-light);
    border-radius: 50%;
    background: var(--white);
    color: var(--green-deep);
    cursor: pointer;
    box-shadow: 0 14px 30px -16px rgb(10 30 12 / 0.45);
    transition: transform var(--t2) var(--ease), background-color var(--t2) var(--ease);
    /* The heartbeat: two quick beats, then a long rest, like a pulse
       rather than a throb. 'both' beats fall inside the first 30% so
       the remaining 70% is the pause that makes it read as a heartbeat
       instead of a bounce. */
    animation: abBeat 2.6s var(--ease) infinite;
  }
  @keyframes abBeat {
    0%, 30%, 100% { transform: scale(1); }
    8%  { transform: scale(1.14); }
    16% { transform: scale(1); }
    24% { transform: scale(1.09); }
  }
  /* Hovering stops the beat — it has your attention already. */
  .ab__open:hover { animation-play-state: paused; }
  .ab__open:hover { transform: scale(1.06); background: #eef6ef; }
  /* The character fills the circle rather than floating in it — at
     32px inside a 52px button it read as a small sticker. */
  .ab__face { width: 40px; height: 40px; flex: none; }
  /* A small nod on hover, so the button feels like a character rather
     than a glyph. */
  .ab__open:hover .ab__face { animation: abNod 700ms var(--ease); }
  @keyframes abNod {
    30% { transform: rotate(-7deg); }
    65% { transform: rotate(5deg); }
    100% { transform: rotate(0); }
  }
  .ab__open:focus-visible { outline: 2px solid var(--green-deep); outline-offset: 3px; }

  .ab {
    width: min(28rem, calc(100vw - 1.5rem));
    max-width: none;
    /* auto on top and left pins the panel to the bottom-right, beside the
       launcher that opens it, rather than to the top of the viewport. */
    margin: auto 0 0 auto;
    padding: 0;
    border: 0;
    background: none;
    overflow: visible;
  }
  .ab::backdrop { background: rgb(7 9 10 / 0.42); }

  .ab__panel {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto auto;
    max-height: min(51rem, 92vh);
    margin: 0 clamp(0.75rem, 2vw, 1.75rem) calc(clamp(0.9rem, 2vw, 1.75rem) + 4.6rem) 0;
    border-radius: 26px;
    overflow: hidden;
    background: var(--white);
    box-shadow: 0 48px 96px -34px rgb(10 30 12 / 0.5);
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 200ms var(--ease), transform 280ms var(--ease);
  }
  .ab[data-in] .ab__panel { opacity: 1; transform: none; }

  /* ---- header ---- */
  .ab__top {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.9rem;
    padding: 0.9rem 1.1rem 1rem;
    overflow: hidden;
    background: linear-gradient(135deg, #e8f5ea 0%, #f2faf3 55%, #e4f2e7 100%);
  }
  .ab__blob {
    position: absolute;
    right: -3.5rem;
    top: -4.5rem;
    width: 14rem;
    height: 14rem;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(89 170 84 / 0.16), rgb(89 170 84 / 0) 68%);
  }
  .ab__bot { position: relative; width: 5.6rem; height: 5.6rem; flex: none; }
  .ab__id { position: relative; min-width: 0; }
  .ab__eyebrow {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--green-deep);
  }
  .ab__who {
    font-size: 1.6rem;
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 1;
    color: var(--green-deep);
  }
  .ab__sub {
    margin-top: 0.3rem;
    font-size: 0.8125rem;
    line-height: 1.35;
    color: var(--text-2);
  }
  .ab__x {
