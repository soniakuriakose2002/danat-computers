---
import Logo from './Logo.astro';
import Icon from '@components/ui/Icon.astro';
import { site, branches, whatsappLink } from '@data/site';

const year = new Date().getFullYear();

/* The head office is Ruwi. Read it off the data rather than retyping
   it, so a correction to the branch record reaches the footer too. */
const head = branches.find((b) => b.slug === 'ruwi') ?? branches[0];

const serviceLinks = [
  ['Computer Repair', '/services/computer-repair'],
  ['Printer Services', '/services/printer-services'],
  ['CCTV & Security', '/services/cctv-services'],
  ['Networking', '/services/networking'],
  ['Data Recovery', '/services/data-recovery'],
  ['Computer Sales', '/services/computer-sales'],
];

const companyLinks = [
  ['About Danat', '/about'],
  ['Our Branches', '/branches'],
  ['Business Solutions', '/business'],
  ['Contact', '/contact'],
];
---

<footer class="ft" data-tone="ink">
  <div class="ft__glow" aria-hidden="true"></div>

  <!-- Call to action band -->
  <div class="ft__cta shell">
    <div>
      <p class="label" data-rise>Get in touch</p>
      <h2 class="d2 ft__h" data-rise style="--d:70ms">
        Something broken?<br /><em>Bring it in.</em>
      </h2>
    </div>
    <div class="ft__actions" data-rise style="--d:160ms">
      <a class="ft__primary" href={whatsappLink()} target="_blank" rel="noopener noreferrer">
        Message us on WhatsApp
        <svg viewBox="0 0 16 16" width="15" height="15" fill="none" aria-hidden="true">
          <path d="M3 8h9.5M8.5 4l4 4-4 4" stroke="currentColor" stroke-width="1.6"
            stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </a>
      <a class="ft__secondary" href={`tel:${site.phone.tel}`}>{site.phone.display}</a>
    </div>
  </div>

  <div class="ft__rule shell"><span class="rule"></span></div>

  <!-- Link grid -->
  <div class="ft__grid shell">
    <div class="ft__brand">
      {/* The supplied artwork has the wordmark in near-black ink, which
          disappears on this ground. Same lockup the header uses: the
          mark, and the name set in type beside it. */}
      <a class="ft__lock" href="/" aria-label={`${site.nameFull} — home`}>
        <Logo size={62} />
        <span class="ft__name">Danat<em>Computers</em></span>
      </a>
      <p class="ft__about">
        Danat Computers has repaired, supplied and installed technology across
        Oman for over twenty years.
      </p>
      <h3 class="ft__follow">Follow us</h3>
      <div class="ft__social">
        <a href={site.social.facebook} target="_blank" rel="noopener noreferrer"
          aria-label="Danat Computers on Facebook">
          <svg viewBox="0 0 24 24" width="17" height="17" fill="currentColor" aria-hidden="true">
            <path d="M14 8.5V6.9c0-.7.2-1.1 1.2-1.1H16.5V3.1A17 17 0 0 0 14.6 3c-1.9 0-3.3 1.2-3.3 3.4v2.1H9v2.8h2.3V21h2.8v-9.7h2.3l.3-2.8H14Z"></path>
          </svg>
        </a>
        <a href={site.social.instagram} target="_blank" rel="noopener noreferrer"
          aria-label="Danat Computers on Instagram">
          <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor"
            stroke-width="1.7" aria-hidden="true">
            <rect x="3.2" y="3.2" width="17.6" height="17.6" rx="5"></rect>
            <circle cx="12" cy="12" r="3.9"></circle>
            <circle cx="17.1" cy="6.9" r="1.1" fill="currentColor" stroke="none"></circle>
          </svg>
        </a>
      </div>
    </div>

    <nav class="ft__col" aria-label="Services">
      <h3>Services</h3>
      <ul>
        {serviceLinks.map(([label, href]) => (
          <li><a href={href}>{label}</a></li>
        ))}
      </ul>
    </nav>

    <nav class="ft__col" aria-label="Company">
      <h3>Company</h3>
      <ul>
        {companyLinks.map(([label, href]) => (
          <li><a href={href}>{label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="ft__col">
      <h3>Branches</h3>
      <ul>
        {branches.map((b) => (
          <li>
            <a href={`/branches#${b.slug}`}>
              {b.name}
              <span>{b.city}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="ft__col ft__office">
      <h3>Head office</h3>
      <address>
        Computer Street, Ruwi<br />
        PO Box 502, PC 118<br />
        Sultanate of Oman
      </address>
      <ul class="ft__contact">
        <li>
          <Icon name="phone" size={15} />
          <a href={`tel:${site.phone.tel}`}>{site.phone.display}</a>
        </li>
        <li>
          <Icon name="mail" size={15} />
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </li>
        {head.hours.length > 0 && (
          <li>
            <Icon name="clock" size={15} />
            <span>{head.hours[0]}</span>
          </li>
        )}
      </ul>
    </div>
  </div>

  <div class="ft__base shell">
    <p class="ft__by">
      {/* Kept on one line: a break inside the anchor leaves a space
          before the full stop. */}
      &copy; {year} <a href={site.builtBy.url} target="_blank" rel="noopener noreferrer">{site.builtBy.name}</a>. All rights reserved.
    </p>
    {/* Derived, not typed. The hardcoded list here still carried Hail,
        which was removed from the business months of edits ago. */}
    <p>{branches.map((b) => b.city.split(',')[0].trim()).join(' · ')}</p>
  </div>
</footer>

<style>
  .ft__by {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
  }
  .ft__by a {
    color: var(--green-bright);
    border-bottom: 1px solid transparent;
    transition: border-color var(--t2) var(--ease);
  }
  .ft__by a:hover { border-color: currentColor; }

  .ft {
    position: relative;
    background: var(--ink);
    color: var(--text-inv);
    padding-top: clamp(4rem, 7vw, 6.5rem);
    padding-bottom: calc(var(--s5) + env(safe-area-inset-bottom, 0px));
    overflow: hidden;
    isolation: isolate;
  }

  /* One soft green wash so the footer is not a flat black slab. */
  .ft__glow {
    position: absolute;
    left: -10%;
    bottom: -60%;
    width: 70%;
    aspect-ratio: 1;
    z-index: -1;
    background: radial-gradient(
      circle,
      color-mix(in oklab, var(--green) 26%, transparent) 0%,
      transparent 62%
    );
    filter: blur(70px);
    pointer-events: none;
  }

  /* ---------- CTA band ---------- */

  .ft__cta {
    display: grid;
    gap: var(--s6);
    padding-bottom: clamp(3rem, 5vw, 4.5rem);
  }

  .ft__h {
    margin-top: var(--s4);
  }

  .ft__h em {
    font-style: normal;
    color: var(--green-bright);
  }

  .ft__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s4);
  }

  .ft__primary {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    padding: 1.05rem 1.7rem;
    border-radius: 999px;
    background: var(--green);
    color: #fff;
    font-weight: 500;
    transition:
      background-color var(--t2) var(--ease),
      transform var(--t1) var(--ease);
  }

  .ft__primary:hover {
    background: #fff;
    color: var(--ink);
  }

  .ft__primary svg {
    transition: transform var(--t2) var(--ease);
  }

  .ft__primary:hover svg {
    transform: translateX(4px);
  }

  .ft__secondary {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    letter-spacing: 0.04em;
    color: var(--text-inv-2);
    border-bottom: 1px solid rgb(255 255 255 / 0.25);
    padding-bottom: 2px;
    transition: color var(--t1) var(--ease), border-color var(--t1) var(--ease);
  }

  .ft__secondary:hover {
    color: #fff;
    border-color: #fff;
  }

  .ft__rule {
    padding-block: 0;
  }

  .ft__rule .rule {
    background: rgb(255 255 255 / 0.12);
  }

  /* ---------- link grid ---------- */

  .ft__grid {
    display: grid;
    gap: var(--s7);
    padding-block: clamp(3rem, 5vw, 4.5rem);
  }

  .ft__lock {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
  }
  /* The artwork is used as supplied — never recoloured. Its own
     wordmark is near-black ink, so on this ground it needs something
     light to sit on rather than a tint applied to it. */
  .ft__lock :global(.logo) {
    padding: 0.5rem 0.6rem;
    border-radius: 14px;
    background: #fff;
  }
  .ft__name {
    font-size: 1.0625rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1;
    color: #fff;
  }
  .ft__name em {
    display: block;
    margin-top: 0.3rem;
    font-style: normal;
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--green-bright);
  }

  .ft__about {
    max-width: 36ch;
    margin-top: var(--s5);
    font-size: var(--small);
    line-height: 1.65;
    color: var(--text-inv-2);
  }

  /* Same label voice as the column heads, so the left column reads as
     part of the same row rather than a loose paragraph. */
  .ft__follow {
    margin-top: var(--s6);
    font-family: var(--font-mono);
    font-size: var(--label);
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-inv-3);
  }

  .ft__social {
    display: flex;
    gap: 0.6rem;
    margin-top: var(--s4);
  }

  .ft__social a {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 11px;
    background: rgb(255 255 255 / 0.07);
    color: var(--text-inv-2);
    transition:
      background-color var(--t1) var(--ease),
      color var(--t1) var(--ease),
      transform var(--t1) var(--ease);
  }

  .ft__social a:hover {
    background: var(--green);
    color: #fff;
    transform: translateY(-2px);
  }

  .ft__col h3 {
    font-family: var(--font-mono);
    font-size: var(--label);
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-inv-3);
    margin-bottom: var(--s5);
  }

  .ft__col ul {
    display: grid;
    gap: 0.7rem;
  }

  .ft__col a,
  .ft__col address {
    font-size: var(--small);
    font-style: normal;
    line-height: 1.6;
    color: var(--text-inv-2);
    transition: color var(--t1) var(--ease);
  }

  .ft__col a {
    display: inline-flex;
    flex-direction: column;
  }

  .ft__col a span {
    font-size: 0.75rem;
    color: var(--text-inv-3);
  }

  .ft__col a:hover {
    color: var(--green-bright);
  }

  /* Phone, mail and hours, each behind its own mark. The list overrides
     .ft__col a's column flow — these rows are icon-beside-text. */
  .ft__contact {
    display: grid;
    gap: 0.65rem;
    margin-top: var(--s5);
  }
  .ft__contact li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: start;
    gap: 0.6rem;
    font-size: var(--small);
    line-height: 1.5;
    color: var(--text-inv-2);
  }
  .ft__contact :global(svg) {
    margin-top: 0.12em;
    color: var(--green-bright);
  }
  .ft__office .ft__contact a {
    display: inline;
    color: var(--text-inv-2);
    overflow-wrap: anywhere;
  }
  .ft__office .ft__contact a:hover { color: #fff; }
  .ft__contact span {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.02em;
    color: var(--text-inv-3);
  }

  /* ---------- base ---------- */

  .ft__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--s3);
    padding-top: var(--s5);
    border-top: 1px solid rgb(255 255 255 / 0.1);
    font-size: 0.8125rem;
    color: var(--text-inv-3);
  }

  @media (min-width: 48rem) {
    .ft__cta {
      grid-template-columns: 1fr auto;
      align-items: end;
    }
    .ft__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--s7) var(--s6);
    }
  }

  @media (min-width: 72rem) {
    /* Head office is the widest column: the email address is 30
       characters and breaks mid-domain in an even track. */
    .ft__grid {
      grid-template-columns: 1.5fr 0.95fr 0.95fr 1fr 1.35fr;
      gap: var(--s6);
    }
  }
</style>
