---
/**
 * CIRCUIT RAIL — the page's own signature.
 *
 * A PCB trace runs down the left gutter and draws itself as you scroll,
 * with solder pads that light as the current reaches them. It is the
 * company's actual subject matter: Danat repairs boards at the component
 * level, so the page is literally wired like one.
 *
 * Driven by --scroll, the page-progress variable the scroll engine
 * publishes on :root. That makes it scroll-LINKED rather than a timed
 * animation that fires once and stops — it tracks you both ways, and
 * scrubbing back un-draws it.
 *
 * Costs nothing: one inline SVG, no library, no per-frame JavaScript of
 * its own. Hidden below 100rem, where the gutter is too narrow, and
 * under reduced motion, where --scroll is never published and the
 * fallback leaves it fully drawn and still.
 */

/** Right-angle trace with pads at the corners, as a board would route. */
const D =
  'M14,0 L14,120 L14,150 Q14,164 28,164 L30,164 Q44,164 44,178 L44,300 ' +
  'L44,330 Q44,344 30,344 L28,344 Q14,344 14,358 L14,520 L14,560 ' +
  'Q14,574 28,574 L30,574 Q44,574 44,588 L44,760 L44,800 ' +
  'Q44,814 30,814 L28,814 Q14,814 14,828 L14,1000';

/** Pads sit on the corners the trace turns at. */
const pads: [number, number][] = [
  [14, 120], [44, 300], [14, 520], [44, 760], [14, 1000],
];
---

<div class="rail" aria-hidden="true">
  <svg viewBox="0 0 56 1000" preserveAspectRatio="none" fill="none">
    {/* The unlit trace, always there, so the rail reads as a board even
        before anything is drawn. */}
    <path class="rail__bed" d={D} />
    {/* The live trace, drawn by scroll. */}
    <path class="rail__live" d={D} pathLength="1" />
  </svg>

  {/* Pads are separate so they can light independently of the sweep. */}
  <svg class="rail__pads" viewBox="0 0 56 1000" preserveAspectRatio="none" fill="none">
    {pads.map(([x, y], i) => (
      <g class="rail__pad" style={`--at:${(y / 1000).toFixed(3)}`}>
        <circle cx={x} cy={y} r="9" class="rail__ring" />
        <circle cx={x} cy={y} r="3.4" class="rail__core" />
      </g>
    ))}
  </svg>
</div>

<style>
  .rail {
    position: fixed;
    left: 0;
    top: 0;
    bottom: 0;
    width: 56px;
    z-index: 2;
    display: none;
    pointer-events: none;
  }
  .rail svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .rail {
    /* Balanced for both grounds: 4.36:1 on white, 4.57:1 on #07090a.
       --green is only 2.88:1 on white, which reads as nothing. */
    --trace: #41883c;
  }

  .rail__bed {
    stroke: color-mix(in oklab, var(--trace) 20%, transparent);
    stroke-width: 2;
  }

  /* stroke-dashoffset is driven straight off page progress, so the trace
     follows the scrollbar rather than replaying on every entry. */
  .rail__live {
    stroke: var(--trace);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: calc(1 - var(--scroll, 1));
    filter: drop-shadow(0 0 4px color-mix(in oklab, var(--trace) 55%, transparent));
  }

  /* A pad lights once the trace has passed it. The step is sharp on
     purpose — current arrives, it does not fade in. */
  .rail__pad {
    --lit: clamp(0, calc((var(--scroll, 1) - var(--at)) * 40), 1);
  }
  .rail__ring {
    stroke: var(--trace);
    stroke-width: 1.6;
    opacity: calc(0.18 + var(--lit) * 0.82);
  }
  .rail__core {
    fill: var(--trace);
    opacity: calc(0.2 + var(--lit) * 0.8);
  }

  /* Only where there is a gutter to put it in. */
  @media (min-width: 100rem) {
    .rail { display: block; }
  }

  @media (prefers-reduced-motion: reduce) {
    /* --scroll is never published, so the fallback of 1 leaves the trace
       fully drawn and every pad lit. Nothing moves, nothing is missing. */
    .rail__live { filter: none; }
  }
</style>
